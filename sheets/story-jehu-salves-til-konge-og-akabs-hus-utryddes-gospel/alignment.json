 "lines": [
  {
   "text": "Elisha called a young disciple",
   "heard": 5,
   "words": 5,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Tuck in your cloak and go to Ramoth-gilead",
   "heard": 7,
   "words": 8,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Find Jehu son of Nimshi",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pour oil on his head and declare his name",
   "heard": 9,
   "words": 9,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jehu is king over Israel",
   "heard": 5,
   "words": 5,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD has spoken and the judgment comes",
   "heard": 8,
   "words": 8,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Strike down the house of Ahab",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Avenge the prophets and the blood they shed",
   "heard": 8,
   "words": 8,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They spread their cloaks on the steps",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Trumpets blew the message loud",
   "heard": 5,
   "words": 5,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jehu rode his chariot fast",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Toward the walls of Jezreel",
   "heard": 5,
   "words": 5,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Joram saw him and asked",
   "heard": 5,
   "words": 5,
   "error_s": 1.37,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Do you come in peace today",
   "heard": 6,
   "words": 6,
   "error_s": 1.44,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jehu said what do you know of peace",
   "heard": 8,
   "words": 8,
   "error_s": 1.52,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "As long as idolatry remains",
   "heard": 4,
   "words": 5,
   "error_s": 1.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jehu is king over Israel",
   "heard": 5,
   "words": 5,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD has spoken and the judgment comes",
   "heard": 8,
   "words": 8,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Strike down the house of Ahab",
   "heard": 5,
   "words": 6,
   "error_s": 1.41,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Avenge the prophets and the blood they shed",
   "heard": 8,
   "words": 8,
   "error_s": 1.32,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jehu drew his bow and shot",
   "heard": 6,
   "words": 6,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The arrow pierced the king's heart",
   "heard": 6,
   "words": 6,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He fell in his chariot",
   "heard": 5,
   "words": 5,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "On Naboth's plot of ground",
   "heard": 4,
   "words": 5,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Ahaziah fled in fear",
   "heard": 4,
   "words": 4,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But arrows found him on the road",
   "heard": 7,
   "words": 7,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He died at Megiddo",
   "heard": 4,
   "words": 4,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His body taken to Jerusalem",
