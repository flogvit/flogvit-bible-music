   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But Jesus looked with grace",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Saw the small face",
   "heard": 4,
   "words": 4,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let the little children come to me",
   "heard": 7,
   "words": 7,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And do not hinder them",
