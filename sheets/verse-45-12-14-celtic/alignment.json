 "words": 142,
 "lines": [
  {
   "text": "Never let your zeal grow slack",
   "heard": 6,
   "words": 6,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Be fervent in spirit today",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Serve the Lord with steady hand",
   "heard": 6,
   "words": 6,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the light of His grace",
   "heard": 6,
   "words": 6,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Share with the saints in their need",
   "heard": 7,
   "words": 7,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pursue hospitality for all",
   "heard": 4,
   "words": 4,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Live in harmony with one another",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be arrogant at all",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bless those who persecute you",
   "heard": 5,
   "words": 5,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bless them and do not curse",
   "heard": 6,
   "words": 6,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rejoice with those who rejoice",
   "heard": 5,
   "words": 5,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Weep with those who weep",
   "heard": 4,
   "words": 5,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Repay no one evil for evil",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give thought to what is honorable",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "If it is possible for you",
   "heard": 6,
   "words": 6,
   "error_s": 1.06,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Live at peace with everyone",
   "heard": 5,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bless those who persecute you",
   "heard": 5,
   "words": 5,
   "error_s": 0.78,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Bless them and do not curse",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rejoice with those who rejoice",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Weep with those who weep",
   "heard": 5,
   "words": 5,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Associate with the lowly ones",
   "heard": 5,
   "words": 5,
   "error_s": 0.48,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Do not be wise in your own eyes",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
