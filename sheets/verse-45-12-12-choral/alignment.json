 "lines": [
  {
   "text": "Let love be genuine and true",
   "heard": 6,
   "words": 6,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hate what is evil, hold fast to good",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Be devoted to one another",
   "heard": 5,
   "words": 5,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Outdo one another in honor",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Never let your zeal grow slack",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Be fervent in spirit",
   "heard": 4,
   "words": 4,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Serve the Lord with all your heart",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rejoice in hope",
   "heard": 3,
   "words": 3,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Endure in affliction",
   "heard": 3,
   "words": 3,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Persevere in prayer",
   "heard": 3,
   "words": 3,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Share with the saints in their needs",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pursue hospitality always",
   "heard": 3,
   "words": 3,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bless those who persecute you",
   "heard": 5,
   "words": 5,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bless them and do not curse them",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rejoice in hope",
   "heard": 3,
   "words": 3,
   "error_s": 1.39,
