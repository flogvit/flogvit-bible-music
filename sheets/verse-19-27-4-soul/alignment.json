  {
   "text": "To dwell in the house of the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 1.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For all the days that I have",
   "heard": 7,
   "words": 7,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He hides me under the cover",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of his tent upon a rock",
   "heard": 5,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My head is lifted high above",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The enemies who surround me",
   "heard": 5,
   "words": 5,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will sing and make music",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the Lord in his tent",
