   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who is better in his eyes",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So all the women from the least",
