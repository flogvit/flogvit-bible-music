{
 "id": "story-den-lamme-ved-betesda-dammen-choral",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-den-lamme-ved-betesda-dammen-choral",
 "offset_seconds": -3.6600000000001778,
 "words_heard": 240,
 "words": 243,
 "lines": [
  {
   "text": "By the Sheep Gate in Jerusalem stands a pool",
   "heard": 9,
   "words": 9,
   "error_s": 1.37,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Called Bethesda where the sick all are",
   "heard": 7,
   "words": 7,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Five covered colonnades hold the crowd",
   "heard": 6,
   "words": 6,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blind and lame and paralyzed remain",
   "heard": 6,
   "words": 6,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Waiting for the water to be stirred",
   "heard": 7,
   "words": 7,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "An angel comes to stir the waves",
   "heard": 6,
   "words": 7,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The first to step in after the stir",
   "heard": 8,
   "words": 8,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Is healed of whatever illness held him",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One man there had been an invalid",
   "heard": 7,
   "words": 7,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For thirty-eight long years he lay",
   "heard": 5,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jesus saw him lying there below",
   "heard": 6,
   "words": 6,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And asked if he desired to be well",
   "heard": 8,
   "words": 8,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sick man answered with a sigh",
   "heard": 7,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have no one to help me in",
   "heard": 8,
   "words": 8,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "While I am on my way to the pool",
   "heard": 9,
   "words": 9,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Someone else goes down ahead of me",
   "heard": 7,
   "words": 7,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jesus said to him in that hour",
   "heard": 7,
   "words": 7,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Get up and pick up your mat",
   "heard": 7,
   "words": 7,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And walk with me this very day",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At once the man was made well",
   "heard": 6,
   "words": 7,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He picked up his mat and began to walk",
   "heard": 9,
   "words": 9,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now that day was a Sabbath",
   "heard": 6,
   "words": 6,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Jews said it is not permitted",
   "heard": 7,
   "words": 7,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To carry your mat on this holy day",
   "heard": 8,
   "words": 8,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But he answered the man who made me well",
   "heard": 9,
   "words": 9,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Told me to pick it up and walk",
   "heard": 8,
   "words": 8,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who is the man who told you so",
   "heard": 8,
   "words": 8,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They asked him in the crowd",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the man who had been healed did not know",
   "heard": 10,
   "words": 10,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jesus had slipped away from the place",
   "heard": 7,
   "words": 7,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Later Jesus found him in the temple",
   "heard": 7,
   "words": 7,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And spoke to him with gentle care",
   "heard": 7,
   "words": 7,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sin no more or something worse may happen",
   "heard": 8,
   "words": 8,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  }
 ],
