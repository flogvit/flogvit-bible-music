 "lines": [
  {
   "text": "The One enthroned in heaven laughs",
   "heard": 5,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He mocks the raging kings below",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then he speaks in anger and wrath",
   "heard": 7,
   "words": 7,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Terrifying them as they go",
   "heard": 5,
   "words": 5,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I myself have installed my king",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Upon Zion my holy mountain",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are my Son today I have begotten you",
   "heard": 9,
   "words": 9,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ask of me and I will make the nations yours",
   "heard": 10,
   "words": 10,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The ends of the earth shall be your possession",
   "heard": 9,
   "words": 9,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are my Son today I have begotten you",
   "heard": 9,
   "words": 9,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Break them with an iron rod",
   "heard": 6,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shatter them like a potter's jar",
   "heard": 5,
   "words": 6,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So now be wise you kings of earth",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Be warned you judges far and near",
   "heard": 7,
   "words": 7,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
