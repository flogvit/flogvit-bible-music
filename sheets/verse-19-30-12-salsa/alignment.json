 "words": 114,
 "lines": [
  {
   "text": "I was dressed in sackcloth",
   "heard": 5,
   "words": 5,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sitting in the dust",
   "heard": 4,
   "words": 4,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But you came and lifted me",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You turned it all around",
   "heard": 5,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You turned my mourning into dancing",
   "heard": 6,
   "words": 6,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You clothed me with joy",
   "heard": 5,
   "words": 5,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My heart will sing your praise",
   "heard": 6,
   "words": 6,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And not be silent",
   "heard": 3,
   "words": 4,
   "error_s": 0.85,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Take away my sorrow",
   "heard": 4,
   "words": 4,
   "error_s": 1.08,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Put the music in my feet",
   "heard": 6,
   "words": 6,
   "error_s": 1.37,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Lord, my God, I thank you",
   "heard": 6,
   "words": 6,
   "error_s": 2.07,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Forever I will sing",
   "heard": 4,
   "words": 4,
   "error_s": 1.93,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "You turned my mourning into dancing",
