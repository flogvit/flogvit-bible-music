 "lines": [
  {
   "text": "My soul magnifies the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 1.34,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And my spirit rejoices",
   "heard": 4,
   "words": 4,
   "error_s": 1.36,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In God my Savior",
   "heard": 4,
   "words": 4,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For he has looked upon the humble state of his servant",
   "heard": 11,
   "words": 11,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From now on all generations",
   "heard": 5,
   "words": 5,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will call me blessed",
   "heard": 4,
   "words": 4,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the Mighty One has done great things for me",
   "heard": 10,
   "words": 10,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Holy is his name",
   "heard": 4,
   "words": 4,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His mercy extends to those who fear him",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From generation to generation",
   "heard": 4,
   "words": 4,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  }
