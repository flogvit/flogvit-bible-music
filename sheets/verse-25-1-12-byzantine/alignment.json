 "words": 97,
 "lines": [
  {
   "text": "Is it nothing to you, all you who pass by",
   "heard": 10,
   "words": 10,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look and see",
   "heard": 3,
   "words": 3,
   "error_s": 1.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Is there any sorrow like my sorrow",
   "heard": 7,
   "words": 7,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That was brought upon me",
   "heard": 5,
   "words": 5,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For these things I weep",
   "heard": 5,
   "words": 5,
   "error_s": 1.23,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My eyes flow down with tears",
   "heard": 6,
   "words": 6,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the comforter is far from me",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The one who should restore my soul",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look and see, look and see",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Is there any sorrow like my sorrow",
   "heard": 7,
   "words": 7,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My children are desolate",
   "heard": 4,
   "words": 4,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the enemy has prevailed",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zion stretches out her hands",
   "heard": 5,
   "words": 5,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And there is none to comfort her",
   "heard": 7,
   "words": 7,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look and see, look and see",
