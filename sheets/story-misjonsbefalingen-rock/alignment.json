   "heard": 9,
   "words": 9,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the mountain into every town, to every land and nation",
   "heard": 11,
   "words": 11,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
