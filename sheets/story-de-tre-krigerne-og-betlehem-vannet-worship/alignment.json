 "words_heard": 160,
 "words": 163,
 "lines": [
  {
   "text": "The Philistines held the gate strong",
   "heard": 6,
   "words": 6,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "David waited in the cave deep",
   "heard": 6,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Three chief men heard the longing song",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And rose while the harvest was ripe",
   "heard": 7,
   "words": 7,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pour it out to the Lord above",
   "heard": 7,
   "words": 7,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "It is blood of the men who died",
   "heard": 8,
   "words": 8,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not drink from this cup of love",
   "heard": 8,
   "words": 8,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For their lives are the price paid",
   "heard": 7,
   "words": 7,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They broke through the enemy camp",
   "heard": 6,
   "words": 6,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And drew water from the well",
   "heard": 6,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The risk was great and the danger damp",
   "heard": 8,
   "words": 8,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But they carried it back to town",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pour it out to the Lord above",
   "heard": 7,
   "words": 7,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It is blood of the men who died",
   "heard": 6,
   "words": 8,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not drink from this cup of love",
   "heard": 8,
   "words": 8,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For their lives are the price paid",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Far be it from me to take",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This sacrifice of their blood",
   "heard": 4,
   "words": 5,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The mighty men went at the risk",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And gave their lives to God",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Such were the exploits of the three",
   "heard": 7,
   "words": 7,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Refusing to drink the water",
   "heard": 5,
   "words": 5,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Honor the risk of the men for me",
   "heard": 8,
   "words": 8,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And keep the holy order",
   "heard": 5,
   "words": 5,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  }
 ],
