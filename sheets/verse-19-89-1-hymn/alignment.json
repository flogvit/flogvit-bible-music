   "words": 6,
   "error_s": 1.97,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Steadfast love is built to last forever",
   "heard": 7,
   "words": 7,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
