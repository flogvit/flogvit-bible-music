   "words": 7,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Part of the structure of the people",
   "heard": 7,
   "words": 7,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Chief Timna and Chief Alvah are named",
   "heard": 6,
   "words": 7,
   "error_s": 0.8,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Chief Jetheth holds his place in the land",
   "heard": 8,
   "words": 8,
   "error_s": 0.54,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Chief Oholibamah and Chief Elah",
   "heard": 4,
   "words": 5,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
