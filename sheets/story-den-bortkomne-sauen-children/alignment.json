 "lines": [
  {
   "text": "A shepherd had a hundred sheep",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He counted them before his sleep",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ninety-seven, ninety-eight",
   "heard": 0,
   "words": 2,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Ninety-nine, but wait, wait, wait",
   "heard": 4,
   "words": 5,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ninety-nine and one, ninety-nine and one",
   "heard": 4,
   "words": 6,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will not stop looking till the lost one comes",
   "heard": 10,
   "words": 10,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Up on his shoulders, home we go",
   "heard": 7,
   "words": 7,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rejoice with me, for I have found my lost sheep",
   "heard": 10,
   "words": 10,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He left the ninety-nine to graze",
   "heard": 5,
   "words": 6,
   "error_s": 0.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And searched the hills and rocky ways",
   "heard": 7,
   "words": 7,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Behind a bush, beneath a tree",
   "heard": 6,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Baa, baa, here I am, it is me",
   "heard": 6,
   "words": 8,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ninety-nine and one, ninety-nine and one",
   "heard": 4,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will not stop looking till the lost one comes",
   "heard": 10,
   "words": 10,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Up on his shoulders, home we go",
   "heard": 5,
   "words": 7,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rejoice with me, for I have found my lost sheep",
   "heard": 10,
   "words": 10,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He did not scold, he did not frown",
   "heard": 8,
   "words": 8,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He laid it on his shoulders, homeward bound",
   "heard": 8,
   "words": 8,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He called his neighbors and his friends",
   "heard": 7,
   "words": 7,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come and rejoice, the lost is found again",
   "heard": 8,
   "words": 8,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "There is joy in heaven, joy, joy, joy",
   "heard": 8,
   "words": 8,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When one who was lost comes home",
   "heard": 7,
   "words": 7,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It is not the will of your Father in heaven",
   "heard": 10,
   "words": 10,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
