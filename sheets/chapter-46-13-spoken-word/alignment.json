 "offset_seconds": -1.4800000000002242,
 "words_heard": 130,
 "words": 130,
 "lines": [
  {
   "text": "If I speak in the tongues of men and of angels",
   "heard": 11,
   "words": 11,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But have not love",
   "heard": 4,
   "words": 4,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am a noisy gong, a clanging cymbal",
   "heard": 8,
   "words": 8,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If I have all faith, so as to remove mountains",
   "heard": 10,
   "words": 10,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But have not love, I am nothing",
   "heard": 7,
   "words": 7,
   "error_s": 2.12,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Love is patient, love is kind",
   "heard": 6,
   "words": 6,
   "error_s": 2.89,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Love never ends",
   "heard": 3,
   "words": 3,
   "error_s": 0.41,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Love does not envy or boast",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "It is not arrogant or rude",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It does not insist on its own way",
   "heard": 8,
   "words": 8,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It bears all things, believes all things",
   "heard": 7,
   "words": 7,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hopes all things, endures all things",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Love is patient, love is kind",
   "heard": 6,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Love never ends",
   "heard": 3,
   "words": 3,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For now we see in a mirror dimly",
   "heard": 8,
   "words": 8,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But then face to face",
   "heard": 5,
   "words": 5,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now I know in part, then I shall know fully",
   "heard": 10,
   "words": 10,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So now faith, hope and love abide, these three",
   "heard": 9,
   "words": 9,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the greatest of these is love",
   "heard": 7,
   "words": 7,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  }
 ],
