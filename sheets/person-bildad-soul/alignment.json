   "heard": 9,
   "words": 9,
   "error_s": 1.91,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Can papyrus grow where there is no marsh",
   "heard": 8,
   "words": 8,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Can reeds flourish without water",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The hope of the godless perishes",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
