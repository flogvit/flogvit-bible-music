 "words": 128,
 "lines": [
  {
   "text": "David fled to Nob that day",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The priest met him in fear",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why are you alone he asked",
   "heard": 6,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With no one else near",
   "heard": 5,
   "words": 5,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have no ordinary bread",
   "heard": 5,
   "words": 5,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Only holy loaves remain",
   "heard": 4,
   "words": 4,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Since the LORD took them away",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fresh warm bread takes their place",
   "heard": 6,
   "words": 6,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give me five loaves if you have",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Or whatever you can find",
   "heard": 4,
   "words": 5,
   "error_s": 0.63,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The men have kept from women",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As always on my mind",
   "heard": 4,
   "words": 5,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have no ordinary bread",
   "heard": 5,
   "words": 5,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Only holy loaves remain",
   "heard": 4,
   "words": 4,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Since the LORD took them away",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fresh warm bread takes their place",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Doeg the Edomite stood there",
   "heard": 5,
   "words": 5,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Watching with Saul\u2019s men",
   "heard": 4,
   "words": 4,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He saw the son of Jesse",
   "heard": 6,
   "words": 6,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And knew the priest again",
   "heard": 5,
   "words": 5,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You shall surely die Ahimelech",
   "heard": 4,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With your father\u2019s whole house",
   "heard": 5,
   "words": 5,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Doeg turned to strike them down",
   "heard": 5,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Eighty-five in this course",
   "heard": 3,
   "words": 4,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  }
