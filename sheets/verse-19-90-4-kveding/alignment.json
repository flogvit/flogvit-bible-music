   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "F\u00f8r fjellene ble f\u00f8dt",
   "heard": 4,
   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "fra evighet til evighet er du Gud",
   "heard": 7,
   "words": 7,
   "error_s": 15.91,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Du lar mennesket vende tilbake til st\u00f8v",
   "heard": 7,
   "words": 7,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og sier: Vend tilbake, dere menneskebarn",
   "heard": 6,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For tusen \u00e5r er i dine \u00f8yne",
   "heard": 7,
   "words": 7,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "som dagen i g\u00e5r n\u00e5r den er forbi",
   "heard": 8,
   "words": 8,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Om morgenen er de som gress som skifter",
   "heard": 7,
   "words": 8,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "om morgenen blomstrer det",
   "heard": 3,
   "words": 4,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
