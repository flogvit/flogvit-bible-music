   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jezebel painted her eyes",
   "heard": 4,
   "words": 4,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Looking out the window in pride",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She asked is it peace, you Zimri",
   "heard": 5,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who is on my side, who",
   "heard": 6,
