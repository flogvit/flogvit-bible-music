 "lines": [
  {
   "text": "Repay no one evil for evil",
   "heard": 5,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give careful thought to what is honorable",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be wise in your own eyes",
   "heard": 8,
   "words": 8,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Associate with the lowly, stay humble",
   "heard": 6,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If it is possible, as far as it depends on you",
   "heard": 11,
   "words": 11,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Live at peace with everyone",
   "heard": 5,
   "words": 5,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be overcome by evil",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Overcome evil with good",
   "heard": 4,
   "words": 4,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bless those who persecute you",
   "heard": 5,
   "words": 5,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bless them and do not curse them",
   "heard": 7,
   "words": 7,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rejoice with those who rejoice",
   "heard": 5,
   "words": 5,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Weep with those who weep, be one",
   "heard": 7,
   "words": 7,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If it is possible, as far as it depends on you",
   "heard": 11,
   "words": 11,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Live at peace with everyone",
   "heard": 5,
