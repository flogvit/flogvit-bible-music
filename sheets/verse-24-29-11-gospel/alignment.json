 "words": 207,
 "lines": [
  {
   "text": "Far from home by a foreign river",
   "heard": 7,
   "words": 7,
   "error_s": 3.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Hung my harp on the willow tree",
   "heard": 7,
   "words": 7,
   "error_s": 2.82,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Every road I knew was broken",
   "heard": 6,
   "words": 6,
   "error_s": 3.02,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Every dream was lost to me",
   "heard": 6,
   "words": 6,
   "error_s": 3.07,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Then a letter came one dusty morning",
   "heard": 7,
   "words": 7,
   "error_s": 2.8,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Build your house and plant the vine",
   "heard": 7,
   "words": 7,
   "error_s": 2.26,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Seek the peace of the city you live in",
   "heard": 9,
   "words": 9,
   "error_s": 2.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I have not forgotten mine",
   "heard": 5,
   "words": 5,
   "error_s": 1.96,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I hold the thoughts I think of you",
   "heard": 8,
   "words": 8,
   "error_s": 1.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Thoughts of peace and not of harm",
   "heard": 7,
   "words": 7,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A future and a hope, my child",
   "heard": 7,
   "words": 7,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Held forever in my arms",
   "heard": 5,
   "words": 5,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seventy years is a long time waiting",
   "heard": 6,
   "words": 7,
   "error_s": 3.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Children grow and the old ones sigh",
   "heard": 6,
   "words": 7,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the One who counts the sparrows",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Writes tomorrow in the sky",
   "heard": 5,
   "words": 5,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I hold the thoughts I think of you",
   "heard": 8,
   "words": 8,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Thoughts of peace and not of harm",
   "heard": 7,
   "words": 7,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A future and a hope, my child",
   "heard": 7,
   "words": 7,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Held forever in my arms",
   "heard": 5,
   "words": 5,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When you seek me, you will find me",
   "heard": 8,
   "words": 8,
   "error_s": 3.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "When you search with all your heart",
   "heard": 7,
   "words": 7,
   "error_s": 3.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I will bring you home again",
   "heard": 6,
   "words": 6,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": false
  },
  {
