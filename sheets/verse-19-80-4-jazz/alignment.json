  {
   "text": "Shepherd of Israel listen to us now",
   "heard": 6,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You who lead Joseph like a flock",
   "heard": 5,
