 "words_heard": 209,
 "words": 211,
 "lines": [
  {
   "text": "Saul's daughter Michal loved David",
   "heard": 5,
   "words": 5,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He killed two hundred Philistines",
   "heard": 3,
   "words": 5,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To win her hand from the king",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She let him escape the night",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through the window he ran away",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A household idol in the bed",
   "heard": 6,
   "words": 6,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Saul sought his life in vain",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But she deceived the messengers",
   "heard": 5,
   "words": 5,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She said he was sick and weak",
   "heard": 7,
   "words": 7,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He fled to save his own life",
   "heard": 7,
   "words": 7,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Dancing before the Lord",
   "heard": 4,
   "words": 4,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Leaping with joy in the street",
   "heard": 6,
   "words": 6,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Michal looked down from the window",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And despised him in her heart",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Years passed and David was king",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He asked for his wife to return",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Paltiel followed weeping",
   "heard": 3,
   "words": 3,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sent away to go home",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The ark of the covenant came",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Into the city of David",
   "heard": 5,
   "words": 5,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "David leaped and danced before",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord of hosts on high",
   "heard": 6,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Michal came out to meet him",
   "heard": 6,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With scorn upon her face",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Dancing before the Lord",
   "heard": 4,
   "words": 4,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Leaping with joy in the street",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Michal looked down from the window",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And despised him in her heart",
   "heard": 6,
   "words": 6,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How the king has exposed himself",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Before the eyes of slave girls",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "David said I will be humbled",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In my own eyes I am small",
   "heard": 7,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Before the Lord I will celebrate",
   "heard": 6,
   "words": 6,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And be held in honor by them",
   "heard": 7,
   "words": 7,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Michal had no child to the day of her death",
   "heard": 10,
   "words": 10,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She remained in childless ways",
   "heard": 5,
   "words": 5,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  }
