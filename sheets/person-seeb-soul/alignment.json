 "lines": [
  {
   "text": "From the sons of Cush, Seba is named",
   "heard": 8,
   "words": 8,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Havilah, Sabtah, and Raamah",
   "heard": 4,
   "words": 4,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sons of Raamah, Sheba and Dedan",
   "heard": 7,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A line of nations, known by name",
   "heard": 7,
   "words": 7,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Cush fathered Nimrod, mighty on earth",
   "heard": 6,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A hunter before the Lord, it is said",
   "heard": 8,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Like Nimrod, a mighty hunter",
   "heard": 5,
   "words": 5,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Kingdoms of Babel, Erech, and Akkad",
