   "words": 7,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have surely seen the misery of my people in Egypt",
   "heard": 11,
   "words": 11,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
