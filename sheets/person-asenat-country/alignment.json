 "lines": [
  {
   "text": "Pharaoh named him Zaphenath-paneah",
   "heard": 3,
   "words": 4,
   "error_s": 1.13,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Gave him Asenath, daughter of Potiphera",
   "heard": 6,
   "words": 6,
   "error_s": 1.15,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Priest of On, a wife of grace",
   "heard": 7,
   "words": 7,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Joseph stood before the king",
   "heard": 5,
   "words": 5,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Thirty years old in that land",
   "heard": 5,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He left the palace, traveled on",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "May God make you like Ephraim and Manasseh",
   "heard": 8,
   "words": 8,
   "error_s": 0.24,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Blessed with names that carry on",
   "heard": 6,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Inheritance equal, sons of Israel",
   "heard": 5,
   "words": 5,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Adopted in the covenant home",
   "heard": 5,
   "words": 5,
   "error_s": 0.17,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Before the famine came to pass",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Two sons were born in the land",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Manasseh, the firstborn son",
   "heard": 4,
   "words": 4,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God made him forget his hardship",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ephraim, the fruitful boy",
   "heard": 4,
   "words": 4,
   "error_s": 1.15,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Born where he had suffered long",
   "heard": 6,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Asenath, mother of these two",
   "heard": 5,
   "words": 5,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Secured their place in the genealogy",
   "heard": 6,
   "words": 6,
   "error_s": 1.65,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "May God make you like Ephraim and Manasseh",
   "heard": 8,
