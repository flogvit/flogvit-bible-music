   "uncertain": false
  },
  {
   "text": "Who are called according to his purpose",
   "heard": 7,
   "words": 7,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In all things, in all things",
