 "lines": [
  {
   "text": "The word of the Lord came to Jonah one day",
   "heard": 10,
   "words": 10,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Go to Nineveh, preach against her ways",
   "heard": 3,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But Jonah ran down to Joppa instead",
   "heard": 7,
   "words": 7,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Paid for a ship bound for Tarshish ahead",
   "heard": 7,
   "words": 8,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Running from the Lord, running from the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You can't outrun him on the sea or the shore",
   "heard": 10,
   "words": 10,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Running from the Lord, running from the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jonah went down, down, down",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord sent a wind and a terrible storm",
   "heard": 9,
   "words": 9,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sailors cried out, every man to his god",
   "heard": 9,
   "words": 9,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jonah lay sleeping deep down in the hold",
   "heard": 8,
   "words": 8,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Throw me in the sea and it will be calm",
   "heard": 10,
   "words": 10,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Running from the Lord, running from the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You can't outrun him on the sea or the shore",
   "heard": 10,
   "words": 10,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Running from the Lord, running from the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jonah went down, down, down",
   "heard": 5,
   "words": 5,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They threw him overboard and the sea grew still",
   "heard": 9,
   "words": 9,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord sent a fish to do his will",
   "heard": 9,
   "words": 9,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Three days and three nights in the belly of the whale",
   "heard": 11,
   "words": 11,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jonah learned to pray where his running failed",
   "heard": 7,
   "words": 8,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  }
