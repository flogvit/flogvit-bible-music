 "lines": [
  {
   "text": "They will sing of the ways of the LORD",
   "heard": 9,
   "words": 9,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the glory of the LORD is great",
   "heard": 8,
   "words": 8,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is exalted yet he sees the lowly",
   "heard": 8,
   "words": 8,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The proud he knows from afar",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The LORD will fulfill his purpose for me",
   "heard": 8,
   "words": 8,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your steadfast love endures forever",
   "heard": 5,
   "words": 5,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not abandon the work of your hands",
   "heard": 8,
   "words": 8,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your right hand saves me",
   "heard": 5,
   "words": 5,
   "error_s": 1.71,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Though I walk in the midst of trouble",
   "heard": 8,
   "words": 8,
   "error_s": 1.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You keep me alive and hold me",
   "heard": 7,
   "words": 7,
   "error_s": 1.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You stretch out your hand against the wrath",
   "heard": 8,
   "words": 8,
   "error_s": 1.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of my enemies you save me",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD will fulfill his purpose for me",
   "heard": 8,
   "words": 8,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your steadfast love endures forever",
   "heard": 5,
