   "error_s": 0.92,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He will destroy the mighty and the holy people",
   "heard": 9,
   "words": 9,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through his cunning, deceit will prosper",
   "heard": 6,
