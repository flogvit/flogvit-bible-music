 "lines": [
  {
   "text": "Keep your life free from the love of money",
   "heard": 9,
   "words": 9,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Be content with what you have today",
   "heard": 7,
   "words": 7,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He has spoken a promise that stands firm",
   "heard": 8,
   "words": 8,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the quiet of the world",
   "heard": 6,
   "words": 6,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No fear takes hold of the heart",
   "heard": 7,
   "words": 7,
   "error_s": 1.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When the Lord is near",
   "heard": 5,
   "words": 5,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will never leave you nor forsake you",
   "heard": 8,
   "words": 8,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So we can say with confidence",
   "heard": 6,
   "words": 6,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord is my helper I will not be afraid",
   "heard": 10,
   "words": 10,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "What can anyone do to me",
   "heard": 6,
   "words": 6,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Marriage is to be honored by all",
   "heard": 7,
   "words": 7,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The marriage bed kept undefiled",
   "heard": 5,
   "words": 5,
   "error_s": 1.2,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "God will judge the sexually immoral",
