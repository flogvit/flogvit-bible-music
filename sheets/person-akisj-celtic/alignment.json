 "lines": [
  {
   "text": "David fled the king of Israel",
   "heard": 6,
   "words": 6,
   "error_s": 1.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Crossed the border to Gath's gate",
   "heard": 6,
   "words": 6,
   "error_s": 1.61,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Achish sat upon his throne",
   "heard": 5,
   "words": 5,
   "error_s": 1.52,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But the servants knew his name",
   "heard": 6,
   "words": 6,
   "error_s": 1.49,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They sang of David's fame",
   "heard": 5,
   "words": 5,
   "error_s": 1.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Saul struck thousands, David ten",
   "heard": 5,
   "words": 5,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "David's heart was filled with fear",
   "heard": 6,
   "words": 6,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He knew his days were done",
   "heard": 6,
   "words": 6,
   "error_s": 1.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Madman make marks on the door",
   "heard": 5,
   "words": 6,
   "error_s": 1.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Spittle runs down your beard",
   "heard": 5,
   "words": 5,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why bring such a fool to me",
   "heard": 7,
   "words": 7,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look at him, he is mad",
   "heard": 6,
   "words": 6,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Six hundred men with him came",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Two wives in his household",
   "heard": 5,
   "words": 5,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ziklag was given that day",
   "heard": 4,
   "words": 5,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Saul stopped his search",
   "heard": 4,
   "words": 4,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "David raided the south",
   "heard": 4,
   "words": 4,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Geshurites and Amalekites",
   "heard": 3,
   "words": 3,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He told the king it was Judah",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Deception in his eyes",
   "heard": 4,
   "words": 4,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Madman make marks on the door",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Spittle runs down your beard",
   "heard": 5,
   "words": 5,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why bring such a fool to me",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look at him, he is mad",
   "heard": 6,
   "words": 6,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bodyguard for life he said",
   "heard": 5,
   "words": 5,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "March with me against Israel",
   "heard": 5,
   "words": 5,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the rulers said no",
   "heard": 5,
   "words": 5,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Send the Hebrew back away",
   "heard": 5,
   "words": 5,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Trust was broken in the court",
   "heard": 6,
   "words": 6,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "David left with heavy heart",
   "heard": 5,
   "words": 5,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Two slaves ran to Gath",
   "heard": 5,
   "words": 5,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shimei broke his oath to Solomon",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Achish son of Maacah",
   "heard": 3,
   "words": 4,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "King of Gath, the end",
   "heard": 5,
