 "words": 106,
 "lines": [
  {
   "text": "I lift my eyes to the mountains",
   "heard": 7,
   "words": 7,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where will my help come from",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My help comes from the LORD",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who made heaven and earth",
   "heard": 5,
   "words": 5,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will not let your foot slip",
   "heard": 7,
   "words": 7,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He who watches over you will not slumber",
   "heard": 8,
   "words": 8,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "See, he who watches over Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will neither slumber nor sleep",
   "heard": 5,
   "words": 5,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD watches over you",
   "heard": 5,
   "words": 5,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD is your shade at your right side",
   "heard": 9,
   "words": 9,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sun will not strike you by day",
   "heard": 8,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nor the moon by night",
   "heard": 5,
   "words": 5,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD will keep you from all harm",
   "heard": 8,
   "words": 8,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will watch over your life",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD will watch over your going out and your coming in",
   "heard": 12,
   "words": 12,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now and forevermore",
   "heard": 3,
   "words": 3,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  }
 ],
