 "lines": [
  {
   "text": "The Lord is my shepherd, I shall not want",
   "heard": 9,
   "words": 9,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He makes me lie down in green pastures",
   "heard": 8,
   "words": 8,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He leads me beside the still waters",
   "heard": 7,
   "words": 7,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He restores my soul",
   "heard": 4,
   "words": 4,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Though I walk through the valley of the shadow",
   "heard": 9,
   "words": 9,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will fear no evil, for you are with me",
   "heard": 10,
   "words": 10,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your rod and your staff, they comfort me",
   "heard": 8,
   "words": 8,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the valley of the shadow",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You prepare a table before me",
   "heard": 6,
   "words": 6,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the presence of my enemies",
   "heard": 6,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You anoint my head with oil",
   "heard": 6,
   "words": 6,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
