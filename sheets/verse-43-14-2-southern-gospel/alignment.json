 "lines": [
  {
   "text": "Do not let your hearts be troubled",
   "heard": 7,
   "words": 7,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You believe in God, believe in me",
   "heard": 7,
   "words": 7,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In my Father's house are many rooms",
   "heard": 7,
   "words": 7,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If it were not so, would I have told you",
   "heard": 10,
   "words": 10,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "There's a room prepared for me",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In my Father's house up yonder",
   "heard": 6,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will go and he will come again",
   "heard": 8,
   "words": 8,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And take me home to be with him",
   "heard": 8,
   "words": 8,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I go to prepare a place for you",
   "heard": 8,
   "words": 8,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And if I go, I'll come again",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And take you to myself, that where I am",
   "heard": 9,
   "words": 9,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
