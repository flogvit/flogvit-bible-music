{
 "id": "person-konanja-hymn",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-konanja-hymn",
 "offset_seconds": -4.860000000000152,
 "words_heard": 121,
 "words": 133,
 "lines": [
  {
   "text": "They faithfully brought in the contributions",
   "heard": 6,
   "words": 6,
   "error_s": 1.71,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The tithes and the dedicated gifts",
   "heard": 6,
   "words": 6,
   "error_s": 1.58,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Conaniah the Levite was in charge",
   "heard": 6,
   "words": 6,
   "error_s": 1.74,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Managing every holy thing",
   "heard": 4,
   "words": 4,
   "error_s": 1.57,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His brother Shimei was second in command",
   "heard": 6,
   "words": 7,
   "error_s": 1.58,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Serving under the King",
   "heard": 4,
   "words": 4,
   "error_s": 1.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jehiel and Azaziah served as supervisors",
   "heard": 5,
   "words": 6,
   "error_s": 1.34,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Nahath and Asahel too",
   "heard": 2,
   "words": 4,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "By appointment of King Hezekiah",
   "heard": 5,
   "words": 5,
   "error_s": 1.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And Azariah the official",
   "heard": 4,
   "words": 4,
   "error_s": 1.64,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They distributed the gifts fairly",
   "heard": 5,
   "words": 5,
   "error_s": 1.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To the priests and Levites",
   "heard": 4,
   "words": 5,
   "error_s": 1.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Kore son of Imnah was the gatekeeper",
   "heard": 6,
   "words": 7,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At the East Gate he stood",
   "heard": 6,
   "words": 6,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In charge of freewill offerings",
   "heard": 5,
   "words": 5,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For God and for the LORD",
   "heard": 6,
   "words": 6,
   "error_s": 1.11,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He distributed the consecrated gifts",
   "heard": 5,
   "words": 5,
   "error_s": 1.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With a faithful heart",
   "heard": 4,
   "words": 4,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Eden and Miniamin helped him out",
   "heard": 3,
   "words": 6,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jeshua and Shemaiah",
   "heard": 1,
   "words": 3,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the towns of the priests they worked",
   "heard": 7,
   "words": 8,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Dividing by their turns",
   "heard": 4,
   "words": 4,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To old and young alike they gave",
   "heard": 7,
   "words": 7,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With steady hands",
   "heard": 3,
   "words": 3,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He sought his God and worked wholeheartedly",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  }
 ],
