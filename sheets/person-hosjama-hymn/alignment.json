{
 "id": "person-hosjama-hymn",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-hosjama-hymn",
 "offset_seconds": -5.460000000000139,
 "words_heard": 103,
 "words": 106,
 "lines": [
  {
   "text": "The sons of Jeconiah the captive",
   "heard": 6,
   "words": 6,
   "error_s": 1.87,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shealtiel was his first born son",
   "heard": 6,
   "words": 6,
   "error_s": 2.15,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Malchiram and Pedaiah too",
   "heard": 4,
   "words": 4,
   "error_s": 2.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shenazzar stood beside him",
   "heard": 4,
   "words": 4,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jekamiah and Hoshama named",
   "heard": 4,
   "words": 4,
   "error_s": 1.86,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With Nedabiah in the list",
   "heard": 5,
   "words": 5,
   "error_s": 1.81,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A lineage kept in Babylon",
   "heard": 5,
   "words": 5,
   "error_s": 1.69,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "While Jerusalem lay in dust",
   "heard": 5,
   "words": 5,
   "error_s": 1.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He took the king to Babylon",
   "heard": 6,
   "words": 6,
   "error_s": 1.56,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With mothers wives and court attendants",
   "heard": 6,
   "words": 6,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The strong and fit for war",
   "heard": 5,
   "words": 6,
   "error_s": 1.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Led into exile far away",
   "heard": 5,
   "words": 5,
   "error_s": 1.19,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In thirty-seven years of exile",
   "heard": 4,
   "words": 5,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Evil-merodach set him free",
   "heard": 3,
   "words": 4,
   "error_s": 0.44,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "He spoke kindly to the king",
   "heard": 6,
   "words": 6,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And gave him a seat of honor",
   "heard": 7,
   "words": 7,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Prison clothes were put aside",
   "heard": 5,
   "words": 5,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To eat at the king's table",
   "heard": 6,
   "words": 6,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A regular allowance given",
   "heard": 4,
   "words": 4,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Day by day as he lived on",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  }
 ],
