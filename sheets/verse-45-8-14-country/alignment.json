 "offset_seconds": -2.420000000000204,
 "words_heard": 211,
 "words": 213,
 "lines": [
  {
   "text": "We are not led by flesh or fear",
   "heard": 8,
   "words": 8,
   "error_s": 1.72,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But by the Spirit who lives near",
   "heard": 7,
   "words": 7,
   "error_s": 1.92,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He raised Jesus from the dead",
   "heard": 6,
   "words": 6,
   "error_s": 1.45,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Now He gives our mortal bodies life ahead",
   "heard": 8,
   "words": 8,
   "error_s": 1.19,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "We have an obligation to the Spirit",
   "heard": 7,
   "words": 7,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not to live in the flesh and its grip",
   "heard": 8,
   "words": 9,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "All who are led by the Spirit are children",
   "heard": 9,
   "words": 9,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No more slaves to fear or hidden sins",
   "heard": 8,
   "words": 8,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We cry out Abba Father in the Spirit",
   "heard": 8,
   "words": 8,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He testifies we are God's own children",
   "heard": 7,
   "words": 7,
   "error_s": 0.53,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "We received a Spirit of adoption",
   "heard": 6,
   "words": 6,
   "error_s": 1.02,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Not a spirit of slavery or dread",
   "heard": 7,
   "words": 7,
   "error_s": 1.15,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In Him we cry Abba Father loud",
   "heard": 7,
   "words": 7,
   "error_s": 1.11,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Spirit testifies we are known",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All who are led by the Spirit are children",
   "heard": 9,
   "words": 9,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No more slaves to fear or hidden sins",
   "heard": 8,
   "words": 8,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We cry out Abba Father in the Spirit",
   "heard": 8,
   "words": 8,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He testifies we are God's own children",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If we are children then we are heirs",
   "heard": 8,
   "words": 8,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heirs of God and with Christ we share",
   "heard": 8,
   "words": 8,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Suffering with Him leads to glory",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Present pain is not worth the story",
   "heard": 7,
   "words": 7,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All who are led by the Spirit are children",
