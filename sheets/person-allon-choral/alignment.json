{
 "id": "person-allon-choral",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-allon-choral",
 "offset_seconds": -4.220000000000166,
 "words_heard": 140,
 "words": 162,
 "lines": [
  {
   "text": "Allon, son of Jedajah, stands in the line",
   "heard": 7,
   "words": 8,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Father of Shiphji, his name is divine",
   "heard": 7,
   "words": 7,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No deed of his hand is written in stone",
   "heard": 9,
   "words": 9,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But in the genealogy he is known",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They lived in Beersheba, Moladah, Hazar-shual",
   "heard": 4,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In Bilhah, Ezem, Tolad, without fail",
   "heard": 5,
   "words": 6,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bethuel, Hormah, Ziklag, the towns",
   "heard": 3,
   "words": 5,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where they dwelt until David, the king, was found",
   "heard": 8,
   "words": 9,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Their villages Etam, Ain, Rimmon, and Tochen",
   "heard": 4,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With Ashan, five towns, the record is spoken",
   "heard": 7,
   "words": 8,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Around these towns as far as Baal",
   "heard": 6,
   "words": 7,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They kept a genealogical record in the hall",
   "heard": 8,
   "words": 8,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They went to the entrance of Gedor, east side of the valley",
   "heard": 12,
   "words": 12,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To look for pasture for their flocks, steadily",
   "heard": 8,
   "words": 8,
   "error_s": 0.19,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "They found rich, good pasture, the land was broad",
   "heard": 9,
   "words": 9,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Quiet and peaceful, where the Hamites had trod",
   "heard": 8,
   "words": 8,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the days of Hezekiah, they came with might",
   "heard": 9,
   "words": 9,
   "error_s": 1.88,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Attacked the tents, put the Meunites to flight",
   "heard": 5,
   "words": 8,
   "error_s": 3.14,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Destroyed them completely, so it remains",
   "heard": 6,
   "words": 6,
   "error_s": 3.86,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They settled in their place, answering the chains",
   "heard": 7,
   "words": 8,
   "error_s": 3.95,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Recorded by name, in the covenant kept",
   "heard": 1,
   "words": 7,
   "error_s": 0.57,
   "tie_split": true,
   "uncertain": true
  }
 ],
