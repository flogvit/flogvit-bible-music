 "lines": [
  {
   "text": "In spring the kings march out to war",
   "heard": 8,
   "words": 8,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "David stayed in Jerusalem",
   "heard": 4,
   "words": 4,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He walked the roof of the king's house",
   "heard": 8,
   "words": 8,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Saw a woman bathing there",
   "heard": 5,
   "words": 5,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She was Bathsheba daughter of Eliam",
   "heard": 6,
   "words": 6,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Wife of Uriah the Hittite",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "David sent messengers for her",
   "heard": 5,
   "words": 5,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And slept with her that night",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are the man Nathan said",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As the Lord lives the man must die",
   "heard": 8,
   "words": 8,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Repays four times for the little ewe",
   "heard": 6,
   "words": 7,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who had no pity in his eye",
   "heard": 7,
   "words": 7,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "David sent word to Joab",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Send me Uriah the Hittite",
   "heard": 5,
   "words": 5,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Uriah slept at the gate of the house",
   "heard": 8,
   "words": 8,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He did not go to his own door",
   "heard": 8,
   "words": 8,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "David wrote a letter in the morning",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Put him where the fighting is fiercest",
   "heard": 7,
   "words": 7,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pull back so he is struck down",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Joab obeyed the king's command",
   "heard": 5,
   "words": 5,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are the man Nathan said",
   "heard": 6,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As the Lord lives the man must die",
   "heard": 8,
   "words": 8,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Repays four times for the little ewe",
   "heard": 6,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who had no pity in his eye",
   "heard": 7,
   "words": 7,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bathsheba heard her husband died",
   "heard": 5,
   "words": 5,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She mourned for him in grief",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When the mourning was over",
   "heard": 5,
   "words": 5,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "David sent for her again",
   "heard": 5,
   "words": 5,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She became his wife and bore a son",
   "heard": 8,
   "words": 8,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the child did not live",
   "heard": 6,
   "words": 6,
   "error_s": 0.91,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Nathan spoke of disaster rising",
   "heard": 5,
   "words": 5,
   "error_s": 3.41,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "From within the king's own house",
   "heard": 6,
   "words": 6,
   "error_s": 3.98,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "You are the man Nathan said",
   "heard": 6,
   "words": 6,
   "error_s": 7.7,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "As the Lord lives the man must die",
