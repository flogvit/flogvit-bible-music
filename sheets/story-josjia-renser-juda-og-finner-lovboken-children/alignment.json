   "words": 5,
   "error_s": 2.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But you are gathered to your fathers",
   "heard": 7,
   "words": 7,
   "error_s": 1.65,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Your eyes will not see the end",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your heart was tender and humble",
   "heard": 6,
   "words": 6,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Weeping before God's holy face",
