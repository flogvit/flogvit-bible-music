 "lines": [
  {
   "text": "Justified by faith we find peace",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through our Lord Jesus Christ",
   "heard": 5,
   "words": 5,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Access gained into grace",
   "heard": 4,
   "words": 4,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We stand in this light",
   "heard": 5,
   "words": 5,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We boast in our sufferings",
   "heard": 5,
   "words": 5,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Knowing suffering produces endurance",
   "heard": 4,
   "words": 4,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Endurance produces character",
   "heard": 3,
   "words": 3,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And character produces hope",
   "heard": 4,
   "words": 4,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hope does not put us to shame",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God's love poured into hearts",
   "heard": 5,
   "words": 5,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Holy Spirit given",
   "heard": 4,
   "words": 4,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Is the part we start",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We boast in our sufferings",
   "heard": 5,
   "words": 5,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Knowing suffering produces endurance",
   "heard": 4,
   "words": 4,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Endurance produces character",
   "heard": 3,
   "words": 3,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And character produces hope",
   "heard": 4,
   "words": 4,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "While we were still helpless",
   "heard": 5,
   "words": 5,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At just the right time",
   "heard": 5,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Christ died for the ungodly",
   "heard": 5,
   "words": 5,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In His mighty prime",
   "heard": 4,
   "words": 4,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
