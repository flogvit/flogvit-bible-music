 "lines": [
  {
   "text": "Twelve governors ruled over all Israel",
   "heard": 5,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Supplying provisions for the king and house",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Each one held a month of the whole year",
   "heard": 9,
   "words": 9,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ben-Hur in the hills of Ephraim",
   "heard": 5,
   "words": 6,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ben-Deker in Makaz and Shaalbim",
   "heard": 2,
   "words": 5,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Ben-Hesed in Arubboth and Hepher",
   "heard": 1,
   "words": 5,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In all the region of Naphath Dor",
   "heard": 5,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ben-Abinadab held his place",
   "heard": 3,
   "words": 4,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A governor among the twelve names",
   "heard": 6,
   "words": 6,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keeping the household in good order",
   "heard": 6,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He had Solomon's daughter Taphath as his wife",
   "heard": 8,
   "words": 8,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A bond of loyalty and royal grace",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the district of Naphath Dor",
   "heard": 4,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her name is remembered in that line",
   "heard": 7,
   "words": 7,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Baana son of Ahilud in Taanach",
   "heard": 3,
   "words": 6,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Megiddo and Beth Shan by Zarethan",
