 "lines": [
  {
   "text": "One day Jacob was cooking stew",
   "heard": 6,
   "words": 6,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Esau came in exhausted from the field",
   "heard": 7,
   "words": 7,
   "error_s": 1.6,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Quick let me gulp down that red stuff",
   "heard": 7,
   "words": 8,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So he was called Edom in the heat",
   "heard": 8,
   "words": 8,
   "error_s": 1.37,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Sell me your birthright Jacob said",
   "heard": 6,
   "words": 6,
   "error_s": 1.34,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Look I am about to die he replied",
   "heard": 8,
   "words": 8,
   "error_s": 1.37,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Swear it to me here and now",
   "heard": 7,
   "words": 7,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "So he sold his birthright away",
   "heard": 5,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This is nothing less than the house of God",
   "heard": 9,
   "words": 9,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "This is the gate of heaven open wide",
   "heard": 8,
   "words": 8,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Angels go up and down on the stair",
   "heard": 8,
   "words": 8,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord stands above in the night",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am Esau your firstborn he lied",
   "heard": 7,
   "words": 7,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The voice is Jacob but hands are Esau",
   "heard": 8,
   "words": 8,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bring me wine and eat my son",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "May God give you dew of heaven",
   "heard": 7,
   "words": 7,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abundance of grain and new wine",
   "heard": 6,
   "words": 6,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Peoples will serve you nations bow",
   "heard": 6,
   "words": 6,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Cursed be those who curse you",
