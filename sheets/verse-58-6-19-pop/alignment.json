 "lines": [
  {
   "text": "People swear by someone greater than themselves",
   "heard": 7,
   "words": 7,
   "error_s": 12.02,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "An oath serves as confirmation, settling the dispute",
   "heard": 8,
   "words": 8,
   "error_s": 11.7,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "God showed the heirs of the promise his will",
   "heard": 9,
   "words": 9,
   "error_s": 11.36,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He guaranteed it with an oath, unchangeable and still",
   "heard": 9,
   "words": 9,
   "error_s": 11.77,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Two unchangeable things, in which God cannot lie",
   "heard": 8,
   "words": 8,
   "error_s": 11.88,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "We fled to him for refuge, we are not to say goodbye",
   "heard": 12,
   "words": 12,
   "error_s": 11.53,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "This hope we have as an anchor for the soul",
   "heard": 10,
   "words": 10,
   "error_s": 10.52,
   "tie_split": true,
   "uncertain": true
