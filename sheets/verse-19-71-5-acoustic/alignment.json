   "heard": 4,
   "words": 4,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For you are my hope Lord GOD",
   "heard": 7,
   "words": 7,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My confidence from my youth",
