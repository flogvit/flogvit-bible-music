{
 "id": "person-sidkia-josias-sonn-folk",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-sidkia-josias-sonn-folk",
 "offset_seconds": -0.9200000000002362,
 "words_heard": 285,
 "words": 292,
 "lines": [
  {
   "text": "A twenty-one year old sat on the throne",
   "heard": 7,
   "words": 8,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In Jerusalem, his mother was Hamutal",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He reigned for eleven years in that place",
   "heard": 8,
   "words": 8,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But he did what was evil in the Lord's sight",
   "heard": 10,
   "words": 10,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He did not humble himself before Jeremiah",
   "heard": 7,
   "words": 7,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who spoke from the mouth of the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He rebelled against King Nebuchadnezzar",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who had made him swear an oath by God",
   "heard": 9,
   "words": 9,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He stiffened his neck and hardened his heart",
   "heard": 8,
   "words": 8,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Against turning back to the Lord God of Israel",
   "heard": 9,
   "words": 9,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zedekiah sent for the prophet in secret",
   "heard": 7,
   "words": 7,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Asked him to hide nothing from his eyes",
   "heard": 8,
   "words": 8,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But Jeremiah said if I tell you",
   "heard": 7,
   "words": 7,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will surely put me to death",
   "heard": 7,
   "words": 7,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The king swore in private as the Lord lives",
   "heard": 9,
   "words": 9,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who gave us breath, I will not kill you",
   "heard": 9,
   "words": 9,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He rebelled against King Nebuchadnezzar",
   "heard": 5,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who had made him swear an oath by God",
   "heard": 9,
   "words": 9,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He stiffened his neck and hardened his heart",
   "heard": 8,
   "words": 8,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Against turning back to the Lord God of Israel",
   "heard": 9,
   "words": 9,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you surrender to the officers of Babylon",
   "heard": 8,
   "words": 8,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your life will be spared and this city will stand",
   "heard": 9,
   "words": 10,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But if you do not surrender to them",
   "heard": 8,
   "words": 8,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This city will be burned down by the Chaldeans",
   "heard": 9,
   "words": 9,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You yourself will not escape from their hands",
   "heard": 8,
   "words": 8,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He sent envoys to Egypt for horses",
   "heard": 7,
   "words": 7,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Broke the covenant and gave his hand in pledge",
   "heard": 9,
   "words": 9,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He rebelled against King Nebuchadnezzar",
   "heard": 5,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who had made him swear an oath by God",
   "heard": 9,
   "words": 9,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He stiffened his neck and hardened his heart",
   "heard": 8,
   "words": 8,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Against turning back to the Lord God of Israel",
   "heard": 9,
   "words": 9,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Chaldeans pursued him in the plains of Jericho",
   "heard": 9,
   "words": 9,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They captured the king and brought him to Riblah",
   "heard": 9,
   "words": 9,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They slaughtered his sons before his eyes",
   "heard": 2,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Put out his eyes and bound him in bronze shackles",
   "heard": 10,
   "words": 10,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He kept him in prison until the day of his death",
   "heard": 11,
   "words": 11,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  }
 ],
