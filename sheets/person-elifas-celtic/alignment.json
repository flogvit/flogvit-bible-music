{
 "id": "person-elifas-celtic",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-elifas-celtic",
 "offset_seconds": -0.2800000000002498,
 "words_heard": 229,
 "words": 235,
 "lines": [
  {
   "text": "Eliphaz the Temanite came from afar",
   "heard": 4,
   "words": 6,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With Bildad and Zophar to meet you there",
   "heard": 8,
   "words": 8,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They looked from a distance, could not recognize you",
   "heard": 9,
   "words": 9,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Wept aloud, tore robes, tossed dust to the sky",
   "heard": 8,
   "words": 9,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They sat with you on the ground for seven days",
   "heard": 10,
   "words": 10,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And seven nights, no word spoken in praise",
   "heard": 8,
   "words": 8,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your suffering was great, they saw your pain",
   "heard": 8,
   "words": 8,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Silent witnesses to your deep distress",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seven days silent, no word was said",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Watching the sorrow that you have spread",
   "heard": 7,
   "words": 7,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your friends are here, though their words may fail",
   "heard": 9,
   "words": 9,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To comfort the soul in the dark and cold",
   "heard": 9,
   "words": 9,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then Eliphaz spoke, who can hold back",
   "heard": 7,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When trouble strikes and the body is weak",
   "heard": 8,
   "words": 8,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You strengthened the weak, held up the stumbling",
   "heard": 8,
   "words": 8,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But now you are dismayed, your spirit crumbling",
   "heard": 8,
   "words": 8,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He spoke of a vision, a spirit passed by",
   "heard": 9,
   "words": 9,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A whisper in the dark, a voice from the sky",
   "heard": 10,
   "words": 10,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who ever perished being innocent",
   "heard": 3,
   "words": 5,
   "error_s": 0.46,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Where were the upright ever destroyed",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seven days silent, no word was said",
   "heard": 7,
   "words": 7,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Watching the sorrow that you have spread",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your friends are here, though their words may fail",
   "heard": 9,
   "words": 9,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To comfort the soul in the dark and cold",
   "heard": 9,
   "words": 9,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He accused you of sin, of taking pledges",
   "heard": 8,
   "words": 8,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of refusing water, of hiding treasures",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But God spoke from the storm, rebuked them all",
   "heard": 9,
   "words": 9,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For not speaking rightly of His own will",
   "heard": 8,
   "words": 8,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Offer seven bulls, seven rams as well",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Job prays for you, God forgives your soul",
   "heard": 7,
   "words": 8,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  }
 ],
