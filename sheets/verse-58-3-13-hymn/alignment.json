 "lines": [
  {
   "text": "Do not let wicked hearts grow",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Far from the living God",
   "heard": 5,
   "words": 5,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "See to it you do not stray",
   "heard": 4,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "On this holy road",
   "heard": 4,
   "words": 4,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Encourage one another every day",
   "heard": 5,
   "words": 5,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As long as it is called today",
   "heard": 7,
   "words": 7,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "So none of you are hardened",
   "heard": 6,
   "words": 6,
   "error_s": 1.09,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "By the deceit of sin",
   "heard": 5,
   "words": 5,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We share in Christ if we hold fast",
   "heard": 8,
   "words": 8,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Our confidence to the end",
   "heard": 5,
   "words": 5,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hear the voice and do not rebel",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
