 "lines": [
  {
   "text": "Have mercy on me, O God",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "According to your steadfast love",
   "heard": 5,
   "words": 5,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "According to your great compassion",
   "heard": 5,
   "words": 5,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blot out my transgressions",
   "heard": 4,
   "words": 4,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Create in me a clean heart, O God",
   "heard": 8,
   "words": 8,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And renew a right spirit within me",
   "heard": 7,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not cast me from your presence",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not take your Holy Spirit from me",
   "heard": 8,
   "words": 8,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Restore to me the joy of your salvation",
   "heard": 8,
   "words": 8,
   "error_s": 1.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And uphold me with a willing spirit",
   "heard": 7,
   "words": 7,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Create in me a clean heart, O God",
   "heard": 8,
   "words": 8,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
