  {
   "text": "King Uzziah lived apart in a separate house",
   "heard": 7,
   "words": 8,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A leper cut off from the house of the Lord",
   "heard": 10,
   "words": 10,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His son Jotham took charge of the palace",
   "heard": 8,
   "words": 8,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He governed the people of the land with care",
   "heard": 9,
   "words": 9,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jotham walked steadfastly before the Lord",
