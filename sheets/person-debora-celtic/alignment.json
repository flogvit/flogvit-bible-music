{
 "id": "person-debora-celtic",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-debora-celtic",
 "offset_seconds": -4.080000000000169,
 "words_heard": 203,
 "words": 207,
 "lines": [
  {
   "text": "In the hill country of Ephraim, between Ramah and Bethel's stones",
   "heard": 11,
   "words": 11,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sat Deborah beneath the palm while Israel cried and groaned",
   "heard": 8,
   "words": 10,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nine hundred iron chariots had kept them twenty years",
   "heard": 9,
   "words": 9,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The highways lay empty",
   "heard": 4,
   "words": 4,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And travelers kept to the winding trails",
   "heard": 7,
   "words": 7,
   "error_s": 1.67,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "She sent for Barak in Naphtali and gave him the LORD's command",
   "heard": 12,
   "words": 12,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Go, march to Mount Tabor",
   "heard": 5,
   "words": 5,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With ten thousand at your hand",
   "heard": 6,
   "words": 6,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you go with me, I will go",
   "heard": 8,
   "words": 8,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will surely go with you, she said",
   "heard": 8,
   "words": 8,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Awake, awake, Deborah",
   "heard": 3,
   "words": 3,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Awake, awake, break into song",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will sing to the LORD, I myself will sing",
   "heard": 10,
   "words": 10,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will make music to the LORD, the God of Israel",
   "heard": 11,
   "words": 11,
   "error_s": 0.43,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The chariots came thundering across the Kishon plain",
   "heard": 8,
   "words": 8,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The earth shook, the heavens poured",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The clouds poured down water",
   "heard": 5,
   "words": 5,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the heavens they fought",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The river Kishon swept them away",
   "heard": 5,
   "words": 6,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Village life in Israel ceased",
   "heard": 5,
   "words": 5,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Until I, Deborah, arose",
   "heard": 3,
   "words": 4,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Until I arose, a mother in Israel",
   "heard": 7,
   "words": 7,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Awake, awake, Deborah",
   "heard": 3,
   "words": 3,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Awake, awake, break into song",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will sing to the LORD, I myself will sing",
   "heard": 10,
   "words": 10,
   "error_s": 0.41,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "I will make music to the LORD, the God of Israel",
   "heard": 11,
   "words": 11,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "May those who love you be like the sun",
   "heard": 9,
   "words": 9,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When it rises in its strength",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the land had rest for forty years",
   "heard": 8,
   "words": 8,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  }
 ],
