 "lines": [
  {
   "text": "I hate I despise your festivals",
   "heard": 6,
   "words": 6,
   "error_s": 6.01,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Your solemn assemblies bring no delight",
   "heard": 6,
   "words": 6,
   "error_s": 5.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Your burnt offerings I will not accept",
   "heard": 7,
   "words": 7,
   "error_s": 4.21,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Your grain offerings give me no pleasure",
   "heard": 7,
   "words": 7,
   "error_s": 2.56,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Take away from me the noise of your songs",
   "heard": 9,
   "words": 9,
   "error_s": 1.24,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "I will not listen to the music of your harps",
   "heard": 10,
   "words": 10,
   "error_s": 0.98,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "But let justice roll on like water",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "And righteousness like an ever-flowing stream",
   "heard": 5,
   "words": 6,
   "error_s": 0.61,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "You carried Sikkuth your king",
   "heard": 5,
   "words": 5,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Kiyyun your images of the star",
   "heard": 6,
   "words": 7,
   "error_s": 1.49,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The star of your god you made for yourselves",
   "heard": 9,
   "words": 9,
   "error_s": 1.62,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And I will send you into exile beyond Damascus",
   "heard": 9,
   "words": 9,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Says the LORD whose name is the God of hosts",
   "heard": 10,
   "words": 10,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Did you bring me sacrifices and offerings",
   "heard": 7,
   "words": 7,
   "error_s": 2.62,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Those forty years in the wilderness house of Israel",
   "heard": 9,
   "words": 9,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You carried Sikkuth your king again",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Kiyyun your images you made to worship",
   "heard": 5,
   "words": 8,
   "error_s": 1.04,
   "tie_split": true,
   "uncertain": false
  },
  {
