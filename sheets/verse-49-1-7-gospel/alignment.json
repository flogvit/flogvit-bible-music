 "lines": [
  {
   "text": "He chose us in him before the world began",
   "heard": 9,
   "words": 9,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To be holy and blameless in his hand",
   "heard": 8,
   "words": 8,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Destined for adoption as sons through Christ",
   "heard": 7,
   "words": 7,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Brought to himself by his good will",
   "heard": 7,
   "words": 7,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In him we have redemption through his blood",
   "heard": 8,
   "words": 8,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The forgiveness of trespasses is good",
   "heard": 6,
   "words": 6,
   "error_s": 1.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "According to the riches of his grace",
   "heard": 7,
   "words": 7,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
