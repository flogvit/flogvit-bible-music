 "lines": [
  {
   "text": "Cloud and thick darkness surround him",
   "heard": 6,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Righteousness and justice are the foundation of his throne",
   "heard": 9,
   "words": 9,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The world holds its breath in awe",
   "heard": 7,
   "words": 7,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "See the King upon the throne",
   "heard": 6,
   "words": 6,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fire goes before him on every side",
   "heard": 7,
   "words": 7,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Consumes his foes in the burning light",
   "heard": 7,
   "words": 7,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No power can stand against his might",
   "heard": 7,
   "words": 7,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The darkness flees before the King",
   "heard": 6,
   "words": 6,
   "error_s": 0.28,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The LORD reigns! Let the earth rejoice",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
