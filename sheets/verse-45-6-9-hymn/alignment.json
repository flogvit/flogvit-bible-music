 "words": 149,
 "lines": [
  {
   "text": "We know our old self was crucified with him",
   "heard": 9,
   "words": 9,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The body of sin is rendered powerless now",
   "heard": 8,
   "words": 8,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No longer slaves to the weight of our sin",
   "heard": 9,
   "words": 9,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For anyone who died is set free somehow",
   "heard": 8,
   "words": 8,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Christ has been raised from the dead",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will never die again",
   "heard": 5,
   "words": 5,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Death no longer has dominion over him",
   "heard": 7,
   "words": 7,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His life is pure and clean",
   "heard": 6,
   "words": 6,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If we died with him we believe we live",
   "heard": 9,
   "words": 9,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We will also live with him forever",
   "heard": 7,
   "words": 7,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The death he died was once for all",
   "heard": 8,
   "words": 8,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He lives to God in every way",
   "heard": 7,
   "words": 7,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Christ has been raised from the dead",
   "heard": 7,
   "words": 7,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will never die again",
   "heard": 5,
   "words": 5,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Death no longer has dominion over him",
   "heard": 7,
   "words": 7,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His life is pure and clean",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Consider yourselves dead to sin",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But alive to God in Christ Jesus",
   "heard": 7,
   "words": 7,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not let sin reign in your body",
   "heard": 8,
   "words": 8,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not obey its empty wishes",
   "heard": 6,
