  {
   "text": "How can they call on the one unknown",
   "heard": 8,
   "words": 8,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How can they trust a face not seen",
   "heard": 8,
   "words": 8,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The bridge of belief must be drawn",
   "heard": 7,
