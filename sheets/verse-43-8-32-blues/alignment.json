 "lines": [
  {
   "text": "He who sent me is with me",
   "heard": 7,
   "words": 7,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He has not left me alone",
   "heard": 6,
   "words": 6,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I always do what pleases him",
   "heard": 6,
   "words": 6,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And many believed in the sign",
   "heard": 5,
   "words": 6,
   "error_s": 0.73,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "So Jesus said to those who believed",
   "heard": 7,
   "words": 7,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you remain in my word",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are truly my disciples",
   "heard": 5,
   "words": 5,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And you will know the truth",
   "heard": 6,
   "words": 6,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the truth will set you free",
   "heard": 7,
   "words": 7,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The truth will set you free",
   "heard": 6,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It breaks the chains of your mind",
   "heard": 7,
   "words": 7,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The truth will set you free",
   "heard": 6,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They answered we are Abraham's seed",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We have never been anyone's slave",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How can you say we will be free",
   "heard": 8,
