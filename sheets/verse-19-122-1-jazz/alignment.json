 "lines": [
  {
   "text": "I rejoiced when they said to me",
   "heard": 7,
   "words": 7,
   "error_s": 1.15,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Let us go to the house of the LORD",
   "heard": 9,
   "words": 9,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My heart is light with this simple plea",
   "heard": 8,
   "words": 8,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To walk where His presence is adored",
   "heard": 7,
   "words": 7,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Our feet are standing in your gates",
