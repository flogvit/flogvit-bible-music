  {
   "text": "The roads to Zion mourn",
   "heard": 5,
   "words": 5,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For a comforter is far from me",
   "heard": 7,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "One to revive my spirit",
   "heard": 5,
   "words": 5,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "How lonely sits the city",
   "heard": 5,
   "words": 5,
   "error_s": 12.84,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "That was full of people",
