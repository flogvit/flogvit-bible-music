 "lines": [
  {
   "text": "Long day, heavy shoulders",
   "heard": 4,
   "words": 4,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Too much on my mind",
   "heard": 5,
   "words": 5,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hear a voice inside the quiet",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Saying leave it all behind",
   "heard": 5,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come to me, all you who are weary",
   "heard": 8,
   "words": 8,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come to me and I will give you rest",
   "heard": 9,
   "words": 9,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My yoke is easy and my burden light",
   "heard": 5,
   "words": 8,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come to me and rest",
   "heard": 5,
   "words": 5,
   "error_s": 0.27,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Take my yoke and learn from me",
   "heard": 7,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am gentle, lowly in heart",
   "heard": 5,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will find rest for your souls",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Right here where you are",
   "heard": 5,
   "words": 5,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
