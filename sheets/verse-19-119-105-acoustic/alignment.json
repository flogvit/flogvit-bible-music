 "lines": [
  {
   "text": "I have not turned away from your judgments",
   "heard": 8,
   "words": 8,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For you yourself have taught me the way",
   "heard": 8,
   "words": 8,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How sweet your promise is to my taste",
   "heard": 6,
   "words": 8,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sweeter than honey in my mouth",
   "heard": 6,
   "words": 6,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From your precepts I gain understanding",
   "heard": 6,
   "words": 6,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I hate every path of falsehood",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your word is a lamp to my feet",
   "heard": 8,
   "words": 8,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A light on my path in the night",
   "heard": 8,
   "words": 8,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Guiding my steps with divine grace",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shining through the darkness deep",
   "heard": 5,
   "words": 5,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have sworn an oath and confirmed it",
   "heard": 8,
   "words": 8,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To keep your righteous judgments true",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have been afflicted beyond measure",
