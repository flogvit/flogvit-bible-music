 "words": 108,
 "lines": [
  {
   "text": "They came to the tomb at early dawn",
   "heard": 8,
   "words": 8,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To find the Lord who died",
   "heard": 6,
   "words": 6,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "An angel said, Do not be afraid",
   "heard": 7,
   "words": 7,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I know whom you have sought",
   "heard": 6,
   "words": 6,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is not here, for he is risen",
   "heard": 8,
   "words": 8,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Just as he said, it now is done",
   "heard": 8,
   "words": 8,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come, see the place where once he lay",
   "heard": 8,
   "words": 8,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The grave by life is overcome",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now go and tell his followers",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He has risen from the dead",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He goes before you to Galilee",
   "heard": 6,
   "words": 6,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And there you will see him",
   "heard": 5,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So sing, all people, Easter morning",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Our Lord is living, he is here",
   "heard": 7,
   "words": 7,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is not here, for he is risen",
   "heard": 8,
   "words": 8,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The empty grave is always near",
   "heard": 6,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  }
 ],
