 "lines": [
  {
   "text": "O God, you are my God, I seek you at dawn",
   "heard": 11,
   "words": 11,
   "error_s": 4.0,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My heart, I seek you at dawn",
   "heard": 7,
   "words": 7,
   "error_s": 9.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My soul thirsts for you in the dry land",
   "heard": 9,
   "words": 9,
   "error_s": 8.12,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My body longs for you where there is no water",
   "heard": 10,
   "words": 10,
   "error_s": 7.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the wilderness of Judah, I stand",
   "heard": 7,
   "words": 7,
   "error_s": 8.82,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "So I have gazed on you in the sanctuary",
   "heard": 9,
   "words": 9,
   "error_s": 7.0,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To see your power and your glory shine",
   "heard": 8,
   "words": 8,
   "error_s": 6.26,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Your steadfast love is better than life",
   "heard": 7,
   "words": 7,
   "error_s": 6.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My lips will praise you with all my might",
   "heard": 9,
   "words": 9,
   "error_s": 5.43,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I will bless you as long as I live",
   "heard": 9,
   "words": 9,
   "error_s": 5.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In your name, my hands will rise",
   "heard": 7,
   "words": 7,
   "error_s": 5.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Your love is better than the breath of life",
   "heard": 9,
   "words": 9,
   "error_s": 4.99,
   "tie_split": false,
   "uncertain": true
  },
  {
