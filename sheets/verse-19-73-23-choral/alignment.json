 "lines": [
  {
   "text": "My heart was filled with bitter pain",
   "heard": 7,
   "words": 7,
   "error_s": 10.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My inmost being felt the stain",
   "heard": 6,
   "words": 6,
   "error_s": 8.81,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I was senseless and blind of sight",
   "heard": 7,
   "words": 7,
   "error_s": 7.8,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A brute beast in the cold of night",
   "heard": 8,
   "words": 8,
   "error_s": 6.49,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Yet I am always with you",
   "heard": 6,
   "words": 6,
   "error_s": 5.93,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You hold me by my right hand",
   "heard": 7,
   "words": 7,
   "error_s": 4.21,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You guide me with your counsel true",
   "heard": 7,
   "words": 7,
   "error_s": 4.92,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "And lift me up when I am undone",
   "heard": 8,
   "words": 8,
   "error_s": 4.43,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Afterward you will take me",
   "heard": 5,
   "words": 5,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Into the glory you decree",
   "heard": 5,
   "words": 5,
   "error_s": 2.5,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Whom have I in heaven but you?",
   "heard": 7,
   "words": 7,
   "error_s": 0.33,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "With you my soul has nothing due",
   "heard": 7,
   "words": 7,
   "error_s": 0.46,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Yet I am always with you",
   "heard": 6,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You hold me by my right hand",
   "heard": 7,
   "words": 7,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You guide me with your counsel true",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "And lift me up when I am undone",
   "heard": 8,
   "words": 8,
   "error_s": 0.42,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "My flesh and my heart may fail",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But you are the rock of my soul",
   "heard": 8,
   "words": 8,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
