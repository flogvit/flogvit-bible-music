   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pul king of Assyria came to the land",
   "heard": 7,
   "words": 8,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
