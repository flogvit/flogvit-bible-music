   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Examples for the present day",
   "heard": 5,
   "words": 5,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No temptation has overtaken you",
