 "lines": [
  {
   "text": "Bless those who persecute you",
   "heard": 5,
   "words": 5,
   "error_s": 3.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Bless and do not curse",
   "heard": 5,
   "words": 5,
   "error_s": 3.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Rejoice with those who rejoice",
   "heard": 5,
   "words": 5,
   "error_s": 2.47,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Weep with those who weep",
   "heard": 2,
   "words": 5,
   "error_s": 0.81,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "If it is possible, as far as it depends on you",
   "heard": 11,
   "words": 11,
   "error_s": 1.81,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Live in peace with everyone",
   "heard": 5,
   "words": 5,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be overcome by evil",
   "heard": 6,
   "words": 6,
   "error_s": 1.08,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "But overcome evil with good",
   "heard": 5,
   "words": 5,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Live in harmony with one another",
   "heard": 6,
   "words": 6,
   "error_s": 3.65,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Do not be proud, but walk with the lowly",
   "heard": 9,
   "words": 9,
   "error_s": 1.66,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Never repay evil for evil",
   "heard": 5,
   "words": 5,
   "error_s": 2.09,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "If your enemy is hungry, feed him",
