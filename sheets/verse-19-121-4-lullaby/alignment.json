 "lines": [
  {
   "text": "Lay your head down, little one",
   "heard": 6,
   "words": 6,
   "error_s": 1.74,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The lamps are low, the day is done",
   "heard": 8,
   "words": 8,
   "error_s": 1.82,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Lord who made the hills and sky",
   "heard": 8,
   "words": 8,
   "error_s": 1.37,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Is watching you, and so am I",
   "heard": 7,
   "words": 7,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will not slumber, he will not sleep",
   "heard": 8,
   "words": 8,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The one who keeps you, he will keep",
   "heard": 8,
   "words": 8,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your going out, your coming in",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sleep now, sleep again",
   "heard": 4,
   "words": 4,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sun won't hurt you through the day",
   "heard": 8,
   "words": 8,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The moon won't harm you on your way",
   "heard": 8,
   "words": 8,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord will keep you from all harm",
   "heard": 8,
   "words": 8,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Asleep within his arm",
   "heard": 4,
   "words": 4,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
