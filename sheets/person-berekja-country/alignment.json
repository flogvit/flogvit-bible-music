 "lines": [
  {
   "text": "In the eighth month of the second year of Darius",
   "heard": 10,
   "words": 10,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The word of the LORD came to the prophet Zechariah",
   "heard": 8,
   "words": 10,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He was the son of Berechiah",
   "heard": 6,
   "words": 6,
   "error_s": 0.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A man of Levitical clan in the ancient land",
   "heard": 9,
   "words": 9,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Prophesying to the Jews in Judah and Jerusalem",
   "heard": 8,
   "words": 8,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the name of the God of Israel who was over them",
   "heard": 12,
   "words": 12,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zechariah son of Berechiah",
   "heard": 4,
   "words": 4,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A link in the lineage of the prophets",
   "heard": 8,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Between the sanctuary and the altar",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His story is told in the scriptures",
