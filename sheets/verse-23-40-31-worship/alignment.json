 "words": 241,
 "lines": [
  {
   "text": "I have run until my strength gave way",
   "heard": 8,
   "words": 8,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have stumbled on the stony ground",
   "heard": 7,
   "words": 7,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Even the young grow tired by the end of day",
   "heard": 10,
   "words": 10,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the strongest legs go falling down",
   "heard": 7,
   "words": 7,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do you not know? Have you not heard?",
   "heard": 8,
   "words": 8,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD is the everlasting God",
   "heard": 6,
   "words": 6,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Creator of the ends of the earth",
   "heard": 8,
   "words": 8,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He does not grow tired or weary",
   "heard": 7,
   "words": 7,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But those who hope in the LORD will renew their strength",
   "heard": 11,
   "words": 11,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They will rise on wings like eagles",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They will run and not grow weary",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They will walk and not be faint",
   "heard": 7,
   "words": 7,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I lift my eyes on high to see the stars",
   "heard": 10,
   "words": 10,
   "error_s": 0.49,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "He brings them out and calls each one by name",
   "heard": 10,
   "words": 10,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not one is missing from the host he holds",
   "heard": 9,
   "words": 9,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
