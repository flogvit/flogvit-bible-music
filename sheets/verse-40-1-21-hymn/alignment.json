   "heard": 7,
   "words": 7,
   "error_s": 1.44,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The promise kept in the heart",
   "heard": 6,
   "words": 6,
   "error_s": 1.73,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jesus the savior for all",
   "heard": 5,
   "words": 5,
   "error_s": 1.81,
   "tie_split": false,
   "uncertain": true
  },
  {
