  {
   "text": "The third seal, a black horse, its rider is Death",
   "heard": 9,
   "words": 10,
   "error_s": 42.26,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "And Hades follows close behind",
   "heard": 5,
   "words": 5,
   "error_s": 33.96,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Lamb has opened the first seal",
   "heard": 7,
   "words": 7,
   "error_s": 11.58,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "A voice like thunder cries out, come",
   "heard": 7,
   "words": 7,
   "error_s": 8.48,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "A white horse rides, its rider holds a bow",
   "heard": 9,
   "words": 9,
   "error_s": 5.63,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "He goes out conquering, a crown upon his head",
   "heard": 9,
   "words": 9,
   "error_s": 18.15,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The second seal, a fiery red horse",
   "heard": 7,
   "words": 7,
   "error_s": 5.07,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Its rider takes the peace from the earth",
   "heard": 7,
   "words": 8,
   "error_s": 4.56,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "A great sword in his hand",
   "heard": 6,
   "words": 6,
   "error_s": 3.54,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And people turn on one another",
   "heard": 6,
   "words": 6,
   "error_s": 1.84,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Come, cries the thunder",
   "heard": 4,
   "words": 4,
   "error_s": 0.76,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The horsemen ride",
   "heard": 3,
   "words": 3,
   "error_s": 0.53,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Who can stand before the Lamb",
   "heard": 6,
   "words": 6,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
