 "lines": [
  {
   "text": "A woman had ten silver coins",
   "heard": 6,
   "words": 6,
   "error_s": 1.65,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And one of them was lost",
   "heard": 6,
   "words": 6,
   "error_s": 1.54,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "She lit a lamp and swept the house",
   "heard": 8,
   "words": 8,
   "error_s": 1.99,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "She searched at any cost",
   "heard": 5,
   "words": 5,
   "error_s": 1.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Rejoice with me, rejoice with me",
   "heard": 6,
   "words": 6,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For I have found the coin I lost",
   "heard": 8,
   "words": 8,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "There is joy before the angels of God",
   "heard": 8,
   "words": 8,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Over one who turns back home",
   "heard": 6,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And when she found it, she called her friends",
   "heard": 8,
   "words": 9,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her neighbors gathered round",
   "heard": 4,
   "words": 4,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come, celebrate with me tonight",
   "heard": 5,
   "words": 5,
   "error_s": 1.37,
   "tie_split": true,
   "uncertain": true
  },
  {
