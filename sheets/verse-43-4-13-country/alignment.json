 "lines": [
  {
   "text": "Everyone who drinks this water",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will be thirsty again",
   "heard": 4,
   "words": 4,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You asked for a simple cup",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the deep and old well",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But I hold a greater gift",
   "heard": 6,
   "words": 6,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That Jacob never knew",
   "heard": 4,
   "words": 4,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever drinks the water I give",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will never thirst again",
   "heard": 4,
   "words": 4,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It becomes a spring inside",
   "heard": 5,
   "words": 5,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Welling up to life",
   "heard": 4,
   "words": 4,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A fountain flowing fresh",
   "heard": 4,
   "words": 4,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For those who stay and hear",
   "heard": 4,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The well is deep and hard to draw",
   "heard": 8,
   "words": 8,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
