 "words": 168,
 "lines": [
  {
   "text": "Son of man I speak to you",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I made you a watchman true",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the house of Israel now",
   "heard": 6,
   "words": 6,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hear my word and let it show",
   "heard": 6,
   "words": 7,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the wicked I have said",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will surely die instead",
   "heard": 5,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you stay silent in the dark",
   "heard": 7,
   "words": 7,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His blood is on your mark",
   "heard": 6,
   "words": 6,
   "error_s": 2.03,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Warn them now before they fall",
   "heard": 6,
   "words": 6,
   "error_s": 2.03,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Speak the word to stand them tall",
   "heard": 7,
   "words": 7,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If they refuse to turn away",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Their guilt remains for always",
   "heard": 5,
   "words": 5,
   "error_s": 1.67,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "If you warn and they do not change",
   "heard": 8,
   "words": 8,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The wicked path is their range",
   "heard": 6,
   "words": 6,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They die in guilt before your eyes",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But you have saved your life",
   "heard": 6,
   "words": 6,
   "error_s": 1.44,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Warn them now before they fall",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Speak the word to stand them tall",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If they refuse to turn away",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Their guilt remains for always",
   "heard": 5,
   "words": 5,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Even righteous may turn aside",
   "heard": 5,
   "words": 5,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Place a stumbling block to hide",
   "heard": 5,
   "words": 6,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you fail to warn the just",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Their good deeds are turned to dust",
   "heard": 7,
   "words": 7,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Warn the righteous not to sin",
   "heard": 6,
   "words": 6,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He lives because he did listen",
   "heard": 5,
   "words": 6,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You have saved your own life",
   "heard": 6,
   "words": 6,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  }
