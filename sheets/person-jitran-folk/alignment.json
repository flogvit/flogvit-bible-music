{
 "id": "person-jitran-folk",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-jitran-folk",
 "offset_seconds": -2.0800000000002115,
 "words_heard": 260,
 "words": 269,
 "lines": [
  {
   "text": "He sat by the well in the land of Midian",
   "heard": 9,
   "words": 10,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seven daughters came to fill the troughs",
   "heard": 4,
   "words": 7,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shepherds drove them away in the heat",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Moses rose up to water their flock",
   "heard": 7,
   "words": 7,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Reuel asked why they returned so soon",
   "heard": 7,
   "words": 7,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "An Egyptian had rescued their day",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Invite him to eat, said the father",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zipporah became his wife that way",
   "heard": 6,
   "words": 6,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blessed be the LORD who rescued you",
   "heard": 7,
   "words": 7,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the hand of Pharaoh and Egypt",
   "heard": 7,
   "words": 7,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now I know the LORD is greater",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Than all gods who rule the earth",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Go in peace, Jethro said to Moses",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Return to your relatives in Egypt",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But he came back to the mountain of God",
   "heard": 9,
   "words": 9,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With Zipporah and their two sons",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Gershom, a stranger in a foreign land",
   "heard": 6,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Eliezer, the God of his father",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jethro rejoiced over the good of God",
   "heard": 7,
   "words": 7,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He saw the rescue from the Egyptians",
   "heard": 7,
   "words": 7,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blessed be the LORD who rescued you",
   "heard": 7,
   "words": 7,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the hand of Pharaoh and Egypt",
   "heard": 6,
   "words": 7,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now I know the LORD is greater",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Than all gods who rule the earth",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You judge the people from morning till evening",
   "heard": 8,
   "words": 8,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This task is too heavy for you alone",
   "heard": 8,
   "words": 8,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look out for capable men who fear God",
   "heard": 8,
   "words": 8,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Trustworthy men who hate a bribe",
   "heard": 6,
   "words": 6,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Appoint them over thousands and hundreds",
   "heard": 6,
   "words": 6,
   "error_s": 0.11,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Fifties and tens to judge the people",
   "heard": 7,
   "words": 7,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lighten your load and let them carry it",
   "heard": 8,
   "words": 8,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And all these people will go home in peace",
   "heard": 9,
   "words": 9,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blessed be the LORD who rescued you",
   "heard": 7,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the hand of Pharaoh and Egypt",
   "heard": 6,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now I know the LORD is greater",
   "heard": 7,
   "words": 7,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Than all gods who rule the earth",
   "heard": 7,
   "words": 7,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Moses listened and did everything he said",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Then he sent his father-in-law home",
   "heard": 4,
   "words": 6,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": true
  }
