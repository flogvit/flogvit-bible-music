   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Remain in my love",
   "heard": 4,
   "words": 4,
   "error_s": 1.82,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Keep my commandments",
   "heard": 3,
   "words": 3,
   "error_s": 1.62,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You will remain in my love",
   "heard": 6,
   "words": 6,
   "error_s": 1.52,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Just as I kept the Father's",
   "heard": 6,
   "words": 6,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And remained in his love",
   "heard": 5,
   "words": 5,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This is my commandment",
   "heard": 4,
   "words": 4,
   "error_s": 1.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Love one another as I have loved you",
   "heard": 8,
