 "offset_seconds": -4.400000000000162,
 "words_heard": 141,
 "words": 144,
 "lines": [
  {
   "text": "In days of Ahaz son of Jotham,",
   "heard": 7,
   "words": 7,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Rezin and Pekah marched to war,",
   "heard": 6,
   "words": 6,
   "error_s": 1.5,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Against Jerusalem they came to fight,",
   "heard": 6,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet they could not prevail then.",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When word came to the house of David,",
   "heard": 8,
   "words": 8,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The heart of the king shook in fear,",
   "heard": 8,
   "words": 8,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Like trees of the forest before the wind,",
   "heard": 8,
   "words": 8,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people trembled with dread then.",
   "heard": 6,
   "words": 6,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Go out to meet Ahaz at the pool,",
   "heard": 8,
   "words": 8,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At the end of the Upper Pool,",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "On the road to the Launderer's Field,",
   "heard": 7,
   "words": 7,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Be careful and keep calm now.",
   "heard": 6,
   "words": 6,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not lose heart over two stubs,",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of firewood that smolder and burn,",
   "heard": 5,
   "words": 6,
   "error_s": 0.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The fierce anger of Aram and Ephraim,",
   "heard": 7,
   "words": 7,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will not succeed in their plan.",
   "heard": 6,
   "words": 6,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They plotted to tear Judah apart,",
   "heard": 6,
   "words": 6,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And set the son of Tabeel,",
   "heard": 5,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the Lord GOD says it will not happen,",
   "heard": 9,
   "words": 9,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It will not take place then.",
   "heard": 5,
   "words": 6,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you do not stand firm in faith",
   "heard": 8,
   "words": 8,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  }
 ],
