{
 "id": "story-elias-opprykkelse-og-elisjas-doble-del-choral",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-elias-opprykkelse-og-elisjas-doble-del-choral",
 "offset_seconds": 7.439999999999586,
 "words_heard": 212,
 "words": 214,
 "lines": [
  {
   "text": "From Gilgal to Bethel we went",
   "heard": 6,
   "words": 6,
   "error_s": 8.65,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Elijah said stay here my friend",
   "heard": 6,
   "words": 6,
   "error_s": 8.86,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But I said I will not leave you behind",
   "heard": 9,
   "words": 9,
   "error_s": 7.97,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "As surely as the LORD lives he is kind",
   "heard": 9,
   "words": 9,
   "error_s": 7.99,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "From Bethel to Jericho we go",
   "heard": 6,
   "words": 6,
   "error_s": 7.72,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The prophets ask if you know",
   "heard": 6,
   "words": 6,
   "error_s": 5.36,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The LORD will take your master away",
   "heard": 7,
   "words": 7,
   "error_s": 3.79,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "I answered yes I know what they say",
   "heard": 8,
   "words": 8,
   "error_s": 2.86,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "From Jericho to the Jordan stream",
   "heard": 6,
   "words": 6,
   "error_s": 2.4,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Fifty men watched as we walked in between",
   "heard": 8,
   "words": 8,
   "error_s": 1.16,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "He rolled up his cloak and struck the water",
   "heard": 9,
   "words": 9,
   "error_s": 0.94,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The river divided for us to enter",
   "heard": 7,
   "words": 7,
   "error_s": 1.45,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "As we crossed he asked what I need",
   "heard": 8,
   "words": 8,
   "error_s": 25.72,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Before he is taken by the decree",
   "heard": 5,
   "words": 7,
   "error_s": 27.52,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "I asked for a double portion of your spirit",
   "heard": 9,
   "words": 9,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He said if you see it it will be it",
   "heard": 10,
   "words": 10,
   "error_s": 0.43,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "A chariot of fire and horses of flame",
   "heard": 8,
   "words": 8,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Separated us in the sky's domain",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I cried out my father where have you gone",
   "heard": 9,
   "words": 9,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I tore my clothes as I looked on",
   "heard": 8,
   "words": 8,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I picked up his cloak that fell from him",
   "heard": 9,
   "words": 9,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And stood on the bank of the Jordan rim",
   "heard": 9,
   "words": 9,
   "error_s": 0.47,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "I struck the water with his coat",
   "heard": 7,
   "words": 7,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where is the God of Elijah now",
   "heard": 7,
   "words": 7,
   "error_s": 0.56,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The water divided to right and to left",
   "heard": 8,
   "words": 8,
   "error_s": 1.01,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "And I crossed over without effort or debt",
   "heard": 8,
   "words": 8,
   "error_s": 1.24,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The prophets saw and bowed to the ground",
   "heard": 8,
   "words": 8,
   "error_s": 1.49,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The spirit of Elijah is found",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  }
 ],
