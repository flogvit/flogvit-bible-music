   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My soul waits for the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "More than watchmen wait for the morning",
   "heard": 7,
   "words": 7,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
