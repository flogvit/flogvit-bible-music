 "lines": [
  {
   "text": "The day of your death is near",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Summon Joshua, stand together",
   "heard": 4,
   "words": 4,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Present yourselves at the tent",
   "heard": 5,
   "words": 5,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where I will commission him",
   "heard": 5,
   "words": 5,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I appeared in a pillar of cloud",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Standing over the entrance",
   "heard": 4,
   "words": 4,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You lie down with your fathers soon",
   "heard": 7,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the people will rise up",
   "heard": 6,
   "words": 6,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Write down this song for yourselves",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Teach it to the Israelites",
   "heard": 5,
   "words": 5,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Put it in their mouths deep",
   "heard": 6,
   "words": 6,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So it stands as my witness",
   "heard": 6,
   "words": 6,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They prostitute themselves to foreign gods",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Forsaking me and my covenant",
   "heard": 5,
   "words": 5,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My anger will burn against them",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will hide my face away",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Write down this song for yourselves",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Teach it to the Israelites",
   "heard": 5,
   "words": 5,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Put it in their mouths deep",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So it stands as my witness",
   "heard": 6,
   "words": 6,
   "error_s": 1.0,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "They eat their fill and grow fat",
   "heard": 7,
   "words": 7,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Then they despise my holy name",
   "heard": 5,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When disasters come upon them",
   "heard": 5,
   "words": 5,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They will say I am gone",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This song will testify against them",
   "heard": 6,
   "words": 6,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
