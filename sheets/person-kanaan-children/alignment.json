   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "May Canaan be his slave",
   "heard": 5,
   "words": 5,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ham saw his father's nakedness",
