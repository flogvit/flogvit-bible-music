   "error_s": 0.9,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Faithfulness the sash around his hips",
   "heard": 5,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
