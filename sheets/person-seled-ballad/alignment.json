   "words": 5,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bunah, Oren, Ozem, Ahijah",
   "heard": 0,
   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Ram's sons: Maaz, Jamin, Eker",
   "heard": 0,
   "words": 5,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jerahmeel had Atarah too",
