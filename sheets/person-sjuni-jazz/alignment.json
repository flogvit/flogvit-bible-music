 "lines": [
  {
   "text": "Seventy souls went down to the Nile",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gad's sons walked in a single file",
   "heard": 7,
   "words": 7,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ziphion, Haggi, and Shuni too",
   "heard": 5,
   "words": 5,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ezbon, Eri, Arodi, Areli's view",
   "heard": 5,
   "words": 5,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jacob's household, sixty-six count",
   "heard": 3,
   "words": 4,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Two sons born in the new ground",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seventy total, safe and sound",
   "heard": 5,
   "words": 5,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the land where the wheat is found",
   "heard": 8,
   "words": 8,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Wilderness years, the census calls",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Clans of Gad, standing in the halls",
   "heard": 7,
   "words": 7,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From Zephon to the Zephonite name",
   "heard": 6,
   "words": 6,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shuni's line, none lost from fame",
   "heard": 6,
   "words": 6,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shunite clan, east of the Jordan stream",
   "heard": 7,
   "words": 7,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Livestock heavy, the quiet dream",
   "heard": 5,
   "words": 5,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your inheritance lies on the other side",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With the Reubenites, proudly pride",
   "heard": 5,
   "words": 5,
   "error_s": 0.35,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Moses spoke of the fathers' sin",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Kadesh Barnea, the wandering spin",
   "heard": 5,
   "words": 5,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Forty years in the desert heat",
   "heard": 5,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But your flocks are a powerful feat",
   "heard": 7,
   "words": 7,
   "error_s": 1.02,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Build pens for the sheep and the goat",
   "heard": 7,
   "words": 8,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Cities for the children, afloat",
