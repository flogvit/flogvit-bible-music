{
 "id": "person-job-lament",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-job-lament",
 "offset_seconds": -3.9200000000001722,
 "words_heard": 136,
 "words": 148,
 "lines": [
  {
   "text": "Let the day perish on which I was born",
   "heard": 9,
   "words": 9,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the night that said, a boy is conceived",
   "heard": 9,
   "words": 9,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let that day be darkness",
   "heard": 5,
   "words": 5,
   "error_s": 0.37,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Let no light shine upon it",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why did I not die at birth",
   "heard": 5,
   "words": 7,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why did I not breathe my last",
   "heard": 7,
   "words": 7,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why is light given to the one in misery",
   "heard": 8,
   "words": 9,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why",
   "heard": 1,
   "words": 1,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Now my life is poured out within me",
   "heard": 8,
   "words": 8,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Days of affliction have taken hold of me",
   "heard": 8,
   "words": 8,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Night pierces my bones",
   "heard": 3,
   "words": 4,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The pains that gnaw me never rest",
   "heard": 6,
   "words": 7,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I cry out to you, and you do not answer",
   "heard": 10,
   "words": 10,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I stand before you, and you only look at me",
   "heard": 10,
   "words": 10,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You lift me up to the wind",
   "heard": 7,
   "words": 7,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You melt me away in the roar of the storm",
   "heard": 10,
   "words": 10,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why did I not die at birth",
   "heard": 7,
   "words": 7,
   "error_s": 2.54,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Why did I not breathe my last",
   "heard": 7,
   "words": 7,
   "error_s": 5.71,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Why is light given to the one in misery",
   "heard": 9,
   "words": 9,
   "error_s": 5.84,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Why",
   "heard": 1,
   "words": 1,
   "error_s": 5.55,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I have become like dust and ashes",
   "heard": 0,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  }
