   "heard": 6,
   "words": 6,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But this water does not run out",
   "heard": 7,
   "words": 7,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It wells up from within",
   "heard": 5,
   "words": 5,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
