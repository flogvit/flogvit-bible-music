 "words": 171,
 "lines": [
  {
   "text": "We claim the blood of Abraham runs deep",
   "heard": 8,
   "words": 8,
   "error_s": 1.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We say we have never been anyone's slave",
   "heard": 8,
   "words": 8,
   "error_s": 1.15,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But you ask how we could ever be truly free",
   "heard": 10,
   "words": 10,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "When the chains of sin are heavy and strong",
   "heard": 9,
   "words": 9,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Truly, truly, I tell you today",
   "heard": 6,
   "words": 6,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Everyone who commits sin is a slave",
   "heard": 7,
   "words": 7,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A slave does not remain in the house",
   "heard": 8,
   "words": 8,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But a son stays forever in his place",
   "heard": 8,
   "words": 8,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If the Son sets you free from the bond",
   "heard": 9,
   "words": 9,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will be free indeed, truly free",
   "heard": 7,
   "words": 7,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I know your lineage, I know your name",
   "heard": 8,
   "words": 8,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But my word finds no room in your heart",
   "heard": 9,
   "words": 9,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Truly, truly, I tell you today",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Everyone who commits sin is a slave",
   "heard": 7,
   "words": 7,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A slave does not remain in the house",
   "heard": 8,
   "words": 8,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But a son stays forever in his place",
   "heard": 8,
   "words": 8,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I speak of what I have seen with my Father",
   "heard": 10,
   "words": 10,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You do what you have heard from your father",
   "heard": 9,
   "words": 9,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you were children of Abraham then",
   "heard": 7,
   "words": 7,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You would do the works that he did",
   "heard": 8,
   "words": 8,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Free indeed, the son remains",
   "heard": 5,
   "words": 5,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Free indeed, the chains are gone",
   "heard": 6,
