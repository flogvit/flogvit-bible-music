 "lines": [
  {
   "text": "Lord, hear my voice as I call to you",
   "heard": 9,
   "words": 9,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let your ears be attentive to my cry",
   "heard": 8,
   "words": 8,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you kept a record of my sins",
   "heard": 8,
   "words": 8,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who could stand before you?",
   "heard": 5,
   "words": 5,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I wait for the Lord, my soul waits",
   "heard": 7,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And in his word I put my hope",
   "heard": 8,
