   "error_s": 3.04,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Forever with the Lord",
   "heard": 4,
   "words": 4,
   "error_s": 3.87,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Encourage one another with these words",
   "heard": 6,
