 "lines": [
  {
   "text": "I am not ashamed of the good news",
   "heard": 8,
   "words": 8,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It carries the power of God",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the salvation of all who believe",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the first to the last",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It is the power of God for salvation",
   "heard": 8,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of everyone who believes in Him",
