 "words": 132,
 "lines": [
  {
   "text": "Early in the morning, the women went",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Carrying spices to the grave",
   "heard": 5,
   "words": 5,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They found the stone rolled away",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But they did not find his body there",
   "heard": 8,
   "words": 8,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Two men in dazzling clothes stood by them",
   "heard": 8,
   "words": 8,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why do you seek the living among the dead",
   "heard": 8,
   "words": 9,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is not here, but he is risen",
   "heard": 8,
   "words": 8,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Remember how he told you what he said",
   "heard": 8,
   "words": 8,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He got up, he got up",
   "heard": 6,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Early Sunday morning, he got up",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Death could not hold him, the grave could not keep him",
   "heard": 11,
   "words": 11,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He got up, he got up",
   "heard": 6,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Remember what he said, remember what he said",
   "heard": 8,
   "words": 8,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "On the third day he will rise",
   "heard": 7,
   "words": 7,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He got up, he got up",
