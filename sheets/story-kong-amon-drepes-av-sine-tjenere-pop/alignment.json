 "lines": [
  {
   "text": "Amon was twenty-two when he took the throne",
   "heard": 6,
   "words": 8,
   "error_s": 2.02,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Reigned two years in Jerusalem alone",
   "heard": 3,
   "words": 6,
   "error_s": 1.79,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His mother Meshullemeth from Jotbah came",
   "heard": 3,
   "words": 6,
   "error_s": 1.71,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He walked in the paths of his father's name",
   "heard": 9,
   "words": 9,
   "error_s": 1.77,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He did what was evil in the eyes of the LORD",
   "heard": 11,
   "words": 11,
   "error_s": 1.62,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Serving the idols his father adored",
   "heard": 6,
   "words": 6,
   "error_s": 1.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He bowed down to them in the dust",
   "heard": 8,
   "words": 8,
   "error_s": 1.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He forsook the God of his fathers just",
   "heard": 8,
   "words": 8,
   "error_s": 1.39,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His officials conspired in the house of the king",
   "heard": 9,
   "words": 9,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They struck down the ruler and silenced the ring",
   "heard": 9,
   "words": 9,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people of the land rose up in fear",
   "heard": 9,
   "words": 9,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They made Josiah king while the shadows appear",
   "heard": 8,
   "words": 8,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They struck down all who had conspired that day",
   "heard": 9,
   "words": 9,
   "error_s": 0.3,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "To keep the kingdom from slipping away",
   "heard": 7,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He was buried in his tomb deep below",
   "heard": 8,
   "words": 8,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the garden of Uzza where the winds blow",
   "heard": 9,
   "words": 9,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His officials conspired in the house of the king",
   "heard": 9,
   "words": 9,
   "error_s": 0.21,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "They struck down the ruler and silenced the ring",
   "heard": 9,
   "words": 9,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people of the land rose up in fear",
   "heard": 9,
   "words": 9,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They made Josiah king while the shadows appear",
   "heard": 8,
   "words": 8,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
