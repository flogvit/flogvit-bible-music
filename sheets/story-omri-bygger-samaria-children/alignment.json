 "words": 214,
 "lines": [
  {
   "text": "In the thirty-first year of Asa's reign",
   "heard": 6,
   "words": 7,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Omri took his seat upon the throne",
   "heard": 7,
   "words": 7,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He ruled for twelve years in the land",
   "heard": 8,
   "words": 8,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Six of them in Tirzah he held the land",
   "heard": 9,
   "words": 9,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He saw a hill that needed a name",
   "heard": 8,
   "words": 8,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And he saw a price that would be paid",
   "heard": 9,
   "words": 9,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Two talents of silver he gave",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the owner of the hill in the valley",
   "heard": 9,
   "words": 9,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He bought the hill of Samaria",
   "heard": 6,
   "words": 6,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From Shemer the owner of the land",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He built a city on the stone",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And named it after the man he found",
   "heard": 8,
   "words": 8,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But Omri did evil in the Lord's sight",
   "heard": 8,
   "words": 8,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "More wicked than all who went before",
   "heard": 7,
   "words": 7,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He followed the path of Jeroboam",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And led Israel away from the door",
   "heard": 7,
   "words": 7,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With worthless idols they provoked",
   "heard": 4,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The God of Israel to be angry",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They followed the sin of the king",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And turned their hearts to vanity",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He bought the hill of Samaria",
   "heard": 6,
   "words": 6,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From Shemer the owner of the land",
   "heard": 7,
   "words": 7,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He built a city on the stone",
   "heard": 7,
   "words": 7,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And named it after the man he found",
   "heard": 8,
   "words": 8,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The book of the kings records his acts",
   "heard": 8,
   "words": 8,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The exploits he performed are known",
   "heard": 6,
   "words": 6,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But Omri rested with his fathers",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And was buried in the city alone",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His son Ahab became king in his place",
   "heard": 8,
   "words": 8,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the story of Israel continued on",
   "heard": 7,
   "words": 7,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  }
 ],
