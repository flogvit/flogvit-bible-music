 "words_heard": 205,
 "words": 208,
 "lines": [
  {
   "text": "Those who are in the flesh cannot please God",
   "heard": 9,
   "words": 9,
   "error_s": 3.66,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "But you are not in the flesh, you are in the Spirit",
   "heard": 12,
   "words": 12,
   "error_s": 3.09,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The Spirit of Christ dwells deep within",
   "heard": 7,
   "words": 7,
   "error_s": 1.55,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "If He is not in you, you do not belong to Him",
   "heard": 10,
   "words": 12,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Spirit of Him who raised Jesus from the dead",
   "heard": 10,
   "words": 10,
   "error_s": 0.59,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Will give life to your mortal bodies",
   "heard": 7,
   "words": 7,
   "error_s": 0.15,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Through His Spirit who dwells in you",
   "heard": 7,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The dead become alive, the grave cannot hold",
   "heard": 8,
   "words": 8,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The body is dead because of sin",
   "heard": 7,
   "words": 7,
   "error_s": 3.95,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But the Spirit is life because of righteousness",
   "heard": 8,
   "words": 8,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We have an obligation to walk in a new way",
   "heard": 10,
   "words": 10,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not to the flesh, but to the Spirit's holy sway",
   "heard": 9,
   "words": 10,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Spirit of Him who raised Jesus from the dead",
   "heard": 10,
   "words": 10,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will give life to your mortal bodies",
   "heard": 7,
   "words": 7,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through His Spirit who dwells in you",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The dead become alive, the grave cannot hold",
   "heard": 8,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If by the Spirit you put to death the deeds",
   "heard": 10,
   "words": 10,
   "error_s": 1.69,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Of the body, you will live",
   "heard": 6,
   "words": 6,
   "error_s": 1.65,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Led by the Spirit of God",
   "heard": 6,
   "words": 6,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are children of God",
   "heard": 5,
   "words": 5,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Spirit of Him who raised Jesus from the dead",
   "heard": 10,
   "words": 10,
   "error_s": 0.45,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Will give life to your mortal bodies",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through His Spirit who dwells in you",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The dead become alive, the grave cannot hold",
   "heard": 8,
   "words": 8,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are led by the Spirit",
   "heard": 6,
   "words": 6,
   "error_s": 1.67,
   "tie_split": false,
   "uncertain": true
  },
