   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He delivered me from all my fears",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My soul boasts in the Lord today",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let the humble hear and rejoice",
   "heard": 6,
   "words": 6,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Magnify the Lord with me",
   "heard": 5,
   "words": 5,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let us exalt his name together",
   "heard": 6,
