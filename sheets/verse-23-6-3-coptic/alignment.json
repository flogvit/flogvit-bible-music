 "lines": [
  {
   "text": "In the year that King Uzziah died",
   "heard": 7,
   "words": 7,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I saw the Lord on a high and lofty throne",
   "heard": 10,
   "words": 10,
   "error_s": 2.0,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The train of his robe filled the temple",
   "heard": 8,
   "words": 8,
   "error_s": 1.9,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Seraphim stood above him",
   "heard": 4,
   "words": 4,
   "error_s": 1.64,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Holy, holy, holy is the Lord of hosts",
   "heard": 8,
   "words": 8,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The whole earth is full of his glory",
   "heard": 8,
   "words": 8,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With two wings they covered their faces",
   "heard": 7,
   "words": 7,
   "error_s": 1.6,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With two wings they covered their feet",
   "heard": 7,
   "words": 7,
   "error_s": 1.57,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With two wings they flew",
   "heard": 5,
   "words": 5,
   "error_s": 1.25,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And they called out to one another",
   "heard": 7,
   "words": 7,
   "error_s": 1.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Holy, holy, holy is the Lord of hosts",
   "heard": 8,
   "words": 8,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The whole earth is full of his glory",
   "heard": 8,
   "words": 8,
   "error_s": 0.96,
