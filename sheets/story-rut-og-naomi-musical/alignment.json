 "words": 143,
 "lines": [
  {
   "text": "Go back, my daughters, each to her mother's house",
   "heard": 9,
   "words": 9,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "May the Lord deal kindly with you",
   "heard": 7,
   "words": 7,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As you have dealt with the dead and with me",
   "heard": 10,
   "words": 10,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Go back, there is nothing for you with me",
   "heard": 9,
   "words": 9,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not urge me to leave you",
   "heard": 7,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Or to return from following you",
   "heard": 6,
   "words": 6,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For where you go, I will go",
   "heard": 7,
   "words": 7,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And where you lodge, I will lodge",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your people shall be my people",
   "heard": 6,
   "words": 6,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And your God my God",
   "heard": 5,
   "words": 5,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where you die, I will die",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And there I will be buried",
   "heard": 6,
   "words": 6,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Turn back like your sister has turned",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Back to her people and her gods",
   "heard": 7,
   "words": 7,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No, I will not leave you",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "May the Lord do so to me if anything but death parts me from you",
   "heard": 15,
   "words": 15,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
