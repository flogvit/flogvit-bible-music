 "lines": [
  {
   "text": "Praise the LORD with a new song",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His praise in the assembly of the faithful",
   "heard": 8,
   "words": 8,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let Israel rejoice in his Maker",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let the children of Zion exult in their King",
   "heard": 9,
   "words": 9,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sing to the LORD a new song",
   "heard": 7,
   "words": 7,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Praise him with dancing and sound",
   "heard": 6,
   "words": 6,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Tambourine and lyre ring out",
   "heard": 4,
   "words": 5,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For he delights in his people",
   "heard": 6,
   "words": 6,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The humble are crowned with salvation",
   "heard": 4,
   "words": 6,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let the faithful exult in glory",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sing for joy upon your beds",
   "heard": 6,
   "words": 6,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the LORD has made you new",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
