 "lines": [
  {
   "text": "Word of the Lord came to me",
   "heard": 7,
   "words": 7,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Judge the city of blood now",
   "heard": 6,
   "words": 6,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Confront her with detestable deeds",
   "heard": 5,
   "words": 5,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Idols made against herself",
   "heard": 4,
   "words": 4,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You shed blood and bring guilt",
   "heard": 6,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your days are near the end",
   "heard": 6,
   "words": 6,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mocked by nations far and near",
   "heard": 6,
   "words": 6,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Princes shed blood with power",
   "heard": 5,
   "words": 5,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are dross in the furnace",
   "heard": 6,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Melted by my wrath",
   "heard": 4,
   "words": 4,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will gather you into anger",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And blow the fire of fury",
   "heard": 5,
   "words": 6,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Treating father and mother with contempt",
   "heard": 6,
   "words": 6,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Oppressing the stranger in your midst",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Wronging the orphan and the widow",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Despising what is holy to me",
   "heard": 6,
   "words": 6,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Men slander to shed blood",
   "heard": 5,
   "words": 5,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Eating at mountain shrines",
   "heard": 4,
   "words": 4,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Uncleanness in your midst",
   "heard": 4,
   "words": 4,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You have forgotten me",
   "heard": 4,
   "words": 4,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are atrocious in the furnace",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Melted by my wrath",
   "heard": 4,
   "words": 4,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will gather you into anger",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And blow the fire of fury",
   "heard": 4,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Prophets like roaring lions",
   "heard": 4,
   "words": 4,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Devour lives and seize treasure",
   "heard": 5,
   "words": 5,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Priests profane my law",
   "heard": 4,
   "words": 4,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Officials like wolves tearing prey",
   "heard": 4,
   "words": 5,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I searched for one to stand",
   "heard": 6,
   "words": 6,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the breach on behalf of the land",
   "heard": 8,
   "words": 8,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But I found no one there",
   "heard": 6,
   "words": 6,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So I poured out my indignation",
