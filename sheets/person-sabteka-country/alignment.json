 "lines": [
  {
   "text": "The family line of Noah's sons",
   "heard": 6,
   "words": 6,
   "error_s": 1.23,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shem and Ham and Japheth born",
   "heard": 6,
   "words": 6,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "After the flood the waters dried",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And nations spread on every side",
   "heard": 5,
   "words": 6,
   "error_s": 1.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Ham became the father there",
   "heard": 5,
   "words": 5,
   "error_s": 1.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Of Cush and Egypt and Put",
   "heard": 6,
   "words": 6,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Canaan joined them in the land",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where scattered peoples made a stand",
   "heard": 5,
   "words": 6,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The sons of Cush came to be",
   "heard": 7,
   "words": 7,
   "error_s": 1.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Seba Havilah Sabtah too",
   "heard": 0,
   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Raamah and Sabteca named",
