   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When the paycheck's gone too early and the rent is due again",
   "heard": 12,
   "words": 12,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When the doctor's words are heavy and I cannot see the end",
   "heard": 12,
   "words": 12,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When the house is full of laughter and the cupboards overflow",
   "heard": 11,
   "words": 11,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
