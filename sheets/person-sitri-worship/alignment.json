 "words": 176,
 "lines": [
  {
   "text": "Sons of Uzziel stand in the line",
   "heard": 7,
   "words": 7,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mishael and Elzaphan and Sithri",
   "heard": 5,
   "words": 5,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the household of Kohath they came",
   "heard": 7,
   "words": 7,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Levites chosen to bear the name",
   "heard": 6,
   "words": 6,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They camp on the south side of the tent",
   "heard": 9,
   "words": 9,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Guarding the holy things that the Lord sent",
   "heard": 8,
   "words": 8,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The ark and the table and the lampstand bright",
   "heard": 8,
   "words": 9,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They carry the work of the sanctuary night and day",
   "heard": 10,
   "words": 10,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When fire came from before the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And consumed Nadab and Abihu",
   "heard": 4,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Moses called the sons of Uzziel",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come carry them out from the camp",
   "heard": 7,
   "words": 7,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They camp on the south side of the tent",
   "heard": 9,
   "words": 9,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Guarding the holy things that the Lord sent",
   "heard": 8,
   "words": 8,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The ark and the table and the lampstand bright",
   "heard": 8,
   "words": 9,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They carry the work of the sanctuary night and day",
   "heard": 10,
   "words": 10,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Among those who draw near to me",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will show myself holy says the Lord",
   "heard": 5,
   "words": 8,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Before all the people I am glorified",
   "heard": 7,
   "words": 7,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In silence Aaron stands before God",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Eight thousand six hundred men",
   "heard": 1,
   "words": 5,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Charged with the care of the holy things",
   "heard": 8,
   "words": 8,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A gift to Aaron and his sons",
   "heard": 7,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To guard the priesthood of Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  }
