 "words_heard": 167,
 "words": 174,
 "lines": [
  {
   "text": "In the fourth year of King Jehoiakim",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The word of the Lord came to Jeremiah",
   "heard": 8,
   "words": 8,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He called for Baruch son of Neriah",
   "heard": 7,
   "words": 7,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To write the words of the Lord on a scroll",
   "heard": 10,
   "words": 10,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As Jeremiah dictated the words of the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Baruch wrote them down with faithful hands",
   "heard": 7,
   "words": 7,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through the fire and the fear of the king",
   "heard": 9,
   "words": 9,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The scribe remained by the prophet's side",
   "heard": 6,
   "words": 7,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the house of the Lord at the New Gate",
   "heard": 10,
   "words": 10,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Baruch read the words in the hearing of all",
   "heard": 9,
   "words": 9,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the king cut the scroll with a knife",
   "heard": 9,
   "words": 9,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And threw the words into the fire",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As Jeremiah dictated the words of the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Baruch wrote them down with faithful hands",
   "heard": 5,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through the fire and the fear of the king",
   "heard": 9,
   "words": 9,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The scribe remained by the prophet's side",
   "heard": 4,
   "words": 7,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are seeking great things for yourself",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not seek them for I will bring disaster",
   "heard": 9,
   "words": 9,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But wherever you go I will grant",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your life as spoil in the whole land",
   "heard": 7,
   "words": 8,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They went to the land of Egypt",
   "heard": 7,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not obeying the voice of the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  }
 ],
