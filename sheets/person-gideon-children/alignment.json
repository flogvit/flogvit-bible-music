   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One hundred, two hundred, three hundred men",
   "heard": 7,
   "words": 7,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All around the camp in the dark night",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
