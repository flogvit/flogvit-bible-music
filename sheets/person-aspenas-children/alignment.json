 "words_heard": 174,
 "words": 174,
 "lines": [
  {
   "text": "The king ordered Ashpenaz the chief of his court officials",
   "heard": 10,
   "words": 10,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To bring in some of the Israelites from the royal family",
   "heard": 11,
   "words": 11,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Young men without any physical defect and handsome",
   "heard": 8,
   "words": 8,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Skilled in all wisdom and endowed with knowledge",
   "heard": 8,
   "words": 8,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fit to serve in the king's palace",
   "heard": 7,
   "words": 7,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To learn the writing and the language of the Chaldeans",
   "heard": 10,
   "words": 10,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ashpenaz gave them new Babylonian names",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Belteshazzar Shadrach Meshach and Abednego",
   "heard": 5,
   "words": 5,
   "error_s": 0.98,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "But Daniel resolved in his heart",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not to defile himself with the king's food",
   "heard": 8,
   "words": 8,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God granted him favor and compassion",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the sight of the chief official",
   "heard": 7,
   "words": 7,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet Ashpenaz feared the lord the king",
   "heard": 7,
   "words": 7,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who assigned their food and drink",
   "heard": 6,
   "words": 6,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Afraid the king would see them looking worse",
   "heard": 8,
   "words": 8,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Than the other young men their age",
   "heard": 7,
   "words": 7,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ashpenaz gave them new Babylonian names",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Belteshazzar Shadrach Meshach and Abednego",
   "heard": 5,
   "words": 5,
   "error_s": 0.99,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "But Daniel resolved in his heart",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not to defile himself with the king's food",
   "heard": 8,
   "words": 8,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You would cost me my head before the king",
   "heard": 9,
   "words": 9,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So Daniel spoke to the steward in charge",
   "heard": 8,
   "words": 8,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Three years of training in Babylon",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keeping faith in the king's court",
   "heard": 6,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  }
 ],
