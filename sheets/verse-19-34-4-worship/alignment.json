   "words": 6,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Those who look to him are radiant",
   "heard": 7,
   "words": 7,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Their faces will never be ashamed",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This poor man called and the Lord heard",
