 "lines": [
  {
   "text": "Joktan fathered Almodad",
   "heard": 3,
   "words": 3,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sheleph came next in the line",
   "heard": 6,
   "words": 6,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hazarmaveth and Jerah",
   "heard": 3,
   "words": 3,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the east they drew near",
   "heard": 6,
   "words": 6,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sons of Shem after the Flood",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Descendants of Noah's blood",
   "heard": 4,
   "words": 4,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A family tree from the start",
   "heard": 6,
   "words": 6,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the land of the east part",
   "heard": 4,
   "words": 7,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Thirteen sons in the list",
   "heard": 5,
   "words": 5,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of Joktan's lineage distinct",
   "heard": 4,
   "words": 4,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the mountain regions high",
   "heard": 5,
   "words": 5,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Under the open sky",
   "heard": 4,
   "words": 4,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Genesis records their names",
   "heard": 4,
   "words": 4,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Chronicles repeats the same",
   "heard": 4,
   "words": 4,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the beginning of days",
   "heard": 5,
   "words": 5,
   "error_s": 0.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the light of our eyes",
   "heard": 6,
   "words": 6,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Part of the nations spread",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "After the Tower's head",
   "heard": 4,
   "words": 4,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Scattered across the land",
   "heard": 4,
   "words": 4,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By the Father's command",
   "heard": 4,
   "words": 4,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
