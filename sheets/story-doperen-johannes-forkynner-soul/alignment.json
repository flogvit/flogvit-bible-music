 "lines": [
  {
   "text": "In the wilderness of Judea he appeared",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Preaching repentance in the open air",
   "heard": 6,
