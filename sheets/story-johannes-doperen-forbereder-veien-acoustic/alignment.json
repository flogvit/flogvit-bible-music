  {
   "text": "John appeared in the wilderness",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Baptizing and proclaiming a truth",
   "heard": 5,
   "words": 5,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A baptism of repentance",
   "heard": 4,
   "words": 4,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the forgiveness of sins",
