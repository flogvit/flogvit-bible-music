 "words": 240,
 "lines": [
  {
   "text": "The word is near you, in your mouth and in your heart",
   "heard": 12,
   "words": 12,
   "error_s": 1.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not climbing up to heaven or down into the abyss",
   "heard": 10,
   "words": 10,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We do not need to reach for Christ from the dead",
   "heard": 11,
   "words": 11,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The faith we proclaim is close and clearly set",
   "heard": 8,
   "words": 9,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Confess with your mouth that Jesus is Lord",
   "heard": 8,
   "words": 8,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Believe in your heart that God raised him from the dead",
   "heard": 11,
   "words": 11,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will be saved, for this is the way",
   "heard": 9,
   "words": 9,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Righteousness comes to those who believe and say",
   "heard": 8,
   "words": 8,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With the heart one believes, resulting in righteousness",
   "heard": 8,
   "words": 8,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With the mouth one confesses, resulting in salvation",
   "heard": 7,
   "words": 8,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No one who believes in him will be put to shame",
   "heard": 11,
   "words": 11,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord is rich with gifts, calling out the same",
   "heard": 10,
   "words": 10,
   "error_s": 1.2,
   "tie_split": false,
   "uncertain": false
  },
