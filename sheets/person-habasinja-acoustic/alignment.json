 "lines": [
  {
   "text": "Go to the house of the Rechabites now",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bring them into the chamber here",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Set before them bowls full of wine",
   "heard": 7,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And say to them, drink some",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We drink no wine, our father said",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You and your children never will",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No houses built, no seed sown down",
   "heard": 7,
   "words": 7,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No vineyards planted or owned",
   "heard": 5,
   "words": 5,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Live in tents all your days",
   "heard": 6,
   "words": 6,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So that you may live long",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Obeying the voice of the father",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keeping the command strong",
   "heard": 3,
   "words": 4,
   "error_s": 0.07,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "We have obeyed the voice of Jonadab",
   "heard": 6,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In everything he commanded us",
   "heard": 5,
   "words": 5,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To drink no wine all our days",
   "heard": 7,
   "words": 7,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Neither wives nor sons nor daughters",
   "heard": 6,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Live in tents all your days",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So that you may live long",
   "heard": 6,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Obeying the voice of the father",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keeping the command strong",
   "heard": 3,
   "words": 4,
   "error_s": 0.09,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "But I have spoken to you again",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And you have not listened to me",
