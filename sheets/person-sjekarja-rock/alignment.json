 "lines": [
  {
   "text": "The eighth month in the second year",
   "heard": 7,
   "words": 7,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The word of the Lord came near",
   "heard": 7,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To Zechariah son of Iddo",
   "heard": 4,
   "words": 5,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He heard the spirit's quiet load",
   "heard": 6,
   "words": 6,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord was furious with your fathers",
   "heard": 7,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They did not listen to the prophets",
   "heard": 7,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But my words overtook your fathers",
   "heard": 6,
   "words": 6,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They repented in their own disasters",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Return to me declares the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And I will return to you once more",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be like your fathers now",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Turn from your evil ways and vow",
   "heard": 7,
   "words": 7,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The measuring line will be stretched out",
   "heard": 6,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Over Jerusalem in this hour",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My house will be rebuilt there",
   "heard": 6,
   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord of hosts declares it fair",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My cities will overflow with prosperity",
   "heard": 6,
   "words": 6,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord will comfort Zion freely",
   "heard": 6,
   "words": 6,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the night I had a vision",
   "heard": 7,
   "words": 7,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A man on a red horse's mission",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Standing among the myrtle trees",
   "heard": 5,
   "words": 5,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The angel spoke to me with ease",
   "heard": 7,
   "words": 7,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Patrolling the earth at rest and peace",
   "heard": 7,
   "words": 7,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seventy years of anger cease",
   "heard": 5,
   "words": 5,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord answered with kind words",
   "heard": 6,
   "words": 6,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Comfort for the broken and blurred",
   "heard": 6,
   "words": 6,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jealous for Jerusalem with burning fire",
   "heard": 6,
   "words": 6,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Angry with the nations that are near",
   "heard": 7,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have returned with mercy to the land",
   "heard": 8,
   "words": 8,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My people shall be safe and stand",
   "heard": 7,
   "words": 7,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The measuring line will be stretched out",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Over Jerusalem in this hour",
   "heard": 5,
   "words": 5,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My house will be rebuilt there",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord of hosts declares it fair",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My cities will overflow with prosperity",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord will comfort Zion freely",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Four horns that scattered Judah fell",
   "heard": 6,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Four craftsmen came to break them",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Joshua stood in filthy clothes",
   "heard": 5,
   "words": 5,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The angel spoke of holy hopes",
   "heard": 6,
   "words": 6,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Take the guilt away from you",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Clothe you in fine robes anew",
   "heard": 6,
   "words": 6,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am going to bring the Branch",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A sign for your strength",
   "heard": 5,
   "words": 5,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The plumb line in the hand of Zerubbabel",
   "heard": 7,
   "words": 8,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Grace grace to the capstone",
   "heard": 5,
   "words": 5,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The eyes of the Lord range through the earth",
   "heard": 9,
   "words": 9,
   "error_s": 1.18,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He sees the heart of the man",
   "heard": 7,
   "words": 7,
   "error_s": 1.35,
   "tie_split": false,
   "uncertain": true
  }
