 "lines": [
  {
   "text": "I kept the photographs of every time I fell",
   "heard": 9,
   "words": 9,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I kept the receipts of every wrong, I knew them all too well",
   "heard": 13,
   "words": 13,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I wore my yesterday like a coat in summer heat",
   "heard": 10,
   "words": 10,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then grace came walking in and set me on my feet",
   "heard": 11,
   "words": 11,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If anyone is in Christ, there is a new creation",
   "heard": 10,
   "words": 10,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The old has passed away",
   "heard": 4,
   "words": 5,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look, the new has come",
   "heard": 5,
