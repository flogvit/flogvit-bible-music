   "heard": 8,
   "words": 8,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To every hungry home",
   "heard": 4,
   "words": 4,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
