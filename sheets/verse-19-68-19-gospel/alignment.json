 "words": 189,
 "lines": [
  {
   "text": "The chariots of God are twice ten thousand",
   "heard": 8,
   "words": 8,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Thousands upon thousands in the holy place",
   "heard": 7,
   "words": 7,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord is among them in the sanctuary",
   "heard": 8,
   "words": 8,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sinai stands firm in the sacred space",
   "heard": 7,
   "words": 7,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You ascended on high in your might",
   "heard": 7,
   "words": 7,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You led captives in your train",
   "heard": 6,
   "words": 6,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You received gifts among men",
   "heard": 5,
   "words": 5,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Even from the rebellious",
   "heard": 4,
   "words": 4,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blessed be the Lord who daily bears our burdens",
   "heard": 9,
   "words": 9,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The God of our salvation is here",
   "heard": 7,
   "words": 7,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blessed be the Lord who daily bears our burdens",
   "heard": 9,
   "words": 9,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The God of our salvation is near",
   "heard": 7,
   "words": 7,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Our God is a God who saves us truly",
   "heard": 9,
   "words": 9,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the Lord God comes escape from death",
   "heard": 8,
   "words": 8,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He crushes the heads of his enemies",
   "heard": 7,
   "words": 7,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The hairy crown of those in guilt",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blessed be the Lord who daily bears our burdens",
   "heard": 9,
   "words": 9,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The God of our salvation is here",
   "heard": 6,
