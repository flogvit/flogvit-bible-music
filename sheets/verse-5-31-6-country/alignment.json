   "uncertain": false
  },
  {
   "text": "For the LORD your God goes with you",
   "heard": 8,
   "words": 8,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will never fail you or forsake you",
   "heard": 8,
   "words": 8,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
