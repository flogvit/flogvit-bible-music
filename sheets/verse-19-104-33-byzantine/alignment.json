 "lines": [
  {
   "text": "Bless the Lord, O my soul",
   "heard": 6,
   "words": 6,
   "error_s": 1.55,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "O Lord my God, you are very great",
   "heard": 8,
   "words": 8,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are clothed with honor and majesty",
   "heard": 7,
   "words": 7,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Wrapped in light as with a garment",
   "heard": 7,
   "words": 7,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will sing to the Lord as long as I live",
   "heard": 11,
   "words": 11,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will praise my God while I have being",
   "heard": 9,
   "words": 9,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How many are your works, O Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In wisdom you have made them all",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The earth is full of your creatures",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Glory to you, O Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will sing to the Lord as long as I live",
