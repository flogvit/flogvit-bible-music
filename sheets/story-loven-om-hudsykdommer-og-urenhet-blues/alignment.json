   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Live outside the camp, in the dust and the sun",
   "heard": 10,
   "words": 10,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
