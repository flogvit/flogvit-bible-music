   "heard": 7,
   "words": 7,
   "error_s": 8.2,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The sword will never depart",
   "heard": 5,
   "words": 5,
   "error_s": 12.11,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "From your house because you despised me",
   "heard": 7,
   "words": 7,
   "error_s": 12.5,
   "tie_split": true,
   "uncertain": true
  },
  {
