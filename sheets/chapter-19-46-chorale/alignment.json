 "words": 103,
 "lines": [
  {
   "text": "Our God, our refuge and our strength",
   "heard": 7,
   "words": 7,
   "error_s": 1.88,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A help so near in need",
   "heard": 6,
   "words": 6,
   "error_s": 1.65,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "We will not fear though earth gives way",
   "heard": 8,
   "words": 8,
   "error_s": 1.81,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And mountains fall to sea",
   "heard": 5,
   "words": 5,
   "error_s": 1.62,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Though waters roar and foam and rage",
   "heard": 6,
   "words": 7,
   "error_s": 1.22,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "And hills shake at the swell",
   "heard": 6,
   "words": 6,
   "error_s": 0.25,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "A river gladdens God's own town",
   "heard": 6,
   "words": 6,
   "error_s": 1.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where the Most High will dwell",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The nations rage, the kingdoms fall",
   "heard": 6,
   "words": 6,
   "error_s": 1.66,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "He lifts His voice, earth melts",
   "heard": 6,
   "words": 6,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet God is in her midst, she stands",
   "heard": 8,
   "words": 8,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He helps her when day breaks",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord of hosts is here with us",
   "heard": 8,
   "words": 8,
   "error_s": 1.39,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Our fortress, Jacob's God",
   "heard": 4,
   "words": 4,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Be still, and know that I am God",
   "heard": 8,
   "words": 8,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let all the earth be yours",
   "heard": 6,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  }
 ],
