 "words": 169,
 "lines": [
  {
   "text": "My granddad kept a flock of sheep out past the county line",
   "heard": 12,
   "words": 12,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He knew them every one by name and they all knew his sign",
   "heard": 13,
   "words": 13,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He'd sleep across the gateway when the coyotes came around",
   "heard": 10,
   "words": 10,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And not a lamb was taken while he lay upon the ground",
   "heard": 11,
   "words": 12,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I came that they may have life",
   "heard": 7,
   "words": 7,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And have it in abundance",
   "heard": 5,
   "words": 5,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am the good shepherd",
   "heard": 5,
   "words": 5,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The good shepherd lays down his life for the sheep",
   "heard": 10,
   "words": 10,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am the gate",
   "heard": 4,
   "words": 4,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever enters through me will be saved",
   "heard": 7,
   "words": 7,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will come in and go out and find pasture",
   "heard": 10,
   "words": 10,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The thief comes only to steal and kill and destroy",
   "heard": 10,
   "words": 10,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I came that they may have life",
   "heard": 7,
   "words": 7,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And have it in abundance",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am the good shepherd",
   "heard": 5,
   "words": 5,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The good shepherd lays down his life for the sheep",
   "heard": 10,
   "words": 10,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I've wandered from the gateway and I've heard the stranger call",
   "heard": 11,
   "words": 11,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
