  {
   "text": "David feigned madness in fear",
   "heard": 5,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abimelech drove him away",
   "heard": 4,
   "words": 4,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He left to find safety nearby",
   "heard": 6,
   "words": 6,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blessing the Lord day by day",
   "heard": 6,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My soul boasts in the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let the humble hear and rejoice",
