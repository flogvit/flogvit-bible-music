 "lines": [
  {
   "text": "How long must I carry worries within me",
   "heard": 8,
   "words": 8,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With grief in my heart all the day",
   "heard": 8,
   "words": 8,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look at me and answer, LORD my God",
   "heard": 8,
   "words": 8,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give light to my eyes before I fade",
   "heard": 7,
   "words": 8,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But I trust in your steadfast love",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My heart rejoices in your salvation",
   "heard": 6,
   "words": 6,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will sing to the LORD today",
   "heard": 7,
   "words": 7,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For he has dealt bountifully with me",
   "heard": 4,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My enemy may say he has overcome me",
   "heard": 8,
   "words": 8,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My foes may rejoice when I fall",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But I will not hide my face in fear",
   "heard": 9,
   "words": 9,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
