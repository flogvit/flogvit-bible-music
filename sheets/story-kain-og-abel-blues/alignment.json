 "words_heard": 156,
 "words": 164,
 "lines": [
  {
   "text": "Two brothers working the morning land",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One with the flock and one with the plough in his hand",
   "heard": 12,
   "words": 12,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abel brought the firstborn and the best of what he had",
   "heard": 11,
   "words": 11,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Cain brought his offering and his heart was turning bad",
   "heard": 10,
   "words": 10,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sin was crouching at the door like a hungry dog",
   "heard": 10,
   "words": 10,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Cain let it in and the evening turned to fog",
   "heard": 8,
   "words": 10,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Out in the field where nobody could see",
   "heard": 8,
   "words": 8,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He rose up against his brother by the old fig tree",
   "heard": 11,
   "words": 11,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where is your brother Abel",
   "heard": 5,
   "words": 5,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I do not know",
   "heard": 4,
   "words": 4,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Am I my brother's keeper",
   "heard": 5,
   "words": 5,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Am I my brother's keeper",
   "heard": 5,
   "words": 5,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "What have you done",
   "heard": 4,
   "words": 4,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Listen, your brother's blood is crying out to me from the ground",
   "heard": 12,
   "words": 12,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Cain went out wandering, the earth no longer his",
   "heard": 5,
   "words": 9,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But God put a mark on him, that's how mercy is",
   "heard": 11,
   "words": 11,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Where is your brother Abel",
   "heard": 5,
   "words": 5,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I do not know",
   "heard": 4,
   "words": 4,
   "error_s": 1.49,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Am I my brother's keeper",
   "heard": 5,
   "words": 5,
   "error_s": 2.86,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Am I my brother's keeper",
   "heard": 5,
   "words": 5,
   "error_s": 1.64,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Yes, I am my brother's keeper",
   "heard": 5,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lord, make me my brother's keeper",
   "heard": 5,
   "words": 6,
   "error_s": 6.93,
   "tie_split": false,
   "uncertain": true
  }
 ],
