 "lines": [
  {
   "text": "There were shepherds out in the fields nearby",
   "heard": 8,
   "words": 8,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keeping watch over their flock through the night",
   "heard": 8,
   "words": 8,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "An angel of the Lord appeared to them",
   "heard": 8,
   "words": 8,
   "error_s": 1.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the glory of the Lord shone around them",
   "heard": 9,
   "words": 9,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sleep now, little one, sleep now so softly",
   "heard": 8,
   "words": 8,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A baby wrapped in cloths",
   "heard": 5,
   "words": 5,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sleep now, little one, sleep now so softly",
   "heard": 8,
   "words": 8,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A baby wrapped in cloths",
   "heard": 5,
   "words": 5,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be afraid, the angel told them",
   "heard": 8,
   "words": 8,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I bring you good news of great joy",
   "heard": 8,
   "words": 8,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Today in the city of David a Savior is born to you",
   "heard": 12,
   "words": 12,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is Christ the Lord",
   "heard": 5,
