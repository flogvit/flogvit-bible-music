   "error_s": 12.53,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "How like a widow she has become",
   "heard": 6,
   "words": 7,
   "error_s": 11.03,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "She who was great among the nations",
   "heard": 7,
   "words": 7,
   "error_s": 9.03,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "She weeps bitterly in the night",
