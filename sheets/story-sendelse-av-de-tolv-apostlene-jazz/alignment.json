 "lines": [
  {
   "text": "He called the twelve to stand before him",
   "heard": 8,
   "words": 8,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gave power over spirits, sickness gone",
   "heard": 5,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Simon and Andrew, James and John",
   "heard": 6,
   "words": 6,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Philip and Thomas, Matthew, Thaddaeus",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sent to the lost sheep of Israel",
   "heard": 7,
   "words": 7,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Proclaim the Kingdom is come near",
   "heard": 5,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No gold in belts, no second tunic",
   "heard": 5,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No staff to carry, no bag for road",
   "heard": 8,
   "words": 8,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Freely received it, freely give it",
   "heard": 4,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The worker gets his daily bread",
   "heard": 6,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Kingdom of heaven has come near",
   "heard": 7,
   "words": 7,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heal the sick, cleanse the leper",
   "heard": 6,
   "words": 6,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Drive out the demons, raise the dead",
   "heard": 7,
   "words": 7,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Freely you have received, freely give",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Enter the house, give peace a greeting",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If worthy let it rest on them",
   "heard": 7,
   "words": 7,
   "error_s": 0.33,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "If not, let peace return to you",
   "heard": 7,
   "words": 7,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shake the dust off your feet",
   "heard": 6,
   "words": 6,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Be shrewd like serpents, innocent as doves",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They will hand you over to councils",
   "heard": 7,
   "words": 7,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Kingdom of heaven has come near",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heal the sick, cleanse the leper",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Drive out the demons, raise the dead",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Freely you have received, freely give",
   "heard": 4,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not fear those who kill the body",
   "heard": 8,
   "words": 8,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But fear the one who can destroy both",
   "heard": 8,
   "words": 8,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Two sparrows sold for a single penny",
   "heard": 7,
   "words": 7,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not one falls without his care",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your head hairs are all numbered",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are worth more than many sparrows",
   "heard": 7,
   "words": 7,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
