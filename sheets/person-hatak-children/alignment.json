 "offset_seconds": -2.6400000000001995,
 "words_heard": 194,
 "words": 194,
 "lines": [
  {
   "text": "Esther called Hathach to her side",
   "heard": 6,
   "words": 6,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One of the eunuchs assigned to serve",
   "heard": 7,
   "words": 7,
   "error_s": 1.21,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "She ordered him to go and find",
   "heard": 7,
   "words": 7,
   "error_s": 1.28,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Out what was wrong with Mordecai",
   "heard": 6,
   "words": 6,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He went to the city square",
   "heard": 6,
   "words": 6,
   "error_s": 1.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Before the gate of the king",
   "heard": 6,
   "words": 6,
   "error_s": 1.32,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Mordecai told him everything",
   "heard": 4,
   "words": 4,
   "error_s": 1.33,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "That had happened to him",
   "heard": 5,
   "words": 5,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The silver for the Jews to die",
   "heard": 7,
   "words": 7,
   "error_s": 1.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A copy of the decree",
   "heard": 5,
   "words": 5,
   "error_s": 0.95,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Go to the king and plead",
   "heard": 6,
   "words": 6,
   "error_s": 0.55,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Beg for her people",
   "heard": 4,
   "words": 4,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hathach returned with the words",
   "heard": 5,
   "words": 5,
   "error_s": 6.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He reported all to Esther",
   "heard": 5,
   "words": 5,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She told him to take the reply",
   "heard": 7,
   "words": 7,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Back to Mordecai again",
   "heard": 4,
   "words": 4,
   "error_s": 0.25,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "All the servants know the law",
   "heard": 6,
   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you go in unsummoned",
   "heard": 5,
   "words": 5,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "There is but one law is death",
   "heard": 7,
   "words": 7,
   "error_s": 0.16,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Unless the king extends his hand",
   "heard": 6,
   "words": 6,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The silver for the Jews to die",
   "heard": 7,
   "words": 7,
   "error_s": 2.49,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A copy of the decree",
   "heard": 5,
   "words": 5,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Go to the king and plead",
   "heard": 6,
   "words": 6,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Beg for her people",
   "heard": 4,
   "words": 4,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Esther had not been called",
   "heard": 5,
   "words": 5,
   "error_s": 1.95,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For thirty days now",
   "heard": 4,
   "words": 4,
   "error_s": 1.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But Mordecai sent back his charge",
   "heard": 6,
   "words": 6,
   "error_s": 1.54,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Do not think you will escape",
   "heard": 6,
   "words": 6,
   "error_s": 2.24,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "If you keep silent now",
   "heard": 5,
   "words": 5,
   "error_s": 1.74,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Deliverance comes from another place",
   "heard": 5,
   "words": 5,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You and your father's house will perish",
   "heard": 7,
   "words": 7,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Who knows what is to be",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Perhaps you have come to the throne",
   "heard": 7,
   "words": 7,
   "error_s": 1.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For just such a time as this",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  }
 ],
