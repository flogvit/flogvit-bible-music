 "words": 176,
 "lines": [
  {
   "text": "The Most High is to be feared,",
   "heard": 7,
   "words": 7,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A great King over all the earth.",
   "heard": 7,
   "words": 7,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He subdues peoples under us,",
   "heard": 5,
   "words": 5,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nations beneath our feet.",
   "heard": 4,
   "words": 4,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He chooses our inheritance,",
   "heard": 4,
   "words": 4,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The pride of Jacob, whom he loves.",
   "heard": 7,
   "words": 7,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sing praises to God, sing praises!",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sing praises to our King, sing praises!",
   "heard": 7,
   "words": 7,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For God is King of all the earth,",
   "heard": 8,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sing praises with a skillful song.",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God has ascended amid shouts,",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD amid the blast of the horn.",
   "heard": 8,
   "words": 8,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Joy fills the air in celebration,",
   "heard": 6,
   "words": 6,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The trumpet calls the faithful on.",
   "heard": 6,
   "words": 6,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sing praises to God, sing praises!",
