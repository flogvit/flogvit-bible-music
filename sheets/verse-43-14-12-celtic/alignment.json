 "words": 215,
 "lines": [
  {
   "text": "Have I been with you all this time",
   "heard": 8,
   "words": 8,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And you still do not know me",
   "heard": 7,
   "words": 7,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever has seen me has seen the Father",
   "heard": 8,
   "words": 8,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How can you ask to see Him",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do you not believe I am in the Father",
   "heard": 9,
   "words": 9,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the Father is in me",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The words I speak are not my own",
   "heard": 8,
   "words": 8,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Father living in me does His works",
   "heard": 8,
   "words": 8,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I tell you the truth",
   "heard": 5,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever believes in me",
   "heard": 4,
   "words": 4,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will do the works I am doing",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And will do even greater things",
   "heard": 6,
   "words": 6,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Because I am going to the Father",
   "heard": 7,
   "words": 7,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whatever you ask in my name",
   "heard": 6,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will do it for the Father",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "So that He may be glorified in the Son",
   "heard": 9,
   "words": 9,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you ask me anything in my name",
   "heard": 8,
   "words": 8,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will do it",
   "heard": 4,
   "words": 4,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you love me you will keep my commandments",
   "heard": 9,
   "words": 9,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I tell you the truth",
   "heard": 5,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever believes in me",
   "heard": 4,
   "words": 4,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will do the works I am doing",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And will do even greater things",
   "heard": 6,
   "words": 6,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Because I am going to the Father",
   "heard": 7,
   "words": 7,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Believe me when I say I am in the Father",
   "heard": 10,
   "words": 10,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the Father is in me",
   "heard": 6,
