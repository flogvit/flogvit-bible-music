   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lamech sang to Adah and Zillah",
   "heard": 5,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hear my voice and listen close",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I killed a man for wounding me",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A young man for his slight abuse",
