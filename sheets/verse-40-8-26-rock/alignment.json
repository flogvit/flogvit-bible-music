 "lines": [
  {
   "text": "The boat is tossed upon the deep",
   "heard": 7,
   "words": 7,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The waves are rising, fierce and steep",
   "heard": 7,
   "words": 7,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Disciples wake the sleeping man",
   "heard": 5,
   "words": 5,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lord, save us from the storming span",
   "heard": 7,
   "words": 7,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why are you afraid, you of little faith",
   "heard": 8,
   "words": 8,
   "error_s": 0.49,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "He rebuked the winds, He stilled the sway",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sea obeyed His mighty word",
   "heard": 4,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A great calm came to shore",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They watched Him rise with power unseen",
   "heard": 7,
   "words": 7,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The violent wind was driven clean",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sea lay still under His command",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No longer fearing where they stand",
   "heard": 6,
   "words": 6,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why are you afraid, you of little faith",
