 "lines": [
  {
   "text": "Long ago God spoke to fathers",
   "heard": 6,
   "words": 6,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In many ways through the prophets",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But in these last days",
   "heard": 5,
   "words": 5,
   "error_s": 1.09,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He has spoken to us by his Son",
   "heard": 8,
   "words": 8,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whom he appointed heir of all things",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And through whom he made the ages",
   "heard": 7,
   "words": 7,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now the truth is clear",
   "heard": 5,
   "words": 5,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Son is the radiance of God's glory",
   "heard": 8,
   "words": 8,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The exact imprint of his being",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
