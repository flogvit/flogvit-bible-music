{
 "id": "story-samsons-seier-og-dod-metal",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-samsons-seier-og-dod-metal",
 "offset_seconds": 0.0,
 "words_heard": 105,
 "words": 127,
 "lines": [
  {
   "text": "They put out my eyes and bound me in bronze",
   "heard": 9,
   "words": 10,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Grinding at the mill in the prison of Gaza",
   "heard": 9,
   "words": 9,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My hair began to grow again",
   "heard": 6,
   "words": 6,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "While they feasted to their god Dagon",
   "heard": 7,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Lord God, remember me",
   "heard": 4,
   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Strengthen me only this once",
   "heard": 5,
   "words": 5,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Let me die with the Philistines",
   "heard": 6,
   "words": 6,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Lord God, remember me",
   "heard": 4,
   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They called me out to make them sport",
   "heard": 8,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Three thousand on the roof to watch",
   "heard": 7,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A boy led me by the hand",
   "heard": 6,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Let me feel the pillars where the house stands",
   "heard": 9,
   "words": 9,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Lord God, remember me",
   "heard": 4,
   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Strengthen me only this once",
   "heard": 5,
   "words": 5,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Let me die with the Philistines",
   "heard": 6,
   "words": 6,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Lord God, remember me",
   "heard": 4,
   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I grasped the two middle pillars",
   "heard": 0,
   "words": 6,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "One with my right hand, one with my left",
   "heard": 1,
   "words": 9,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I bowed with all my might",
   "heard": 0,
   "words": 6,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And the house fell down",
   "heard": 5,
   "words": 5,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  }
 ],
