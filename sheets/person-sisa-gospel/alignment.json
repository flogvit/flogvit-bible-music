 "lines": [
  {
   "text": "Israel cried out to the Lord in distress",
   "heard": 8,
   "words": 8,
   "error_s": 4.51,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Oppressed for twenty years by iron chariots",
   "heard": 7,
   "words": 7,
   "error_s": 3.87,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Sisera commanded the army of Jabin",
   "heard": 6,
   "words": 6,
   "error_s": 2.62,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Cruelty ruled from Hazor to the plain",
   "heard": 7,
   "words": 7,
   "error_s": 1.76,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Deborah called Barak to Mount Tabor",
   "heard": 3,
   "words": 6,
   "error_s": 0.61,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Ten thousand men from Zebulun and Naphtali",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The Lord would draw Sisera to Kishon",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And give the enemy into their hand",
   "heard": 7,
   "words": 7,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sisera fled on foot in the night",
   "heard": 7,
   "words": 7,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the tent of Jael the Kenite",
   "heard": 4,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She said turn aside and do not fear",
   "heard": 8,
   "words": 8,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And covered him with a blanket",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He asked for water but got milk",
   "heard": 7,
   "words": 7,
   "error_s": 3.03,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "In a bowl fit for a prince",
   "heard": 7,
   "words": 7,
   "error_s": 2.38,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "But her hand reached for the tent peg",
   "heard": 7,
   "words": 8,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And her right hand for the hammer",
   "heard": 7,
   "words": 7,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sisera fled on foot in the night",
   "heard": 7,
   "words": 7,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the tent of Jael the Kenite",
   "heard": 4,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She said turn aside and do not fear",
   "heard": 8,
   "words": 8,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And covered him with a blanket",
   "heard": 6,
   "words": 6,
   "error_s": 1.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "She struck Sisera and crushed his head",
   "heard": 7,
   "words": 7,
   "error_s": 2.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shattered and pierced his temple",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At her feet he sank and fell",
   "heard": 7,
   "words": 7,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And there he lay dead",
   "heard": 5,
   "words": 5,
   "error_s": 1.63,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Sisera fled on foot in the night",
   "heard": 7,
   "words": 7,
   "error_s": 2.78,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To the tent of Jael the Kenite",
   "heard": 5,
   "words": 7,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She said turn aside and do not fear",
   "heard": 8,
   "words": 8,
   "error_s": 0.76,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "And covered him with a blanket",
   "heard": 6,
   "words": 6,
   "error_s": 1.25,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His mother looked through the window",
   "heard": 6,
   "words": 6,
   "error_s": 1.54,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Wailing why the chariot is late",
   "heard": 4,
   "words": 6,
   "error_s": 2.88,
   "tie_split": false,
   "uncertain": true
  }
