   "uncertain": false
  },
  {
   "text": "My hot anger will flare up that day",
   "heard": 7,
   "words": 8,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A great earthquake in the land",
