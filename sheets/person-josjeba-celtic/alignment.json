 "lines": [
  {
   "text": "When Athaliah saw her son was dead",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She rose up to destroy the royal line",
   "heard": 8,
   "words": 8,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The whole royal family fell under her hand",
   "heard": 8,
   "words": 8,
   "error_s": 0.47,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Seeking power, she did not spare a single son",
   "heard": 9,
   "words": 9,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But Jehosheba took the young child away",
   "heard": 6,
   "words": 7,
   "error_s": 44.07,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "She stole him from among the dying sons",
   "heard": 8,
   "words": 8,
   "error_s": 44.32,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "She hid him and his nurse in a bedroom",
   "heard": 9,
   "words": 9,
   "error_s": 44.92,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Out of Athaliah's sight, safe from the blade",
   "heard": 7,
   "words": 8,
   "error_s": 44.9,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He remained hidden with her in the house of the LORD",
   "heard": 0,
   "words": 11,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For six long years while Athaliah reigned",
   "heard": 0,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jehoiada the priest kept the secret close",
   "heard": 0,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Preserving the seed of David in the temple's shadow",
   "heard": 0,
   "words": 9,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But Jehosheba took the young child away",
