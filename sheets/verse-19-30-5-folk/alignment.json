 "lines": [
  {
   "text": "I was lifted from the deep place",
   "heard": 7,
   "words": 7,
   "error_s": 3.91,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You did not let them gloat",
   "heard": 6,
   "words": 6,
   "error_s": 3.99,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I cried out for your help",
   "heard": 6,
   "words": 6,
   "error_s": 3.96,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And you healed my broken soul",
   "heard": 6,
   "words": 6,
   "error_s": 4.0,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You brought me from the dead",
   "heard": 6,
   "words": 6,
   "error_s": 3.89,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Kept me alive from the pit",
   "heard": 6,
   "words": 6,
   "error_s": 3.33,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "I stand here by your grace",
   "heard": 6,
   "words": 6,
   "error_s": 1.16,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Your mercy is my only light",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sing to the Lord his faithful ones",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give thanks to his holy name",
   "heard": 6,
   "words": 6,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His anger lasts but a moment",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His favor a lifetime",
   "heard": 4,
   "words": 4,
   "error_s": 1.58,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Weeping may spend the night",
   "heard": 5,
   "words": 5,
   "error_s": 2.56,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But joy comes in the morning",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The darkness fades away",
   "heard": 4,
   "words": 4,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When the light starts returning",
   "heard": 5,
   "words": 5,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sing to the Lord his faithful ones",
   "heard": 7,
   "words": 7,
   "error_s": 1.11,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Give thanks to his holy name",
   "heard": 6,
   "words": 6,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His anger lasts but a moment",
   "heard": 6,
   "words": 6,
