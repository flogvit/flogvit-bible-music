 "lines": [
  {
   "text": "Solomon had twelve district governors over all Israel",
   "heard": 8,
   "words": 8,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who supplied provisions for the king and his household",
   "heard": 9,
   "words": 9,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Each one was responsible for one month of the year",
   "heard": 10,
   "words": 10,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the hill country of Ephraim Ben-Hur stood",
   "heard": 6,
   "words": 8,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ben-Deker in Makaz and Shaalbim",
   "heard": 3,
   "words": 5,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ben-Hesed in Arubboth and the land of Hepher",
   "heard": 5,
   "words": 8,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ben-Abinadab in all of Naphath Dor",
   "heard": 5,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Baana son of Ahilud in Taanach and Megiddo",
   "heard": 8,
   "words": 8,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Geber son of Uri in the land of Gilead",
   "heard": 8,
   "words": 9,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The country of Sihon king of the Amorites",
   "heard": 8,
