 "words": 145,
 "lines": [
  {
   "text": "Make everyone go out from me",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And no one stayed with him",
   "heard": 6,
   "words": 6,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He wept so loudly that Egypt heard",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am Joseph, is my father still alive",
   "heard": 8,
   "words": 8,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His brothers could not answer him",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They were dismayed at his presence",
   "heard": 6,
   "words": 6,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come near to me, please, he said",
   "heard": 7,
   "words": 7,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am your brother whom you sold into Egypt",
   "heard": 9,
   "words": 9,
   "error_s": 0.28,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Do not be distressed or angry with yourselves",
   "heard": 8,
   "words": 8,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God sent me before you to preserve life",
   "heard": 8,
   "words": 8,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You meant evil against me",
   "heard": 5,
   "words": 5,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But God meant it for good",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So it was not you who sent me here, but God",
   "heard": 11,
   "words": 11,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He has made me a father to Pharaoh",
   "heard": 8,
   "words": 8,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hurry and go up to my father",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And tell him, come down to me, do not tarry",
   "heard": 10,
   "words": 10,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be distressed or angry with yourselves",
   "heard": 8,
