{
 "id": "person-usai-choral",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-usai-choral",
 "offset_seconds": 1.0799999999997212,
 "words_heard": 145,
 "words": 148,
 "lines": [
  {
   "text": "Uzai raised up a son called Hananiah",
   "heard": 7,
   "words": 7,
   "error_s": 5.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He joined the men to build up the wall",
   "heard": 9,
   "words": 9,
   "error_s": 5.55,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The gates were set and the bars were placed",
   "heard": 9,
   "words": 9,
   "error_s": 5.56,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "We worked in the dust as we heard it called",
   "heard": 10,
   "words": 10,
   "error_s": 5.84,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Uzai the goldsmith worked with care",
   "heard": 6,
   "words": 6,
   "error_s": 6.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Hananiah the perfumer stood there",
   "heard": 5,
   "words": 5,
   "error_s": 6.91,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They restored the wall to the Broad Wall side",
   "heard": 9,
   "words": 9,
   "error_s": 6.92,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Next to Rephaiah and the people who stayed",
   "heard": 8,
   "words": 8,
   "error_s": 7.18,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Sanballat and Tobiah were furious",
   "heard": 5,
   "words": 5,
   "error_s": 7.68,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Ammonites and Arabs were furious",
   "heard": 6,
   "words": 6,
   "error_s": 8.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They conspired to throw it into confusion",
   "heard": 7,
   "words": 7,
   "error_s": 9.09,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But we posted a guard day and night",
   "heard": 8,
   "words": 8,
   "error_s": 9.12,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The laborers said our strength is failing",
   "heard": 7,
   "words": 7,
   "error_s": 9.97,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Too much rubble and we cannot rebuild",
   "heard": 7,
   "words": 7,
   "error_s": 9.95,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But we prayed to our God and we warned",
   "heard": 9,
   "words": 9,
   "error_s": 10.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "We kept working though our enemies were stern",
   "heard": 8,
   "words": 8,
   "error_s": 10.73,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The wall was finished in fifty-two days",
   "heard": 6,
   "words": 7,
   "error_s": 11.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The nations around us were afraid",
   "heard": 6,
   "words": 6,
   "error_s": 11.75,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Uzai\u2019s son helped close up the gaps",
   "heard": 5,
   "words": 7,
   "error_s": 11.94,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "We finished the work of the city walls",
   "heard": 8,
   "words": 8,
   "error_s": 12.19,
   "tie_split": false,
   "uncertain": true
  }
 ],
