 "lines": [
  {
   "text": "Awake Lord why do you sleep",
   "heard": 6,
   "words": 6,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rouse yourself from your rest",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not reject us forever",
   "heard": 5,
   "words": 5,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keep us in your sight",
   "heard": 5,
   "words": 5,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why hide your face away",
   "heard": 5,
   "words": 5,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Forget our deep distress",
   "heard": 4,
   "words": 4,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Our soul is sunk to dust",
   "heard": 6,
   "words": 6,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Our body clings to ground",
   "heard": 5,
   "words": 5,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rise up and help us now",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Redeem us in your love",
   "heard": 5,
   "words": 5,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
