  {
   "text": "Du som strever, du som b\u00e6rer",
   "heard": 6,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "byrder tunge, dag og natt",
   "heard": 5,
   "words": 5,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "H\u00f8r hvor Jesus kaller p\u00e5 deg",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "du er ikke glemt og satt",
   "heard": 6,
   "words": 6,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Kom til meg, alle dere som strever",
   "heard": 7,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og b\u00e6rer tunge byrder",
   "heard": 4,
   "words": 4,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og jeg vil gi dere hvile",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "kom til meg",
   "heard": 3,
   "words": 3,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ta mitt \u00e5k og l\u00e6r av meg",
   "heard": 6,
   "words": 7,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "for jeg er mild og ydmyk av hjertet",
   "heard": 6,
   "words": 8,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Dere skal finne hvile for deres sjeler",
   "heard": 7,
   "words": 7,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
