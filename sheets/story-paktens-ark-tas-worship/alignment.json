{
 "id": "story-paktens-ark-tas-worship",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-paktens-ark-tas-worship",
 "offset_seconds": -4.080000000000169,
 "words_heard": 249,
 "words": 252,
 "lines": [
  {
   "text": "Israel marched out to meet the Philistines",
   "heard": 7,
   "words": 7,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They camped at Ebenezer in the dust",
   "heard": 7,
   "words": 7,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The battle was joined and Israel fell",
   "heard": 6,
   "words": 7,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Four thousand men struck down on the field",
   "heard": 6,
   "words": 8,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The elders asked why the LORD let us fall",
   "heard": 9,
   "words": 9,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bring the ark from Shiloh to our camp",
   "heard": 8,
   "words": 8,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It came with a shout that shook the earth",
   "heard": 9,
   "words": 9,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Philistines feared what they heard in the dark",
   "heard": 9,
   "words": 9,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The glory has departed from Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The ark of God is captured by the foe",
   "heard": 9,
   "words": 9,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hophni and Phinehas are no more",
   "heard": 6,
   "words": 6,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The mighty shield of our nation is gone",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "A man of Benjamin ran to the gate",
   "heard": 8,
   "words": 8,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His clothes were torn and dirt on his head",
   "heard": 9,
   "words": 9,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Eli sat by the road with trembling heart",
   "heard": 8,
   "words": 8,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He heard the outcry of the city's grief",
   "heard": 8,
   "words": 8,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Eli was old and his eyes were dim",
   "heard": 8,
   "words": 8,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He asked the messenger what had gone wrong",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The news of defeat came heavy and hard",
   "heard": 8,
   "words": 8,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Two sons are dead and the ark is lost",
   "heard": 9,
   "words": 9,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The glory has departed from Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The ark of God is captured by the foe",
   "heard": 9,
   "words": 9,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hophni and Phinehas are no more",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The mighty shield of our nation is gone",
   "heard": 8,
   "words": 8,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He fell backward off his seat by the gate",
   "heard": 9,
   "words": 9,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His neck was broken and he died that day",
   "heard": 9,
   "words": 9,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He had led Israel for forty years",
   "heard": 7,
   "words": 7,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But now his life was cut short and gone",
   "heard": 9,
   "words": 9,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her son was born as her breath was leaving",
   "heard": 9,
   "words": 9,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She named him Ichabod in her pain",
   "heard": 7,
   "words": 7,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The glory has departed from Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The ark of God has been captured away",
   "heard": 8,
   "words": 8,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  }
 ],
