 "words": 159,
 "lines": [
  {
   "text": "For they loved human glory more",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Than the glory of God",
   "heard": 5,
   "words": 5,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then Jesus cried out",
   "heard": 4,
   "words": 4,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever believes in me",
   "heard": 4,
   "words": 4,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Does not believe in me",
   "heard": 5,
   "words": 5,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But in him who sent me",
   "heard": 6,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have come into the world as light",
   "heard": 8,
   "words": 8,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So that no one who believes in me",
   "heard": 8,
   "words": 8,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Should remain in darkness",
   "heard": 4,
   "words": 4,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And if anyone hears my words",
   "heard": 6,
   "words": 6,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And does not keep them",
   "heard": 5,
   "words": 5,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I do not judge him",
   "heard": 5,
   "words": 5,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For I did not come to judge the world",
   "heard": 9,
   "words": 9,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But to save the world",
   "heard": 5,
   "words": 5,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have come into the world as light",
   "heard": 8,
   "words": 8,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So that no one who believes in me",
   "heard": 8,
   "words": 8,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Should remain in darkness",
   "heard": 4,
   "words": 4,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever rejects me",
   "heard": 3,
   "words": 3,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And does not receive my words",
   "heard": 6,
   "words": 6,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Already has a judge",
   "heard": 4,
   "words": 4,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The very word I have spoken",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will judge him on the last day",
   "heard": 7,
   "words": 7,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have come into the world as light",
   "heard": 8,
   "words": 8,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So that no one who believes in me",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Should remain in darkness",
   "heard": 4,
   "words": 4,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have not spoken on my own authority",
   "heard": 8,
   "words": 8,
   "error_s": 0.59,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The Father has commanded me",
   "heard": 5,
   "words": 5,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  }
