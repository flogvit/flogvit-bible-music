 "words": 250,
 "lines": [
  {
   "text": "Jericho was shut up tight",
   "heard": 5,
   "words": 5,
   "error_s": 4.08,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "No one out and no one in",
   "heard": 7,
   "words": 7,
   "error_s": 4.0,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Walls so high and gates so strong",
   "heard": 7,
   "words": 7,
   "error_s": 3.94,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "How could Israel ever win",
   "heard": 5,
   "words": 5,
   "error_s": 4.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But the LORD said to Joshua",
   "heard": 6,
   "words": 6,
   "error_s": 4.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "See, I give this town to you",
   "heard": 7,
   "words": 7,
   "error_s": 3.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "March around it, trust in me",
   "heard": 5,
   "words": 6,
   "error_s": 3.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "That is all you have to do",
   "heard": 7,
   "words": 7,
   "error_s": 3.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "March, march, round and round",
   "heard": 5,
   "words": 5,
   "error_s": 2.92,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Ram's horn trumpets make a sound",
   "heard": 6,
   "words": 6,
   "error_s": 3.32,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "One, two, three, four, five, six, seven",
   "heard": 7,
   "words": 7,
   "error_s": 3.23,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shout to the LORD, the God of heaven",
   "heard": 8,
   "words": 8,
   "error_s": 3.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Day one, day two, round we go",
   "heard": 7,
   "words": 7,
   "error_s": 3.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Feet go stamping, nice and slow",
   "heard": 6,
   "words": 6,
   "error_s": 3.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Not a word and not a cheer",
   "heard": 7,
   "words": 7,
   "error_s": 3.23,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Only trumpets loud and clear",
   "heard": 5,
   "words": 5,
   "error_s": 3.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Day three, day four, five and six",
   "heard": 7,
   "words": 7,
   "error_s": 2.9,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Once around and back to camp",
   "heard": 6,
   "words": 6,
   "error_s": 3.2,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Quiet mouths and listening ears",
   "heard": 5,
   "words": 5,
   "error_s": 3.19,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Stamp, stamp, stamp, stamp",
