   "words": 9,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The crowds were amazed by what they saw",
   "heard": 8,
   "words": 8,
   "error_s": 0.51,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Could this be the Son of David?",
   "heard": 7,
   "words": 7,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
