{
 "id": "person-sjobak-soul",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-sjobak-soul",
 "offset_seconds": 10.639999999999517,
 "words_heard": 254,
 "words": 264,
 "lines": [
  {
   "text": "The Arameans saw they had been defeated",
   "heard": 7,
   "words": 7,
   "error_s": 11.9,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They regrouped in the shadow of the field",
   "heard": 8,
   "words": 8,
   "error_s": 12.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Hadadezer sent out his messengers",
   "heard": 4,
   "words": 5,
   "error_s": 12.41,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To pull the soldiers from beyond the river",
   "heard": 8,
   "words": 8,
   "error_s": 12.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They came to Helam in a heavy line",
   "heard": 7,
   "words": 8,
   "error_s": 12.03,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With Shobach leading them, commander of the fight",
   "heard": 6,
   "words": 8,
   "error_s": 12.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "When David was told of this new threat",
   "heard": 8,
   "words": 8,
   "error_s": 12.32,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He gathered all Israel, strong and set",
   "heard": 6,
   "words": 7,
   "error_s": 12.23,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Crossed the Jordan to meet them face to face",
   "heard": 9,
   "words": 9,
   "error_s": 12.21,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Arameans drew up their lines in place",
   "heard": 6,
   "words": 8,
   "error_s": 12.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shobach fell where the battle raged",
   "heard": 6,
   "words": 6,
   "error_s": 11.63,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Struck down by the hand of David's might",
   "heard": 8,
   "words": 8,
   "error_s": 11.73,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He died there in the dust and the blood",
   "heard": 9,
   "words": 9,
   "error_s": 11.72,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The commander of their army, no more stood",
   "heard": 8,
   "words": 8,
   "error_s": 11.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Arameans fled before Israel's power",
   "heard": 6,
   "words": 6,
   "error_s": 10.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And the vassal kings bowed to the hour",
   "heard": 8,
   "words": 8,
   "error_s": 10.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Seven hundred charioteers were slain",
   "heard": 5,
   "words": 5,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Forty thousand horsemen gone in vain",
   "heard": 6,
   "words": 6,
   "error_s": 7.94,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The resistance broke, the fear was deep",
   "heard": 7,
   "words": 7,
   "error_s": 8.06,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The kings who served Hadadezer had to sleep",
   "heard": 7,
   "words": 8,
   "error_s": 8.63,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They made peace with the people of the land",
   "heard": 9,
   "words": 9,
   "error_s": 7.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Subject now to a foreign hand",
   "heard": 6,
   "words": 6,
   "error_s": 8.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The fear took hold, they dared not stand",
   "heard": 8,
   "words": 8,
   "error_s": 8.62,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To help the Ammonites across the land",
   "heard": 7,
   "words": 7,
   "error_s": 8.99,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The alliance broke, the war was done",
   "heard": 7,
   "words": 7,
   "error_s": 7.6,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Under the rule of the chosen son",
   "heard": 7,
   "words": 7,
   "error_s": 7.56,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shobach fell where the battle raged",
   "heard": 5,
   "words": 6,
   "error_s": 6.61,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Struck down by the hand of David's might",
   "heard": 8,
   "words": 8,
   "error_s": 5.71,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "He died there in the dust and the blood",
   "heard": 9,
   "words": 9,
   "error_s": 6.0,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The commander of their army, no more stood",
   "heard": 8,
   "words": 8,
   "error_s": 6.61,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Arameans fled before Israel's power",
   "heard": 6,
   "words": 6,
   "error_s": 6.52,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And the vassal kings bowed to the hour",
   "heard": 8,
   "words": 8,
   "error_s": 5.32,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "No longer willing to help the foe",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The army of Hadadezer is low",
   "heard": 6,
   "words": 6,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shobach is gone, the battle is past",
   "heard": 6,
   "words": 7,
   "error_s": 2.48,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Only the truth of this day will last",
   "heard": 8,
   "words": 8,
   "error_s": 1.96,
   "tie_split": false,
   "uncertain": true
  }
