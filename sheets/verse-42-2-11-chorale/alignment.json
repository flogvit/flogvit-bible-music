 "words": 97,
 "lines": [
  {
   "text": "The shepherds watched out in the fields",
   "heard": 7,
   "words": 7,
   "error_s": 1.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Their flock through all the night",
   "heard": 6,
   "words": 6,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "An angel of the Lord appeared",
   "heard": 6,
   "words": 6,
   "error_s": 1.2,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And glory shone so bright",
   "heard": 5,
   "words": 5,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be afraid, I bring you joy",
   "heard": 8,
   "words": 8,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Good news for all the earth",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Today in David's town is born",
   "heard": 6,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A Savior, Christ the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And this will be the sign for you",
   "heard": 8,
   "words": 8,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A baby wrapped and laid",
   "heard": 5,
   "words": 5,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Within a manger, and the host",
   "heard": 5,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of heaven sang and praised",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Glory to God in the highest",
   "heard": 6,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And peace on earth tonight",
   "heard": 5,
   "words": 5,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To those on whom his favor rests",
   "heard": 7,
   "words": 7,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sing all, sing in the light",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  }
 ],
