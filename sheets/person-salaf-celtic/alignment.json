   "words": 6,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the long and living age",
   "heard": 6,
   "words": 6,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "After he became the father of Eber",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shelah lived four hundred and three years",
   "heard": 3,
   "words": 7,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And had other sons and daughters",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
