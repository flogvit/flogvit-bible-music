 "lines": [
  {
   "text": "From the sons of Joseph came a line",
   "heard": 8,
   "words": 8,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ephraim stood with heart and mind",
   "heard": 6,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ammihud named, his father was",
   "heard": 5,
   "words": 5,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Elishama led the chosen class",
   "heard": 5,
   "words": 5,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Elishama son of Ammihud",
