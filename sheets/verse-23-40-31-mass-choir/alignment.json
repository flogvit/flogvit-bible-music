 "words": 135,
 "lines": [
  {
   "text": "Have you not known, have you not heard",
   "heard": 8,
   "words": 8,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The everlasting God, the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He does not faint, he does not grow weary",
   "heard": 9,
   "words": 9,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His understanding is unsearchable",
   "heard": 4,
   "words": 4,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He gives power to the faint",
   "heard": 6,
   "words": 6,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And to the one with no might he increases strength",
   "heard": 9,
   "words": 10,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Even the young shall faint and be weary",
   "heard": 8,
   "words": 8,
   "error_s": 0.25,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "And the young men shall fall exhausted",
   "heard": 7,
   "words": 7,
   "error_s": 1.11,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But they who wait for the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 1.21,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shall renew their strength",
   "heard": 4,
   "words": 4,
   "error_s": 1.11,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They shall mount up with wings like eagles",
   "heard": 8,
   "words": 8,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They shall run and not be weary",
   "heard": 7,
   "words": 7,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They shall walk and not faint",
   "heard": 6,
   "words": 6,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Wait on the Lord, wait on the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Wings like eagles, wings like eagles",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But they who wait for the Lord",
   "heard": 6,
