 "lines": [
  {
   "text": "How long must I carry worries within me",
   "heard": 8,
   "words": 8,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With grief in my heart all the day",
   "heard": 8,
   "words": 8,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How long will my enemy triumph over me",
   "heard": 8,
   "words": 8,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Casting a shadow across my way",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look at me and answer, LORD my God",
   "heard": 8,
   "words": 8,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give light to my eyes before the dark takes hold",
   "heard": 10,
   "words": 10,
   "error_s": 1.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But I trust in your steadfast love",
   "heard": 7,
   "words": 7,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My heart rejoices in your salvation",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will sing to the LORD",
   "heard": 6,
   "words": 6,
   "error_s": 1.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For he has dealt bountifully with me",
   "heard": 7,
   "words": 7,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I feared I would sleep the sleep of death",
   "heard": 9,
   "words": 9,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
