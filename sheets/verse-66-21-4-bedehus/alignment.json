 "words": 94,
 "lines": [
  {
   "text": "Jeg h\u00f8rte en r\u00f8st fra tronen",
   "heard": 6,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Se, Guds bolig er hos oss",
   "heard": 5,
   "words": 6,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han skal bo hos sine egne",
   "heard": 6,
   "words": 6,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og de skal v\u00e6re hans folk",
   "heard": 6,
   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han skal t\u00f8rke bort hver t\u00e5re",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "fra v\u00e5re \u00f8yne der",
   "heard": 4,
   "words": 4,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Og d\u00f8den skal ikke v\u00e6re mer",
   "heard": 6,
   "words": 6,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "heller ikke sorg og smerte mer",
   "heard": 6,
   "words": 6,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "N\u00e5r jeg g\u00e5r min siste vandring",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og min reise her er slutt",
   "heard": 6,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Da skal jeg se ham som han er",
   "heard": 8,
   "words": 8,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og hjemme v\u00e6re hos min Gud",
   "heard": 6,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han skal t\u00f8rke bort hver t\u00e5re",
