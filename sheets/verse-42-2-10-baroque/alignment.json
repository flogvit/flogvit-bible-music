 "lines": [
  {
   "text": "There were shepherds abiding in the field",
   "heard": 7,
   "words": 7,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keeping watch over their flock by night",
   "heard": 7,
   "words": 7,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the angel of the Lord came upon them",
   "heard": 9,
   "words": 9,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the glory of the Lord shone round about them",
   "heard": 10,
   "words": 10,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fear not, for behold, I bring you good tidings",
   "heard": 9,
   "words": 9,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of great joy for all the people",
   "heard": 7,
   "words": 7,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For unto you is born this day in the city of David",
   "heard": 12,
   "words": 12,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A Savior, who is Christ the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Glory to God in the highest",
   "heard": 6,
   "words": 6,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
