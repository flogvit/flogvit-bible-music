 "words_heard": 132,
 "words": 134,
 "lines": [
  {
   "text": "I thought it needful now to send",
   "heard": 7,
   "words": 7,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My brother Epaphroditus back",
   "heard": 4,
   "words": 4,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A fellow worker and soldier friend",
   "heard": 6,
   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your messenger for my need",
   "heard": 5,
   "words": 5,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He longed for you with heavy heart",
   "heard": 7,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Distressed by news of his illness",
   "heard": 6,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He lay in pain, his life apart",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From breath and life in this world",
   "heard": 7,
   "words": 7,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Indeed he was ill near death",
   "heard": 6,
   "words": 6,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God showed mercy to him",
   "heard": 5,
   "words": 5,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And mercy to me from beneath",
   "heard": 6,
   "words": 6,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The weight of sorrow upon my mind",
   "heard": 5,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So I am eager to send him forth",
   "heard": 8,
   "words": 8,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That you may rejoice at sight",
   "heard": 6,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And ease the weight of my worth",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of sorrow lifted from the night",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Welcome him in the Lord with joy",
   "heard": 7,
   "words": 7,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hold such people in high honor",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He faced death for Christ's employ",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Risking life to help me more",
   "heard": 6,
   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He risked his life for the work of Christ",
   "heard": 9,
   "words": 9,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  }
 ],
