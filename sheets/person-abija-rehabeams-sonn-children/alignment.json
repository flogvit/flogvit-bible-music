 "lines": [
  {
   "text": "In the eighteenth year, Jeroboam reigned",
   "heard": 6,
   "words": 6,
   "error_s": 1.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Abijah became king over Judah",
   "heard": 5,
   "words": 5,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Three years he ruled from Jerusalem",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His mother was Maacah of Gibeah",
   "heard": 3,
   "words": 6,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "War broke out between the divided lands",
   "heard": 7,
   "words": 7,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jeroboam rose up in rebellion",
   "heard": 5,
   "words": 5,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD gave kingship to David",
   "heard": 6,
   "words": 6,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Forever, by a covenant of salt",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not fight against the God of Israel",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You cannot succeed in this battle",
   "heard": 6,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abijah stood on Mount Zemaraim",
   "heard": 4,
   "words": 5,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the hill country of Ephraim",
   "heard": 6,
   "words": 6,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He called out to all Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hear me, Jeroboam and the tribes",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You have golden calves for gods",
   "heard": 6,
   "words": 6,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You drove out the priests of Aaron",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD gave kingship to David",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Forever, by a covenant of salt",
   "heard": 5,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not fight against the God of Israel",
   "heard": 8,
   "words": 8,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You cannot succeed in this battle",
   "heard": 6,
   "words": 6,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We keep the charge of the LORD our God",
   "heard": 9,
   "words": 9,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Burnt offerings morning and evening",
   "heard": 5,
   "words": 5,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The priests serve with trumpets ready",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Sound the battle cry against you",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Four hundred thousand chosen men",
   "heard": 2,
   "words": 5,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Against eight hundred mighty warriors",
   "heard": 3,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Judah cried out to the LORD",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The priests blew the trumpets loud",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God struck down Jeroboam",
   "heard": 4,
   "words": 4,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Five hundred thousand men fell slain",
   "heard": 3,
   "words": 6,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD gave kingship to David",
