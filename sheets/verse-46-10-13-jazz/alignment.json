   "words": 6,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will not let you be tempted beyond what you can bear",
   "heard": 12,
   "words": 12,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
