 "words": 113,
 "lines": [
  {
   "text": "Lord, you have searched me and known me",
   "heard": 8,
   "words": 8,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You know when I sit down and when I rise",
   "heard": 10,
   "words": 10,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You discern my thoughts from far away",
   "heard": 7,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Before a word is on my tongue",
   "heard": 7,
   "words": 7,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You know it altogether",
   "heard": 3,
   "words": 4,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You knit me together in my mother's womb",
   "heard": 8,
   "words": 8,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am fearfully and wonderfully made",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where shall I go from your Spirit",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where shall I flee from your presence",
   "heard": 7,
   "words": 7,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If I ascend to heaven, you are there",
   "heard": 8,
   "words": 8,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If I make my bed in the depths, you are there",
   "heard": 9,
   "words": 11,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Even the darkness is not dark to you",
   "heard": 8,
   "words": 8,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You knit me together in my mother's womb",
   "heard": 8,
   "words": 8,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am fearfully and wonderfully made",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Search me, O God, and all my heart",
   "heard": 8,
   "words": 8,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  }
 ],
