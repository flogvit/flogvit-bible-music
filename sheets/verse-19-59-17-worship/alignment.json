   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then they will know",
   "heard": 4,
   "words": 4,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God rules over Jacob",
   "heard": 4,
   "words": 4,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the ends of the earth",
   "heard": 6,
   "words": 6,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They return at evening",
   "heard": 4,
   "words": 4,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Snarling like dogs",
   "heard": 3,
   "words": 3,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Prowling around the city",
   "heard": 3,
   "words": 4,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Roaming for food",
