 "lines": [
  {
   "text": "Eliel the Mahavite stood tall",
   "heard": 4,
   "words": 5,
   "error_s": 1.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Beside Jeribai and Joshaviah",
   "heard": 4,
   "words": 4,
   "error_s": 1.99,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Sons of Elnaam in the hall",
   "heard": 6,
   "words": 6,
   "error_s": 2.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With Ithmah the Moabite he stood",
   "heard": 6,
   "words": 6,
   "error_s": 1.65,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Mishmannah the fourth in the line",
   "heard": 5,
   "words": 6,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jeremiah the fifth by design",
   "heard": 5,
   "words": 5,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Hebron's son Eliel the chief",
   "heard": 3,
   "words": 5,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Eighty relatives stood to keep",
   "heard": 5,
   "words": 5,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mighty warriors, men of renown",
   "heard": 5,
   "words": 5,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heads of their fathers' houses down",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Serving David with faith and might",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the wilderness they took their flight",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Summoned priests Zadok and Abiathar",
   "heard": 3,
   "words": 5,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Levites Uriel, Asaiah, near",
   "heard": 3,
   "words": 4,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Joel, Shemaiah, and Eliel",
