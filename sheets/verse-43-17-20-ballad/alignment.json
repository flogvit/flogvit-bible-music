   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That you sent me, and this is won",
   "heard": 8,
   "words": 8,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I in them and you in me",
   "heard": 7,
   "words": 7,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Brought to complete unity",
