   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "A city set on a hill cannot be hidden",
   "heard": 9,
   "words": 9,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shine, shine, shine",
   "heard": 3,
   "words": 3,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Help your friend, share your bread",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Say a kind word, like Jesus said",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
