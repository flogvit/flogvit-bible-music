 "lines": [
  {
   "text": "A priest named Zechariah served the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 10.66,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His wife Elizabeth from Aaron's line",
   "heard": 6,
   "words": 6,
   "error_s": 10.05,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Righteous and blameless in all their ways",
   "heard": 7,
   "words": 7,
   "error_s": 9.24,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Yet barren and advanced in years",
   "heard": 6,
   "words": 6,
   "error_s": 8.57,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "No child came to fill their home",
   "heard": 7,
   "words": 7,
   "error_s": 5.82,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Waiting on God in silent prayer",
   "heard": 6,
   "words": 6,
   "error_s": 6.34,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Blessed are you among women",
   "heard": 5,
   "words": 5,
   "error_s": 5.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Blessed is the fruit of your womb",
   "heard": 7,
   "words": 7,
   "error_s": 7.2,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The child leaped for joy inside",
   "heard": 6,
   "words": 6,
   "error_s": 6.54,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Filled with the Holy Spirit now",
   "heard": 6,
   "words": 6,
   "error_s": 2.67,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Blessed is she who believed",
   "heard": 5,
   "words": 5,
   "error_s": 3.42,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "That what the Lord said would be true",
   "heard": 8,
   "words": 8,
   "error_s": 4.86,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The angel stood by the altar side",
   "heard": 7,
   "words": 7,
   "error_s": 1.69,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Saying do not be afraid Zechariah",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Your prayer has been heard at last",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your wife will bear a son to you",
   "heard": 8,
   "words": 8,
   "error_s": 1.0,
   "tie_split": true,
   "uncertain": false
  },
  {
