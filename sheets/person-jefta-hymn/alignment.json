{
 "id": "person-jefta-hymn",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-jefta-hymn",
 "offset_seconds": -3.9200000000001722,
 "words_heard": 229,
 "words": 230,
 "lines": [
  {
   "text": "Jephthah the Gileadite was a mighty warrior",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the son of a prostitute in that land",
   "heard": 9,
   "words": 9,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His brothers drove him out of the father's house",
   "heard": 9,
   "words": 9,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Saying you are the son of another woman",
   "heard": 8,
   "words": 8,
   "error_s": 0.41,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "He fled to the land of Tob among outcasts",
   "heard": 9,
   "words": 9,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where worthless men gathered around him",
   "heard": 6,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When Ammon made war upon Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The elders of Gilead sought him out",
   "heard": 7,
   "words": 7,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They said come be our commander in battle",
   "heard": 8,
   "words": 8,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Jephthah asked why now in trouble",
   "heard": 7,
   "words": 7,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If the Lord gives the enemy into my hand",
   "heard": 9,
   "words": 9,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then I shall be your head in Gilead",
   "heard": 8,
   "words": 8,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He sent messengers to the king of Ammon",
   "heard": 8,
   "words": 8,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Arguing for the land of Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the king paid no heed to the message",
   "heard": 9,
   "words": 9,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So Jephthah made a vow to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If you give the Ammonites into my hand",
   "heard": 8,
   "words": 8,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever comes out shall belong to God",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He struck down twenty towns in the valley",
   "heard": 7,
   "words": 8,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A crushing blow that subdued the enemy",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When he came home to Mizpah in triumph",
   "heard": 8,
   "words": 8,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His daughter met him with tambourines and dance",
   "heard": 8,
   "words": 8,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She was his only child in this world",
   "heard": 8,
   "words": 8,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And he tore his clothes in deep sorrow",
   "heard": 8,
   "words": 8,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Oh my daughter you have brought me to my knees",
   "heard": 10,
   "words": 10,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have opened my mouth to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She said do to me as you have vowed",
   "heard": 9,
   "words": 9,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Grant me two months to weep on the hills",
   "heard": 9,
   "words": 9,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And so it became a custom in Israel",
   "heard": 8,
   "words": 8,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  }
 ],
