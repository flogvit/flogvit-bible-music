   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It is better that one man die",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the people than the whole nation perish",
   "heard": 7,
   "words": 8,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One man die for the people",
   "heard": 6,
   "words": 6,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
