 "lines": [
  {
   "text": "Hear this word, you cows of Bashan",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Living on Mount Samaria",
   "heard": 4,
   "words": 4,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You oppress the poor and crush the needy",
   "heard": 8,
   "words": 8,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Saying, Bring us something to drink",
   "heard": 6,
   "words": 6,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord GOD has sworn by his holiness",
   "heard": 7,
   "words": 8,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Days are coming upon you",
   "heard": 5,
   "words": 5,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will be carried off with hooks",
   "heard": 7,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The last of you with fishhooks",
   "heard": 6,
   "words": 6,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will go out through breaches in the wall",
   "heard": 6,
   "words": 9,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Each woman straight ahead of her",
   "heard": 6,
   "words": 6,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will be cast out toward Harmon",
   "heard": 6,
   "words": 7,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Declares the LORD, the end is near",
   "heard": 7,
   "words": 7,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  }
 ],
