   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And know all mysteries",
   "heard": 4,
   "words": 4,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But have no love to offer",
   "heard": 6,
   "words": 6,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am truly just nothing",
   "heard": 5,
   "words": 5,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Love is patient and kind",
