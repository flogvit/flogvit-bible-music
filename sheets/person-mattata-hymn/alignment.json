 "words": 157,
 "lines": [
  {
   "text": "The son of Melea, the son of Menna",
   "heard": 8,
   "words": 8,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The son of Mattatha, the son of Nathan",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A name held tight in the royal chain",
   "heard": 8,
   "words": 8,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A link within the blood and rain",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When your days are done and you rest",
   "heard": 8,
   "words": 8,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With your fathers in the dust and west",
   "heard": 8,
   "words": 8,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will raise up your offspring near",
   "heard": 7,
   "words": 7,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From your own body, clear and dear",
   "heard": 7,
   "words": 7,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is the one who builds a house",
   "heard": 8,
   "words": 8,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For my name, without a single doubt",
   "heard": 7,
   "words": 7,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will establish his throne",
   "heard": 5,
   "words": 5,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the garden of the bone and stone",
   "heard": 8,
   "words": 8,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will be a father to him",
   "heard": 7,
   "words": 7,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And he shall be a son to him",
   "heard": 8,
   "words": 8,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When he does wrong, I will discipline",
   "heard": 7,
   "words": 7,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With the rod of men, with a human line",
   "heard": 8,
   "words": 9,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But my steadfast love will never depart",
   "heard": 7,
   "words": 7,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As I took it from Saul, my heart",
   "heard": 8,
   "words": 8,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your house and kingdom endure before",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your throne is established once and for ever",
   "heard": 6,
   "words": 8,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The son of Adam, the son of God",
   "heard": 8,
   "words": 8,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  }
 ],
