 "words": 253,
 "lines": [
  {
   "text": "A man brought me to the east gate",
   "heard": 8,
   "words": 8,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The door was shut and sealed tight",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord spoke from the place of glory",
   "heard": 8,
   "words": 8,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No one shall pass through this sight",
   "heard": 7,
   "words": 7,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the God of Israel entered here",
   "heard": 7,
   "words": 7,
   "error_s": 1.4,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "He stayed within the holy room",
   "heard": 6,
   "words": 6,
   "error_s": 1.62,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Only the prince may sit inside",
   "heard": 6,
   "words": 6,
   "error_s": 1.54,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To eat bread before the throne",
   "heard": 6,
   "words": 6,
   "error_s": 1.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I am their inheritance",
   "heard": 4,
   "words": 4,
   "error_s": 1.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I am their possession",
   "heard": 4,
   "words": 4,
   "error_s": 1.51,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "No land in Israel given",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But my own blessing",
   "heard": 4,
   "words": 4,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He led me to the north gate",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The temple filled with glory light",
   "heard": 6,
   "words": 6,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I fell upon my face before him",
   "heard": 7,
   "words": 7,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And heard the command in the night",
   "heard": 7,
   "words": 7,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mark the entrances and exits",
   "heard": 5,
   "words": 5,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The laws of the house divine",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Enough of your abominations",
   "heard": 4,
   "words": 4,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You broke my covenant line",
   "heard": 5,
   "words": 5,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Foreigners entered the sanctuary",
   "heard": 4,
   "words": 4,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Profaning my holy ground",
   "heard": 4,
   "words": 4,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You did not keep my holy things",
   "heard": 7,
   "words": 7,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But let others be found",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am their inheritance",
   "heard": 4,
   "words": 4,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am their possession",
   "heard": 4,
   "words": 4,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No land in Israel given",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But my own blessing",
   "heard": 4,
   "words": 4,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Levites who went far from me",
   "heard": 6,
   "words": 6,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Wandered after their idols",
   "heard": 4,
   "words": 4,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bear your guilt and your disgrace",
   "heard": 6,
   "words": 6,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Serve at the gates and walls",
   "heard": 6,
   "words": 6,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You cannot come near to serve",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nor touch the holy things",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But keep charge of the temple work",
   "heard": 7,
   "words": 7,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And do all the necessary things",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sons of Zadok kept the charge",
   "heard": 6,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When Israel went astray",
   "heard": 4,
   "words": 4,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They may come near to serve me",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And stand before my day",
   "heard": 5,
   "words": 5,
   "error_s": 0.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Linen garments on their heads",
   "heard": 5,
   "words": 5,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No wool upon their skin",
   "heard": 5,
   "words": 5,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They shall teach my people well",
   "heard": 6,
   "words": 6,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The holy and the clean",
