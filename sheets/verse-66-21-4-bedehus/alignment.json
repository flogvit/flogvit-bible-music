 "lines": [
  {
   "text": "I heard a voice from the throne",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look, God's dwelling is with us",
   "heard": 6,
   "words": 6,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will dwell with his own",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And they will be his people",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will wipe away every tear",
   "heard": 6,
   "words": 6,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From our eyes up there",
   "heard": 5,
   "words": 5,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And death will be no more",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No more grief or crying or pain",
   "heard": 7,
   "words": 7,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When I walk my final road",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And my journey here is done",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then I will see him as he is",
   "heard": 8,
   "words": 8,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And be at home with God",
