 "words": 120,
 "lines": [
  {
   "text": "The Lord is merciful and gracious",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Slow to anger and abounding in love",
   "heard": 7,
   "words": 7,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will not always accuse us",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nor keep his anger forever",
   "heard": 5,
   "words": 5,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As far as the east is from the west",
   "heard": 9,
   "words": 9,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So far he removes our sins from us",
   "heard": 8,
   "words": 8,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As high as the heavens are above the earth",
   "heard": 9,
   "words": 9,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So great is his love",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He does not deal with us according to our sins",
   "heard": 10,
   "words": 10,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nor repay us for our wrongs",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As a father has compassion on his children",
   "heard": 8,
   "words": 8,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So the Lord has compassion on those who fear him",
   "heard": 10,
   "words": 10,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As far as the east is from the west",
   "heard": 9,
   "words": 9,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
