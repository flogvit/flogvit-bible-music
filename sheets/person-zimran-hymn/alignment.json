 "words_heard": 99,
 "words": 101,
 "lines": [
  {
   "text": "Abraham took another wife",
   "heard": 4,
   "words": 4,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whose name was Keturah",
   "heard": 4,
   "words": 4,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She bore him Zimran first",
   "heard": 5,
   "words": 5,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jokshan and Medan there",
   "heard": 4,
   "words": 4,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Midian and Ishbak too",
   "heard": 4,
   "words": 4,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Shuah round the hearth",
   "heard": 5,
   "words": 5,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Six sons by Keturah born",
   "heard": 4,
   "words": 5,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the ancient earth",
   "heard": 4,
   "words": 4,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abraham gave everything",
   "heard": 3,
   "words": 3,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To Isaac as his heir",
   "heard": 5,
   "words": 5,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But to the sons of concubines",
   "heard": 5,
   "words": 6,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Gifts he did not spare",
   "heard": 5,
   "words": 5,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "While he was still alive",
   "heard": 5,
   "words": 5,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He sent them far away",
   "heard": 5,
   "words": 5,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From Isaac and his son",
   "heard": 5,
   "words": 5,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the land of the day",
   "heard": 6,
   "words": 6,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He breathed his last and died",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Old and satisfied with life",
   "heard": 5,
   "words": 5,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gathered to his people",
   "heard": 4,
   "words": 4,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the cave of his life",
   "heard": 6,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sent eastward to the land",
   "heard": 5,
   "words": 5,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  }
 ],
