   "text": "With the trumpet call of God",
   "heard": 6,
   "words": 6,
   "error_s": 4.94,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And those who sleep in Christ will rise",
   "heard": 8,
   "words": 8,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": true
  },
  {
