{
 "id": "person-maria-magdalena-folk",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-maria-magdalena-folk",
 "offset_seconds": -3.56000000000018,
 "words_heard": 188,
 "words": 189,
 "lines": [
  {
   "text": "She followed him from Galilee when he had set her free",
   "heard": 11,
   "words": 11,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She stood beside the cross of him where others feared to be",
   "heard": 12,
   "words": 12,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She watched them lay him in the tomb and roll the stone in place",
   "heard": 14,
   "words": 14,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And came before the morning light to weep for his dear face",
   "heard": 12,
   "words": 12,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The tomb was standing open and the stone was rolled away",
   "heard": 11,
   "words": 11,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They have taken away my Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And I don't know where they have put him",
   "heard": 9,
   "words": 9,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She turned around and saw a man there in the early grey",
   "heard": 12,
   "words": 12,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Thinking he was the gardener, she said",
   "heard": 7,
   "words": 7,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sir, if you have carried him off",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Tell me where you have put him",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jesus said to her, Mary",
   "heard": 5,
   "words": 5,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She turned to him",
   "heard": 4,
   "words": 4,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Rabboni",
   "heard": 0,
   "words": 1,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I have seen the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have seen the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Do not hold on to me",
   "heard": 6,
   "words": 6,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Go to my brothers and tell them",
   "heard": 7,
   "words": 7,
   "error_s": 0.51,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "I am ascending to my Father and your Father",
   "heard": 9,
   "words": 9,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To my God and your God",
   "heard": 6,
   "words": 6,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jesus said to her, Mary",
