 "words": 232,
 "lines": [
  {
   "text": "Upon the night he was betrayed",
   "heard": 6,
   "words": 6,
   "error_s": 1.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Within the upper room",
   "heard": 4,
   "words": 4,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord sat down among his friends",
   "heard": 7,
   "words": 7,
   "error_s": 1.36,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Beneath the gathering gloom",
   "heard": 4,
   "words": 4,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He took a basin and a towel",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And knelt upon the floor",
   "heard": 5,
   "words": 5,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Teacher and the Lord of all",
   "heard": 7,
   "words": 7,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Washed feet and asked no more",
   "heard": 6,
   "words": 6,
   "error_s": 2.13,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "This is my body, which is for you",
   "heard": 8,
   "words": 8,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do this in remembrance of me",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This cup is the new covenant in my blood",
   "heard": 9,
   "words": 9,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do this in remembrance of me",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He took the bread and gave God thanks",
   "heard": 8,
   "words": 8,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And broke it, saying, Take",
   "heard": 5,
   "words": 5,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He passed the cup of covenant",
   "heard": 6,
   "words": 6,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Poured out for sinners' sake",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will not drink this fruit again",
   "heard": 6,
   "words": 7,
   "error_s": 0.23,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "He told the twelve that night",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Until I drink it new with you",
   "heard": 7,
   "words": 7,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In my Father's kingdom bright",
   "heard": 5,
   "words": 5,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This is my body, which is for you",
   "heard": 8,
   "words": 8,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do this in remembrance of me",
   "heard": 6,
   "words": 6,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This cup is the new covenant in my blood",
   "heard": 9,
   "words": 9,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do this in remembrance of me",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As often as you eat this bread and drink this cup",
   "heard": 11,
   "words": 11,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You proclaim the Lord's death until he comes",
   "heard": 8,
   "words": 8,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They sang a hymn and rose to go",
   "heard": 8,
   "words": 8,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Out to the olive hill",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lamb walked out into the night",
