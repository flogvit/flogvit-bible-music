   "words": 5,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As we also have forgiven our debtors",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And lead us not into temptation",
