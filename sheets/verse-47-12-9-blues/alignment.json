 "words": 146,
 "lines": [
  {
   "text": "A thorn was given to my flesh",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A messenger sent to torment me",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I pleaded three times with the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To take this heavy burden away",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But he said to me",
   "heard": 5,
   "words": 5,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My grace is enough for you",
   "heard": 6,
   "words": 6,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For my power is brought to its fullness",
   "heard": 8,
   "words": 8,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In weakness",
   "heard": 2,
   "words": 2,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I am content with hardships now",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "With insults and persecution",
   "heard": 4,
   "words": 4,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I boast all the more gladly",
   "heard": 6,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "About my weaknesses and pain",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But he said to me",
   "heard": 5,
   "words": 5,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My grace is enough for you",
   "heard": 6,
   "words": 6,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For my power is brought to its fullness",
   "heard": 8,
   "words": 8,
   "error_s": 2.15,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "In weakness",
   "heard": 2,
   "words": 2,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "So the power of Christ",
   "heard": 5,
   "words": 5,
   "error_s": 7.51,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "May rest upon my life",
   "heard": 5,
   "words": 5,
   "error_s": 5.92,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "When I am weak then I am strong",
   "heard": 8,
   "words": 8,
   "error_s": 7.11,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "In the middle of the night",
   "heard": 6,
   "words": 6,
   "error_s": 6.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But he said to me",
   "heard": 5,
   "words": 5,
   "error_s": 6.88,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "My grace is enough for you",
