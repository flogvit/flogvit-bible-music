 "lines": [
  {
   "text": "For everything there is a season",
   "heard": 6,
   "words": 6,
   "error_s": 1.47,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A time for every matter under heaven",
   "heard": 7,
   "words": 7,
   "error_s": 1.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A time to be born, and a time to die",
   "heard": 10,
   "words": 10,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A time to plant, and a time to uproot what was planted",
   "heard": 11,
   "words": 12,
   "error_s": 1.49,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A time to tear down, and a time to build",
   "heard": 10,
   "words": 10,
   "error_s": 1.48,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He has made everything beautiful in its time",
   "heard": 8,
   "words": 8,
   "error_s": 1.37,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Eternity set in our hearts",
   "heard": 5,
   "words": 5,
   "error_s": 1.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A time to weep, and a time to laugh",
   "heard": 9,
   "words": 9,
   "error_s": 1.07,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "A time to mourn, and a time to dance",
   "heard": 9,
   "words": 9,
   "error_s": 1.48,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A time to embrace, and a time to let go",
   "heard": 10,
   "words": 10,
   "error_s": 1.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A time to keep silent, and a time to speak",
   "heard": 10,
   "words": 10,
   "error_s": 1.47,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A time for war, and a time for peace",
   "heard": 9,
   "words": 9,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
