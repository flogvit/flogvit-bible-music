 "words": 126,
 "lines": [
  {
   "text": "Son of Jeconiah the captive",
   "heard": 5,
   "words": 5,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heir of the royal blood",
   "heard": 5,
   "words": 5,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shealtiel his name was given",
   "heard": 4,
   "words": 5,
   "error_s": 1.97,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the darkened time of God",
   "heard": 6,
   "words": 6,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Father of the governor",
   "heard": 4,
   "words": 4,
   "error_s": 1.94,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Leading Judah's returning",
   "heard": 3,
   "words": 3,
   "error_s": 1.56,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Zerubbabel his name was known",
   "heard": 5,
   "words": 5,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the exile's ending",
   "heard": 4,
   "words": 4,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Haggai spoke the Lord's command",
   "heard": 5,
   "words": 5,
   "error_s": 1.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To the house that lay in ruin",
   "heard": 7,
   "words": 7,
   "error_s": 2.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Timber bring to hill and field",
   "heard": 6,
   "words": 6,
   "error_s": 2.21,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Let the temple be rebuilt",
   "heard": 5,
   "words": 5,
   "error_s": 2.31,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Stirred the spirit of the man",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the priest beside him standing",
   "heard": 6,
   "words": 6,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Work begun upon the house",
   "heard": 5,
   "words": 5,
   "error_s": 1.64,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Of the hosts of Israel's land",
   "heard": 6,
   "words": 6,
   "error_s": 4.17,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Matthew traced the royal line",
   "heard": 5,
   "words": 5,
   "error_s": 2.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "From David's throne to Jesus",
   "heard": 5,
   "words": 5,
   "error_s": 1.51,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shealtiel stands in the record",
   "heard": 5,
   "words": 5,
   "error_s": 2.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "King and prophet's measure",
   "heard": 4,
   "words": 4,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Luke also named the son",
   "heard": 5,
   "words": 5,
   "error_s": 1.65,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Of Zerubbabel's father",
   "heard": 3,
   "words": 3,
   "error_s": 1.34,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shealtiel the link is clear",
   "heard": 4,
   "words": 5,
   "error_s": 2.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the Messiah's path we measure",
   "heard": 6,
   "words": 6,
   "error_s": 2.35,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "God's promise holds the line",
   "heard": 4,
   "words": 5,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  }
