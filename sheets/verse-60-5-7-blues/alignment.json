   "words": 5,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Old fisherman Peter learned it hard and slow",
   "heard": 7,
   "words": 8,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He wrote it in a letter so the rest of us would know",
   "heard": 13,
   "words": 13,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Humble yourselves under God's mighty hand",
   "heard": 6,
   "words": 6,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
