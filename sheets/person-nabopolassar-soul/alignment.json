 "words": 153,
 "lines": [
  {
   "text": "During his reign the king of Babylon invaded",
   "heard": 8,
   "words": 8,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jehoiakim served him for three years",
   "heard": 6,
   "words": 6,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then he turned and rebelled against the master",
   "heard": 8,
   "words": 8,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD sent raiding bands against the land",
   "heard": 8,
   "words": 8,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nebuchadnezzar king of Babylon my servant",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I will bring them against this land",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To devote them to destruction",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "An object of horror and scorn",
   "heard": 6,
   "words": 6,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All who see you will recoil from you",
   "heard": 8,
   "words": 8,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And if it's ruined, who will mourn?",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Are you better than Thebes seated by the Nile",
   "heard": 8,
   "words": 9,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet she too went into exile",
   "heard": 5,
   "words": 6,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nebuchadnezzar king of Babylon my servant",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I will bring them against this land",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To devote them to destruction",
   "heard": 5,
   "words": 5,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "An object of horror and scorn",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This whole land will become a ruin",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A wasteland for seventy years",
   "heard": 5,
   "words": 5,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sound of joy will be banished",
   "heard": 7,
   "words": 7,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the city and the fields",
   "heard": 6,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will punish the king of Babylon",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And that nation for their guilt",
   "heard": 6,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The land of Chaldeans made a desolation",
   "heard": 7,
   "words": 7,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  }
 ],
