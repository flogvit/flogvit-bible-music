 "lines": [
  {
   "text": "Live at peace with everyone if you can",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Leave room for the wrath that God takes",
   "heard": 8,
   "words": 8,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Vengeance is mine, I will repay",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord has spoken, we obey",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If your enemy is hungry, feed him",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If he is thirsty, give him drink",
   "heard": 7,
   "words": 7,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do this and you will heap",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Burning coals upon his head",
   "heard": 5,
   "words": 5,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be overcome by evil",
   "heard": 0,
   "words": 6,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But overcome evil with good",
   "heard": 0,
   "words": 5,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Do not be overcome by evil",
   "heard": 6,
   "words": 6,
   "error_s": 12.44,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But overcome evil with good",
   "heard": 5,
   "words": 5,
   "error_s": 12.32,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "As far as it depends on you",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Choose the path of peace today",
   "heard": 6,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not take revenge, dear friends",
   "heard": 6,
   "words": 6,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
