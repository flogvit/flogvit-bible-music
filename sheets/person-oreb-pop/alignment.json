  {
   "text": "Israel did evil in the sight of the Lord",
   "heard": 9,
   "words": 9,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Handed over to Midian for seven long years",
   "heard": 8,
   "words": 8,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They hid in caves and strongholds in the mountains",
   "heard": 9,
   "words": 9,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Crops destroyed and livestock taken away",
   "heard": 5,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Crying out to the Lord in their distress",
