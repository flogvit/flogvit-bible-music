 "words": 201,
 "lines": [
  {
   "text": "Nine hundred iron chariots rolled",
   "heard": 5,
   "words": 5,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Cruel oppression lasted twenty years",
   "heard": 5,
   "words": 5,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Israel cried out to the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 1.34,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jabin reigned in Hazor with fear",
   "heard": 6,
   "words": 6,
   "error_s": 1.39,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Sisera commanded the army",
   "heard": 4,
   "words": 4,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Harosheth-hagoyim was his home",
   "heard": 3,
   "words": 4,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He asked for water she gave him milk",
   "heard": 8,
   "words": 8,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In a bowl fit for a prince",
   "heard": 7,
   "words": 7,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her hand reached for the tent peg",
   "heard": 7,
   "words": 7,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her right hand for the hammer",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She struck Sisera crushed his head",
   "heard": 5,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shattered and pierced his temple",
   "heard": 5,
   "words": 5,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Barak went up Mount Tabor",
   "heard": 5,
   "words": 5,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sisera summoned his troops",
   "heard": 4,
   "words": 4,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From Kishon River to the battle",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord routed his forces",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sisera fled on foot",
   "heard": 4,
   "words": 4,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Left his chariot behind in dust",
   "heard": 6,
   "words": 6,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He asked for water she gave him milk",
   "heard": 8,
   "words": 8,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In a bowl fit for a prince",
   "heard": 7,
   "words": 7,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her hand reached for the tent peg",
   "heard": 7,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her right hand for the hammer",
   "heard": 6,
   "words": 6,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She struck Sisera crushed his head",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shattered and pierced his temple",
   "heard": 5,
   "words": 5,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jael covered him with a blanket",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He lay fast asleep and exhausted",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She drove the peg into the ground",
   "heard": 6,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So he died in the tent",
   "heard": 6,
   "words": 6,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Barak came and found him there",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Dead with the peg through his head",
   "heard": 7,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Most blessed of women be Jael",
   "heard": 6,
   "words": 6,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Most blessed of women in tents",
