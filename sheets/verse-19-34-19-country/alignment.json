 "lines": [
  {
   "text": "The eyes of the LORD watch the righteous",
   "heard": 8,
   "words": 8,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His ears are open to their cry",
   "heard": 7,
   "words": 7,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The face of the LORD is set against the wicked",
   "heard": 10,
   "words": 10,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To cut off their memory from the earth",
   "heard": 8,
   "words": 8,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They cried out and the LORD heard",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He delivered them from all their troubles",
   "heard": 7,
   "words": 7,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD is near to the brokenhearted",
   "heard": 7,
   "words": 7,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He saves those crushed in spirit",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Many are the afflictions of the righteous",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the LORD delivers him from them all",
   "heard": 8,
   "words": 8,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He watches over all his bones",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not one of them is broken",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Evil will put the wicked to death",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And those who hate the righteous will bear their guilt",
   "heard": 10,
   "words": 10,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
