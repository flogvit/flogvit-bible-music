 "lines": [
  {
   "text": "I have called by name Bezalel son of Uri",
   "heard": 9,
   "words": 9,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the tribe of Judah he stands before me",
   "heard": 9,
   "words": 9,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have filled him with the Spirit of God",
   "heard": 9,
   "words": 9,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With skill and understanding to build His house",
   "heard": 8,
   "words": 8,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Designing works in gold and silver and bronze",
   "heard": 8,
   "words": 8,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Cutting stones and carving wood with grace",
   "heard": 7,
   "words": 7,
   "error_s": 1.48,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In every kind of craft the wisdom flows",
   "heard": 8,
   "words": 8,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To make the sanctuary as I command",
   "heard": 7,
   "words": 7,
   "error_s": 1.34,
   "tie_split": false,
   "uncertain": true
  },
  {
