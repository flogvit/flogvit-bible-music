 "lines": [
  {
   "text": "Day and night your hand was heavy",
   "heard": 7,
   "words": 7,
   "error_s": 1.18,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My vigor turned to summer dryness",
   "heard": 6,
   "words": 6,
   "error_s": 1.45,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I made my sin known to you",
   "heard": 7,
   "words": 7,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I did not cover up my guilt",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are my hiding place",
   "heard": 5,
   "words": 5,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You guard me from all trouble",
   "heard": 6,
   "words": 6,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Surround me with songs",
   "heard": 4,
   "words": 4,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Songs of deliverance",
   "heard": 3,
   "words": 3,
   "error_s": 12.6,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I will instruct you and teach",
   "heard": 6,
   "words": 6,
   "error_s": 1.76,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The way you should go is clear",
   "heard": 7,
   "words": 7,
   "error_s": 1.67,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I will counsel you and watch",
   "heard": 6,
   "words": 6,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Over you with tender care",
   "heard": 5,
   "words": 5,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are my hiding place",
   "heard": 5,
   "words": 5,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You guard me from all trouble",
   "heard": 6,
   "words": 6,
   "error_s": 1.2,
   "tie_split": false,
   "uncertain": false
  },
  {
