{
 "id": "theme-korset-hymn",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/theme-korset-hymn",
 "offset_seconds": -2.6200000000002,
 "words_heard": 123,
 "words": 123,
 "lines": [
  {
   "text": "Upon a hill outside the gate",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They raised a cross of wood",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And there the Son of God was hung",
   "heard": 8,
   "words": 8,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where we ourselves had stood",
   "heard": 5,
   "words": 5,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The crowd went by and shook their heads",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And mocked him as he died",
   "heard": 6,
   "words": 6,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The soldiers gambled for his clothes",
   "heard": 6,
   "words": 6,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And pierced him in his side",
   "heard": 6,
   "words": 6,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The message of the cross is called",
   "heard": 7,
   "words": 7,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But foolishness by some",
   "heard": 4,
   "words": 4,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet unto us who are being saved",
   "heard": 7,
   "words": 7,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The power of God has come",
   "heard": 6,
   "words": 6,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will not boast in anything",
   "heard": 6,
   "words": 6,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But in the cross of Christ",
   "heard": 6,
   "words": 6,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The world is crucified to me",
   "heard": 6,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And I to it have died",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now let the proud lay down their crowns",
   "heard": 8,
   "words": 8,
   "error_s": 0.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The wise their clever word",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For in this foolishness we find",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The wisdom of the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  }
 ],
