{
 "id": "story-den-lamme-ved-betesda-dammen-hymn",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-den-lamme-ved-betesda-dammen-hymn",
 "offset_seconds": 1.9599999999997024,
 "words_heard": 190,
 "words": 195,
 "lines": [
  {
   "text": "Some time later Jesus went up",
   "heard": 4,
   "words": 6,
   "error_s": 2.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To Jerusalem for a festival",
   "heard": 5,
   "words": 5,
   "error_s": 2.71,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "By the Sheep Gate there is a pool",
   "heard": 8,
   "words": 8,
   "error_s": 2.78,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Where five colonnades covered",
   "heard": 4,
   "words": 4,
   "error_s": 2.8,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Blind and lame and paralyzed",
   "heard": 5,
   "words": 5,
   "error_s": 2.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Lay in these places waiting",
   "heard": 5,
   "words": 5,
   "error_s": 2.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For the water to be stirred",
   "heard": 6,
   "words": 6,
   "error_s": 2.13,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "So they might be healed",
   "heard": 5,
   "words": 5,
   "error_s": 2.11,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "One man had been an invalid",
   "heard": 6,
   "words": 6,
   "error_s": 2.12,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For thirty-eight long years",
   "heard": 3,
   "words": 4,
   "error_s": 2.49,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jesus saw him lying there",
   "heard": 5,
   "words": 5,
   "error_s": 1.91,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And asked if he wanted well",
   "heard": 6,
   "words": 6,
   "error_s": 1.59,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "He had no one to help him in",
   "heard": 8,
   "words": 8,
   "error_s": 1.23,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "When the water was stirred",
   "heard": 5,
   "words": 5,
   "error_s": 1.18,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "While he was on his way",
   "heard": 6,
   "words": 6,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Someone else would go down first",
   "heard": 6,
   "words": 6,
   "error_s": 1.11,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jesus said get up and pick up",
   "heard": 7,
   "words": 7,
   "error_s": 10.11,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Your mat and begin to walk",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At once the man was made well",
   "heard": 6,
   "words": 7,
   "error_s": 1.39,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And began to walk away",
   "heard": 5,
   "words": 5,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Jews said it was the Sabbath",
   "heard": 7,
   "words": 7,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are not permitted to carry",
   "heard": 6,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the man who made him well",
   "heard": 7,
   "words": 7,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Told him to pick it up",
   "heard": 6,
   "words": 6,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They asked who the man was",
   "heard": 6,
   "words": 6,
   "error_s": 2.71,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But he did not know who it was",
   "heard": 8,
   "words": 8,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jesus had slipped away",
   "heard": 4,
   "words": 4,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Because there was a crowd",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Later Jesus found him in the temple",
   "heard": 7,
   "words": 7,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And said see you have been made well",
   "heard": 8,
   "words": 8,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sin no more or something worse",
   "heard": 5,
   "words": 6,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "May happen to you",
   "heard": 4,
   "words": 4,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pick up your mat and walk",
   "heard": 6,
   "words": 6,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  }
 ],
