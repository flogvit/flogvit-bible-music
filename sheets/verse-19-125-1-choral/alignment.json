 "lines": [
  {
   "text": "Those who trust in the LORD",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Are like Mount Zion today",
   "heard": 5,
   "words": 5,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It cannot be shaken by wind",
   "heard": 6,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It stands forever strong and bright",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Like Mount Zion, we are held",
   "heard": 6,
   "words": 6,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Like Mount Zion, we are kept",
   "heard": 6,
   "words": 6,
   "error_s": 1.47,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Steadfast and secure",
   "heard": 3,
   "words": 3,
   "error_s": 1.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The mountains surround Jerusalem",
   "heard": 4,
   "words": 4,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So the LORD surrounds his people",
   "heard": 6,
   "words": 6,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Both now and forevermore",
   "heard": 4,
   "words": 4,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His care is constant and true",
   "heard": 6,
   "words": 6,
   "error_s": 1.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Like Mount Zion, we are held",
   "heard": 6,
   "words": 6,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Like Mount Zion, we are kept",
