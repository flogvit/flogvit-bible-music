   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "While the world turns and shifts its day",
   "heard": 8,
   "words": 8,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not let your spirit shrink back",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
