{
 "id": "chapter-19-1-folk",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/chapter-19-1-folk",
 "offset_seconds": -0.7600000000002396,
 "words_heard": 124,
 "words": 124,
 "lines": [
  {
   "text": "Blessed is the one who does not walk in the counsel of the wicked",
   "heard": 14,
   "words": 14,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who does not stand in the way of sinners",
   "heard": 9,
   "words": 9,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who does not sit in the seat of mockers",
   "heard": 9,
   "words": 9,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But whose delight is in the instruction of the LORD",
   "heard": 10,
   "words": 10,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And who murmurs over his instruction day and night",
   "heard": 9,
   "words": 9,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is like a tree transplanted beside channels of water",
   "heard": 10,
   "words": 10,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yielding its fruit in season, its leaf never withering",
   "heard": 9,
   "words": 9,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In all that he does, he thrives",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not so the wicked",
   "heard": 4,
   "words": 4,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They are like chaff that the wind blows away",
   "heard": 9,
   "words": 9,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Therefore the wicked will not stand in the judgment",
   "heard": 9,
   "words": 9,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nor sinners in the assembly of the righteous",
   "heard": 8,
   "words": 8,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the LORD knows the way of the righteous",
   "heard": 9,
   "words": 9,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the way of the wicked will perish",
   "heard": 8,
   "words": 8,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  }
 ],
