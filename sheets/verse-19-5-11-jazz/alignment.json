 "lines": [
  {
   "text": "I enter your house through abundant mercy",
   "heard": 7,
   "words": 7,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bow in reverence to your holy place",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lead me in your righteousness, O Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Make your way straight before my face",
   "heard": 7,
   "words": 7,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let all who take refuge in you rejoice",
   "heard": 8,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let them sing for joy forevermore",
   "heard": 6,
   "words": 6,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Spread your shelter over them completely",
   "heard": 6,
   "words": 6,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let those who love your name exult",
   "heard": 7,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Declare them guilty, God, in your judgment",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let them fall by their own wicked schemes",
   "heard": 8,
   "words": 8,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
