 "lines": [
  {
   "text": "Jesus came to Jericho",
   "heard": 4,
   "words": 4,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A crowd was all around",
   "heard": 5,
   "words": 5,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zacchaeus was a little man",
   "heard": 5,
   "words": 5,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He could not see from the ground",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He ran ahead and climbed a tree",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A sycamore so high",
   "heard": 4,
   "words": 4,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Jesus stopped and looked up there",
   "heard": 7,
   "words": 7,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And called him from the sky",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zacchaeus, come down, come down",
   "heard": 5,
   "words": 5,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Today I'm staying at your house",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zacchaeus, come down, come down",
   "heard": 5,
   "words": 5,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Salvation has come to your house",
   "heard": 6,
   "words": 6,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He hurried down with joy that day",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people grumbled loud",
   "heard": 4,
   "words": 4,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look, Lord, I give half to the poor",
   "heard": 8,
   "words": 8,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And four times what I owe",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Son of Man has come to seek",
   "heard": 8,
   "words": 8,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And save the ones who're lost",
   "heard": 6,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zacchaeus, son of Abraham",
   "heard": 4,
   "words": 4,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Is found at any cost",
   "heard": 4,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
