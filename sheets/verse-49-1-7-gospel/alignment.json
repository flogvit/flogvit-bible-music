   "heard": 8,
   "words": 8,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Poured out on us in all wisdom and understanding",
   "heard": 9,
   "words": 9,
   "error_s": 1.21,
   "tie_split": false,
   "uncertain": true
  },
  {
