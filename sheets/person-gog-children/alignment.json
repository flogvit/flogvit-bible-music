 "lines": [
  {
   "text": "Son of man set your face against Gog",
   "heard": 8,
   "words": 8,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Chief prince of Meshech",
   "heard": 4,
   "words": 4,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The word of the Lord came to me",
   "heard": 8,
   "words": 8,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am against you I declare",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will turn you around with a hook",
   "heard": 8,
   "words": 8,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bring you out with your whole army",
   "heard": 7,
   "words": 7,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Horses and horsemen splendidly clothed",
   "heard": 5,
   "words": 5,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A vast company with shields",
   "heard": 5,
   "words": 5,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Persia and Cush and Put are with them",
   "heard": 6,
   "words": 8,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gomer and Beth Togarmah from the north",
   "heard": 7,
   "words": 7,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Many peoples gathered around you",
   "heard": 5,
   "words": 5,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Prepare yourself for the battle",
   "heard": 5,
   "words": 5,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will turn you around with a hook",
   "heard": 8,
   "words": 8,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bring you out with your whole army",
   "heard": 7,
   "words": 7,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Horses and horsemen splendidly clothed",
