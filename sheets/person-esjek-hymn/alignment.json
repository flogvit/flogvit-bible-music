 "lines": [
  {
   "text": "Ner fathered Kish, Kish fathered Saul",
   "heard": 5,
   "words": 6,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Saul fathered Jonathan and Malchishua",
   "heard": 4,
   "words": 5,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abinadab and Eshbaal came",
   "heard": 4,
   "words": 4,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The line of kings in Benjamin's name",
   "heard": 7,
   "words": 7,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jonathan brought forth Merib-baal",
   "heard": 4,
   "words": 4,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Micah was born to Merib-baal",
   "heard": 5,
   "words": 5,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pithon, Melech, Tarea, Ahaz",
   "heard": 1,
   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Ahaz fathered Jehoaddah's gaze",
   "heard": 3,
   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jehoaddah had Alemeth there",
   "heard": 1,
   "words": 4,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Azmaveth and Zimri were fair",
   "heard": 4,
   "words": 5,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zimri fathered Moza, it is said",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Moza fathered Binea, so laid",
   "heard": 2,
   "words": 5,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Raphah was his son, Eleasah",
   "heard": 3,
   "words": 5,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Azel his son, the days that pass",
   "heard": 6,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Azel had six sons, names we know",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Azrikam, Bocheru, in the flow",
   "heard": 3,
   "words": 5,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ishmael, Sheariah, Obadiah",
   "heard": 3,
   "words": 3,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hanan completed the family's tie",
   "heard": 5,
   "words": 5,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sons of Eshek his brother stood",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ulam his firstborn, Jeush understood",
   "heard": 5,
   "words": 5,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jeush the second, Eliphelet third",
   "heard": 4,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sons of Ulam, mighty and firm",
   "heard": 7,
   "words": 7,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Archers who drew the bow with might",
   "heard": 7,
   "words": 7,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Many sons and grandsons, day and night",
   "heard": 7,
   "words": 7,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One hundred and fifty in all",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Among the sons of Benjamin they dwell",
   "heard": 7,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The register keeps their names alive",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the tribal history, they thrive",
   "heard": 6,
   "words": 6,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All these were among the sons of Benjamin",
   "heard": 8,
   "words": 8,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  }
 ],
