   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will establish her forever",
   "heard": 5,
   "words": 5,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We have pondered your steadfast love",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
