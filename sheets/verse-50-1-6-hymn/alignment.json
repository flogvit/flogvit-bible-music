 "words": 149,
 "lines": [
  {
   "text": "I thank my God each time",
   "heard": 6,
   "words": 6,
   "error_s": 1.39,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "That you come to my mind",
   "heard": 6,
   "words": 6,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In every prayer I lift",
   "heard": 5,
   "words": 5,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For all of you combined",
   "heard": 5,
   "words": 5,
   "error_s": 1.89,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With joy I do remember",
   "heard": 5,
   "words": 5,
   "error_s": 1.34,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Your partnership in grace",
   "heard": 4,
   "words": 4,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the first day until now",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You share this holy place",
   "heard": 5,
   "words": 5,
   "error_s": 1.43,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He who began a good work in you",
   "heard": 8,
   "words": 8,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will bring it to completion",
   "heard": 5,
   "words": 5,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Until the day of Christ Jesus",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His faithful preservation",
   "heard": 3,
   "words": 3,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It is right for me to think",
   "heard": 7,
   "words": 7,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of all of you with care",
   "heard": 6,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I hold you in my heart",
   "heard": 6,
   "words": 6,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Beyond comparison there",
   "heard": 3,
   "words": 3,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He who began the work in you",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will bring it to completion",
   "heard": 5,
   "words": 5,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Until the day of Christ Jesus",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His faithful preservation",
   "heard": 3,
   "words": 3,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whether in chains or defending",
   "heard": 5,
   "words": 5,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Confirming the gospel way",
   "heard": 4,
   "words": 4,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You share with me in this grace",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That I can never sway",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God is my witness how I long",
   "heard": 7,
   "words": 7,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With the affection of Christ",
   "heard": 5,
   "words": 5,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your love will overflow",
   "heard": 4,
   "words": 4,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In knowledge and in light",
   "heard": 4,
   "words": 5,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  }
 ],
