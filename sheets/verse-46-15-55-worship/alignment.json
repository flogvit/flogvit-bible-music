   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This perishable puts on what is immortal",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The mortal body is changed by the call",
