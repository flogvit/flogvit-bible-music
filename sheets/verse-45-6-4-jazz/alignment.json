 "words": 148,
 "lines": [
  {
   "text": "What shall we say about grace",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Should we keep on sinning more",
   "heard": 6,
   "words": 6,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By no means we died to sin",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So how can we live in it",
   "heard": 7,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do you not know the truth",
   "heard": 6,
   "words": 6,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We were baptized into Christ",
   "heard": 5,
   "words": 5,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Into His death we went",
   "heard": 5,
   "words": 5,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All of us who followed",
   "heard": 5,
   "words": 5,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Buried with Him into death",
   "heard": 5,
   "words": 5,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In order that we might rise",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As Christ was raised from the dead",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We too walk in newness",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "United in His death",
   "heard": 4,
   "words": 4,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We will be united in life",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Our old self was crucified",
   "heard": 5,
   "words": 5,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The body of sin is gone",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Buried with Him into death",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In order that we might rise",
   "heard": 6,
   "words": 6,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As Christ was raised from the dead",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We too walk in newness",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No longer slaves to sin",
   "heard": 5,
   "words": 5,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rendered powerless is the body",
   "heard": 5,
   "words": 5,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We have died and are set free",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Free from the old life",
   "heard": 5,
   "words": 5,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Walk in newness of life",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Raised by the glory of the Father",
   "heard": 7,
   "words": 7,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  }
