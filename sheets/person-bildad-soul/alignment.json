 "lines": [
  {
   "text": "Three friends came from far away",
   "heard": 6,
   "words": 6,
   "error_s": 1.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Eliphaz, Bildad, and Zophar too",
   "heard": 5,
   "words": 5,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They saw his pain from a distance away",
   "heard": 8,
   "words": 8,
   "error_s": 1.6,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Could not recognize the man he knew",
   "heard": 7,
   "words": 7,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How long will you go on talking like this",
   "heard": 9,
   "words": 9,
   "error_s": 1.21,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Your words are a driving wind",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Does God pervert justice in his design",
   "heard": 7,
   "words": 7,
   "error_s": 2.09,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Does the Almighty let what is right be blind",
   "heard": 9,
   "words": 9,
   "error_s": 12.82,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They wept aloud and tore their robes",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Tossed dust into the air above",
   "heard": 6,
   "words": 6,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sat with him for seven days and nights",
   "heard": 8,
   "words": 8,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No words were spoken, suffering in sight",
   "heard": 5,
   "words": 7,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How long will you go on talking like this",
