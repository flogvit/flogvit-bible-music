   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give me ears to hear",
   "heard": 5,
   "words": 5,
   "error_s": 1.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "If you walk in my ways",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keeping my statutes and my commandments",
   "heard": 6,
   "words": 6,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As your father David walked",
   "heard": 5,
   "words": 5,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
