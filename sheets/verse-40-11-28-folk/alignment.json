 "words": 165,
 "lines": [
  {
   "text": "Long road and heavy shoulders",
   "heard": 5,
   "words": 5,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Dust of every mile I've known",
   "heard": 6,
   "words": 6,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Carried more than I could carry",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Thought that I would walk alone",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then a voice beside the water",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gentle as the evening light",
   "heard": 5,
   "words": 5,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Calling out to all the weary",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Calling me by name tonight",
   "heard": 5,
   "words": 5,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come to me, all you who are weary and burdened",
   "heard": 10,
   "words": 10,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And I will give you rest",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Take my yoke upon you and learn from me",
   "heard": 9,
   "words": 9,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For I am gentle and humble in heart",
   "heard": 8,
   "words": 8,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Set them down, the stones I gathered",
   "heard": 7,
   "words": 7,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Every failure, every fear",
   "heard": 4,
   "words": 4,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He who made the hills and rivers",
   "heard": 5,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bends to meet me, draws me near",
   "heard": 7,
   "words": 7,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come to me, all you who are weary and burdened",
   "heard": 10,
   "words": 10,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And I will give you rest",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Take my yoke upon you and learn from me",
   "heard": 9,
   "words": 9,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For I am gentle and humble in heart",
   "heard": 8,
   "words": 8,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My yoke is easy",
   "heard": 4,
   "words": 4,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My burden is light",
   "heard": 4,
   "words": 4,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will find rest for your souls",
   "heard": 7,
   "words": 7,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rest for your souls tonight",
