   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heave away, my boys",
   "heard": 4,
   "words": 4,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord hurled a great wind on the sea",
   "heard": 8,
   "words": 9,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heave away, my boys",
