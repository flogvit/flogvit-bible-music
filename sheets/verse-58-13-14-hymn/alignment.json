   "uncertain": false
  },
  {
   "text": "Obey your leaders and submit to them",
   "heard": 7,
   "words": 7,
   "error_s": 0.28,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "They keep watch over your souls",
