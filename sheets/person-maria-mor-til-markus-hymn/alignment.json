 "words_heard": 81,
 "words": 83,
 "lines": [
  {
   "text": "Peter walked through the night",
   "heard": 5,
   "words": 5,
   "error_s": 1.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To the home of Mary",
   "heard": 5,
   "words": 5,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Many had gathered there",
   "heard": 4,
   "words": 4,
   "error_s": 1.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To pray without ceasing",
   "heard": 4,
   "words": 4,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He knocked on the outer door",
   "heard": 5,
   "words": 6,
   "error_s": 1.39,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A servant girl came",
   "heard": 3,
   "words": 4,
   "error_s": 1.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her name was Rhoda",
   "heard": 4,
   "words": 4,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She heard his voice clear",
   "heard": 5,
   "words": 5,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She was overjoyed",
   "heard": 3,
   "words": 3,
   "error_s": 1.48,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "She did not open the gate",
   "heard": 6,
   "words": 6,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She ran inside quickly",
   "heard": 4,
   "words": 4,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To tell them all true",
   "heard": 5,
   "words": 5,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Peter was standing outside",
   "heard": 4,
   "words": 4,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The gate remained shut",
   "heard": 4,
   "words": 4,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The joy was too great",
   "heard": 5,
   "words": 5,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To stop at the door",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mary's house was the place",
   "heard": 5,
   "words": 5,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where prayer did not end",
   "heard": 5,
   "words": 5,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  }
 ],
