  {
   "text": "I fled the king into a hidden cave",
   "heard": 8,
   "words": 8,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My heart was heavy with the weight of fear",
   "heard": 9,
   "words": 9,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I hide myself within this narrow place",
   "heard": 7,
   "words": 7,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And cry out loud for you to draw near",
   "heard": 9,
   "words": 9,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I call to God Most High who rules above",
