{
 "id": "story-vismennene-fra-osten-orchestral",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-vismennene-fra-osten-orchestral",
 "offset_seconds": -2.9200000000001936,
 "words_heard": 214,
 "words": 216,
 "lines": [
  {
   "text": "Far away in the east we watched the night sky turn",
   "heard": 11,
   "words": 11,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A new star was rising and we saw it burn",
   "heard": 10,
   "words": 10,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Over desert and mountain we followed its light",
   "heard": 8,
   "words": 8,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To Jerusalem's gates and King Herod's court by night",
   "heard": 8,
   "words": 9,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where is the one who has been born king of the Jews",
   "heard": 12,
   "words": 12,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We saw his star when it rose",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And we have come to worship him",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The king was disturbed and Jerusalem too",
   "heard": 7,
   "words": 7,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The scribes searched the scrolls till they found what was true",
   "heard": 11,
   "words": 11,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In Bethlehem of Judea the ruler will be born",
   "heard": 9,
   "words": 9,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So we rode on in the darkness before the morn",
   "heard": 10,
   "words": 10,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where is the one who has been born king of the Jews",
   "heard": 12,
   "words": 12,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We saw his star when it rose",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And we have come to worship him",
   "heard": 7,
   "words": 7,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The star went ahead till it stopped where he lay",
   "heard": 10,
   "words": 10,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We rejoiced with exceedingly great joy that day",
   "heard": 8,
   "words": 8,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We saw the child with Mary and we fell down at his feet",
   "heard": 13,
   "words": 13,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gold, frankincense, and myrrh we gave, our journey was complete",
   "heard": 10,
   "words": 10,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And you, Bethlehem, in the land of Judah",
   "heard": 8,
   "words": 8,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Are by no means least among the rulers of Judah",
   "heard": 10,
   "words": 10,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For out of you will come a ruler",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who will shepherd my people Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Warned in a dream, we went home by another way",
   "heard": 9,
   "words": 10,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We have come to worship him",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  }
 ],
