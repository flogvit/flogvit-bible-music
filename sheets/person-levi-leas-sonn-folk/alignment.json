   "words": 6,
   "error_s": 5.04,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Simeon and Levi took their swords",
   "heard": 6,
   "words": 6,
   "error_s": 5.04,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Against the unsuspecting city",
   "heard": 4,
   "words": 4,
   "error_s": 4.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Killing every male in the crowd",
   "heard": 6,
   "words": 6,
   "error_s": 4.83,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Taking Dinah from the pit",
   "heard": 5,
   "words": 5,
   "error_s": 2.5,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Cursed be their anger so fierce",
   "heard": 6,
   "words": 6,
   "error_s": 3.72,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And their fury is cruel",
   "heard": 5,
   "words": 5,
   "error_s": 6.42,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "I will divide them in Jacob",
   "heard": 6,
   "words": 6,
   "error_s": 2.37,
   "tie_split": false,
   "uncertain": true
  },
  {
