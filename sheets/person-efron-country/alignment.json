 "lines": [
  {
   "text": "Sarah died in Hebron land",
   "heard": 5,
   "words": 5,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A hundred twenty-seven years she stayed",
   "heard": 5,
   "words": 6,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Abrose up to speak the word",
   "heard": 5,
   "words": 6,
   "error_s": 1.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A stranger in the foreign world",
   "heard": 6,
   "words": 6,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am a sojourner among you",
   "heard": 6,
   "words": 6,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give me a burial site to view",
   "heard": 5,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Hittites spoke with gentle voice",
   "heard": 6,
   "words": 6,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are a prince before God's choice",
   "heard": 7,
   "words": 7,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ephron sat in the city gate",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Said I give you field and cave",
   "heard": 7,
   "words": 7,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No, my lord, hear me please",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will pay the price with ease",
   "heard": 7,
   "words": 7,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abraham bowed before the crowd",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And told them all what they should",
   "heard": 7,
   "words": 7,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Plead with Ephron son of Zohar",
   "heard": 6,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To sell the cave and open door",
   "heard": 7,
   "words": 7,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ephron sat in the city gate",
   "heard": 6,
   "words": 6,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Said I give you field and cave",
   "heard": 7,
   "words": 7,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No, my lord, hear me please",
   "heard": 6,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will pay the price with ease",
   "heard": 7,
   "words": 7,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Four hundred shekels silver weighed",
   "heard": 4,
   "words": 5,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the hearing of the people",
   "heard": 6,
   "words": 6,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abraham agreed to terms",
   "heard": 4,
   "words": 4,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And bought the land with his arms",
   "heard": 7,
   "words": 7,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The field of Machpelah passed",
   "heard": 4,
   "words": 5,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Into the hand of the father",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All trees within the border",
