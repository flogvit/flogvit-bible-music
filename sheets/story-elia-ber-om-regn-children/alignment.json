 "lines": [
  {
   "text": "Elijah was a man just like us",
   "heard": 7,
   "words": 7,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He prayed earnestly to the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That it would not rain on the land",
   "heard": 8,
   "words": 8,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No rain fell for three and a half years",
   "heard": 9,
   "words": 9,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He prayed again with all his heart",
   "heard": 7,
   "words": 7,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The heavens opened wide and gave rain",
   "heard": 7,
   "words": 7,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The earth produced its harvest now",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Power of prayer is seen today",
   "heard": 6,
   "words": 6,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A human being just like us",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He sought the Lord with deep desire",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The drought held fast for long days",
   "heard": 7,
   "words": 7,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Until his words reached heaven high",
   "heard": 6,
   "words": 6,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He prayed again with all his heart",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The heavens opened wide and gave rain",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The earth produced its harvest now",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Power of prayer is seen today",
   "heard": 6,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Earnest prayer moves the heavens",
   "heard": 5,
   "words": 5,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It stops the rain or brings it back",
   "heard": 8,
   "words": 8,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Like Elijah standing in faith",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
