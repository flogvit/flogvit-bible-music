   "words": 6,
   "error_s": 2.62,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He fathered Shealtiel, who raised Zerubbabel",
   "heard": 6,
   "words": 6,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
