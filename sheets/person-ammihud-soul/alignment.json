   "words": 4,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Leader of the tribe that stood",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "On the west side under flag",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Guiding Israel through the track",
   "heard": 5,
   "words": 5,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When the camp was set in order",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Standard raised to find the border",
   "heard": 6,
   "words": 6,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Elishama led the people through",
   "heard": 5,
   "words": 5,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
