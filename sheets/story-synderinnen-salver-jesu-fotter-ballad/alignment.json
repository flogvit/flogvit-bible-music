 "offset_seconds": -4.6600000000001565,
 "words_heard": 157,
 "words": 157,
 "lines": [
  {
   "text": "She came into the Pharisee's house uninvited",
   "heard": 7,
   "words": 7,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With an alabaster jar and a name everyone knew",
   "heard": 9,
   "words": 9,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She knelt at his feet and the tears came falling",
   "heard": 10,
   "words": 10,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She wiped them with her hair, she didn't know what else to do",
   "heard": 13,
   "words": 13,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Simon watched from the table and he thought within his heart",
   "heard": 11,
   "words": 11,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If this man were a prophet he would know who she is",
   "heard": 12,
   "words": 12,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But Jesus turned toward the woman and said to Simon",
   "heard": 10,
   "words": 10,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do you see this woman",
   "heard": 5,
   "words": 5,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her many sins have been forgiven",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For she loved much",
   "heard": 4,
   "words": 4,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the one who is forgiven little",
   "heard": 7,
   "words": 7,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Loves little",
   "heard": 2,
   "words": 2,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You gave me no water for my feet",
   "heard": 8,
   "words": 8,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But she has wet my feet with her tears",
   "heard": 9,
   "words": 9,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You gave me no kiss",
   "heard": 5,
   "words": 5,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But she has not stopped kissing my feet",
   "heard": 8,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her many sins have been forgiven",
   "heard": 6,
   "words": 6,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For she loved much",
   "heard": 4,
   "words": 4,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the one who is forgiven little",
   "heard": 7,
   "words": 7,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Loves little",
