  {
   "text": "The craftsman speaks to the goldsmith",
   "heard": 5,
   "words": 6,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The hammer urges the striker",
   "heard": 5,
   "words": 5,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He says the solder is good",
   "heard": 6,
   "words": 6,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And fastens the idol tight",
   "heard": 4,
   "words": 5,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It will not topple down",
   "heard": 5,
   "words": 5,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But you are my servant chosen",
   "heard": 6,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jacob, offspring of Abraham",
