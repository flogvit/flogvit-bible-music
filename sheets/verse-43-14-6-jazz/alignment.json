   "heard": 7,
   "words": 7,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jesus looked at him with an eye",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have been with you in this rough",
   "heard": 8,
   "words": 8,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
