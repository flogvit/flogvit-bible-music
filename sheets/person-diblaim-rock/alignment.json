 "lines": [
  {
   "text": "When the Lord first spoke through Hosea",
   "heard": 7,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Go take a wife of prostitution",
   "heard": 6,
   "words": 6,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For the land turns away from the Lord",
   "heard": 8,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Great infidelity is their foundation",
   "heard": 5,
   "words": 5,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He went and took Gomer daughter of Diblaim",
   "heard": 4,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And she conceived and bore him a son",
   "heard": 7,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A sign of the covenant broken and torn",
   "heard": 7,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The daughter of Diblaim in the sun",
   "heard": 7,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The command came down from the holy one",
   "heard": 8,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To marry the woman who strays",
   "heard": 6,
   "words": 6,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A living sign of the people's ways",
   "heard": 7,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Who turn their faces from the sun",
   "heard": 7,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He went and took Gomer daughter of Diblaim",
   "heard": 6,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And she conceived and bore him a son",
   "heard": 8,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A sign of the covenant broken and torn",
   "heard": 8,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The daughter of Diblaim in the sun",
   "heard": 7,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Her father is named in the ancient scroll",
   "heard": 8,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Diblaim is the source of the line",
   "heard": 7,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A single verse to make it known",
   "heard": 7,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The prophet walked on a path divine",
   "heard": 7,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Gomer daughter of Diblaim",
   "heard": 3,
   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Bore the son as the word said",
   "heard": 6,
   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The story begins where the heart is led",
   "heard": 8,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  }
