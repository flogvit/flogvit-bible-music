 "words": 100,
 "lines": [
  {
   "text": "You who struggle, you who carry",
   "heard": 6,
   "words": 6,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heavy burdens day and night",
   "heard": 5,
   "words": 5,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hear how Jesus calls you to him",
   "heard": 7,
   "words": 7,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are not forgotten here",
   "heard": 5,
   "words": 5,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come to me, all you who are weary",
   "heard": 8,
   "words": 8,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And burdened, come to me",
   "heard": 5,
   "words": 5,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And I will give you rest",
   "heard": 6,
   "words": 6,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come to me",
   "heard": 3,
   "words": 3,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Take my yoke and learn from me",
   "heard": 7,
   "words": 7,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For I am gentle and humble in heart",
   "heard": 8,
   "words": 8,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And you will find rest for your souls",
   "heard": 8,
   "words": 8,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For my yoke is easy and my burden is light",
   "heard": 10,
   "words": 10,
   "error_s": 1.13,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Come to me, all you who are weary",
   "heard": 8,
   "words": 8,
   "error_s": 0.79,
   "tie_split": false,
