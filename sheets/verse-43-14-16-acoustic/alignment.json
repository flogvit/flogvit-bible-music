 "lines": [
  {
   "text": "I will ask the Father now",
   "heard": 6,
   "words": 6,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will give you another guide",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To be with you forevermore",
   "heard": 5,
   "words": 5,
   "error_s": 1.34,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the quiet of the night",
   "heard": 6,
   "words": 6,
   "error_s": 1.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Spirit of truth comes near",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who the world cannot receive",
   "heard": 5,
   "words": 5,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It neither sees nor knows his face",
   "heard": 7,
   "words": 7,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But you have him within",
   "heard": 5,
   "words": 5,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Another Advocate with you",
   "heard": 4,
   "words": 4,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Spirit of truth remains",
   "heard": 5,
   "words": 5,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is in you and with you",
   "heard": 7,
   "words": 7,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The truth that no one claims",
   "heard": 6,
   "words": 6,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will not leave you as orphans",
   "heard": 7,
   "words": 7,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am coming to return",
   "heard": 5,
   "words": 5,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In a little while you see",
   "heard": 6,
   "words": 6,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Father in the Son",
   "heard": 2,
   "words": 5,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The world will see me no more",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But you will see me live",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Because I live you will live",
   "heard": 6,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the Father and in me",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Another Advocate with you",
   "heard": 2,
   "words": 4,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Spirit of truth remains",
   "heard": 5,
   "words": 5,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is in you and with you",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The truth that no one claims",
   "heard": 6,
   "words": 6,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You know him for he stays",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He remains with you always",
   "heard": 5,
   "words": 5,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The world does not know his name",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But you are not alone",
   "heard": 5,
