 "lines": [
  {
   "text": "A name is written in the scroll",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Among the sons of Judah",
   "heard": 5,
   "words": 5,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The record keeps the family whole",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Though few have heard his name",
   "heard": 6,
   "words": 6,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is the brother of the wife",
   "heard": 7,
   "words": 7,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of Hodiah known in Judea",
   "heard": 5,
   "words": 5,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her sister stands within the life",
   "heard": 6,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A thread of ancient lineage",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Father of Keilah the Garmite",
   "heard": 5,
   "words": 5,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Eshtemoa the Maacathite",
   "heard": 3,
   "words": 4,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His name is bound to holy ground",
   "heard": 7,
   "words": 7,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the tribal record found",
   "heard": 5,
   "words": 5,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keilah stands with Akzib near",
   "heard": 5,
   "words": 5,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Mareshah in the list",
   "heard": 0,
   "words": 5,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Nine towns with their villages appear",
   "heard": 5,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the allotted land of bliss",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Eshtemoa with its pastureland",
   "heard": 3,
   "words": 4,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where shepherds keep their flocks",
   "heard": 5,
   "words": 5,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Part of the inheritance planned",
   "heard": 5,
   "words": 5,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the sons of Judah",
   "heard": 5,
   "words": 5,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
