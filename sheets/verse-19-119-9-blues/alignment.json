 "lines": [
  {
   "text": "How can a young man keep his path pure",
   "heard": 9,
   "words": 9,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By guarding it according to your word",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With all my heart I seek you now",
   "heard": 8,
   "words": 8,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not let me stray from your commandments",
   "heard": 8,
   "words": 8,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have stored up your word in my heart",
   "heard": 9,
   "words": 9,
   "error_s": 0.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So that I may not sin against you",
   "heard": 8,
   "words": 8,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your law is the light of my feet",
   "heard": 8,
   "words": 8,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Guiding me through the night",
   "heard": 5,
   "words": 5,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will thank you with an upright heart",
   "heard": 8,
   "words": 8,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As I learn your righteous judgments",
   "heard": 6,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will keep your statutes close",
   "heard": 6,
   "words": 6,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not utterly forsake me here",
   "heard": 6,
   "words": 6,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
