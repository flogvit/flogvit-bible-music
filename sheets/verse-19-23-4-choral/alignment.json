 "lines": [
  {
   "text": "The Lord is my shepherd, I lack nothing",
   "heard": 8,
   "words": 8,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He lets me lie down in green pastures",
   "heard": 8,
   "words": 8,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He leads me beside still waters",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He restores my soul so gently",
   "heard": 6,
   "words": 6,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Even though I walk through the valley",
   "heard": 7,
   "words": 7,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of the shadow of death, I fear no evil",
   "heard": 9,
   "words": 9,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For you are with me, always near",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your rod and your staff, they comfort me",
   "heard": 8,
   "words": 8,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You set a table before me",
   "heard": 6,
   "words": 6,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the presence of my enemies",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You anoint my head with oil",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My cup overflows with grace",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
