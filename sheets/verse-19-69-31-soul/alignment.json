 "words": 140,
 "lines": [
  {
   "text": "I am afflicted and in pain",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let your salvation lift me high",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Out of the dust and out of shame",
   "heard": 8,
   "words": 8,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I see your light in the sky",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will praise the name of God with song",
   "heard": 9,
   "words": 9,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will magnify him with thanksgiving",
   "heard": 6,
   "words": 6,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This will please the LORD more than an ox",
   "heard": 9,
   "words": 9,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "More than a bull with horns and hooves",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You who seek God let your hearts revive",
   "heard": 8,
   "words": 8,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The humble will see it and be glad",
   "heard": 8,
   "words": 8,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the LORD hears the needy cry",
   "heard": 6,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He does not despise his own in chains",
   "heard": 7,
   "words": 8,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will praise the name of God with song",
