 "words": 161,
 "lines": [
  {
   "text": "I sought the Lord and he heard my cry",
   "heard": 8,
   "words": 9,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He answered me from the other side",
   "heard": 7,
   "words": 7,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Delivered me from all my fears",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The weight of the world disappears",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Taste and see that the Lord is good",
   "heard": 8,
   "words": 8,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blessed is the one who stands in his blood",
   "heard": 9,
   "words": 9,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Refuge found in the shelter of grace",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No matter the price of time or space",
   "heard": 8,
   "words": 8,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Those who look to him shine with light",
   "heard": 8,
   "words": 8,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Their faces never see the night of shame",
   "heard": 8,
   "words": 8,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The poor man called and the Lord heard",
   "heard": 8,
   "words": 8,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He saved him from every trouble found",
   "heard": 7,
   "words": 7,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Taste and see that the Lord is good",
   "heard": 8,
   "words": 8,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blessed is the one who stands in his blood",
   "heard": 9,
   "words": 9,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Refuge found in the shelter of grace",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No matter the price of time or space",
   "heard": 8,
   "words": 8,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His angel encamps around the faithful",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rescuing the soul that has been shaken",
   "heard": 7,
   "words": 7,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fear the Lord you holy ones",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lacking nothing under the sun",
   "heard": 5,
   "words": 5,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Young lions grow poor and hungry",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But those who seek lack no good thing",
   "heard": 8,
   "words": 8,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  }
