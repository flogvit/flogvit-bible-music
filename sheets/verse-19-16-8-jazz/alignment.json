 "words_heard": 155,
 "words": 161,
 "lines": [
  {
   "text": "I hold my lot secure in your hand",
   "heard": 8,
   "words": 8,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My portion is your grace, my cup filled",
   "heard": 8,
   "words": 8,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The boundary lines fell in pleasant places",
   "heard": 7,
   "words": 7,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A beautiful inheritance, so true",
   "heard": 5,
   "words": 5,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have set the Lord always before me",
   "heard": 7,
   "words": 8,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is at my right hand, I will not be shaken",
   "heard": 11,
   "words": 11,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I bless the Lord who counsels my soul",
   "heard": 8,
   "words": 8,
   "error_s": 1.25,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "At night my inmost being is instructed",
   "heard": 7,
   "words": 7,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My heart is glad and my glory rejoices",
   "heard": 8,
   "words": 8,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My body rests secure in your keeping",
   "heard": 7,
   "words": 7,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have set the Lord always before me",
   "heard": 7,
   "words": 8,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is at my right hand, I will not be shaken",
   "heard": 11,
   "words": 11,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will not abandon my soul to the grave",
   "heard": 9,
   "words": 9,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nor let your faithful one see decay",
   "heard": 7,
   "words": 7,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You make known to me the path of life",
   "heard": 9,
   "words": 9,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In your presence there is fullness of joy",
   "heard": 8,
   "words": 8,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I have set the Lord always before me",
   "heard": 7,
   "words": 8,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is at my right hand, I will not be shaken",
   "heard": 11,
   "words": 11,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At your right hand are pleasures forevermore",
   "heard": 5,
   "words": 7,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord is my portion, precious",
   "heard": 5,
   "words": 6,
   "error_s": 1.67,
   "tie_split": true,
   "uncertain": true
  }
 ],
