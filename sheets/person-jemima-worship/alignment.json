   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A beauty that is much",
   "heard": 5,
   "words": 5,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
