 "words": 129,
 "lines": [
  {
   "text": "Langt borte i et fremmed land",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "der satt jeg uten noe",
   "heard": 5,
   "words": 5,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jeg tenkte p\u00e5 min fars hus",
   "heard": 6,
   "words": 6,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og alt det gode der",
   "heard": 5,
   "words": 5,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jeg vil bryte opp og g\u00e5",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og si til ham i dag",
   "heard": 6,
   "words": 6,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Far, jeg har syndet mot himmelen og mot deg",
   "heard": 9,
   "words": 9,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han l\u00f8p meg i m\u00f8te",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "han kastet seg om halsen min",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han var d\u00f8d og er blitt levende",
   "heard": 7,
   "words": 7,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "han var tapt og er funnet",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jeg er ikke lenger verdig",
   "heard": 5,
   "words": 5,
   "error_s": 0.25,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "\u00e5 kalles s\u00f8nnen din",
   "heard": 4,
   "words": 4,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Men far han hentet kappen",
   "heard": 5,
   "words": 5,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og ringen til min h\u00e5nd",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Og sko p\u00e5 mine f\u00f8tter",
   "heard": 5,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og festen ble gjort klar",
   "heard": 5,
   "words": 5,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For denne s\u00f8nnen min var d\u00f8d og lever n\u00e5",
   "heard": 9,
   "words": 9,
   "error_s": 0.53,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Han l\u00f8p meg i m\u00f8te",
   "heard": 5,
