 "lines": [
  {
   "text": "Three months at sea on Alexandrian ship",
   "heard": 7,
   "words": 7,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At Syracuse we stayed three days",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To Rhegium we went and Puteoli too",
   "heard": 6,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Brothers invited us to stay a week",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We came to Rome and met the elders",
   "heard": 8,
   "words": 8,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Paul said I did no wrong to my people",
   "heard": 9,
   "words": 9,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They wanted to release me from my chains",
   "heard": 8,
   "words": 8,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But I appealed to Caesar for hope",
   "heard": 7,
   "words": 7,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Proclaiming the kingdom of God",
   "heard": 5,
   "words": 5,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Teaching about the Lord Jesus Christ",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With complete boldness and full assurance",
   "heard": 6,
   "words": 6,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Without any hindrance at all",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From morning until evening he spoke",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Testifying about Jesus from the Law",
   "heard": 5,
   "words": 6,
   "error_s": 0.19,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Some were convinced by his words",
   "heard": 6,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Others would not believe his message",
