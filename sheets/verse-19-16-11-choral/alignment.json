 "lines": [
  {
   "text": "I have set the LORD always before me",
   "heard": 8,
   "words": 8,
   "error_s": 3.97,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Because he is at my right hand I will not be shaken",
   "heard": 12,
   "words": 12,
   "error_s": 3.9,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My heart is glad and my glory rejoices",
   "heard": 8,
   "words": 8,
   "error_s": 4.13,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My body also rests secure in his care",
   "heard": 8,
   "words": 8,
   "error_s": 4.0,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You make known to me the path of life",
   "heard": 9,
   "words": 9,
   "error_s": 3.58,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "In your presence there is fullness of joy",
   "heard": 8,
   "words": 8,
   "error_s": 3.43,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "At your right hand are pleasures forevermore",
   "heard": 7,
   "words": 7,
   "error_s": 3.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I hold you close and I am not afraid",
   "heard": 8,
   "words": 9,
   "error_s": 3.07,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You will not abandon my soul to the grave",
   "heard": 9,
   "words": 9,
   "error_s": 3.32,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Nor let your faithful one see decay",
   "heard": 7,
   "words": 7,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My hope is bound to your steadfast love",
   "heard": 8,
   "words": 8,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
