 "offset_seconds": -0.12000000000025324,
 "words_heard": 119,
 "words": 128,
 "lines": [
  {
   "text": "The sons of Kohath are named in truth",
   "heard": 8,
   "words": 8,
   "error_s": 3.49,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Amram and Izhar stand together",
   "heard": 5,
   "words": 5,
   "error_s": 3.92,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Hebron and Uzziel follow suit",
   "heard": 5,
   "words": 5,
   "error_s": 3.7,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "One hundred thirty three years lived here",
   "heard": 7,
   "words": 7,
   "error_s": 3.95,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The sons of Izhar are counted clear",
   "heard": 7,
   "words": 7,
   "error_s": 4.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Korah and Nepheg and Zichri too",
   "heard": 6,
   "words": 6,
   "error_s": 4.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Descendants serving the tabernacle",
   "heard": 4,
   "words": 4,
   "error_s": 4.64,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Their duties fixed for Levitical view",
   "heard": 6,
   "words": 6,
   "error_s": 4.59,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In David's time the Izharites stood",
   "heard": 6,
   "words": 6,
   "error_s": 4.59,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "As officials and judges over Israel",
   "heard": 6,
   "words": 6,
   "error_s": 4.99,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In charge of treasuries and gifts",
   "heard": 6,
   "words": 6,
   "error_s": 5.04,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Dedicated for the house of God",
   "heard": 6,
   "words": 6,
   "error_s": 5.47,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Korah rose up against Moses there",
   "heard": 6,
   "words": 6,
   "error_s": 5.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With Dathan and Abiram from Reuben",
   "heard": 6,
   "words": 6,
   "error_s": 5.69,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Two hundred and fifty men opposed",
   "heard": 2,
   "words": 6,
   "error_s": 6.15,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Challenging the holy Levite men",
   "heard": 5,
   "words": 5,
   "error_s": 6.2,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Take censers and lay incense on fire",
   "heard": 4,
   "words": 7,
   "error_s": 6.12,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Present it before the LORD tomorrow",
   "heard": 4,
   "words": 6,
   "error_s": 7.06,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The man he chooses will be holy",
   "heard": 7,
   "words": 7,
   "error_s": 7.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Levites have gone too far",
   "heard": 6,
   "words": 6,
   "error_s": 7.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The earth of men is fallen down",
   "heard": 7,
   "words": 7,
   "error_s": 7.31,
   "tie_split": false,
   "uncertain": true
  }
 ],
