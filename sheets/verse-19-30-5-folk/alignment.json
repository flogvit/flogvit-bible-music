   "uncertain": true
  },
  {
   "text": "His favor a lifetime",
   "heard": 4,
   "words": 4,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When I felt secure I said",
   "heard": 6,
   "words": 6,
   "error_s": 21.96,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I would never be shaken",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But when you hid your face",
   "heard": 6,
   "words": 6,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
