   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To restore the broken altar",
   "heard": 5,
   "words": 5,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Watch answering watch we stay",
   "heard": 4,
   "words": 5,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Praise and thanks in day and night",
