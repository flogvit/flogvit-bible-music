{
 "id": "person-sokja-gospel",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-sokja-gospel",
 "offset_seconds": -3.880000000000173,
 "words_heard": 249,
 "words": 250,
 "lines": [
  {
   "text": "These are the people of the province who came up out of the captivity",
   "heard": 14,
   "words": 14,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nebuchadnezzar king of Babylon had carried them away",
   "heard": 8,
   "words": 8,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They returned to Jerusalem and Judah, each to his own town",
   "heard": 11,
   "words": 11,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With Zerubbabel and Jeshua leading the way",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When the seventh month came the Israelites were settled in their towns",
   "heard": 12,
   "words": 12,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people gathered as one in Jerusalem to stand",
   "heard": 9,
   "words": 9,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jeshua and Zerubbabel set to work with their kinsmen",
   "heard": 9,
   "words": 9,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To rebuild the altar of the God of Israel",
   "heard": 9,
   "words": 9,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Settled in their towns, the families are registered",
   "heard": 8,
   "words": 8,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Restoring worship in the place God has blessed",
   "heard": 8,
   "words": 8,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The ears of all the people are attentive to the Law",
   "heard": 11,
   "words": 11,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We are one again, returning home",
   "heard": 6,
   "words": 6,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They set the altar on its foundations in dread of surrounding lands",
   "heard": 12,
   "words": 12,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Offering burnt offerings to the LORD both morning and evening",
   "heard": 10,
   "words": 10,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ezra brought the Book of the Law to the square before the Water Gate",
   "heard": 13,
   "words": 14,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Reading from daybreak until midday to the men and women",
   "heard": 10,
   "words": 10,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Settled in their towns, the families are registered",
   "heard": 8,
   "words": 8,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Restoring worship in the place God has blessed",
   "heard": 8,
   "words": 8,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The ears of all the people are attentive to the Law",
   "heard": 11,
   "words": 11,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We are one again, returning home",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The priests and Levites and the rest of the returned exiles",
   "heard": 11,
   "words": 11,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Celebrated the dedication of this house of God with joy",
   "heard": 10,
   "words": 10,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hundred bulls, two hundred rams, and four hundred lambs",
   "heard": 9,
   "words": 9,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Twelve male goats for the tribes, sin offering complete",
   "heard": 9,
   "words": 9,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Installed in their groups for the service of God in Jerusalem",
   "heard": 11,
   "words": 11,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As prescribed in the book of Moses, we stand",
   "heard": 9,
   "words": 9,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  }
 ],
