{
 "id": "person-kyros-choral",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-kyros-choral",
 "offset_seconds": 10.279999999999525,
 "words_heard": 179,
 "words": 179,
 "lines": [
  {
   "text": "Who says of Cyrus, He is my shepherd",
   "heard": 8,
   "words": 8,
   "error_s": 12.25,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He will accomplish all that I please",
   "heard": 7,
   "words": 7,
   "error_s": 12.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Who says of Jerusalem, It shall be rebuilt",
   "heard": 8,
   "words": 8,
   "error_s": 12.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And of the temple, Its foundation shall be laid",
   "heard": 9,
   "words": 9,
   "error_s": 12.15,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "This is what the LORD says to his anointed",
   "heard": 9,
   "words": 9,
   "error_s": 12.03,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To Cyrus, whose right hand I have grasped",
   "heard": 8,
   "words": 8,
   "error_s": 12.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To subdue nations before him and strip kings",
   "heard": 8,
   "words": 8,
   "error_s": 12.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Of their armor, to open doors before him",
   "heard": 8,
   "words": 8,
   "error_s": 12.43,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I will go before you and level the mountains",
   "heard": 9,
   "words": 9,
   "error_s": 12.67,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I will shatter doors of bronze and cut through bars",
   "heard": 10,
   "words": 10,
   "error_s": 12.59,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I will give you treasures of darkness hidden",
   "heard": 8,
   "words": 8,
   "error_s": 12.96,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "So that you may know that I am the LORD",
   "heard": 10,
   "words": 10,
   "error_s": 12.66,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For the sake of my servant Jacob",
   "heard": 7,
   "words": 7,
   "error_s": 13.11,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Of Israel my chosen, I have called you by name",
   "heard": 10,
   "words": 10,
   "error_s": 12.68,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I have given you a title of honor",
   "heard": 8,
   "words": 8,
   "error_s": 12.65,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Though you do not know me, I am the LORD",
   "heard": 10,
   "words": 10,
   "error_s": 13.25,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the first year of Cyrus king of Persia",
   "heard": 9,
   "words": 9,
   "error_s": 13.18,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The LORD stirred up the spirit of Cyrus",
   "heard": 8,
   "words": 8,
   "error_s": 13.59,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He sent a proclamation throughout his kingdom",
   "heard": 7,
   "words": 7,
   "error_s": 13.52,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To build the house of the LORD in Jerusalem",
   "heard": 9,
   "words": 9,
   "error_s": 14.27,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "I am the LORD, and there is no other",
   "heard": 9,
   "words": 9,
   "error_s": 13.69,
   "tie_split": false,
   "uncertain": true
  }
 ],
