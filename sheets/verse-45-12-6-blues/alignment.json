 "words": 124,
 "lines": [
  {
   "text": "We are one body in Christ",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Each part has a function to play",
   "heard": 7,
   "words": 7,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not think of yourself too high",
   "heard": 7,
   "words": 7,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Judge with sober judgment today",
   "heard": 5,
   "words": 5,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If it is prophecy prophesy",
   "heard": 5,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In proportion to your faith",
   "heard": 5,
   "words": 5,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If it is service then serve",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If it is teaching teach",
   "heard": 5,
   "words": 5,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If it is encouragement encourage",
   "heard": 5,
   "words": 5,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If it is giving give generously",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If it is leading lead diligently",
   "heard": 6,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Showing mercy do it cheerfully",
   "heard": 5,
   "words": 5,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If it is prophecy prophesy",
   "heard": 5,
   "words": 5,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In proportion to your faith",
   "heard": 5,
   "words": 5,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "If it is service then serve",
   "heard": 6,
   "words": 6,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If it is teaching teach",
   "heard": 5,
   "words": 5,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let love be genuine always",
   "heard": 5,
   "words": 5,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hate what is evil hold fast to good",
   "heard": 8,
   "words": 8,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Devoted in brotherly love",
   "heard": 4,
   "words": 4,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Outdo one another in honor",
   "heard": 5,
   "words": 5,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Never let your zeal grow slack",
   "heard": 6,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Be fervent in spirit serve the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  }
