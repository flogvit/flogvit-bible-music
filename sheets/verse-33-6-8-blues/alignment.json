   "error_s": 1.79,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Only to do justice",
   "heard": 4,
   "words": 4,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
