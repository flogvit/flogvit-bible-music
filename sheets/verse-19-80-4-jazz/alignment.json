   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shine forth with your holy might",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
