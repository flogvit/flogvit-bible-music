 "words_heard": 109,
 "words": 111,
 "lines": [
  {
   "text": "The LORD is my shepherd, I lack nothing",
   "heard": 8,
   "words": 8,
   "error_s": 1.45,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He lets me lie down in green pastures",
   "heard": 8,
   "words": 8,
   "error_s": 1.95,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He leads me beside still waters",
   "heard": 6,
   "words": 6,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He restores my soul",
   "heard": 4,
   "words": 4,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He guides me along right paths",
   "heard": 6,
   "words": 6,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For his name's sake",
   "heard": 2,
   "words": 4,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Even though I walk through the valley of the shadows",
   "heard": 10,
   "words": 10,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I fear no evil, for you are with me",
   "heard": 9,
   "words": 9,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your rod and your staff, they comfort me",
   "heard": 8,
   "words": 8,
   "error_s": 1.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You set a table before me in the presence of my enemies",
   "heard": 12,
   "words": 12,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You anoint my head with oil, my cup overflows",
   "heard": 9,
   "words": 9,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Surely goodness and mercy will pursue me all the days of my life",
   "heard": 13,
   "words": 13,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And I will dwell in the house of the LORD for length of days",
   "heard": 14,
   "words": 14,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  }
 ],
