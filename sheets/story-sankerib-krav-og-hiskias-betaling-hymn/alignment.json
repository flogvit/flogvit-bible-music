 "words": 102,
 "lines": [
  {
   "text": "In Hezekiah's fourteenth year,",
   "heard": 4,
   "words": 4,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Assyrian king drew near.",
   "heard": 5,
   "words": 5,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sennacherib attacked the land,",
   "heard": 4,
   "words": 4,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He took the strongholds in his hand.",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "From Lachish Hezekiah spoke,",
   "heard": 4,
   "words": 4,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "\"I have sinned, my sins I broke.\"",
   "heard": 7,
   "words": 7,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "\"Withdraw from me, I will pay,",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whatever you demand today.\"",
   "heard": 4,
   "words": 4,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Three hundred talents of silver stood,",
   "heard": 4,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Thirty talents of gold added to the wood.",
   "heard": 7,
   "words": 8,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He gave the silver found inside,",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The house of the Lord, side by side.",
   "heard": 8,
   "words": 8,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From palace treasuries he drew,",
   "heard": 5,
   "words": 5,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Every coin that he knew.",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The doors of the temple he stripped bare,",
   "heard": 8,
   "words": 8,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The gold he gave him there.",
   "heard": 6,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He gave the doors to the king of Assyria.",
   "heard": 9,
   "words": 9,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  }
 ],
