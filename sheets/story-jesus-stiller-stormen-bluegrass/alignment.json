 "offset_seconds": -1.9800000000002136,
 "words_heard": 155,
 "words": 156,
 "lines": [
  {
   "text": "The wind came howling off the hills",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The waves broke over the side",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The boat was filling fast with water",
   "heard": 7,
   "words": 7,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the fishermen cried",
   "heard": 4,
   "words": 4,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But Jesus slept down in the stern",
   "heard": 7,
   "words": 7,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His head upon a pillow",
   "heard": 5,
   "words": 5,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Teacher, don't you care at all",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We're going down below",
   "heard": 4,
   "words": 4,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Quiet, be still, he said to the sea",
   "heard": 8,
   "words": 8,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the wind lay down at his feet",
   "heard": 8,
   "words": 8,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who is this man, who can this be",
   "heard": 8,
   "words": 8,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Even the wind and the waves obey",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He rose and spoke into the gale",
   "heard": 7,
   "words": 7,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And all the storm was gone",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The water lay as smooth as glass",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Beneath the morning sun",
   "heard": 4,
   "words": 4,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why are you so afraid, he said",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do you still have no faith",
   "heard": 6,
   "words": 6,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They trembled in the quiet boat",
   "heard": 6,
   "words": 6,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And looked into his face",
   "heard": 5,
   "words": 5,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Quiet, be still, he said to the sea",
   "heard": 8,
   "words": 8,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
