 "offset_seconds": -3.8600000000001735,
 "words_heard": 122,
 "words": 123,
 "lines": [
  {
   "text": "Upon a hill outside the gate",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They raised a cross of wood",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And there the Son of God was hung",
   "heard": 8,
   "words": 8,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where we ourselves had stood",
   "heard": 5,
   "words": 5,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The crowd went by and shook their heads",
   "heard": 8,
   "words": 8,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And mocked him as he died",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The soldiers gambled for his clothes",
   "heard": 6,
   "words": 6,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And pierced him in his side",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The message of the cross is called",
   "heard": 7,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But foolishness by some",
   "heard": 4,
   "words": 4,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet unto us who are being saved",
   "heard": 7,
   "words": 7,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The power of God has come",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will not boast in anything",
   "heard": 6,
   "words": 6,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But in the cross of Christ",
   "heard": 6,
   "words": 6,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The world is crucified to me",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And I to it have died",
   "heard": 6,
   "words": 6,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now let the proud lay down their crowns",
   "heard": 8,
   "words": 8,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The wise their clever word",
   "heard": 4,
   "words": 5,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For in this foolishness we find",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The wisdom of the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  }
 ],
