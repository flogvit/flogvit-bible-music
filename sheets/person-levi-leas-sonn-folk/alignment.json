 "lines": [
  {
   "text": "She bore three sons to join her heart",
   "heard": 8,
   "words": 8,
   "error_s": 4.9,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Now at last my husband stays",
   "heard": 6,
   "words": 6,
   "error_s": 5.73,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Named Levi for the bond they share",
   "heard": 7,
   "words": 7,
   "error_s": 5.72,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The third son of Jacob's days",
