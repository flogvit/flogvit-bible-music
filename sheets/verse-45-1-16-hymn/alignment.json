   "words": 8,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the wise and to the foolish alike",
   "heard": 8,
   "words": 8,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
