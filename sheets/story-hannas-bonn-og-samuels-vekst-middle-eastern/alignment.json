 "lines": [
  {
   "text": "My heart exults in the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My strength is lifted up in the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 1.53,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "There is none holy like the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "There is none besides you",
   "heard": 5,
   "words": 5,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Lord brings low and he lifts up",
   "heard": 8,
   "words": 8,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He raises the poor from the dust",
   "heard": 7,
   "words": 7,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He lifts the needy from the ash heap",
   "heard": 6,
   "words": 8,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To sit with princes",
   "heard": 4,
   "words": 4,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The bows of the mighty are broken",
   "heard": 7,
   "words": 7,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The feeble are clothed with strength",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The barren has borne seven",
   "heard": 4,
   "words": 5,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord kills and brings to life",
   "heard": 6,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord brings low and he lifts up",
