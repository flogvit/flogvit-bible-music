 "words": 153,
 "lines": [
  {
   "text": "God blessed them and said to them",
   "heard": 7,
   "words": 7,
   "error_s": 3.75,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Be fruitful and multiply",
   "heard": 4,
   "words": 4,
   "error_s": 3.38,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Fill the earth and subdue it",
   "heard": 6,
   "words": 6,
   "error_s": 2.27,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Rule over the sea and sky",
   "heard": 6,
   "words": 6,
   "error_s": 2.13,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Every seed-bearing plant on earth",
   "heard": 4,
   "words": 5,
   "error_s": 1.7,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Every tree with fruit and seed",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They will be your food to eat",
   "heard": 7,
   "words": 7,
   "error_s": 0.62,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "From the ground where you proceed",
   "heard": 6,
   "words": 6,
   "error_s": 1.26,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "God saw all that he had made",
   "heard": 6,
   "words": 7,
   "error_s": 1.92,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And behold, it was very good",
   "heard": 6,
   "words": 6,
   "error_s": 1.33,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The evening came, the morning rose",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sixth day stood as it should",
   "heard": 7,
   "words": 7,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To wild animals of the earth",
   "heard": 6,
   "words": 6,
   "error_s": 4.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To birds that fly in high",
   "heard": 6,
   "words": 6,
   "error_s": 1.74,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Green plants for their food to eat",
   "heard": 6,
   "words": 7,
   "error_s": 1.81,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Under the open sky",
   "heard": 4,
   "words": 4,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God saw all that he had made",
