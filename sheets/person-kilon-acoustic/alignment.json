 "lines": [
  {
   "text": "In days when the judges ruled the land",
   "heard": 8,
   "words": 8,
   "error_s": 4.07,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A famine emptied out the grain",
   "heard": 5,
   "words": 6,
   "error_s": 3.91,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "A man left Bethlehem in Judah",
   "heard": 5,
   "words": 6,
   "error_s": 3.4,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Seeking bread in foreign plain",
