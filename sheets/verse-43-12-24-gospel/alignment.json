 "words": 194,
 "lines": [
  {
   "text": "The hour has come for the Son of Man",
   "heard": 9,
   "words": 9,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "to be glorified in this place",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Truly, truly, I tell you now",
   "heard": 6,
   "words": 6,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "what the grain of wheat will face",
   "heard": 7,
   "words": 7,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Unless it falls into the earth",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "and dies within the dark",
   "heard": 5,
   "words": 5,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "it remains alone, a single seed",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "with no life to mark",
   "heard": 5,
   "words": 5,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But if it dies, it bears much fruit",
   "heard": 8,
   "words": 8,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "the hidden life breaks through",
   "heard": 5,
   "words": 5,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever loves his life loses it",
   "heard": 6,
   "words": 6,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "while hate keeps it for you",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever hates his life in this world",
   "heard": 7,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "will keep it for eternal life",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If anyone serves me, follow close",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "where I am, he will strive",
   "heard": 6,
   "words": 6,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where I am, there my servant will be",
   "heard": 8,
   "words": 8,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "honored by the Father\u2019s hand",
   "heard": 5,
   "words": 5,
   "error_s": 1.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "No servant stands alone in this",
   "heard": 6,
   "words": 6,
   "error_s": 1.59,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "the Father\u2019s love commands",
   "heard": 4,
   "words": 4,
   "error_s": 2.44,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "But if it dies, it bears much fruit",
   "heard": 8,
   "words": 8,
   "error_s": 4.72,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "the hidden life breaks through",
   "heard": 5,
   "words": 5,
   "error_s": 6.79,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Whoever loves his life loses it",
   "heard": 6,
   "words": 6,
   "error_s": 6.82,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "while hate keeps it for you",
   "heard": 6,
   "words": 6,
   "error_s": 5.92,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Now my soul is troubled deeply",
   "heard": 6,
   "words": 6,
   "error_s": 11.67,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "what shall I say to the sky",
   "heard": 7,
   "words": 7,
   "error_s": 9.97,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Father, save me from this hour",
   "heard": 6,
   "words": 6,
   "error_s": 11.89,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "is the prayer that rises high",
   "heard": 5,
   "words": 6,
   "error_s": 13.2,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "No, for this purpose I came",
   "heard": 6,
   "words": 6,
   "error_s": 18.55,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "to stand in this hour",
   "heard": 5,
   "words": 5,
   "error_s": 18.35,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The grain falls, the fruit rises",
   "heard": 6,
   "words": 6,
   "error_s": 19.63,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "the glory is ours",
   "heard": 4,
   "words": 4,
   "error_s": 16.82,
   "tie_split": true,
   "uncertain": true
  }
 ],
