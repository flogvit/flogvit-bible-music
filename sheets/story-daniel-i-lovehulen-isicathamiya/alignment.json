   "words": 5,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And they have not hurt me",
   "heard": 5,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At the break of day the king came running",
