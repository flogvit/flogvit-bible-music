 "words_heard": 191,
 "words": 194,
 "lines": [
  {
   "text": "If your son should ask for bread, would you hand him a stone",
   "heard": 13,
   "words": 13,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If he asks you for a fish, would you give him a snake",
   "heard": 13,
   "words": 13,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If even we know how to give good gifts to our own",
   "heard": 12,
   "words": 12,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How much more will the Father give, for his children's sake",
   "heard": 11,
   "words": 11,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ask, and it will be given to you",
   "heard": 8,
   "words": 8,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seek, and you will find",
   "heard": 5,
   "words": 5,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Knock, and the door will be opened to you",
   "heard": 9,
   "words": 9,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ask, seek, knock",
   "heard": 3,
   "words": 3,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I come with empty hands and I knock upon the door",
   "heard": 11,
   "words": 11,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I'm asking for the daily bread like I have asked before",
   "heard": 9,
   "words": 11,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My Father hears me knocking and he knows the things I need",
   "heard": 12,
   "words": 12,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will not give me stones, he gives good gifts indeed",
   "heard": 11,
   "words": 11,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ask, and it will be given to you",
   "heard": 8,
   "words": 8,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seek, and you will find",
   "heard": 5,
   "words": 5,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Knock, and the door will be opened to you",
   "heard": 9,
   "words": 9,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ask, seek, knock",
   "heard": 2,
   "words": 3,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For everyone who asks receives",
   "heard": 5,
   "words": 5,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the one who seeks finds",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And to the one who knocks the door will be opened",
   "heard": 11,
   "words": 11,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How much more will your Father in heaven",
   "heard": 8,
   "words": 8,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give good things to those who ask him",
   "heard": 8,
   "words": 8,
   "error_s": 0.27,
