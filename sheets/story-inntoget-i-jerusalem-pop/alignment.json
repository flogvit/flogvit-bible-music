 "lines": [
  {
   "text": "Down from the Mount of Olives on a borrowed colt he rides",
   "heard": 12,
   "words": 12,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No sword and no chariot, no soldiers at his side",
   "heard": 10,
   "words": 10,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people throw their cloaks out on the dusty road ahead",
   "heard": 11,
   "words": 11,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They cut the branches from the trees and lay them down instead",
   "heard": 12,
   "words": 12,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Say to the daughter of Zion",
   "heard": 6,
   "words": 6,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look, your king is coming to you",
   "heard": 7,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gentle and riding on a donkey",
   "heard": 6,
   "words": 6,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hosanna to the Son of David",
   "heard": 6,
   "words": 6,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
