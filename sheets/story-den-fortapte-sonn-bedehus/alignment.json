 "words": 151,
 "lines": [
  {
   "text": "Far off in a foreign land",
   "heard": 5,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I sat with nothing left",
   "heard": 5,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I thought about my father's house",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And all the good I left",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will get up and go to him",
   "heard": 8,
   "words": 8,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And say to him today",
   "heard": 5,
   "words": 5,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Father, I have sinned against heaven and before you",
   "heard": 9,
   "words": 9,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He ran to meet me on the road",
   "heard": 8,
   "words": 8,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He threw his arms around my neck",
   "heard": 7,
   "words": 7,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This son of mine was dead and is alive again",
   "heard": 10,
   "words": 10,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He was lost and is found",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am no longer worthy",
   "heard": 5,
   "words": 5,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To be called your son",
   "heard": 5,
   "words": 5,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But father called for the best robe",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A ring upon my hand",
   "heard": 5,
   "words": 5,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And sandals on my feet",
   "heard": 5,
   "words": 5,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the feast was all made ready",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For this son of mine was dead and is alive",
   "heard": 10,
   "words": 10,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He ran to meet me on the road",
   "heard": 8,
