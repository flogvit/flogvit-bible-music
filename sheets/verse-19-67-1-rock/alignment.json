 "lines": [
  {
   "text": "May God be gracious to us and bless us",
   "heard": 9,
   "words": 9,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And make his face shine upon us",
   "heard": 7,
   "words": 7,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His light breaks through the morning",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A mercy that we cannot earn",
   "heard": 6,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let your way be known on earth",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your salvation among all nations",
   "heard": 5,
   "words": 5,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Let the peoples praise you, O God",
