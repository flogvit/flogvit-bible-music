 "lines": [
  {
   "text": "I could sing like the angels",
   "heard": 6,
   "words": 6,
   "error_s": 6.18,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I could speak in every tongue",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But without love I'm a clanging gong",
   "heard": 7,
   "words": 7,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A song that's never sung",
   "heard": 5,
   "words": 5,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I could move every mountain",
   "heard": 4,
   "words": 5,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give away all that I own",
   "heard": 6,
   "words": 6,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But without love I gain nothing",
   "heard": 6,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I'm standing here alone",
   "heard": 4,
   "words": 4,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Love is patient, love is kind",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keeps no record of wrongs",
   "heard": 5,
   "words": 5,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It bears all things, believes all things",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hopes all things, endures all things",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Love never ends",
