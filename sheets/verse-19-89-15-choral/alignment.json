   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Love and faithfulness walk ahead of us",
   "heard": 7,
   "words": 7,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Light upon our path, day and night",
   "heard": 7,
   "words": 7,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We lift our voices in holy praise",
   "heard": 7,
   "words": 7,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
