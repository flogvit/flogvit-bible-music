 "lines": [
  {
   "text": "Terah lived in Ur of Chaldees",
   "heard": 6,
   "words": 6,
   "error_s": 2.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Seventy years he walked the dust",
   "heard": 4,
   "words": 6,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He became the father of three sons",
   "heard": 7,
   "words": 7,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abram, Nahor, and Haran he trusted",
   "heard": 6,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Haran became the father of Lot",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Milcah and Iscah came from him",
   "heard": 6,
   "words": 6,
   "error_s": 0.56,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "He died in the land of his birth",
   "heard": 8,
   "words": 8,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "While his father Terah still lived",
   "heard": 6,
   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
