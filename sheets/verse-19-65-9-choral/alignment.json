   "words": 6,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The hills are robed with joy, they sing",
   "heard": 8,
   "words": 8,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
