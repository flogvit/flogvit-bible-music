 "lines": [
  {
   "text": "Hold each other in the highest love",
   "heard": 7,
   "words": 7,
   "error_s": 15.04,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Because of the work they do",
   "heard": 6,
   "words": 6,
   "error_s": 15.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Live in peace with one another",
   "heard": 6,
   "words": 6,
   "error_s": 14.92,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Admonish the idle and few",
   "heard": 5,
   "words": 5,
   "error_s": 14.8,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Comfort the discouraged hearts",
   "heard": 4,
   "words": 4,
   "error_s": 15.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Help the weak along the way",
   "heard": 6,
   "words": 6,
   "error_s": 14.68,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Be patient with everyone",
   "heard": 4,
   "words": 4,
   "error_s": 14.87,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Never repay evil",
   "heard": 3,
   "words": 3,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
