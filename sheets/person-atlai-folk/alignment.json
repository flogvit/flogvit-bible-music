 "lines": [
  {
   "text": "Ezra wept before the house of God",
   "heard": 6,
   "words": 7,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A large assembly gathered around",
   "heard": 5,
   "words": 5,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Men and women weeping bitterly",
   "heard": 5,
   "words": 5,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sin had filled the holy ground",
   "heard": 6,
   "words": 6,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shecaniah spoke up to Ezra's ear",
   "heard": 5,
   "words": 6,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We have been unfaithful to God",
   "heard": 6,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet hope remains for Israel now",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let us follow the covenant",
   "heard": 5,
   "words": 5,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Send away all these foreign wives",
   "heard": 6,
   "words": 6,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Along with their children too",
   "heard": 5,
   "words": 5,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do it according to the Law",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It is our duty to do",
   "heard": 6,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ezra stood up and spoke aloud",
   "heard": 5,
   "words": 6,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You have added to Israel's guilt",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Make confession to the Lord your God",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do his will and separate",
   "heard": 5,
   "words": 5,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Send away all these foreign wives",
   "heard": 6,
   "words": 6,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Along with their children too",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do it according to the Law",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It is our duty to do",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heads of families sat to judge",
   "heard": 3,
   "words": 6,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Examining each case with care",
   "heard": 5,
   "words": 5,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the sons of Bebai's line",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Athlai agreed to leave",
   "heard": 2,
   "words": 4,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Send away all these foreign wives",
