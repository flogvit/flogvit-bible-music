 "lines": [
  {
   "text": "With feet strapped by the gospel peace",
   "heard": 7,
   "words": 7,
   "error_s": 2.62,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Take up the shield of faith",
   "heard": 6,
   "words": 6,
   "error_s": 1.64,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Extinguish every flaming arrow",
   "heard": 4,
   "words": 4,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of the evil one in his wrath",
   "heard": 6,
   "words": 7,
   "error_s": 1.52,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Helmet of salvation on my head",
   "heard": 6,
   "words": 6,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sword of the Spirit in my hand",
   "heard": 7,
   "words": 7,
   "error_s": 1.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The word of God is the blade",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That cuts through the darkness in the land",
   "heard": 8,
   "words": 8,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pray in the Spirit at all times",
   "heard": 7,
   "words": 7,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With every kind of prayer and petition",
   "heard": 7,
   "words": 7,
   "error_s": 1.44,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Stay alert and persevere",
   "heard": 4,
   "words": 4,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For all the saints in this world",
   "heard": 7,
   "words": 7,
   "error_s": 1.66,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Pray for me that words may come",
   "heard": 7,
   "words": 7,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When I open my mouth to speak",
   "heard": 7,
   "words": 7,
   "error_s": 1.47,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Boldly make known the mystery",
   "heard": 5,
   "words": 5,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of the gospel that I seek",
   "heard": 6,
   "words": 6,
   "error_s": 1.2,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Pray in the Spirit at all times",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With every kind of prayer and petition",
