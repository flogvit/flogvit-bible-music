 "lines": [
  {
   "text": "Many foes have risen up against me",
   "heard": 7,
   "words": 7,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Voices claim there is no help in God",
   "heard": 8,
   "words": 8,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They crowd in on every side I see",
   "heard": 6,
   "words": 8,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But I know the truth in the heart of the Lord",
   "heard": 11,
   "words": 11,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But you Lord are a shield around me",
   "heard": 8,
   "words": 8,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My glory and the one who lifts my head high",
   "heard": 10,
   "words": 10,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are the strength when I am weak",
   "heard": 8,
   "words": 8,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My refuge in the dark and the light",
   "heard": 8,
   "words": 8,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I call aloud to the Lord for help",
   "heard": 8,
   "words": 8,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He answers me from his holy mountain",
   "heard": 7,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My heart finds rest in His firm grip",
   "heard": 8,
   "words": 8,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The truth that is certain and unshaken",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
