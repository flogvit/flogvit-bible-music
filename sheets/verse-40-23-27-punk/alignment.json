  {
   "text": "Woe to you, scribes and Pharisees",
   "heard": 6,
   "words": 6,
   "error_s": 5.23,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Hypocrites",
   "heard": 1,
   "words": 1,
   "error_s": 4.91,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You tithe your mint and dill and cumin",
   "heard": 8,
   "words": 8,
   "error_s": 5.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And neglect the weightier things",
   "heard": 5,
   "words": 5,
   "error_s": 5.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Whitewashed tombs, whitewashed tombs",
   "heard": 4,
   "words": 4,
   "error_s": 3.73,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Beautiful outside, dead men's bones within",
