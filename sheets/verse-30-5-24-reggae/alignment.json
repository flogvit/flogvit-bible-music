 "words": 129,
 "lines": [
  {
   "text": "I hate, I despise your feasts",
   "heard": 6,
   "words": 6,
   "error_s": 1.88,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I take no delight in your solemn assemblies",
   "heard": 8,
   "words": 8,
   "error_s": 1.57,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Though you offer me your offerings",
   "heard": 6,
   "words": 6,
   "error_s": 1.59,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I will not accept them",
   "heard": 5,
   "words": 5,
   "error_s": 4.98,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Take away from me the noise of your songs",
   "heard": 9,
   "words": 9,
   "error_s": 0.42,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "To the melody of your harps I will not listen",
   "heard": 10,
   "words": 10,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your festivals are empty",
   "heard": 4,
   "words": 4,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When the poor cry out at your gate",
   "heard": 8,
   "words": 8,
   "error_s": 0.43,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "But let justice roll down like waters",
   "heard": 7,
   "words": 7,
   "error_s": 1.27,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "And righteousness like an ever-flowing stream",
   "heard": 5,
   "words": 6,
   "error_s": 1.55,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Let justice roll down like waters",
   "heard": 6,
   "words": 6,
   "error_s": 2.07,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Righteousness like a mighty stream",
   "heard": 5,
   "words": 5,
   "error_s": 3.22,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Seek good and not evil, that you may live",
   "heard": 9,
   "words": 9,
   "error_s": 17.73,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Hate evil and love good",
   "heard": 5,
   "words": 5,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Establish justice in the gate",
   "heard": 2,
   "words": 5,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Maybe the Lord will be gracious",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But let justice roll down like waters",
