 "lines": [
  {
   "text": "Terah lived in Ur of the Chaldeans",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Father of Abram, Nahor, and Haran",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Haran died in the land of his birth",
   "heard": 6,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "While his father Terah was still alive on earth",
   "heard": 9,
   "words": 9,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abram and Nahor both took wives",
   "heard": 6,
   "words": 6,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sarai was the name that Abram lives",
   "heard": 7,
   "words": 7,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nahor's wife was named Milcah",
   "heard": 5,
   "words": 5,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Daughter of Haran, born in that place",
   "heard": 7,
   "words": 7,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She is the daughter of Haran",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Iscah, named in the ancient clan",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sister to Lot and Milcah",
   "heard": 2,
   "words": 5,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Living in Ur, waiting to go",
   "heard": 6,
   "words": 6,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sarai was barren, she had no child",
   "heard": 6,
   "words": 7,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Terah packed the family for a wild ride",
   "heard": 6,
   "words": 8,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Took his son Abram, grandson Lot",
   "heard": 6,
   "words": 6,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Sarai, the wife, to go forth",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She is the daughter of Haran",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Iscah, named in the ancient clan",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sister to Lot and Milcah",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Living in Ur, waiting to go",
   "heard": 5,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They left Ur of the Chaldeans behind",
   "heard": 6,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heading for Canaan, a land to find",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But when they came to Haran",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They settled there, as the story began",
