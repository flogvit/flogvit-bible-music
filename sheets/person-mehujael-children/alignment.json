 "words": 186,
 "lines": [
  {
   "text": "Cain knew his wife and gave birth to Enoch",
   "heard": 9,
   "words": 9,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He built a city and named it his son",
   "heard": 9,
   "words": 9,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From Enoch came Irad in the dust",
   "heard": 6,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Irad was the father of Mehujael",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mehujael was the father of Methushael",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Methushael was the father of Lamech",
   "heard": 6,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The line of Cain stood apart in the world",
   "heard": 9,
   "words": 9,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A lineage moving through the ancient earth",
   "heard": 7,
   "words": 7,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lamech took two wives for himself",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Adah was the first and Zillah the other",
   "heard": 8,
   "words": 8,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Adah gave birth to Jabal the elder",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Father of tents and those who keep livestock",
   "heard": 8,
   "words": 8,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mehujael was the father of Methushael",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Methushael was the father of Lamech",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The line of Cain stood apart in the world",
   "heard": 9,
   "words": 9,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A lineage moving through the ancient earth",
   "heard": 6,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jubal was the brother of Jabal",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Father of all who play the lyre and pipe",
   "heard": 9,
   "words": 9,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zillah gave birth to Tubal-Cain",
   "heard": 4,
   "words": 5,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He forged tools out of bronze and iron",
   "heard": 8,
   "words": 8,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Tubal-Cain's sister was named Naamah",
   "heard": 4,
   "words": 5,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The civilization grew in their hands",
   "heard": 6,
   "words": 6,
   "error_s": 0.35,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Far from the godly line of Seth",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Their names are written in the book of Genesis",
   "heard": 9,
   "words": 9,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Irad the father of Mehujael",
   "heard": 4,
   "words": 5,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mehujael the father of Methushael",
   "heard": 5,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The descendants of Cain remain",
