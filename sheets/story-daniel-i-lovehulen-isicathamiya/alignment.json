   "error_s": 1.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The king could not sleep all night",
   "heard": 7,
   "words": 7,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He fasted all alone",
   "heard": 4,
   "words": 4,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My God sent his angel",
