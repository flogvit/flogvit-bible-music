 "lines": [
  {
   "text": "On the morning of the third day thunder rolled across the plain",
   "heard": 12,
   "words": 12,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lightning on the mountain and a cloud as dark as rain",
   "heard": 11,
   "words": 11,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The horn blew loud and louder and the camp began to shake",
   "heard": 12,
   "words": 12,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sinai wrapped in smoke and fire for the people's sake",
   "heard": 9,
   "words": 10,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am the LORD your God",
   "heard": 6,
   "words": 6,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who brought you out of the land of Egypt",
   "heard": 9,
   "words": 9,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Out of the house of slavery",
   "heard": 6,
   "words": 6,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You shall have no other gods before me",
   "heard": 8,
   "words": 8,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You shall not make for yourself an idol",
   "heard": 8,
   "words": 8,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You shall not misuse the name of the LORD your God",
   "heard": 11,
   "words": 11,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Remember the Sabbath day by keeping it holy",
   "heard": 8,
   "words": 8,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
