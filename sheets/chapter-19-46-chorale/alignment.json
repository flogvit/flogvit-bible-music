 "lines": [
  {
   "text": "Gud er v\u00e5r tilflukt og v\u00e5r borg",
   "heard": 7,
   "words": 7,
   "error_s": 3.37,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "en hjelp i n\u00f8d s\u00e5 n\u00e6r",
   "heard": 6,
   "words": 6,
   "error_s": 3.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Vi frykter ikke i v\u00e5r sorg",
   "heard": 6,
   "words": 6,
   "error_s": 3.44,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "om jorden skjelver her",
   "heard": 4,
   "words": 4,
   "error_s": 3.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "La havet bruse, fjellet g\u00e5",
   "heard": 5,
   "words": 5,
   "error_s": 3.47,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "og vannet skumme vilt",
   "heard": 4,
   "words": 4,
   "error_s": 3.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Guds by skal likevel best\u00e5",
   "heard": 5,
   "words": 5,
   "error_s": 3.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "der elven renner stilt",
   "heard": 4,
   "words": 4,
   "error_s": 3.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "N\u00e5r folkene i vrede st\u00e5r",
   "heard": 5,
   "words": 5,
   "error_s": 3.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "og riker raver tungt",
   "heard": 2,
   "words": 4,
   "error_s": 3.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "han l\u00f8fter r\u00f8sten, jorden g\u00e5r",
   "heard": 5,
   "words": 5,
   "error_s": 3.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "og alt blir stille, ungt",
   "heard": 5,
   "words": 5,
   "error_s": 3.36,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "H\u00e6rskarers Herre er med oss",
   "heard": 4,
   "words": 5,
   "error_s": 3.44,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "v\u00e5r borg er Jakobs Gud",
   "heard": 5,
   "words": 5,
   "error_s": 3.23,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "V\u00e6r stille, kjenn at jeg er Gud",
