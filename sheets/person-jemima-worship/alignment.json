   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A gift of justice and gentle glories",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
