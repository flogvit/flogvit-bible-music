  {
   "text": "Lamech took two wives for himself",
   "heard": 6,
   "words": 6,
   "error_s": 10.55,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "One was named Adah, the other Zillah",
   "heard": 7,
   "words": 7,
   "error_s": 10.61,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Adah gave birth to a son",
   "heard": 6,
   "words": 6,
   "error_s": 10.76,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His name was Jabal in the land",
