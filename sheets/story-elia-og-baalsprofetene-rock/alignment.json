{
 "id": "story-elia-og-baalsprofetene-rock",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-elia-og-baalsprofetene-rock",
 "offset_seconds": -1.5200000000002234,
 "words_heard": 199,
 "words": 215,
 "lines": [
  {
   "text": "Ahab called all Israel up to Carmel's height",
   "heard": 7,
   "words": 8,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Four hundred fifty prophets came to win the fight",
   "heard": 6,
   "words": 9,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One man stood before them with the people standing round",
   "heard": 10,
   "words": 10,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Two bulls on the wood and not a spark upon the ground",
   "heard": 12,
   "words": 12,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How long will you keep limping between two opinions",
   "heard": 9,
   "words": 9,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If the LORD is God, follow him",
   "heard": 7,
   "words": 7,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The god who answers with fire, he is God",
   "heard": 9,
   "words": 9,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From morning until noon they called on Baal by name",
   "heard": 9,
   "words": 10,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They danced around their altar but no answer ever came",
   "heard": 10,
   "words": 10,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They cut themselves with swords and spears until the evening hour",
   "heard": 11,
   "words": 11,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No sound, no answer, no response, no fire and no power",
   "heard": 11,
   "words": 11,
   "error_s": 0.43,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Elijah took twelve stones, one for each tribe of Jacob's sons",
   "heard": 11,
   "words": 11,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He built the LORD an altar where the broken one had come",
   "heard": 12,
   "words": 12,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fill four jars with water, pour it out on wood and stone",
   "heard": 12,
   "words": 12,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do it a third time, till the trench is overflown",
   "heard": 10,
   "words": 10,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Answer me, LORD, answer me",
   "heard": 5,
   "words": 5,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So that this people may know that you, LORD, are God",
   "heard": 11,
   "words": 11,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then the fire of the LORD fell",
   "heard": 7,
   "words": 7,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And consumed the burnt offering, the wood, the stones, and the dust",
   "heard": 11,
   "words": 12,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And it licked up the water in the trench",
   "heard": 3,
   "words": 9,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The LORD, he is God",
   "heard": 5,
   "words": 5,
   "error_s": 11.34,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The LORD, he is God",
   "heard": 5,
   "words": 5,
   "error_s": 21.78,
   "tie_split": false,
   "uncertain": true
  },
  {
