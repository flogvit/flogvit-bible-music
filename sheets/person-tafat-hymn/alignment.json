{
 "id": "person-tafat-hymn",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-tafat-hymn",
 "offset_seconds": 1.59999999999971,
 "words_heard": 119,
 "words": 127,
 "lines": [
  {
   "text": "Solomon had twelve governors over all Israel",
   "heard": 7,
   "words": 7,
   "error_s": 5.23,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They supplied provisions for the king and his household",
   "heard": 9,
   "words": 9,
   "error_s": 4.7,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Each one was responsible for a month of the year",
   "heard": 10,
   "words": 10,
   "error_s": 3.74,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Their names were recorded in the ancient scroll",
   "heard": 8,
   "words": 8,
   "error_s": 2.41,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Ben-Abinadab ruled in all of Naphath Dor",
   "heard": 6,
   "words": 7,
   "error_s": 2.64,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "He had Solomon's daughter Taphath as his wife",
   "heard": 8,
   "words": 8,
   "error_s": 1.55,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A bond of loyalty between the royal house",
   "heard": 8,
   "words": 8,
   "error_s": 1.37,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And the administrative leaders of the land",
   "heard": 7,
   "words": 7,
   "error_s": 1.79,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The hill country of Ephraim held Ben-Hur",
   "heard": 6,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ben-Deker in Makaz and Shaalbim and Beth Shemesh",
   "heard": 7,
   "words": 8,
   "error_s": 0.68,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Ben-Hesed held Arubboth and Socoh and Hepher",
   "heard": 5,
   "words": 7,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Each region provided for the royal needs",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Taphath was given to strengthen the kingdom",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A political arrangement to ensure stability",
   "heard": 6,
   "words": 6,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her father had many wives of royal birth",
   "heard": 8,
   "words": 8,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet Taphath's union served the state's design",
   "heard": 6,
   "words": 7,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Taphath, Solomon's daughter, wife of Ben-Abinadab",
   "heard": 4,
   "words": 6,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  }
 ],
