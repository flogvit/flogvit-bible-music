{
 "id": "story-rehabeams-regjering-i-juda-worship",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-rehabeams-regjering-i-juda-worship",
 "offset_seconds": -2.6800000000001987,
 "words_heard": 212,
 "words": 215,
 "lines": [
  {
   "text": "Solomon's son took the crown of the south",
   "heard": 8,
   "words": 8,
   "error_s": 1.84,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Forty-one years he stood at the gate",
   "heard": 6,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seventeen years in the chosen city",
   "heard": 5,
   "words": 6,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His mother Naamah from Ammon's state",
   "heard": 5,
   "words": 6,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people turned from the Lord's command",
   "heard": 7,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They sinned and provoked His jealousy",
   "heard": 6,
   "words": 6,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Building high places on every hill",
   "heard": 6,
   "words": 6,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Idols under every green tree",
   "heard": 5,
   "words": 5,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He carried off the treasures of the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gold shields from the palace hall",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rehoboam made shields of bronze",
   "heard": 5,
   "words": 5,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the guard to stand and call",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the fifth year the Egypt king came",
   "heard": 8,
   "words": 8,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shishak marched against Jerusalem",
   "heard": 4,
   "words": 4,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He took the gold from the house of God",
   "heard": 9,
   "words": 9,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And from the royal palace as well",
   "heard": 7,
   "words": 7,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nothing was left in the holy place",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Except the bronze that could not be kept",
   "heard": 8,
   "words": 8,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He gave them to the commanders of the guard",
   "heard": 9,
   "words": 9,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To watch at the palace gate",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He carried off the treasures of the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gold shields from the palace hall",
   "heard": 6,
   "words": 6,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rehoboam made shields of bronze",
   "heard": 5,
   "words": 5,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the guard to stand and call",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "War between Rehoboam and Jeroboam",
   "heard": 5,
   "words": 5,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Continual conflict in the land",
   "heard": 5,
   "words": 5,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He lay down with his fathers at last",
   "heard": 8,
   "words": 8,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Buried in the City of David's hand",
   "heard": 7,
   "words": 7,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abijam stood up to take the throne",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The story remains as it was planned",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bronze shields for the guard to keep",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the house of the Lord they sleep",
   "heard": 8,
   "words": 8,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  }
