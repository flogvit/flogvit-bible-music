{
 "id": "story-de-fem-straffene-og-kallet-til-omvendelse-choral",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-de-fem-straffene-og-kallet-til-omvendelse-choral",
 "offset_seconds": -11.580000000000009,
 "words_heard": 130,
 "words": 140,
 "lines": [
  {
   "text": "I gave you empty stomachs in all your cities",
   "heard": 9,
   "words": 9,
   "error_s": 8.41,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Lack of bread in all your places, yet you refused",
   "heard": 10,
   "words": 10,
   "error_s": 8.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I withheld the rain when harvest was near",
   "heard": 8,
   "words": 8,
   "error_s": 8.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Sent it on one city, but not on another",
   "heard": 7,
   "words": 9,
   "error_s": 7.85,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Fields staggered for water but found no relief",
   "heard": 8,
   "words": 8,
   "error_s": 7.62,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Blight and mildew struck your gardens and trees",
   "heard": 8,
   "words": 8,
   "error_s": 7.48,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Locusts devoured figs and vines you loved",
   "heard": 7,
   "words": 7,
   "error_s": 7.75,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Plagues went out as they did to Egypt",
   "heard": 8,
   "words": 8,
   "error_s": 7.18,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Your young men killed by the sword, horses taken",
   "heard": 9,
   "words": 9,
   "error_s": 7.03,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Stench of camps rose into your nostrils",
   "heard": 7,
   "words": 7,
   "error_s": 7.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I overthrew you like Sodom and Gomorrah",
   "heard": 7,
   "words": 7,
   "error_s": 6.84,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A charred stick snatched from the fire",
   "heard": 7,
   "words": 7,
   "error_s": 6.71,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Yet you did not return to me, declares the Lord",
   "heard": 10,
   "words": 10,
   "error_s": 6.69,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Therefore I will do this to you, Israel",
   "heard": 8,
   "words": 8,
   "error_s": 6.94,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Prepare yourself to meet your God, Israel",
   "heard": 7,
   "words": 7,
   "error_s": 8.12,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He who forms the mountains and creates the wind",
   "heard": 9,
   "words": 9,
   "error_s": 14.43,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The LORD, the God of hosts, is his name",
   "heard": 1,
   "words": 9,
   "error_s": 10.96,
   "tie_split": true,
   "uncertain": true
  }
 ],
