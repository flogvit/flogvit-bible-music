{
 "id": "person-dareios-i-soul",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-dareios-i-soul",
 "offset_seconds": -2.6400000000001995,
 "words_heard": 227,
 "words": 235,
 "lines": [
  {
   "text": "So the work on the house of God in Jerusalem came to a halt",
   "heard": 14,
   "words": 14,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It stood still until the second year of the reign of Darius king of Persia",
   "heard": 15,
   "words": 15,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The eye of their God was on the elders of the Jews",
   "heard": 12,
   "words": 12,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They were not stopped until a report could go to Darius",
   "heard": 10,
   "words": 11,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let the house be rebuilt as a place for offering sacrifices",
   "heard": 11,
   "words": 11,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let its foundations be laid with sixty cubits of height and width",
   "heard": 12,
   "words": 12,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The cost is to be paid from the royal treasury",
   "heard": 10,
   "words": 10,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I, Darius, have issued this decree",
   "heard": 6,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then King Darius issued an order and a search was made",
   "heard": 11,
   "words": 11,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the archives where the treasures were stored in Babylon",
   "heard": 9,
   "words": 10,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At Ecbatana in the fortress in Media a scroll was found",
   "heard": 7,
   "words": 11,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "King Cyrus issued this order in his first year",
   "heard": 9,
   "words": 9,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let the house be rebuilt as a place for offering sacrifices",
   "heard": 11,
   "words": 11,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let its foundations be laid with sixty cubits of height and width",
   "heard": 12,
   "words": 12,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The cost is to be paid from the royal treasury",
   "heard": 10,
   "words": 10,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I, Darius, have issued this decree",
   "heard": 6,
   "words": 6,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keep far away from there Tattenai and Shethar-bozenai",
   "heard": 6,
   "words": 8,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Leave the work on this house of God alone",
   "heard": 9,
   "words": 9,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let the governor of the Jews and the elders rebuild this house",
   "heard": 12,
   "words": 12,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The cost is to be paid in full from the royal treasury",
   "heard": 12,
   "words": 12,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This house was completed on the third day of the month of Adar",
   "heard": 13,
   "words": 13,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the sixth year of the reign of King Darius",
   "heard": 10,
   "words": 10,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  }
 ],
