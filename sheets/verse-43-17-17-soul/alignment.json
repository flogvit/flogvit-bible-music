 "lines": [
  {
   "text": "I have given them your word to hold",
   "heard": 8,
   "words": 8,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The world has hated them, I am told",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They are not of the world, just as I",
   "heard": 9,
   "words": 9,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The truth of heaven stands before their eye",
   "heard": 8,
   "words": 8,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I do not ask you to take them out",
   "heard": 9,
   "words": 9,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But to keep them from the evil one's doubt",
   "heard": 8,
   "words": 9,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sanctify them in the truth",
   "heard": 5,
   "words": 5,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your word is truth",
