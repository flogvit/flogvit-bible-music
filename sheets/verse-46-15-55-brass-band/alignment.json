 "words": 107,
 "lines": [
  {
   "text": "Listen, I tell you a mystery",
   "heard": 6,
   "words": 6,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We shall not all sleep",
   "heard": 5,
   "words": 5,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In a moment, in the twinkling of an eye",
   "heard": 9,
   "words": 9,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At the last trumpet we shall all be changed",
   "heard": 9,
   "words": 9,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Death is swallowed up in victory",
   "heard": 6,
   "words": 6,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where, O death, is your victory",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where, O death, is your sting",
   "heard": 6,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Thanks be to God, who gives us the victory",
   "heard": 9,
   "words": 9,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the trumpet will sound",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the dead will be raised",
   "heard": 6,
   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This mortal body puts on immortality",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hallelujah, the grave has lost its prey",
   "heard": 7,
   "words": 7,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
