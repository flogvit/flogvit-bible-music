 "words": 172,
 "lines": [
  {
   "text": "King Solomon loved many foreign women",
   "heard": 6,
   "words": 6,
   "error_s": 1.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Moabites and Ammonites were among them",
   "heard": 6,
   "words": 6,
   "error_s": 1.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the nations the Lord had warned against",
   "heard": 8,
   "words": 8,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet he clung to them in his love",
   "heard": 8,
   "words": 8,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When the king grew old in his days",
   "heard": 8,
   "words": 8,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His wives turned his heart away",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He followed Ashtoreth and Milcom too",
   "heard": 6,
   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His heart was no longer true",
   "heard": 6,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Naamah the Ammonite stood in the court",
   "heard": 7,
   "words": 7,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mother of Rehoboam by record",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the city the Lord had chosen she lived",
   "heard": 9,
   "words": 9,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her story is what the text gives",
   "heard": 7,
   "words": 7,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rehoboam reigned in Jerusalem",
   "heard": 4,
   "words": 4,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Forty-one years old when he began",
   "heard": 5,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He ruled for seventeen years there",
   "heard": 5,
   "words": 6,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His mother's name was Naamah",
   "heard": 5,
   "words": 5,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Naamah the Ammonite stood in the court",
   "heard": 7,
   "words": 7,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mother of every hope owned by record",
   "heard": 7,
   "words": 7,
   "error_s": 0.14,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "In the city the Lord had chosen she lived",
   "heard": 9,
   "words": 9,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her story is what the text gives",
   "heard": 7,
   "words": 7,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people said we have no share in David",
   "heard": 9,
   "words": 9,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To your tents, Israel, go away",
   "heard": 6,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The tribes rebelled against the house of David",
   "heard": 8,
   "words": 8,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Judah alone remained to stay",
   "heard": 5,
   "words": 5,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Naamah the Ammonite is remembered",
   "heard": 5,
   "words": 5,
   "error_s": 0.56,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Mother of Rehoboam in the text",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  }
 ],
