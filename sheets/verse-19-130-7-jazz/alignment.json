 "words": 143,
 "lines": [
  {
   "text": "Deep down my soul is calling out",
   "heard": 7,
   "words": 7,
   "error_s": 1.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To you who sit above the clouds",
   "heard": 7,
   "words": 7,
   "error_s": 1.89,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My heart is waiting on your word",
   "heard": 7,
   "words": 7,
   "error_s": 1.88,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In all the dark and heavy furor",
   "heard": 7,
   "words": 7,
   "error_s": 2.07,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With the Lord there is steadfast love",
   "heard": 7,
   "words": 7,
   "error_s": 1.63,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And abundant redemption flows",
   "heard": 4,
   "words": 4,
   "error_s": 1.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He will redeem us from our sins",
   "heard": 7,
   "words": 7,
   "error_s": 1.53,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "This is where the mercy ends",
   "heard": 6,
   "words": 6,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I put my hope in what you say",
   "heard": 8,
   "words": 8,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My soul waits more than watchmen stay",
   "heard": 7,
   "words": 7,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They wait for morning breaking light",
   "heard": 6,
   "words": 6,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I wait for you through day and night",
   "heard": 8,
   "words": 8,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With the Lord there is steadfast love",
   "heard": 7,
   "words": 7,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And abundant redemption flows",
   "heard": 4,
   "words": 4,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will redeem us from our sins",
   "heard": 7,
   "words": 7,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This is where the mercy ends",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Forgiveness rests within your hands",
   "heard": 5,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So we may fear you as we stand",
   "heard": 8,
   "words": 8,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not in dread but holy awe",
   "heard": 4,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your truth will never fail or waver",
   "heard": 7,
   "words": 7,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Israel, hope in the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With him is love, a living word",
   "heard": 7,
   "words": 7,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  }
 ],
