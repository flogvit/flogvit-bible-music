 "words_heard": 232,
 "words": 234,
 "lines": [
  {
   "text": "Sarai had borne him no children yet",
   "heard": 7,
   "words": 7,
   "error_s": 5.41,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "An Egyptian slave girl named Hagar",
   "heard": 6,
   "words": 6,
   "error_s": 5.02,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "She gave her to Abram instead",
   "heard": 6,
   "words": 6,
   "error_s": 4.34,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "To build a family through her",
   "heard": 6,
   "words": 6,
   "error_s": 3.72,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Hagar became pregnant with joy",
   "heard": 5,
   "words": 5,
   "error_s": 0.7,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "But began to despise her mistress",
   "heard": 6,
   "words": 6,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sarai cried out to the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abram said do as you wish",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hagar the slave girl of Sarai",
   "heard": 6,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where have you come from and where are you going",
   "heard": 10,
   "words": 10,
   "error_s": 1.07,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "I am running away from my mistress",
   "heard": 7,
   "words": 7,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the wilderness I am alone",
   "heard": 6,
   "words": 6,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Found her by a spring of water",
   "heard": 7,
   "words": 7,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Beside the road to Shur",
   "heard": 4,
   "words": 5,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The angel of the Lord spoke",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "To the weary heart",
   "heard": 4,
   "words": 4,
   "error_s": 0.79,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "I got a slave girl, love's your ride",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where have you come from and where are you going",
   "heard": 10,
   "words": 10,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am running away from my mistress",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the wilderness I am alone",
   "heard": 6,
   "words": 6,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Go back to your mistress he said",
   "heard": 7,
   "words": 7,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Submit to her authority",
   "heard": 4,
   "words": 4,
   "error_s": 1.58,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I will greatly increase your descendants",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Too many for counting to see",
   "heard": 6,
   "words": 6,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I got a slave girl up so right",
   "heard": 8,
   "words": 8,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where have you come from and where are you going",
   "heard": 10,
   "words": 10,
   "error_s": 1.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am running away from my mistress",
   "heard": 7,
   "words": 7,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the wilderness I am alone",
   "heard": 6,
   "words": 6,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You are pregnant and will give birth",
   "heard": 7,
   "words": 7,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Name him Ishmael for God hears",
   "heard": 6,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will be like a wild donkey",
   "heard": 7,
   "words": 7,
   "error_s": 1.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Living at odds with his kin",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She called the Lord the God who sees me",
   "heard": 9,
   "words": 9,
   "error_s": 1.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Beer-lahai-roi by the well",
   "heard": 3,
   "words": 4,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hagar bore Abram a son",
   "heard": 5,
   "words": 5,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
