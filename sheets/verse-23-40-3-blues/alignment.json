 "lines": [
  {
   "text": "Comfort falls like morning light",
   "heard": 5,
   "words": 5,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your God speaks to the soul tonight",
   "heard": 7,
   "words": 7,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Speak tenderly to the city gate",
   "heard": 6,
   "words": 6,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her hard service is paid and late",
   "heard": 6,
   "words": 7,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Guilt is washed away in the rain",
   "heard": 5,
   "words": 7,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Double payment for the pain",
   "heard": 5,
   "words": 5,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A voice cries out through the night",
   "heard": 6,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Prepare the way in the light",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the wilderness prepare the way",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Make straight in the desert a highway for our God",
   "heard": 10,
