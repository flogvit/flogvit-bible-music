 "lines": [
  {
   "text": "As the Father has loved me",
   "heard": 6,
   "words": 6,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So I have loved you",
   "heard": 5,
   "words": 5,
