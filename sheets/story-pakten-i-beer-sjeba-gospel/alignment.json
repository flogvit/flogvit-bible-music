 "lines": [
  {
   "text": "Abimelech and Phicol came to me",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "God is with you in all your deeds",
   "heard": 8,
   "words": 8,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Swear to me by God, do not lie",
   "heard": 8,
   "words": 8,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Show the kindness that you see",
   "heard": 6,
   "words": 6,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I confronted him about the well",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His servants took it, he denied",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I gave him sheep and cattle too",
   "heard": 7,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And a covenant we made anew",
   "heard": 6,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seven ewe lambs I set aside",
   "heard": 6,
   "words": 6,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Witness that I dug this well",
   "heard": 4,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Beersheba, where we swore",
   "heard": 3,
   "words": 4,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God\u2019s truth is clear and full",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abimelech asked what this means",
   "heard": 5,
   "words": 5,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "These seven lambs from my hand",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Accept them as my witness",
   "heard": 5,
   "words": 5,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That I dug the well in the land",
   "heard": 8,
   "words": 8,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They returned to the Philistine land",
   "heard": 6,
   "words": 6,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Phicol and the king went away",
   "heard": 5,
   "words": 6,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I planted a tamarisk tree",
   "heard": 4,
   "words": 5,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
