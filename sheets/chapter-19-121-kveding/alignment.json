 "words": 93,
 "lines": [
  {
   "text": "Jeg l\u00f8fter mine \u00f8yne mot fjellene",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "hvorfra skal min hjelp komme",
   "heard": 5,
   "words": 5,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Min hjelp kommer fra Herren",
   "heard": 5,
   "words": 5,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "han som skapte himmel og jord",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han lar ikke din fot vakle",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "din vokter slumrer ikke",
   "heard": 4,
   "words": 4,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Se, han slumrer ikke og sover ikke",
   "heard": 6,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "han som vokter Israel",
   "heard": 4,
   "words": 4,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Herren er din vokter",
   "heard": 4,
   "words": 4,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Herren er din skygge ved din h\u00f8yre h\u00e5nd",
   "heard": 8,
   "words": 8,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Om dagen skal solen ikke stikke deg",
   "heard": 7,
   "words": 7,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og m\u00e5nen ikke om natten",
   "heard": 4,
   "words": 5,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Herren skal bevare deg fra alt ondt",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "han skal bevare din sjel",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Herren skal bevare din utgang og din inngang",
   "heard": 8,
   "words": 8,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "fra n\u00e5 og til evig tid",
   "heard": 6,
   "words": 6,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  }
 ],
