 "words": 222,
 "lines": [
  {
   "text": "The king gave his command to the governor",
   "heard": 8,
   "words": 8,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hand the prophet over to the city walls",
   "heard": 8,
   "words": 8,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With Joash the son of the crown",
   "heard": 7,
   "words": 7,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keep the man behind the bars",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Say thus says the king to the prisoner",
   "heard": 8,
   "words": 8,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Put this man in prison for his words",
   "heard": 8,
   "words": 8,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give him only meager rations of bread",
   "heard": 7,
   "words": 7,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And water until I return safely",
   "heard": 6,
   "words": 6,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The word of the Lord cannot be bound",
   "heard": 8,
   "words": 8,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Though the governor keeps the door locked tight",
   "heard": 8,
   "words": 8,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No prison can hold the truth of God",
   "heard": 8,
   "words": 8,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The prophecy stands before the king",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Someone drew his bow at random aim",
   "heard": 6,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Struck the king between the sections of armor",
   "heard": 8,
   "words": 8,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Turn around and get me out of the fight",
   "heard": 9,
   "words": 9,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For I am wounded and dying now",
   "heard": 7,
   "words": 7,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The battle grew fierce that very day",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The king was propped up in his chariot",
   "heard": 8,
   "words": 8,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Facing the Arameans in the dust",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That evening he died in the blood",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The word of the Lord cannot be bound",
   "heard": 8,
   "words": 8,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Though the governor keeps the door locked tight",
   "heard": 8,
   "words": 8,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No prison can hold the truth of God",
   "heard": 8,
   "words": 8,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The prophecy stands before the king",
   "heard": 6,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A cry spread through the army at sunset",
   "heard": 8,
   "words": 8,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Every man to his own city and land",
   "heard": 8,
   "words": 8,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The king died and was brought to Samaria",
   "heard": 8,
   "words": 8,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And they buried him in the ground",
   "heard": 7,
   "words": 7,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The meager rations could not save him",
   "heard": 6,
   "words": 7,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The word of the Lord came true",
   "heard": 7,
