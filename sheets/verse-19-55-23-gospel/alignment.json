 "lines": [
  {
   "text": "Companion raised his hand against his friends",
   "heard": 7,
   "words": 7,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Violated the covenant he made",
   "heard": 5,
   "words": 5,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Speech smoother than butter to the eye",
   "heard": 7,
   "words": 7,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "War was hidden deep inside",
   "heard": 5,
   "words": 5,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Words softer than oil on the tongue",
   "heard": 7,
   "words": 7,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet drawn swords were waiting there",
   "heard": 6,
   "words": 6,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They have no fear of God in their hearts",
   "heard": 9,
   "words": 9,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And they never change their ways",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Cast your burden on the LORD",
   "heard": 6,
   "words": 6,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will sustain you forever",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will never let the righteous be shaken",
   "heard": 8,
   "words": 8,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When the trouble starts to grow",
   "heard": 6,
   "words": 6,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God will hear and humble them",
   "heard": 6,
   "words": 6,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who are enthroned from of old",
   "heard": 4,
   "words": 6,
   "error_s": 0.45,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Men of blood and treachery",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will not live out half their days",
