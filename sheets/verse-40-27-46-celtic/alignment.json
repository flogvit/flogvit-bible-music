 "lines": [
  {
   "text": "The sixth hour broke the light of day",
   "heard": 8,
   "words": 8,
   "error_s": 2.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Darkness wrapped the world in grey",
   "heard": 6,
   "words": 6,
   "error_s": 2.18,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He trusts in God to set him free",
   "heard": 8,
   "words": 8,
   "error_s": 1.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Let God rescue him if He will be",
   "heard": 8,
   "words": 8,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The rebels on the crosses near",
   "heard": 5,
   "words": 6,
   "error_s": 1.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heaped their insults without fear",
   "heard": 5,
   "words": 5,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He said, \"I am the Son of God\"",
   "heard": 8,
   "words": 8,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They mocked the words they did not know",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Eli, Eli, lema sabachthani",
   "heard": 2,
   "words": 4,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My God, my God, why have you forsaken me",
   "heard": 9,
   "words": 9,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A loud voice in the silent night",
   "heard": 7,
   "words": 7,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why have you forsaken me",
   "heard": 5,
   "words": 5,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Some stood by and heard the cry",
   "heard": 7,
   "words": 7,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Said he calls for Elijah",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One ran to bring a drink of sour wine",
   "heard": 8,
   "words": 9,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "On a stick, held out in the dark",
   "heard": 8,
   "words": 8,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
