 "lines": [
  {
   "text": "In Jerusalem with their relatives",
   "heard": 5,
   "words": 5,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Opposite their kinsmen in Jerusalem",
   "heard": 5,
   "words": 5,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Along with their kinsmen they stayed there",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The register names them in the tribal hall",
   "heard": 8,
   "words": 8,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lived in Jerusalem with their relatives",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Opposite their kinsmen in the city",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mikloth was the father of Shimeam",
   "heard": 5,
   "words": 6,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Near their kinsmen in the holy land",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jeiel the father of Gibeon lived there",
   "heard": 6,
   "words": 7,
   "error_s": 1.52,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His wife was named Maacah in the place",
   "heard": 8,
   "words": 8,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abdon was firstborn then Zur and Kish",
   "heard": 6,
   "words": 7,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ner fathered Kish and Kish fathered Saul",
   "heard": 6,
   "words": 7,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lived in Jerusalem with their relatives",
   "heard": 6,
   "words": 6,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Opposite their kinsmen in the city",
   "heard": 6,
   "words": 6,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mikloth was the father of Shimeam",
   "heard": 5,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Near their kinsmen in the holy land",
   "heard": 7,
   "words": 7,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jonathan son of Shimeah struck him down",
   "heard": 7,
   "words": 7,
   "error_s": 18.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "When he taunted Israel in the fight",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Shimeah was the brother of David",
   "heard": 6,
   "words": 6,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And his son was shrewd in the king's court",
   "heard": 9,
   "words": 9,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
