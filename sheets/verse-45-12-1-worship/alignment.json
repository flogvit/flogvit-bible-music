 "lines": [
  {
   "text": "Here are my hands, the work I do",
   "heard": 8,
   "words": 8,
   "error_s": 1.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Here are my days, I give them to you",
   "heard": 9,
   "words": 9,
   "error_s": 1.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not just a song on a Sunday morning",
   "heard": 8,
   "words": 8,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All of my life laid down before you",
   "heard": 8,
   "words": 8,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By the mercies of God",
   "heard": 5,
   "words": 5,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I offer my body as a living sacrifice",
   "heard": 8,
   "words": 8,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Holy and pleasing to God",
   "heard": 5,
   "words": 5,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This is my spiritual worship",
   "heard": 5,
   "words": 5,
   "error_s": 1.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be conformed to this age",
   "heard": 7,
   "words": 7,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But be transformed by the renewing of your mind",
   "heard": 9,
   "words": 9,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So that you can discern what God's will is",
   "heard": 9,
   "words": 9,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": false
  },
  {
