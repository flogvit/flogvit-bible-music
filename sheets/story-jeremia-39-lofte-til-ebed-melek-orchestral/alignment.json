 "lines": [
  {
   "text": "Jeremiah waits in the guard court alone",
   "heard": 5,
   "words": 7,
   "error_s": 3.97,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The word of the Lord breaks the heavy stone",
   "heard": 9,
   "words": 9,
   "error_s": 3.5,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A message is sent to Ebed-melech",
   "heard": 6,
   "words": 6,
   "error_s": 4.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For the Cushite man who holds his breath",
   "heard": 8,
   "words": 8,
   "error_s": 2.76,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The city faces disaster and not good",
   "heard": 7,
   "words": 7,
   "error_s": 1.72,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "The words will pass before his eyes in the flood",
   "heard": 10,
   "words": 10,
   "error_s": 1.43,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "But I will rescue you on that day",
   "heard": 8,
   "words": 8,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will not be handed over in fear",
   "heard": 8,
