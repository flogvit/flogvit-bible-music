 "lines": [
  {
   "text": "An angel of the Lord appeared to Joseph in a dream",
   "heard": 11,
   "words": 11,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Rise, take the child and his mother",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And flee into Egypt",
   "heard": 4,
   "words": 4,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Stay there until I tell you",
   "heard": 6,
   "words": 6,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Out of Egypt I called my son",
   "heard": 7,
   "words": 7,
   "error_s": 1.58,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Out of Egypt I called my son",
   "heard": 7,
   "words": 7,
   "error_s": 1.44,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He rose and took the child and his mother by night",
   "heard": 11,
   "words": 11,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And went down into Egypt",
   "heard": 5,
   "words": 5,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And there they stayed",
   "heard": 4,
   "words": 4,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blessed be Egypt, where the Lord came",
