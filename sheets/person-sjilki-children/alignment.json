 "words": 201,
 "lines": [
  {
   "text": "Amon was twenty-two when he began to rule",
   "heard": 7,
   "words": 8,
   "error_s": 0.39,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "He reigned two years in the city of Jerusalem",
   "heard": 9,
   "words": 9,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His mother was Meshullemeth from the town of Jotbah",
   "heard": 9,
   "words": 9,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He did what was evil in the eyes of the Lord",
   "heard": 11,
   "words": 11,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Two years in Jerusalem, a short and dark time",
   "heard": 9,
   "words": 9,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He walked in the ways of his father\u2019s sin",
   "heard": 9,
   "words": 9,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bowing down to idols, leaving the Lord behind",
   "heard": 8,
   "words": 8,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Two years in Jerusalem, a heavy, heavy crown",
   "heard": 8,
   "words": 8,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He served the idols that Manasseh made",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He forsook the God who had led his fathers",
   "heard": 8,
   "words": 9,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He did not humble himself before the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.21,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Instead he multiplied his guilt and shame",
   "heard": 7,
   "words": 7,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Two years in Jerusalem, a short and dark time",
   "heard": 9,
   "words": 9,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He walked in the ways of his father\u2019s sin",
   "heard": 9,
   "words": 9,
   "error_s": 0.5,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Bowing down to idols, leaving the Lord behind",
   "heard": 8,
   "words": 8,
   "error_s": 1.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Two years in Jerusalem, a heavy, heavy crown",
   "heard": 8,
   "words": 8,
   "error_s": 1.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His officials conspired against him in his house",
   "heard": 8,
   "words": 8,
   "error_s": 0.9,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "They killed the king and ended his brief reign",
   "heard": 9,
   "words": 9,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people struck down all who plotted against him",
   "heard": 9,
   "words": 9,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And they made his son Josiah king",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Buried in the garden of Uzza\u2019s tomb",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His son Josiah succeeded him on the throne",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The annals record the acts of Amon",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A link in the line of the kings of Judah",
   "heard": 10,
   "words": 10,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  }
 ],
