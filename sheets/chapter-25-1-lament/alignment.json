   "error_s": 11.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "She has none to comfort her",
   "heard": 6,
   "words": 6,
   "error_s": 11.18,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For these things I weep",
