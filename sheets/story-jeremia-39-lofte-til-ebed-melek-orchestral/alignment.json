   "error_s": 0.65,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "I will surely deliver you away",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "You will escape with your life, I swear",
   "heard": 8,
   "words": 8,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
