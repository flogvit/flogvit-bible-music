{
 "id": "person-anak-children",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-anak-children",
 "offset_seconds": -5.720000000000134,
 "words_heard": 231,
 "words": 237,
 "lines": [
  {
   "text": "Through the Negev they climbed to the land",
   "heard": 8,
   "words": 8,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where the giants of Hebron stood tall",
   "heard": 7,
   "words": 7,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ahiman Sheshai and Talmai",
   "heard": 4,
   "words": 4,
   "error_s": 0.32,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The descendants of Anak remained there",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A single cluster of grapes",
   "heard": 5,
   "words": 5,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Carried on a pole by two",
   "heard": 6,
   "words": 6,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Forty days they scouted the place",
   "heard": 5,
   "words": 6,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And brought back the fruit of the land",
   "heard": 8,
   "words": 8,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It flows with milk and honey indeed",
   "heard": 7,
   "words": 7,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the cities are strong and the people great",
   "heard": 9,
   "words": 9,
   "error_s": 0.34,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The walls rise up to the sky",
   "heard": 7,
   "words": 7,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And our hearts have melted in fear",
   "heard": 7,
   "words": 7,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We saw the descendants of Anak",
   "heard": 5,
   "words": 6,
   "error_s": 0.92,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "The Nephilim from whom they came",
   "heard": 6,
   "words": 6,
   "error_s": 1.2,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In our own eyes we seemed like grasshoppers",
   "heard": 8,
   "words": 8,
   "error_s": 1.49,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "So we seemed to them we said",
   "heard": 7,
   "words": 7,
   "error_s": 1.39,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The whole congregation wept that night",
   "heard": 4,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Grumbling against Moses and Aaron",
   "heard": 5,
   "words": 5,
   "error_s": 0.87,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Why bring us here to fall by the sword",
   "heard": 9,
   "words": 9,
   "error_s": 1.19,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Our wives and children become plunder",
   "heard": 6,
   "words": 6,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If only we had died in the wilderness",
   "heard": 8,
   "words": 8,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Or back in Egypt we wished",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But one man stood with a different spirit",
   "heard": 8,
   "words": 8,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Caleb who followed wholeheartedly",
   "heard": 4,
   "words": 4,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We saw the descendants of Anak",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Nephilim from whom they came",
   "heard": 6,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In our own eyes we seemed like grasshoppers",
   "heard": 8,
   "words": 8,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So we seemed to them we said",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Joshua cut off the Anakim",
   "heard": 5,
   "words": 5,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From Hebron Debir and Anab",
   "heard": 4,
   "words": 5,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Devoting them to destruction",
   "heard": 4,
   "words": 4,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So none remained in the hill country",
   "heard": 7,
   "words": 7,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Only in Gaza Gath and Ashdod",
   "heard": 6,
   "words": 6,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Did any of them survive",
   "heard": 5,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But Caleb drove out the three",
   "heard": 6,
   "words": 6,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sheshai Ahiman and Talmai",
   "heard": 4,
   "words": 4,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hebron was called Kiriath-arba",
   "heard": 3,
   "words": 4,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "After the greatest among them",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  }
 ],
