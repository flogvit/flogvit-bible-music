{
 "id": "person-etbaal-choral",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-etbaal-choral",
 "offset_seconds": -1.6200000000002213,
 "words_heard": 135,
 "words": 140,
 "lines": [
  {
   "text": "Ahab walked in Jeroboam's sins",
   "heard": 5,
   "words": 5,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He took as his wife Jezebel",
   "heard": 6,
   "words": 6,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Daughter of Ethbaal, king of Sidonians",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He went and served Baal",
   "heard": 5,
   "words": 5,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "An altar for Baal in Samaria",
   "heard": 6,
   "words": 6,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Built within the temple walls",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ahab also made an Asherah pole",
   "heard": 6,
   "words": 6,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To provoke the Lord's anger",
   "heard": 5,
   "words": 5,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jezebel was killing off the prophets",
   "heard": 6,
   "words": 6,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Obadiah hid them in a cave",
   "heard": 6,
   "words": 6,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Fifty in a cave with bread and water",
   "heard": 8,
   "words": 8,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Preserved by faithful hands",
   "heard": 4,
   "words": 4,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gather Israel to Mount Carmel",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Prophets of Baal and Asherah",
   "heard": 5,
   "words": 5,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Four hundred fifty shout and dance",
   "heard": 3,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But there is no sound or answer",
   "heard": 7,
   "words": 7,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Elijah repaired the altar",
   "heard": 4,
   "words": 4,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Twelve stones for Jacob's tribes",
   "heard": 5,
   "words": 5,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Four jars of water poured around",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The trench ran full with water",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fire of the Lord fell from heaven",
   "heard": 7,
   "words": 7,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Consumed the wood and stones",
   "heard": 5,
   "words": 5,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people fell facedown and cried",
   "heard": 5,
   "words": 6,
   "error_s": 0.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord is God indeed",
   "heard": 5,
   "words": 5,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seize the prophets of Baal",
   "heard": 4,
   "words": 5,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": true
  }
 ],
