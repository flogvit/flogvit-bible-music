 "words": 78,
 "lines": [
  {
   "text": "Lord, you have been our dwelling place",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through all generations",
   "heard": 3,
   "words": 3,
   "error_s": 1.52,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Before the mountains were born",
   "heard": 5,
   "words": 5,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From everlasting to everlasting you are God",
   "heard": 7,
   "words": 7,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You return mortals to dust",
   "heard": 5,
   "words": 5,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Saying, Return, you children of man",
   "heard": 5,
   "words": 6,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For a thousand years in your sight",
   "heard": 7,
   "words": 7,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Are like a day that has just gone by",
   "heard": 9,
   "words": 9,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Like grass that springs up in the morning",
   "heard": 8,
   "words": 8,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the morning it blooms and flourishes",
   "heard": 7,
   "words": 7,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By evening it withers and dries up",
   "heard": 7,
   "words": 7,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From everlasting to everlasting you are God",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  }
 ],
