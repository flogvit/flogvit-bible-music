 "words": 98,
 "lines": [
  {
   "text": "Though he was in the form of God",
   "heard": 8,
   "words": 8,
   "error_s": 7.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He did not count equality with God a thing to be grasped",
   "heard": 12,
   "words": 12,
   "error_s": 7.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He emptied himself, taking the form of a servant",
   "heard": 9,
   "words": 9,
   "error_s": 7.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Being born in the likeness of men",
   "heard": 7,
   "words": 7,
   "error_s": 7.23,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And being found in human form",
   "heard": 6,
   "words": 6,
   "error_s": 7.23,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "He humbled himself",
   "heard": 3,
   "words": 3,
   "error_s": 7.21,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "By becoming obedient to the point of death",
   "heard": 8,
   "words": 8,
   "error_s": 7.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Even death on a cross",
   "heard": 5,
   "words": 5,
   "error_s": 8.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Therefore God has highly exalted him",
   "heard": 6,
   "words": 6,
   "error_s": 8.36,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "And given him the name above every name",
   "heard": 8,
   "words": 8,
   "error_s": 8.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "That at the name of Jesus every knee shall bow",
   "heard": 10,
   "words": 10,
   "error_s": 10.36,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "And every tongue confess that Jesus Christ is Lord",
   "heard": 9,
   "words": 9,
   "error_s": 11.6,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "To the glory of God the Father",
   "heard": 7,
   "words": 7,
   "error_s": 17.46,
   "tie_split": true,
   "uncertain": true
  }
 ],
