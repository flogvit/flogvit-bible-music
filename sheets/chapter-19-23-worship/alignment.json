 "words_heard": 125,
 "words": 126,
 "lines": [
  {
   "text": "The LORD is my shepherd",
   "heard": 5,
   "words": 5,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I lack nothing",
   "heard": 3,
   "words": 3,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He lets me lie down in green pastures",
   "heard": 8,
   "words": 8,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He leads me beside still waters",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He restores my soul",
   "heard": 4,
   "words": 4,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He guides me along right paths",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For his name's sake",
   "heard": 4,
   "words": 4,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Even though I walk through the valley of the shadow of death",
   "heard": 12,
   "words": 12,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I fear no evil, for you are with me",
   "heard": 9,
   "words": 9,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your rod and your staff, they comfort me",
   "heard": 8,
   "words": 8,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You set a table before me in the presence of my enemies",
   "heard": 12,
   "words": 12,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You anoint my head with oil",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My cup overflows",
   "heard": 3,
   "words": 3,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Surely goodness and mercy will pursue me",
   "heard": 7,
   "words": 7,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All the days of my life",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And I will dwell in the house of the LORD",
   "heard": 10,
   "words": 10,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For length of days",
   "heard": 4,
   "words": 4,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will dwell in the house of the LORD",
   "heard": 9,
   "words": 9,
   "error_s": 0.79,
