   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Steadfast love and truth are joined",
   "heard": 5,
   "words": 6,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your promise does not fail",
   "heard": 5,
   "words": 5,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the midst of my distress",
   "heard": 6,
   "words": 6,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
