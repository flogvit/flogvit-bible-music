 "words": 234,
 "lines": [
  {
   "text": "He looked at the disciple by his side",
   "heard": 8,
   "words": 8,
   "error_s": 12.41,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Here is your mother, he said with pride",
   "heard": 8,
   "words": 8,
   "error_s": 12.39,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "From that hour she entered his home",
   "heard": 7,
   "words": 7,
   "error_s": 11.96,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "No more alone, in Jesus' name",
   "heard": 6,
   "words": 6,
   "error_s": 9.02,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Knowing all things were now complete",
   "heard": 5,
   "words": 6,
   "error_s": 6.88,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Scripture fulfilled on this holy street",
   "heard": 6,
   "words": 6,
   "error_s": 6.74,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "He said I thirst, dry lips and tongue",
   "heard": 8,
   "words": 8,
   "error_s": 5.96,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A jar of sour wine stood along",
   "heard": 7,
   "words": 7,
   "error_s": 6.43,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Soaked a sponge in the bitter wine",
   "heard": 5,
   "words": 7,
   "error_s": 5.39,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Held it high on a hyssop line",
   "heard": 5,
   "words": 7,
   "error_s": 5.43,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To his mouth they raised the branch",
   "heard": 7,
   "words": 7,
   "error_s": 7.48,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He received the drink to his command",
   "heard": 7,
   "words": 7,
   "error_s": 2.87,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "When he had taken the final cup",
   "heard": 7,
   "words": 7,
   "error_s": 0.4,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "He spoke the words, making all stop",
   "heard": 6,
   "words": 7,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It is finished, the debt is paid",
   "heard": 7,
   "words": 7,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bowing his head, the spirit stayed",
   "heard": 6,
   "words": 6,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Soaked a sponge in the bitter wine",
   "heard": 7,
   "words": 7,
   "error_s": 0.33,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Held it high on a hyssop line",
   "heard": 5,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To his mouth they raised the branch",
   "heard": 7,
