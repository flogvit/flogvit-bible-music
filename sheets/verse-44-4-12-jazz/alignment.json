 "lines": [
  {
   "text": "Examined for a good deed done today",
   "heard": 7,
   "words": 7,
   "error_s": 1.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A crippled man now healed and stands up straight",
   "heard": 9,
   "words": 9,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let it be known to all of Israel",
   "heard": 8,
   "words": 8,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By the name of Jesus Christ of Nazareth",
   "heard": 8,
   "words": 8,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whom you crucified and God raised from the dead",
   "heard": 9,
   "words": 9,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This man stands before you fully healed",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is the stone you builders rejected",
   "heard": 7,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now the cornerstone where our hope is met",
   "heard": 8,
   "words": 8,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "There is salvation in no one else",
   "heard": 7,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No other name under heaven given to men",
   "heard": 8,
   "words": 8,
   "error_s": 1.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By which we must be saved from our sin",
   "heard": 9,
   "words": 9,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
