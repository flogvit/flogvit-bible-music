 "offset_seconds": 5.459999999999628,
 "words_heard": 209,
 "words": 210,
 "lines": [
  {
   "text": "In the fifth month of that year",
   "heard": 7,
   "words": 7,
   "error_s": 8.93,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The prophet Hananiah stood",
   "heard": 4,
   "words": 4,
   "error_s": 8.71,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the house of the LORD",
   "heard": 6,
   "words": 6,
   "error_s": 7.23,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Before the priests and crowd",
   "heard": 5,
   "words": 5,
   "error_s": 7.76,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He spoke in the name of God",
   "heard": 7,
   "words": 7,
   "error_s": 6.61,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "That Babylon's rule would cease",
   "heard": 5,
   "words": 5,
   "error_s": 7.03,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And vessels would return",
   "heard": 4,
   "words": 4,
   "error_s": 6.67,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "From the distant Babylon",
   "heard": 4,
   "words": 4,
   "error_s": 7.6,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He would bring back Jeconiah",
   "heard": 5,
   "words": 5,
   "error_s": 6.8,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "And all the exiles home",
   "heard": 5,
   "words": 5,
   "error_s": 6.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Within two years he said",
   "heard": 5,
   "words": 5,
   "error_s": 5.7,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The yoke would be undone",
   "heard": 5,
   "words": 5,
   "error_s": 5.63,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jeremiah replied Amen",
   "heard": 3,
   "words": 3,
   "error_s": 6.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "May the LORD do so",
   "heard": 5,
   "words": 5,
   "error_s": 4.51,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "But listen to my word",
   "heard": 5,
   "words": 5,
   "error_s": 3.57,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To you and to the crowd",
   "heard": 6,
   "words": 6,
   "error_s": 4.62,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Prophets long before your time",
   "heard": 5,
   "words": 5,
   "error_s": 0.35,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Spoke of war and plague",
   "heard": 5,
   "words": 5,
   "error_s": 0.85,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "But he who prophesies peace",
   "heard": 5,
   "words": 5,
   "error_s": 1.68,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Must see it come to pass",
   "heard": 6,
   "words": 6,
   "error_s": 2.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Then Hananiah took the yoke",
   "heard": 5,
   "words": 5,
   "error_s": 2.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "From the prophet's neck",
   "heard": 4,
   "words": 4,
   "error_s": 1.67,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He broke it in pieces",
   "heard": 5,
   "words": 5,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Before the eyes of all",
   "heard": 5,
   "words": 5,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He declared to the people",
   "heard": 5,
   "words": 5,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That God had spoken",
   "heard": 4,
   "words": 4,
   "error_s": 1.36,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "That within two years",
   "heard": 4,
   "words": 4,
   "error_s": 0.7,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "He'd break the yoke off",
   "heard": 5,
   "words": 5,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jeremiah went his way",
   "heard": 4,
   "words": 4,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the word came to him",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You broke yokes of wood",
   "heard": 5,
   "words": 5,
   "error_s": 1.85,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Yet you made yokes of iron",
   "heard": 6,
   "words": 6,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD of hosts has put",
   "heard": 6,
   "words": 6,
   "error_s": 4.34,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "An iron yoke on them",
   "heard": 5,
   "words": 5,
   "error_s": 3.79,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To serve Nebuchadnezzar",
   "heard": 3,
   "words": 3,
   "error_s": 4.25,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "And serve him they will",
   "heard": 5,
   "words": 5,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The wild animals given",
   "heard": 4,
   "words": 4,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the king of Babylon",
   "heard": 5,
   "words": 5,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You have made them trust",
   "heard": 5,
   "words": 5,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In a great and heavy lie",
   "heard": 5,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hananiah died in the seventh month",
   "heard": 6,
   "words": 6,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In that very same year",
   "heard": 5,
   "words": 5,
   "error_s": 3.18,
   "tie_split": false,
   "uncertain": true
  }
 ],
