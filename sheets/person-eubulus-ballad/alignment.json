   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Crescens has gone to Galatia",
   "heard": 5,
   "words": 5,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Only Luke remains with me",
   "heard": 5,
   "words": 5,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
