{
 "id": "story-saul-og-spaakvinnen-i-en-dor-acoustic",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-saul-og-spaakvinnen-i-en-dor-acoustic",
 "offset_seconds": -3.1600000000001884,
 "words_heard": 297,
 "words": 308,
 "lines": [
  {
   "text": "Samuel is dead and buried in Ramah",
   "heard": 7,
   "words": 7,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All Israel mourned his passing away",
   "heard": 6,
   "words": 6,
   "error_s": 1.74,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Saul had driven mediums out of the land",
   "heard": 5,
   "words": 8,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But fear now gripped his trembling heart",
   "heard": 7,
   "words": 7,
   "error_s": 1.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Philistines camped at Shunem in sight",
   "heard": 5,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Israel waited at Gilboa that night",
   "heard": 6,
   "words": 6,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He inquired of the LORD for a sign",
   "heard": 8,
   "words": 8,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But no answer came through dream or line",
   "heard": 8,
   "words": 8,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not by Urim nor by prophets' call",
   "heard": 6,
   "words": 7,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Silence held him in the empty hall",
   "heard": 7,
   "words": 7,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why have you disturbed me by bringing me up",
   "heard": 9,
   "words": 9,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD has turned away and become your enemy",
   "heard": 9,
   "words": 9,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He has torn the kingdom out of your hand",
   "heard": 9,
   "words": 9,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And given it to David your neighbor today",
   "heard": 8,
   "words": 8,
   "error_s": 0.61,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Saul disguised himself in other clothes",
   "heard": 6,
   "words": 6,
   "error_s": 1.36,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Took two men to the woman at night",
   "heard": 8,
   "words": 8,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Asked her to consult a spirit for him",
   "heard": 7,
   "words": 8,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She asked who he would want to find",
   "heard": 8,
   "words": 8,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bring up Samuel he whispered low",
   "heard": 5,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She cried out in a sudden flow",
   "heard": 7,
   "words": 7,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why have you deceived me she exclaimed",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I see you clearly you are Saul",
   "heard": 6,
   "words": 7,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "An old man wrapped in a robe is coming",
   "heard": 9,
   "words": 9,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rising up from the ground so lonely",
   "heard": 7,
   "words": 7,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Saul bowed his face to the dusty ground",
   "heard": 6,
   "words": 8,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Trembling before the prophet found",
   "heard": 4,
   "words": 5,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why have you disturbed me by bringing me up",
   "heard": 9,
   "words": 9,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD has turned away and become your enemy",
   "heard": 9,
   "words": 9,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He has torn the kingdom out of your hand",
   "heard": 9,
   "words": 9,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And given it to David your neighbor today",
   "heard": 8,
   "words": 8,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Because you did not obey the voice of the LORD",
   "heard": 10,
   "words": 10,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And failed his burning anger against Amalek",
   "heard": 7,
   "words": 7,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD will hand both you and Israel over",
   "heard": 9,
   "words": 9,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the Philistines in the dark",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Tomorrow you and your sons will be with me",
   "heard": 9,
   "words": 9,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the army will fall in defeat",
   "heard": 7,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Saul fell full length on the ground in fear",
   "heard": 9,
   "words": 9,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His strength was gone and his spirit broke",
   "heard": 8,
   "words": 8,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They ate and left in the dark of the night",
   "heard": 10,
   "words": 10,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With no hope left in the sight",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  }
 ],
