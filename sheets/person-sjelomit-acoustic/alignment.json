 "offset_seconds": -4.240000000000165,
 "words_heard": 154,
 "words": 155,
 "lines": [
  {
   "text": "An Egyptian father, an Israelite mother",
   "heard": 6,
   "words": 6,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The son of Shelomith, daughter of Dibri",
   "heard": 6,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the tribe of Dan, he walked in the camp",
   "heard": 10,
   "words": 10,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A fight broke out, and the Name was blasphemed",
   "heard": 9,
   "words": 9,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They brought him to Moses, held him in custody",
   "heard": 9,
   "words": 9,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Waiting for the will of the Lord to be known",
   "heard": 10,
   "words": 10,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Take the blasphemer outside the camp",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All who heard him lay hands on his head",
   "heard": 9,
   "words": 9,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The whole assembly is to stone him",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As the LORD has commanded Moses",
   "heard": 6,
   "words": 6,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord spoke down, saying to the leader",
   "heard": 8,
   "words": 8,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Anyone who curses God bears the sin",
   "heard": 7,
   "words": 7,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever blasphemes the Name of the LORD",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Must be put to death, foreigner or native",
   "heard": 8,
   "words": 8,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Take the blasphemer outside the camp",
   "heard": 6,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All who heard him lay hands on his head",
   "heard": 9,
   "words": 9,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The whole assembly is to stone him",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As the LORD has commanded Moses",
   "heard": 6,
   "words": 6,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So the Israelites did as the LORD commanded",
   "heard": 8,
   "words": 8,
   "error_s": 0.57,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "They took him out, and they stoned him to death",
   "heard": 10,
   "words": 10,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  }
 ],
