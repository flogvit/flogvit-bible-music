 "lines": [
  {
   "text": "Jeconiah the captive lived in Babylon",
   "heard": 5,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His sons were listed in the royal line",
   "heard": 8,
   "words": 8,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pedaiah stands among the names recorded",
   "heard": 6,
   "words": 6,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Malchiram, Shenazzar, and Hoshama too",
   "heard": 5,
   "words": 5,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A seat of honor above the other kings",
   "heard": 7,
   "words": 8,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He spoke kindly and the prison clothes were gone",
   "heard": 9,
   "words": 9,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He ate at the king's table for his life",
   "heard": 9,
   "words": 9,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Davidic promise kept within the line",
   "heard": 5,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zerubbabel was Pedaiah's son",
   "heard": 3,
   "words": 4,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He led the exiles back to Jerusalem",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
