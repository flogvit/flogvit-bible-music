{
 "id": "person-hobaja-choral",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/person-hobaja-choral",
 "offset_seconds": -4.8000000000001535,
 "words_heard": 128,
 "words": 130,
 "lines": [
  {
   "text": "We came from exile to the city gate",
   "heard": 8,
   "words": 8,
   "error_s": 1.32,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With Zerubbabel and the faithful band",
   "heard": 6,
   "words": 6,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seeking our place in the holy estate",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the records of our names were scant",
   "heard": 8,
   "words": 8,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sons of Hobaiah and Hakkoz too",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Barzillai who took the Gileadite name",
   "heard": 7,
   "words": 7,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We sought the entry in the book anew",
   "heard": 7,
   "words": 8,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the trace was lost in history's flame",
   "heard": 8,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They searched for our name in the registers",
   "heard": 8,
   "words": 8,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But it could not be found by the eye",
   "heard": 9,
   "words": 9,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Excluded from the priesthood as unclean we stand",
   "heard": 8,
   "words": 8,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Denied the holy service to rely",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The governor spoke with a firm decree",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not eat of the most holy food",
   "heard": 8,
   "words": 8,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Until a priest should arise in the day",
   "heard": 8,
   "words": 8,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To consult the Urim and Thummim in the cloud",
   "heard": 8,
   "words": 9,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "We wait for the sign that we are clean",
   "heard": 9,
   "words": 9,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  }
 ],
