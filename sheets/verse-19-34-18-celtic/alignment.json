 "words": 179,
 "lines": [
  {
   "text": "Turn away from evil and do good",
   "heard": 7,
   "words": 7,
   "error_s": 12.5,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Seek peace and pursue it day by day",
   "heard": 8,
   "words": 8,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The eyes of the LORD are on the righteous",
   "heard": 9,
   "words": 9,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His ears are open to their cry",
   "heard": 7,
   "words": 7,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD is near to the brokenhearted",
   "heard": 6,
   "words": 7,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He saves those crushed in spirit",
   "heard": 6,
   "words": 6,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They cried out and the LORD heard",
   "heard": 7,
   "words": 7,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He delivered them from all their troubles",
   "heard": 7,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The face of the LORD is set against evil",
   "heard": 9,
   "words": 9,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To cut off their memory from the earth",
   "heard": 8,
   "words": 8,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Many are the afflictions of the righteous",
   "heard": 7,
   "words": 7,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the LORD delivers him from them all",
   "heard": 8,
   "words": 8,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD is near to the brokenhearted",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He saves those crushed in spirit",
   "heard": 6,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They cried out and the LORD heard",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He delivered them from all their troubles",
   "heard": 7,
   "words": 7,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He watches over all his bones",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not one of them is broken",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Evil will put the wicked to death",
   "heard": 7,
   "words": 7,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the guilty will bear their guilt",
   "heard": 7,
   "words": 7,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD is near to the brokenhearted",
