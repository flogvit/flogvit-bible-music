   "error_s": 1.18,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And the plans of the wicked are scattered",
   "heard": 8,
   "words": 8,
   "error_s": 1.15,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "But Hushai the Archite spoke with care",
   "heard": 7,
   "words": 7,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Saying the advice was not good",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
