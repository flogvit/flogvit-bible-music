{
 "id": "story-jehu-salves-til-konge-og-akabs-hus-utryddes-choral",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-jehu-salves-til-konge-og-akabs-hus-utryddes-choral",
 "offset_seconds": -0.9800000000002349,
 "words_heard": 146,
 "words": 149,
 "lines": [
  {
   "text": "Elisha called a son of prophets",
   "heard": 6,
   "words": 6,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Take the flask and go to Ramoth-gilead",
   "heard": 6,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Find Jehu son of Jehoshaphat",
   "heard": 5,
   "words": 5,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pour the oil on his head",
   "heard": 6,
   "words": 6,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This is what the Lord says",
   "heard": 6,
   "words": 6,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I anoint you king over Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Strike down the house of Ahab",
   "heard": 6,
   "words": 6,
   "error_s": 1.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Avenge the blood of prophets",
   "heard": 5,
   "words": 5,
   "error_s": 1.88,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jehu rode to Jezreel city",
   "heard": 5,
   "words": 5,
   "error_s": 1.64,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Joram asked if it came in peace",
   "heard": 7,
   "words": 7,
   "error_s": 1.55,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He drew his bow and shot the king",
   "heard": 8,
   "words": 8,
   "error_s": 1.66,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Between the shoulders and the heart",
   "heard": 6,
   "words": 6,
   "error_s": 1.8,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Throw him on the plot of Naboth",
   "heard": 7,
   "words": 7,
   "error_s": 2.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Repent for the blood of the prophet",
   "heard": 7,
   "words": 7,
   "error_s": 1.64,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Ahaziah fled to Megiddo",
   "heard": 4,
   "words": 4,
   "error_s": 2.12,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Where he died in his chariot",
   "heard": 6,
   "words": 6,
   "error_s": 2.04,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jezebel looked out the window",
   "heard": 5,
   "words": 5,
   "error_s": 4.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Asking if Zimri came in peace",
   "heard": 6,
   "words": 6,
   "error_s": 1.95,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He called for help and they threw her down",
   "heard": 9,
   "words": 9,
   "error_s": 2.0,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Trampled by the horses",
   "heard": 4,
   "words": 4,
   "error_s": 2.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They found only skull and feet",
   "heard": 6,
   "words": 6,
   "error_s": 16.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "No one could bury her body",
   "heard": 6,
   "words": 6,
   "error_s": 2.96,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Dogs devoured her in Jezreel",
   "heard": 5,
   "words": 5,
   "error_s": 3.56,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "As Elijah had foretold",
   "heard": 4,
   "words": 4,
   "error_s": 2.51,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "This is the word of the Lord",
   "heard": 5,
   "words": 7,
   "error_s": 30.48,
   "tie_split": false,
   "uncertain": true
  }
 ],
