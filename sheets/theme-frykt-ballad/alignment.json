  },
  {
   "text": "I will strengthen you, I will surely help you",
   "heard": 9,
   "words": 9,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will uphold you with my righteous right hand",
   "heard": 9,
   "words": 9,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
