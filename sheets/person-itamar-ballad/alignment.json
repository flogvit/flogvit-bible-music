  {
   "text": "Bring near Aaron and his sons",
   "heard": 6,
   "words": 6,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To serve me as priests among the people",
   "heard": 8,
   "words": 8,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nadab and Abihu Eleazar Ithamar",
   "heard": 5,
   "words": 5,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Chosen for the holy task",
   "heard": 5,
   "words": 5,
   "error_s": 1.08,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Fire went out from before the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Consumed two who offered unauthorized fire",
   "heard": 6,
   "words": 6,
   "error_s": 1.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Aaron was silent in the shock",
   "heard": 6,
   "words": 6,
   "error_s": 0.54,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Moses spoke with weight and grace",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Do not let your hair hang loose",
   "heard": 7,
   "words": 7,
   "error_s": 1.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Do not tear your garments in despair",
   "heard": 7,
   "words": 7,
   "error_s": 1.49,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Stay at the entrance of the tent",
