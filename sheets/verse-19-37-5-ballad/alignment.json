 "lines": [
  {
   "text": "Like grass they will soon wither",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fade like the green of new growth",
   "heard": 7,
   "words": 7,
   "error_s": 1.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Trust in the Lord and do good",
   "heard": 7,
   "words": 7,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Dwell in the land with grace",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Make faithfulness your pasture",
   "heard": 4,
   "words": 4,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Delight in the Lord alone",
   "heard": 5,
   "words": 5,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will give what your heart asks",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When you walk in his ways",
   "heard": 6,
   "words": 6,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Commit your way to the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Trust in him and he will act",
   "heard": 7,
   "words": 7,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bring out your righteousness",
   "heard": 4,
   "words": 4,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Like the light of day",
   "heard": 5,
   "words": 5,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Be still before the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Wait patiently for him",
   "heard": 4,
   "words": 4,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
