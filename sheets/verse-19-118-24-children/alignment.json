 "lines": [
  {
   "text": "When the sun comes up and I open my eyes",
   "heard": 10,
   "words": 10,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I can see the morning in the bright blue sky",
   "heard": 10,
   "words": 10,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I stretch up tall and I jump out of bed",
   "heard": 10,
   "words": 10,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I remember what the Bible said",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This is the day the LORD has made",
   "heard": 0,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Let us rejoice and be glad in it",
