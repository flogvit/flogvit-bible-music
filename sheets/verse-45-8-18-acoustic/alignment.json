   "words": 4,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In hope it was subjected",
   "heard": 4,
   "words": 5,
   "error_s": 0.05,
   "tie_split": false,
   "uncertain": false
  },
  {
