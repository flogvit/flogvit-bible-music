 "lines": [
  {
   "text": "A young shoot in the dry ground",
   "heard": 7,
   "words": 7,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No beauty to draw our eyes",
   "heard": 6,
   "words": 6,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He was despised and rejected",
   "heard": 5,
   "words": 5,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A man of sorrows and grief",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We hid our faces from him",
   "heard": 6,
   "words": 6,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Holding him of no account",
   "heard": 5,
   "words": 5,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet he bore our heavy griefs",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Carrying our deep sorrows",
   "heard": 4,
   "words": 4,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But he was pierced for our transgressions",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Crushed for our iniquities",
   "heard": 4,
   "words": 4,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The punishment brought us peace",
   "heard": 5,
   "words": 5,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Laid upon his body",
   "heard": 4,
   "words": 4,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By his wounds we are healed",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By his wounds we are healed",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All of us have strayed like sheep",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Turning to our own ways",
   "heard": 5,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord laid all our sin",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Upon his innocent soul",
   "heard": 4,
   "words": 4,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
