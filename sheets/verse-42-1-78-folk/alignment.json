 "lines": [
  {
   "text": "In holiness and righteousness we walk",
   "heard": 6,
   "words": 6,
   "error_s": 11.11,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Before him all our days we shall keep",
   "heard": 8,
   "words": 8,
   "error_s": 9.95,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "You child will be called a prophet",
   "heard": 7,
   "words": 7,
   "error_s": 6.72,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Of the Most High in your sacred sleep",
   "heard": 8,
   "words": 8,
   "error_s": 6.0,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Dawn from on high will visit us",
   "heard": 7,
   "words": 7,
   "error_s": 4.86,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shine on those in darkness and the shadow of death",
   "heard": 10,
   "words": 10,
   "error_s": 6.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Guide our feet into the way of peace",
   "heard": 8,
   "words": 8,
   "error_s": 5.7,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With the tender mercy of our God",
   "heard": 7,
   "words": 7,
   "error_s": 4.73,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Prepare his ways to go on ahead",
   "heard": 7,
   "words": 7,
   "error_s": 0.53,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Give his people knowledge of salvation",
   "heard": 6,
   "words": 6,
   "error_s": 3.24,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Through the forgiveness of their sins",
   "heard": 6,
   "words": 6,
   "error_s": 0.31,
   "tie_split": true,
   "uncertain": false
  },
  {
