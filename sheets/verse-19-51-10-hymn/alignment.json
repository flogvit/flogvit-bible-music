 "lines": [
  {
   "text": "I was born in guilt and sin",
   "heard": 7,
   "words": 7,
   "error_s": 2.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My mother conceived me in shame",
   "heard": 6,
   "words": 6,
   "error_s": 1.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You delight in truth within",
   "heard": 5,
   "words": 5,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Teach me wisdom in the hidden place",
   "heard": 7,
   "words": 7,
   "error_s": 1.39,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Cleanse me with hyssop now",
   "heard": 4,
   "words": 5,
   "error_s": 1.59,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Wash me and I will be clean",
   "heard": 7,
   "words": 7,
   "error_s": 1.56,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Whiter than snow I become",
   "heard": 5,
   "words": 5,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When your hand removes the stain",
   "heard": 6,
   "words": 6,
   "error_s": 1.43,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Create in me a clean heart, O God",
   "heard": 6,
   "words": 8,
   "error_s": 1.25,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Renew a steadfast spirit within me",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not cast me from your presence",
   "heard": 7,
   "words": 7,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not take your holy Spirit from me",
   "heard": 8,
   "words": 8,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hide your face from my sins",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Blot out all my guilt and shame",
   "heard": 7,
   "words": 7,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
