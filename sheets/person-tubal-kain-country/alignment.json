 "lines": [
  {
   "text": "Zillah gave birth to a new son",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Cain was building his first city",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lamech took two wives for his own",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One named Adah, the other Zillah",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Adah bore Jabal the nomad",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Father of those with tents and flocks",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jubal played the lyre and pipe",
   "heard": 6,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Father of all who hear the song",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Tubal-Cain forged the metal tools",
   "heard": 4,
   "words": 5,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Out of bronze and iron bright",
   "heard": 6,
   "words": 6,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He shaped the hammer and the tongs",
   "heard": 7,
   "words": 7,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Under the heavy weight of night",
   "heard": 6,
   "words": 6,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His sister Naamah stood beside",
   "heard": 5,
   "words": 5,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Name recorded in the old genealogy",
   "heard": 6,
   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jabal lived among the tents",
   "heard": 5,
   "words": 5,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jubal played the ancient melodies",
   "heard": 4,
   "words": 5,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Tubal-Cain forged the metal tools",
