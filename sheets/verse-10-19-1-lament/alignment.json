 "words_heard": 128,
 "words": 131,
 "lines": [
  {
   "text": "Good news for my lord the king",
   "heard": 7,
   "words": 7,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The Lord has delivered you today",
   "heard": 6,
   "words": 6,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Is it well with the young man Absalom",
   "heard": 8,
   "words": 8,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "May all your enemies be like that young man",
   "heard": 9,
   "words": 9,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "O my son Absalom",
   "heard": 4,
   "words": 4,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "My son, my son Absalom",
   "heard": 5,
   "words": 5,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Would I had died instead of you",
   "heard": 6,
   "words": 7,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "O Absalom, my son, my son",
   "heard": 6,
   "words": 6,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The king was deeply moved",
   "heard": 5,
   "words": 5,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He went up to the chamber over the gate and wept",
   "heard": 11,
   "words": 11,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And as he went, he said",
   "heard": 6,
   "words": 6,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "O my son",
   "heard": 3,
   "words": 3,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The victory that day was turned to mourning",
   "heard": 8,
   "words": 8,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people stole into the city",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As people steal in who are ashamed",
   "heard": 6,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The king covered his face and cried with a loud voice",
   "heard": 11,
   "words": 11,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "O my son Absalom",
   "heard": 4,
   "words": 4,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My son, my son Absalom",
