   "words": 5,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the kingdom of heaven belongs",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To such as these",
   "heard": 4,
   "words": 4,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hands placed on the head",
   "heard": 5,
   "words": 5,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A prayer softly said",
   "heard": 4,
   "words": 4,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": true
  },
  {
