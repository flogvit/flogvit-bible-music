 "words_heard": 95,
 "words": 100,
 "lines": [
  {
   "text": "Det var noen gjetere p\u00e5 marken",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "som voktet flokken sin om natt",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Da sto en Herrens engel foran dem",
   "heard": 7,
   "words": 7,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og lyset str\u00e5lte overalt",
   "heard": 3,
   "words": 4,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Frykt ikke, se, jeg bringer glede",
   "heard": 6,
   "words": 6,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "en glede for det hele folk",
   "heard": 6,
   "words": 6,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I dag er f\u00f8dt i Davids by",
   "heard": 7,
   "words": 7,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "en frelser, Kristus, Herren v\u00e5r",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Og dette skal for dere v\u00e6re tegnet",
   "heard": 7,
   "words": 7,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "et barn som ligger i en krybbe sv\u00f8pt",
   "heard": 6,
   "words": 8,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Og himmelens h\u00e6r sang sammen med engelen",
   "heard": 6,
   "words": 7,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "med lovsang over jorden l\u00f8ftet",
   "heard": 4,
   "words": 5,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "\u00c6re v\u00e6re Gud i det h\u00f8yeste",
   "heard": 6,
   "words": 6,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og fred p\u00e5 jorden, fred i kveld",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "blant mennesker som Gud har behag i",
   "heard": 7,
   "words": 7,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "syng med, alle, syng i kveld",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  }
 ],
