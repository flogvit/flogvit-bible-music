   "heard": 8,
   "words": 8,
   "error_s": 1.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With my mouth I make faithfulness known",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To every generation that shall come",
