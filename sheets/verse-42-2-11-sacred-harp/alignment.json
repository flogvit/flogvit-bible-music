 "words_heard": 97,
 "words": 98,
 "lines": [
  {
   "text": "The shepherds in the field by night",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Were watching flocks of sheep",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When glory shone with sudden light",
   "heard": 6,
   "words": 6,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And woke them from their sleep",
   "heard": 6,
   "words": 6,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fear not, the shining angel said",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Great joy to all I bring",
   "heard": 6,
   "words": 6,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In Bethlehem a manger bed",
   "heard": 5,
   "words": 5,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now holds your Lord and King",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And then a host of angels came",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And filled the midnight sky",
   "heard": 5,
   "words": 5,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They sang the glory of his name",
   "heard": 7,
   "words": 7,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To God be praise on high",
   "heard": 6,
   "words": 6,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And peace on earth to all below",
   "heard": 7,
   "words": 7,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With whom the Lord is pleased",
   "heard": 6,
   "words": 6,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So let us all to Bethlehem go",
   "heard": 7,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And see what God has seized",
   "heard": 5,
   "words": 6,
   "error_s": 0.04,
   "tie_split": false,
   "uncertain": false
  }
 ],
