 "lines": [
  {
   "text": "You did not pick me out of the crowd",
   "heard": 9,
   "words": 9,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I chose no one, I was found",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your voice reached out to lift me up",
   "heard": 8,
   "words": 8,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A new and quiet purpose in my cup",
   "heard": 8,
   "words": 8,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Go and bear fruit that will last",
