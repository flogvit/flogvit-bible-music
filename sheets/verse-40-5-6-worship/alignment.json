   "words": 7,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Meek in spirit, the earth is the prize",
   "heard": 0,
   "words": 8,
   "error_s": null,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Hunger and thirst, with open wide eyes",
