   "words": 10,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zacchaeus stood up tall that day",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Half of all I own",
   "heard": 5,
   "words": 5,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
