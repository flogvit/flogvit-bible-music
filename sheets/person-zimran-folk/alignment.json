   "words": 4,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ishbak and Shuah",
   "heard": 3,
   "words": 3,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Everything to Isaac",
   "heard": 3,
   "words": 3,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But gifts to the rest",
   "heard": 5,
   "words": 5,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sent away eastward",
   "heard": 3,
   "words": 3,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Away from the west",
   "heard": 4,
   "words": 4,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "While he was still alive",
   "heard": 5,
   "words": 5,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He sent them to the land",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where the sun rises early",
