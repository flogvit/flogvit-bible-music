 "lines": [
  {
   "text": "Rooted deep in the soil of Judah",
   "heard": 7,
   "words": 7,
   "error_s": 1.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The branch of Jerahmeel grew",
   "heard": 5,
   "words": 5,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Hezron's firstborn led the way",
   "heard": 4,
   "words": 5,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ram and Bunah in their day",
   "heard": 6,
   "words": 6,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Oren and Ozem stood beside",
   "heard": 5,
   "words": 5,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ahijah walking with pride",
   "heard": 4,
   "words": 4,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Another wife named Atarah",
   "heard": 4,
   "words": 4,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mother of Onam in the earth",
   "heard": 6,
   "words": 6,
   "error_s": 1.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shammai and Jada were born",
   "heard": 5,
   "words": 5,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "From Onam's line in the dawn",
   "heard": 6,
   "words": 6,
   "error_s": 1.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Shammai's sons were Nadab and Abishur",
   "heard": 6,
   "words": 6,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abishur's wife bore the fruit",
   "heard": 5,
   "words": 5,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abihail gave birth to Ahban",
   "heard": 5,
   "words": 5,
   "error_s": 1.36,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Molid joined in the clan",
   "heard": 4,
   "words": 5,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nadab's sons were Seled and Appaim",
   "heard": 5,
   "words": 6,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seled died without children's claim",
   "heard": 4,
   "words": 5,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But Appaim carried the name",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sole heir in the house of fame",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The son of Appaim was Ishi",
   "heard": 5,
   "words": 6,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who walked in the faithful day",
   "heard": 6,
   "words": 6,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sheshan came after Ishi",
   "heard": 3,
   "words": 4,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Ahlai closed the way",
   "heard": 5,
   "words": 5,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The genealogy stands and tells",
   "heard": 4,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of the tribe that never falls",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sons of Sheshan followed on",
   "heard": 6,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ahlai kept the tradition",
   "heard": 3,
   "words": 4,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Recording names for inheritance",
   "heard": 4,
   "words": 4,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Tribal rights in the land",
   "heard": 5,
   "words": 5,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From Judah down through Jerahmeel",
   "heard": 4,
   "words": 5,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The lines were kept whole and real",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No brother's line was lost in the dark",
   "heard": 8,
   "words": 8,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For Appaim left his mark",
   "heard": 4,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But Appaim carried the name",
   "heard": 4,
   "words": 5,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sole heir in the house of fame",
   "heard": 7,
   "words": 7,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
