 "words": 93,
 "lines": [
  {
   "text": "Eliashib the high priest began",
   "heard": 5,
   "words": 5,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Rebuilding the Sheep Gate again",
   "heard": 5,
   "words": 5,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They consecrated it with care",
   "heard": 5,
   "words": 5,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Set doors and bolted them there",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Next to them Meremoth worked on",
   "heard": 5,
   "words": 6,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Repairs for the city strong",
   "heard": 5,
   "words": 5,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Meshullam son of Berechiah",
   "heard": 4,
   "words": 4,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Made repairs as the wall grew",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Zadok son of Baana joined",
   "heard": 5,
   "words": 5,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Next to them their labor joined",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Men of Tekoa made repairs",
   "heard": 5,
   "words": 5,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But nobles would not lift their cares",
   "heard": 7,
   "words": 7,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "On the twenty-fifth of Elul",
   "heard": 4,
   "words": 5,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The wall was finished, it was full",
   "heard": 7,
   "words": 7,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In fifty-two days it stood",
   "heard": 4,
   "words": 5,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Against all the enemy\u2019s mood",
   "heard": 5,
   "words": 5,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They knew it was our God",
   "heard": 6,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  }
 ],
