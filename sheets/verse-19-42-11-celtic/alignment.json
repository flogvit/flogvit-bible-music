 "lines": [
  {
   "text": "Deep calls to deep at the thunder of waterfalls",
   "heard": 9,
   "words": 9,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All your breakers and waves have swept over me",
   "heard": 9,
   "words": 9,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By day the Lord commands his steadfast love",
   "heard": 8,
   "words": 8,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At night his song is with me in prayer",
   "heard": 9,
   "words": 9,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why are you cast down, my soul",
   "heard": 7,
   "words": 7,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "O soul, why do you groan within me",
   "heard": 8,
   "words": 8,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hope in God for I will praise him again",
   "heard": 9,
   "words": 9,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My salvation and my God",
   "heard": 5,
   "words": 5,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I say to God my rock why have you forgotten me",
   "heard": 11,
   "words": 11,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why must I go about in mourning oppressed",
   "heard": 8,
   "words": 8,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The enemy presses in with cold and silence",
   "heard": 8,
   "words": 8,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
