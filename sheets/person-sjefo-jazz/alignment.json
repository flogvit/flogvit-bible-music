 "lines": [
  {
   "text": "In the land where the Horites once stood",
   "heard": 8,
   "words": 8,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Before Esau came to claim the land",
   "heard": 7,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lotan and Shobal and Zibeon",
   "heard": 4,
   "words": 5,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Anah and Dishon in the sun",
   "heard": 5,
   "words": 6,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ezer and Dishan held the place",
