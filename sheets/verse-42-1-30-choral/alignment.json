 "lines": [
  {
   "text": "A virgin pledged to Joseph of David's line",
   "heard": 8,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The angel came to say a sacred sign",
   "heard": 8,
   "words": 8,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She was deeply troubled by the sudden light",
   "heard": 8,
   "words": 8,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Wondering what this greeting could be like",
   "heard": 7,
   "words": 7,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the angel spoke with gentle grace",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Do not be afraid in this place",
   "heard": 7,
   "words": 7,
   "error_s": 0.64,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "You have found favor with God",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "A promise made to stand apart",
   "heard": 6,
   "words": 6,
   "error_s": 1.44,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You will conceive a son of might",
   "heard": 7,
   "words": 7,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Name him Jesus in the light",
