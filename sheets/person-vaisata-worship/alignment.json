 "words": 218,
 "lines": [
  {
   "text": "This happened in the days of Ahasuerus",
   "heard": 7,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ruling over a hundred and twenty-seven provinces",
   "heard": 6,
   "words": 7,
   "error_s": 1.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Seated on his royal throne in Susa",
   "heard": 7,
   "words": 7,
   "error_s": 1.36,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the third year of his reign he gave a feast",
   "heard": 11,
   "words": 11,
   "error_s": 1.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A hundred and eighty days of wealth displayed",
   "heard": 4,
   "words": 8,
   "error_s": 1.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Splendid glory of his greatness seen",
   "heard": 6,
   "words": 6,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Then seven days in the garden court",
   "heard": 7,
   "words": 7,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For all the people in the citadel",
   "heard": 7,
   "words": 7,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Queen Vashti gave a banquet for the women",
   "heard": 8,
   "words": 8,
   "error_s": 1.13,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the royal palace of the king",
   "heard": 7,
   "words": 7,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "On the seventh day his heart was merry",
   "heard": 8,
   "words": 8,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With wine he commanded the eunuchs",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bring Queen Vashti wearing her royal crown",
   "heard": 7,
   "words": 7,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To display her beauty to the peoples",
   "heard": 7,
   "words": 7,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She was lovely to look at they said",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But she refused to come at the command",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The king became furious in his heart",
   "heard": 7,
   "words": 7,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His anger burned within him deep",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He consulted the wise men who knew the law",
   "heard": 9,
   "words": 9,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To ask what should be done with her",
   "heard": 8,
   "words": 8,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bring Queen Vashti wearing her royal crown",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To display her beauty to the peoples",
   "heard": 7,
   "words": 7,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She was lovely to look at they said",
   "heard": 8,
   "words": 8,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But she refused to come at the command",
   "heard": 8,
   "words": 8,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Memucan answered before the king",
   "heard": 3,
   "words": 5,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She has wronged all the officials",
   "heard": 6,
   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The women will despise their husbands",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If she does not obey the decree",
   "heard": 7,
   "words": 7,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let the royal position go to another",
   "heard": 7,
   "words": 7,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "To a woman who is better than she",
   "heard": 8,
   "words": 8,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  }
 ],
