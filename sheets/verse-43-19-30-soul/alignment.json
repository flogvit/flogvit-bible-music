   "error_s": 1.66,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "He received the drink to his command",
   "heard": 7,
   "words": 7,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The day of preparation was near",
   "heard": 6,
   "words": 6,
   "error_s": 2.02,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Jews did not want bodies here",
   "heard": 6,
   "words": 6,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For that Sabbath was a high day",
   "heard": 7,
   "words": 7,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ask Pilate to stop the display",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
