   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Heave away, my boys",
   "heard": 4,
   "words": 4,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A stranger slept down in the hold",
   "heard": 7,
