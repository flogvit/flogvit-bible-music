 "lines": [
  {
   "text": "We have confidence to enter now",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By the blood of Jesus it allows",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The new and living way is clear",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Opened through the curtain",
   "heard": 4,
   "words": 4,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through his flesh the path is true",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We walk upon the ground so new",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A great priest stands over the house",
   "heard": 7,
   "words": 7,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We find our rest in his grace",
   "heard": 7,
   "words": 7,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Draw near with a true heart today",
   "heard": 7,
   "words": 7,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the full assurance of faith",
   "heard": 6,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Our hearts are sprinkled clean",
