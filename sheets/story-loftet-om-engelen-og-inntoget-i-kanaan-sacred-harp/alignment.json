 "words": 95,
 "lines": [
  {
   "text": "On Nebo's height old Moses stood",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And looked on Canaan's land",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord showed him the promised good",
   "heard": 7,
   "words": 7,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Laid out on every hand",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The priests went down to Jordan's flood",
   "heard": 7,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The ark upon their shoulders high",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The waters stood up where they stood",
   "heard": 7,
   "words": 7,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Israel passed by dry",
   "heard": 5,
   "words": 5,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So when I come to Jordan's side",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And hear the waters roar",
   "heard": 5,
   "words": 5,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord will part the swelling tide",
   "heard": 7,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And lead me safely o'er",
   "heard": 4,
   "words": 5,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then I shall stand on Canaan's ground",
   "heard": 7,
   "words": 7,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And see the promised land",
   "heard": 5,
   "words": 5,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where milk and honey flow around",
   "heard": 6,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "At God's own right hand",
   "heard": 5,
   "words": 5,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  }
 ],
