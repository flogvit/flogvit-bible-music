 "words": 168,
 "lines": [
  {
   "text": "Who are you to judge another's servant",
   "heard": 7,
   "words": 7,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He stands or falls before his master",
   "heard": 7,
   "words": 7,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord is able to make him stand",
   "heard": 8,
   "words": 8,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So let each be fully convinced in his mind",
   "heard": 9,
   "words": 9,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For none of us lives to himself",
   "heard": 7,
   "words": 7,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And none of us dies to himself",
   "heard": 7,
   "words": 7,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If we live we live to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If we die we die to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We belong to the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One regards one day above another",
   "heard": 6,
   "words": 6,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Another regards every day alike",
   "heard": 3,
   "words": 5,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever eats does so to the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And whoever abstains gives thanks to God",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For none of us lives to himself",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And none of us dies to himself",
   "heard": 7,
   "words": 7,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If we live we live to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If we die we die to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We belong to the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Christ died and returned to life",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To be Lord of the dead and living",
   "heard": 8,
   "words": 8,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why do you judge your brother",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Why do you look down on him",
   "heard": 7,
   "words": 7,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
