 "lines": [
  {
   "text": "I could sing like the angels",
   "heard": 6,
   "words": 6,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I could speak in every tongue",
   "heard": 6,
   "words": 6,
   "error_s": 1.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But without love I'm a clanging gong",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A song that's never sung",
   "heard": 5,
   "words": 5,
   "error_s": 1.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I could move every mountain",
   "heard": 5,
   "words": 5,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give away all that I own",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But without love I gain nothing",
   "heard": 6,
   "words": 6,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I'm standing here alone",
   "heard": 4,
   "words": 4,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Love is patient, love is kind",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Keeps no record of wrongs",
   "heard": 5,
   "words": 5,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It bears all things, believes all things",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hopes all things, endures all things",
   "heard": 6,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Love never ends",
