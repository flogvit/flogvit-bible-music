 "lines": [
  {
   "text": "By the river two figures stood",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One on each bank where the waters flowed",
   "heard": 8,
   "words": 8,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One asked the man in linen",
   "heard": 6,
   "words": 6,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How long until the wonders cease",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He raised his hands to heaven",
   "heard": 6,
   "words": 6,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Swearing by the one who lives forever",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A time times and half a time",
   "heard": 4,
   "words": 7,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Until the power of holy ones is broken",
   "heard": 8,
   "words": 8,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sealed until the end",
   "heard": 4,
   "words": 4,
   "error_s": 0.51,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Many shall be purified and made clean",
   "heard": 6,
   "words": 7,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I heard but did not understand",
   "heard": 6,
   "words": 6,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Asked my lord for the outcome",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The words are closed and sealed",
   "heard": 6,
   "words": 6,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Until the time of the end",
   "heard": 6,
   "words": 6,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The wicked shall act wickedly",
   "heard": 5,
   "words": 5,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "None of them will understand",
   "heard": 5,
   "words": 5,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A time times and half a time",
   "heard": 6,
   "words": 7,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Until the power of holy ones is broken",
   "heard": 8,
   "words": 8,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sealed until the end",
   "heard": 4,
   "words": 4,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Many shall be purified and made clean",
   "heard": 7,
   "words": 7,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Daily sacrifice taken away",
   "heard": 4,
   "words": 4,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abomination of desolation set up",
   "heard": 5,
   "words": 5,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One thousand two hundred ninety days",
   "heard": 1,
   "words": 6,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Blessed is he who waits for thirteen thirty five",
   "heard": 6,
   "words": 9,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Go your way until the end",
