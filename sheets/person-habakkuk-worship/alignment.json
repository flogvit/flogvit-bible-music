 "words": 179,
 "lines": [
  {
   "text": "How long, LORD, must I call for help",
   "heard": 8,
   "words": 8,
   "error_s": 1.56,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I cry out to you, Violence!",
   "heard": 6,
   "words": 6,
   "error_s": 1.56,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Why do you make me see wrongdoing?",
   "heard": 7,
   "words": 7,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Destruction and violence are before me",
   "heard": 6,
   "words": 6,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The law goes numb, justice never comes forth",
   "heard": 8,
   "words": 8,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The wicked hem in the righteous",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the righteous shall live by his faith",
   "heard": 8,
   "words": 8,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The vision awaits its appointed time",
   "heard": 6,
   "words": 6,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look at the proud one, his soul is not upright",
   "heard": 9,
   "words": 10,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The righteous shall live by his faith",
   "heard": 7,
   "words": 7,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look among the nations and watch",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Be astonished, be astounded",
   "heard": 4,
   "words": 4,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am doing a work in your days",
   "heard": 8,
   "words": 8,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You would not believe if it were told",
   "heard": 8,
   "words": 8,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the righteous shall live by his faith",
   "heard": 8,
   "words": 8,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The vision awaits its appointed time",
   "heard": 6,
   "words": 6,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Look at the proud one, his soul is not upright",
   "heard": 9,
   "words": 10,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The righteous shall live by his faith",
   "heard": 7,
   "words": 7,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Though the fig tree does not blossom",
   "heard": 7,
   "words": 7,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the vines bear no fruit",
   "heard": 6,
   "words": 6,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet I will exult in the LORD",
   "heard": 7,
   "words": 7,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will rejoice in the God of my salvation",
   "heard": 9,
   "words": 9,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD God is my strength",
   "heard": 6,
   "words": 6,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He makes my feet like the feet of a deer",
   "heard": 10,
   "words": 10,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sets me upon the heights",
   "heard": 5,
   "words": 5,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  }
