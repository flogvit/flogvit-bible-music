 "lines": [
  {
   "text": "John was arrested, Jesus withdrew",
   "heard": 5,
   "words": 5,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Left Nazareth for the sea",
   "heard": 5,
   "words": 5,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Settled in Capernaum",
   "heard": 3,
   "words": 3,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In Zebulun and Naphtali",
   "heard": 4,
   "words": 4,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fulfilling the word of Isaiah",
   "heard": 4,
   "words": 5,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The people sat in darkness",
   "heard": 5,
   "words": 5,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now a great light has been seen",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the land of death's shadow",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Repent, for the kingdom is near",
   "heard": 6,
   "words": 6,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Great light for the nations",
   "heard": 5,
   "words": 5,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Follow me, be fishers of men",
   "heard": 4,
   "words": 6,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your new calling is here",
   "heard": 4,
   "words": 5,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Walking beside the Sea of Galilee",
   "heard": 6,
   "words": 6,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He saw Simon and Andrew",
   "heard": 5,
   "words": 5,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Casting their nets into the water",
