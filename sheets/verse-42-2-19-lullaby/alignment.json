 "lines": [
  {
   "text": "Wrapped in cloth and laid in hay",
   "heard": 7,
   "words": 7,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "There was no room for us to stay",
   "heard": 8,
   "words": 8,
   "error_s": 1.19,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The shepherds came and knelt to see",
   "heard": 7,
   "words": 7,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The baby sleeping close to me",
   "heard": 6,
   "words": 6,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hush now, hush now, little King",
   "heard": 6,
   "words": 6,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The angels told me everything",
   "heard": 5,
   "words": 5,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And I will keep these things and ponder",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In my heart, in my heart",
   "heard": 6,
   "words": 6,
   "error_s": 1.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They told of angels in the sky",
   "heard": 7,
   "words": 7,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Of glory sung to God on high",
   "heard": 7,
   "words": 7,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And all who heard it were amazed",
   "heard": 7,
   "words": 7,
   "error_s": 1.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Now sleep while heaven gives you praise",
   "heard": 7,
   "words": 7,
   "error_s": 1.2,
   "tie_split": false,
   "uncertain": true
  },
  {
