 "words": 149,
 "lines": [
  {
   "text": "In my distress I called upon the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To my God I cried for help",
   "heard": 7,
   "words": 7,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From his temple he heard my voice",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My cry came before him, into his ears",
   "heard": 8,
   "words": 8,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then the earth reeled and rocked",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The foundations of the mountains trembled",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Smoke went up from his nostrils",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Devouring fire from his mouth",
   "heard": 5,
   "words": 5,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He rode upon a cherub and flew",
   "heard": 6,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He came swiftly on the wings of the wind",
   "heard": 9,
   "words": 9,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He reached from on high, he took me",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He drew me out of many waters",
   "heard": 6,
   "words": 7,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord thundered in the heavens",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Most High uttered his voice",
   "heard": 6,
   "words": 6,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He sent out his arrows and scattered them",
   "heard": 8,
   "words": 8,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lightnings and routed them",
   "heard": 2,
   "words": 4,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He rode upon a cherub and flew",
   "heard": 7,
   "words": 7,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He came swiftly on the wings of the wind",
   "heard": 9,
   "words": 9,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He reached from on high, he took me",
   "heard": 8,
   "words": 8,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He drew me out of many waters",
   "heard": 6,
   "words": 7,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
