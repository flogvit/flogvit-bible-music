   "error_s": 0.23,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Remember what was done along the way",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Their name shall fade in God\u2019s judgment",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not forget this ancient warning",
