{
 "id": "story-lovloshetens-menneske-og-gjenkomsten-hymn",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-lovloshetens-menneske-og-gjenkomsten-hymn",
 "offset_seconds": -2.520000000000202,
 "words_heard": 169,
 "words": 170,
 "lines": [
  {
   "text": "Do not be quickly shaken in mind",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nor alarmed by a spirit or word",
   "heard": 7,
   "words": 7,
   "error_s": 1.39,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Let no one deceive you in any way",
   "heard": 8,
   "words": 8,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The day of the Lord is not yet here",
   "heard": 9,
   "words": 9,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "First comes the rebellion and the fall",
   "heard": 7,
   "words": 7,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The man of lawlessness is revealed",
   "heard": 6,
   "words": 6,
   "error_s": 1.25,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The son of destruction opposes all",
   "heard": 6,
   "words": 6,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He exalts himself above the gods",
   "heard": 6,
   "words": 6,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He sits in the temple of God",
   "heard": 7,
   "words": 7,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Proclaiming himself to be divine",
   "heard": 5,
   "words": 5,
   "error_s": 1.02,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The mystery of lawlessness at work",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Held back until the proper time",
   "heard": 6,
   "words": 6,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He comes by the working of Satan",
   "heard": 7,
   "words": 7,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "With false signs and wicked deception",
   "heard": 6,
   "words": 6,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Aiming at those who refuse the truth",
   "heard": 7,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And delight in the ways of evil",
   "heard": 7,
   "words": 7,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the Lord Jesus will destroy him",
   "heard": 7,
   "words": 7,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With the breath of his mouth to nothing",
   "heard": 8,
   "words": 8,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The splendor of his coming returns",
   "heard": 6,
   "words": 6,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To destroy the power of the lie",
   "heard": 6,
   "words": 7,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We thank God for you who are loved",
   "heard": 8,
   "words": 8,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Chosen as the firstfruits for salvation",
   "heard": 6,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Stand firm and hold fast to the truth",
   "heard": 8,
   "words": 8,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Loved by the Lord in every word",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Comfort your hearts and strengthen you",
   "heard": 6,
   "words": 6,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  }
