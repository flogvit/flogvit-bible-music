   "words": 2,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "May he rejoice in his works",
   "heard": 6,
   "words": 6,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who trembles the earth and more",
