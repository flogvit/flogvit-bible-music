 "offset_seconds": -1.7800000000002179,
 "words_heard": 203,
 "words": 204,
 "lines": [
  {
   "text": "I had it all planned out from the morning to the night",
   "heard": 12,
   "words": 12,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I had a map for every road and a reason for each fight",
   "heard": 13,
   "words": 13,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the rain came down on the dusty field and the seed began to grow",
   "heard": 15,
   "words": 15,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And it taught me there's a wisdom that I'm never going to know",
   "heard": 13,
   "words": 13,
   "error_s": 0.88,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "For my thoughts are not your thoughts",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nor are your ways my ways, declares the LORD",
   "heard": 9,
   "words": 9,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As the heavens are higher than the earth",
   "heard": 8,
   "words": 8,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So are my ways higher than your ways",
   "heard": 8,
   "words": 8,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seek the LORD while he may be found",
   "heard": 8,
   "words": 8,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Call on him while he is near",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let him return to the LORD, and he will have mercy on him",
   "heard": 13,
   "words": 13,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And to our God, for he will freely pardon",
   "heard": 9,
   "words": 9,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For my thoughts are not your thoughts",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nor are your ways my ways, declares the LORD",
   "heard": 8,
   "words": 9,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As the heavens are higher than the earth",
   "heard": 8,
   "words": 8,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So are my ways higher than your ways",
   "heard": 8,
   "words": 8,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So is my word that goes out from my mouth",
   "heard": 10,
   "words": 10,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It will not return to me empty",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will go out with joy and be led forth in peace",
   "heard": 12,
   "words": 12,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The mountains and hills will break into song before you",
   "heard": 10,
   "words": 10,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And all the trees of the field will clap their hands",
   "heard": 11,
   "words": 11,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  }
 ],
