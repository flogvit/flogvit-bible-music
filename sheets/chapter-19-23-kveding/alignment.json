 "words_heard": 91,
 "words": 98,
 "lines": [
  {
   "text": "Herren er min hyrde, jeg mangler ingenting",
   "heard": 7,
   "words": 7,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han lar meg ligge i gr\u00f8nne enger",
   "heard": 5,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "han leder meg til stille vann",
   "heard": 6,
   "words": 6,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han fornyer min sjel",
   "heard": 4,
   "words": 4,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han leder meg p\u00e5 rettferdighets stier",
   "heard": 4,
   "words": 6,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "for sitt navns skyld",
   "heard": 4,
   "words": 4,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Om jeg enn vandrer i d\u00f8dsskyggens dal",
   "heard": 5,
   "words": 7,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "frykter jeg ikke noe ondt, for du er med meg",
   "heard": 9,
   "words": 10,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Din kjepp og din stav, de tr\u00f8ster meg",
   "heard": 8,
   "words": 8,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Du dekker bord for meg like foran mine fiender",
   "heard": 9,
   "words": 9,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Du salver mitt hode med olje, mitt beger flyter over",
   "heard": 10,
   "words": 10,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bare godhet og n\u00e5de skal f\u00f8lge meg alle mine dager",
   "heard": 10,
   "words": 10,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og jeg skal bo i Herrens hus i lange tider",
   "heard": 10,
   "words": 10,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  }
 ],
