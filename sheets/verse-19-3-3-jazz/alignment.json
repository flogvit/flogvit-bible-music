   "heard": 8,
   "words": 8,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I lie down and sleep in peace",
   "heard": 7,
   "words": 7,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I wake again because He sustains me",
   "heard": 7,
   "words": 7,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
