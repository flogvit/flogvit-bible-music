 "lines": [
  {
   "text": "Outside the camp we go",
   "heard": 5,
   "words": 5,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Bearing the disgrace he bore",
   "heard": 5,
   "words": 5,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No lasting city here",
   "heard": 4,
   "words": 4,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We seek the one that is to come",
   "heard": 8,
   "words": 8,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through him let us continually",
   "heard": 5,
   "words": 5,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Offer to God a sacrifice of praise",
   "heard": 7,
   "words": 7,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The fruit of lips that confess",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His holy name before the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not neglect to do good",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Share with others in your days",
   "heard": 6,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Such sacrifices are pleasing",
   "heard": 4,
   "words": 4,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the God who knows our hearts",
   "heard": 7,
   "words": 7,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through him let us continually",
   "heard": 5,
   "words": 5,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Offer to God a sacrifice of praise",
   "heard": 7,
   "words": 7,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The fruit of lips that confess",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His holy name before the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jesus suffered outside the gate",
   "heard": 5,
   "words": 5,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To make the people holy",
   "heard": 5,
   "words": 5,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through his own blood he cleansed us",
   "heard": 7,
   "words": 7,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the weight of all our sin",
   "heard": 7,
   "words": 7,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through him let us continually",
   "heard": 5,
   "words": 5,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Offer to God a sacrifice of praise",
