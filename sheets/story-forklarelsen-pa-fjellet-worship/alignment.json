 "lines": [
  {
   "text": "Up the mountain, six days later",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Peter, James and John",
   "heard": 4,
   "words": 4,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Far above the noisy valley",
   "heard": 5,
   "words": 5,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Where the light was coming on",
   "heard": 6,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His face shone like the sun",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And his clothes became white as the light",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This is my beloved Son, in whom I am well pleased",
   "heard": 11,
   "words": 11,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Listen to him",
   "heard": 3,
   "words": 3,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Moses and Elijah appeared",
   "heard": 4,
   "words": 4,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Talking with him there",
   "heard": 4,
   "words": 4,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Lord, it is good for us to be here",
   "heard": 9,
   "words": 9,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Peter spoke into the air",
   "heard": 5,
   "words": 5,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His face shone like the sun",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And his clothes became white as the light",
   "heard": 8,
   "words": 8,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This is my beloved Son, in whom I am well pleased",
   "heard": 11,
   "words": 11,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Listen to him",
   "heard": 3,
   "words": 3,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A bright cloud overshadowed them",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They fell face down, terrified",
   "heard": 5,
   "words": 5,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But Jesus came and touched them",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Get up, do not be afraid",
   "heard": 6,
   "words": 6,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And they saw no one but Jesus alone",
   "heard": 8,
   "words": 8,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
