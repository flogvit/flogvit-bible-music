   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I am only a clanging gong",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With a sound that is wide",
