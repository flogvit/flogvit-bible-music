 "lines": [
  {
   "text": "Sing to the LORD a new song",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Call out to all the earth",
   "heard": 6,
   "words": 6,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sing to the LORD and bless his name",
   "heard": 8,
   "words": 8,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His salvation is so dear",
   "heard": 5,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Proclaim his salvation day after day",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Declare his glory among the nations",
   "heard": 6,
   "words": 6,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His wonders shown to all peoples",
   "heard": 6,
   "words": 6,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Great is the LORD in praise",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is to be feared above all gods",
   "heard": 8,
   "words": 8,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For all the gods of the peoples",
   "heard": 7,
   "words": 7,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Are idols and nothing more",
   "heard": 4,
   "words": 5,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
