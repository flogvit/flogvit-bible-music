 "lines": [
  {
   "text": "One person holds one day above another",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Another sees them all as equal",
   "heard": 6,
   "words": 6,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let each be fully convinced in his mind",
   "heard": 8,
   "words": 8,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No one lives for himself alone",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If we live we live to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If we die we die to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whether we live or die we belong to the Lord",
   "heard": 10,
   "words": 10,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We belong to the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever observes the day does so to the Lord",
   "heard": 7,
   "words": 9,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever eats does so to the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He gives thanks to God for his food",
   "heard": 8,
   "words": 8,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whoever abstains does so to the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If we live we live to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If we die we die to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whether we live or die we belong to the Lord",
   "heard": 10,
   "words": 10,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We belong to the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Christ died and returned to life",
   "heard": 6,
   "words": 6,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "That he might be Lord of the dead",
   "heard": 8,
   "words": 8,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Lord of the living as well",
   "heard": 7,
   "words": 7,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We will all stand before the judgment seat",
   "heard": 8,
   "words": 8,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If we live we live to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.44,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "If we die we die to the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whether we live or die we belong to the Lord",
   "heard": 10,
   "words": 10,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We belong to the Lord",
   "heard": 5,
   "words": 5,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not judge your brother in his faith",
   "heard": 8,
   "words": 8,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not look down on his path",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As I live says the Lord of hosts",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Every knee will bow to me",
   "heard": 6,
   "words": 6,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
