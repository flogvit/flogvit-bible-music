 "lines": [
  {
   "text": "An hour is coming, it is now here",
   "heard": 8,
   "words": 8,
   "error_s": 0.94,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will worship the Father, not on this mountain",
   "heard": 9,
   "words": 9,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nor in Jerusalem, but in a new way",
   "heard": 8,
   "words": 8,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Believe me, woman, the time has arrived",
   "heard": 7,
   "words": 7,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Worship in spirit and truth",
   "heard": 5,
   "words": 5,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Father seeks such people",
