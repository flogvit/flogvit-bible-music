 "lines": [
  {
   "text": "Show us your steadfast love, O Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Grant us your salvation now",
   "heard": 5,
   "words": 5,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will hear what God the Lord will speak",
   "heard": 9,
   "words": 9,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Peace to his people, his faithful ones",
   "heard": 7,
   "words": 7,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let them not turn back to folly",
   "heard": 7,
   "words": 7,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His salvation is near to those who fear him",
   "heard": 9,
   "words": 9,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That glory may dwell in our land",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Steadfast love and faithfulness have met",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Righteousness and peace have kissed",
   "heard": 5,
   "words": 5,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Faithfulness springs up from the earth",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Righteousness looks down from heaven",
   "heard": 5,
   "words": 5,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord himself will give what is good",
   "heard": 8,
   "words": 8,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
