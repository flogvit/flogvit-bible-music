 "words": 128,
 "lines": [
  {
   "text": "Seth lived one hundred and five",
   "heard": 6,
   "words": 6,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Then he saw a son arrive",
   "heard": 6,
   "words": 6,
   "error_s": 1.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He named him Enosh, pure and true",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Into the line where faith grew",
   "heard": 6,
   "words": 6,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "At that time the people found",
   "heard": 6,
   "words": 6,
   "error_s": 1.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A way to make their hearts sound",
   "heard": 7,
   "words": 7,
   "error_s": 1.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They began to call aloud",
   "heard": 5,
   "words": 5,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "On the name of the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When Enosh was ninety years old",
   "heard": 6,
   "words": 6,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He fathered Kenan, as told",
   "heard": 3,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Eight hundred and fifteen more",
   "heard": 5,
   "words": 5,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He lived, keeping faith to the core",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Other sons and daughters came",
   "heard": 5,
   "words": 5,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the name they bore the same",
   "heard": 7,
   "words": 7,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From Adam down to Seth\u2019s line",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Enosh stands in grace divine",
   "heard": 5,
   "words": 5,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Luke lists him in the chain",
   "heard": 5,
   "words": 6,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The son of Enosh, plain and plain",
   "heard": 6,
   "words": 7,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Son of Seth, son of Adam\u2019s seed",
   "heard": 7,
   "words": 7,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From God, the story is read",
   "heard": 6,
   "words": 6,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Calling on the name of the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": true
  }
