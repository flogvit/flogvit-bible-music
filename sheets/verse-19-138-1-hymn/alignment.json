   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Exalted word above all else",
   "heard": 5,
   "words": 5,
   "error_s": 2.09,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "On the day I called you answered me",
   "heard": 8,
