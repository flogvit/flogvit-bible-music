 "lines": [
  {
   "text": "Ever since I heard your faith in Christ",
   "heard": 8,
   "words": 8,
   "error_s": 3.9,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And love for all the saints",
   "heard": 6,
   "words": 6,
   "error_s": 3.01,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "I have not stopped giving thanks",
   "heard": 6,
   "words": 6,
   "error_s": 1.79,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Remembering you in my prayers",
   "heard": 5,
   "words": 5,
   "error_s": 2.55,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Eyes of your heart may be enlightened",
