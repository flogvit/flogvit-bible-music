  {
   "text": "The voice cries out to speak",
   "heard": 6,
   "words": 6,
   "error_s": 1.41,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "All flesh is just like grass",
   "heard": 6,
   "words": 6,
   "error_s": 1.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Its beauty fades so fast",
   "heard": 5,
   "words": 5,
   "error_s": 1.36,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The flower dies in the field",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The breath of the Lord blows on it",
   "heard": 8,
   "words": 8,
   "error_s": 0.94,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Surely the people are grass",
   "heard": 5,
   "words": 5,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The word of our God stands forever",
   "heard": 7,
   "words": 7,
   "error_s": 0.34,
   "tie_split": true,
   "uncertain": false
  },
  {
