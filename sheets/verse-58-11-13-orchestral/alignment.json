 "lines": [
  {
   "text": "They died in faith but not received",
   "heard": 7,
   "words": 7,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The promise stayed unseen in view",
   "heard": 6,
   "words": 6,
   "error_s": 1.65,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "They saw it from a far away place",
   "heard": 6,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Welcoming the hope so new",
   "heard": 5,
   "words": 5,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Confessing they were strangers here",
   "heard": 5,
   "words": 5,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sojourners upon the earth",
   "heard": 4,
   "words": 4,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No opportunity to return",
   "heard": 4,
   "words": 4,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the land they left first",
   "heard": 6,
   "words": 6,
   "error_s": 1.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Looking for a homeland true",
   "heard": 5,
   "words": 5,
   "error_s": 1.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Longing for a better country",
   "heard": 5,
   "words": 5,
   "error_s": 1.34,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A heavenly place prepared",
   "heard": 4,
   "words": 4,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For God has not disowned them",
   "heard": 6,
   "words": 6,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If they thought of the land they left",
   "heard": 8,
   "words": 8,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They would have had chance to go back",
   "heard": 8,
   "words": 8,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But as it is they long ahead",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the city God has made",
   "heard": 6,
   "words": 6,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
