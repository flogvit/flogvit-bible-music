 "words": 108,
 "lines": [
  {
   "text": "The Spirit of the Lord is upon me",
   "heard": 8,
   "words": 8,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Because the Lord has anointed me",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To bring good news to the poor",
   "heard": 7,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To bind up the brokenhearted",
   "heard": 5,
   "words": 5,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Liberty to the captives",
   "heard": 4,
   "words": 4,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Opening of the prison to those who are bound",
   "heard": 8,
   "words": 9,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Proclaim the year of the Lord's favor",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Comfort all who mourn",
   "heard": 4,
   "words": 4,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To give them a crown of beauty instead of ashes",
   "heard": 10,
   "words": 10,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The oil of gladness instead of mourning",
   "heard": 7,
   "words": 7,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A garment of praise instead of a faint spirit",
   "heard": 9,
   "words": 9,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Oaks of righteousness, the planting of the Lord",
