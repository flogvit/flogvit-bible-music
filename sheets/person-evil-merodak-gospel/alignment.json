 "words": 164,
 "lines": [
  {
   "text": "The thirty-seventh year of exile passed",
   "heard": 5,
   "words": 6,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the twelfth month when hope arrived",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Evil-Merodach became king of Babylon",
   "heard": 4,
   "words": 5,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the heavy chains were lifted high",
   "heard": 7,
   "words": 7,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He showed favor to the captive king",
   "heard": 7,
   "words": 7,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who sat in darkness for so long",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He spoke kindly to him with grace",
   "heard": 5,
   "words": 7,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gave a seat of honor in that place",
   "heard": 8,
   "words": 8,
   "error_s": 0.61,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Above the thrones of other kings",
   "heard": 6,
   "words": 6,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jehoiachin heard the sweet things",
   "heard": 5,
   "words": 5,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The prison clothes were taken away",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Restored to his dignity that day",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He ate regularly at the royal table",
   "heard": 7,
   "words": 7,
   "error_s": 0.61,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "For the rest of his life",
   "heard": 6,
   "words": 6,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The daily allowance was provided",
   "heard": 5,
   "words": 5,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the land where he was exiled",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He spoke kindly to him with grace",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gave a seat of honor in that place",
   "heard": 8,
   "words": 8,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Above the thrones of other kings",
   "heard": 6,
   "words": 6,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jehoiachin heard the sweet things",
   "heard": 5,
   "words": 5,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "From the shadows of the cell",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the light where the honor dwell",
   "heard": 6,
   "words": 7,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A glimmer of hope remains",
   "heard": 5,
   "words": 5,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the memories of old days",
   "heard": 6,
   "words": 6,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Released from prison in the end",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With kindness that we cannot mend",
   "heard": 6,
   "words": 6,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  }
 ],
