 "lines": [
  {
   "text": "Lord, you have been our dwelling place",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Through all the years gone by",
   "heard": 6,
   "words": 6,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Before the mountains rose in space",
   "heard": 6,
   "words": 6,
   "error_s": 0.53,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You were, and you are nigh",
   "heard": 5,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You turn us back to dust again",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Return, you sons of men",
   "heard": 5,
   "words": 5,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A thousand years are in your sight",
   "heard": 7,
   "words": 7,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Like yesterday, like a watch in the night",
   "heard": 8,
   "words": 8,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We flourish like the morning grass",
   "heard": 6,
   "words": 6,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "By evening it is dry",
   "heard": 5,
   "words": 5,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "So teach us how our days will pass",
   "heard": 8,
   "words": 8,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That wise our hearts may lie",
   "heard": 6,
   "words": 6,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
