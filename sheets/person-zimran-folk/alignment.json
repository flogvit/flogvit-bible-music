 "lines": [
  {
   "text": "Abraham took another wife",
   "heard": 4,
   "words": 4,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Her name was Keturah",
   "heard": 4,
   "words": 4,
   "error_s": 0.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "She bore him Zimran first",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With five other sons named",
   "heard": 5,
   "words": 5,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Jokshan Medan and Midian",
