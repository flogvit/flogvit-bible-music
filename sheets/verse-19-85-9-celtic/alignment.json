 "lines": [
  {
   "text": "Will you be angry with us forever",
   "heard": 7,
   "words": 7,
   "error_s": 1.48,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Prolong your anger through all generations",
   "heard": 6,
   "words": 6,
   "error_s": 1.55,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Will you not revive us again",
   "heard": 6,
   "words": 6,
   "error_s": 1.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "So your people may rejoice in you",
   "heard": 7,
   "words": 7,
   "error_s": 1.47,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Steadfast love and faithfulness have met",
   "heard": 6,
   "words": 6,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Righteousness and peace have kissed",
   "heard": 4,
   "words": 5,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Faithfulness springs up from the earth",
   "heard": 5,
   "words": 6,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Righteousness looks down from heaven",
   "heard": 5,
   "words": 5,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Show us your steadfast love Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Grant us your salvation now",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
