 "words": 154,
 "lines": [
  {
   "text": "Abimelech came with Pikol",
   "heard": 4,
   "words": 4,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Said God is with you in all",
   "heard": 7,
   "words": 7,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Swear to me by the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not deal falsely at all",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seven ewe lambs set apart",
   "heard": 5,
   "words": 5,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Witness to the well you dug",
   "heard": 6,
   "words": 6,
   "error_s": 0.75,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Beersheba the oath was sworn",
   "heard": 4,
   "words": 5,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The covenant made by trust",
   "heard": 5,
   "words": 5,
   "error_s": 0.98,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "You took my well by force",
   "heard": 6,
   "words": 6,
   "error_s": 1.07,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "I did not know who did it",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now I see your anger rise",
   "heard": 6,
   "words": 6,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have heard nothing of it",
   "heard": 6,
   "words": 6,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Seven little lambs set apart",
   "heard": 5,
   "words": 5,
   "error_s": 1.13,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Witness to the well you dug",
   "heard": 6,
   "words": 6,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Beersheba the oath was sworn",
   "heard": 4,
   "words": 5,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The covenant made by trust",
   "heard": 5,
   "words": 5,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sheep and cattle were given",
   "heard": 5,
   "words": 5,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The two made a covenant",
   "heard": 5,
   "words": 5,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Pikol left to his land",
   "heard": 4,
   "words": 5,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Abraham stayed in the dust",
   "heard": 5,
   "words": 5,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He planted a tamarisk tree",
   "heard": 5,
   "words": 5,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Called on the name of the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Everlasting God heard",
   "heard": 4,
   "words": 4,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His prayer in the desert",
   "heard": 5,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Seven ewe lambs as witness",
   "heard": 5,
   "words": 5,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The well dug in the sand",
   "heard": 6,
   "words": 6,
   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The name of the Lord remembered",
   "heard": 6,
   "words": 6,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the land of the Philistines",
   "heard": 6,
   "words": 6,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  }
