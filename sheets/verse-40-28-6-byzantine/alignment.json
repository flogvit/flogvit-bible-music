 "lines": [
  {
   "text": "Do not be afraid, the angel said",
   "heard": 7,
   "words": 7,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You seek Jesus who was crucified",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is not here, for he is risen",
   "heard": 8,
   "words": 8,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come and see the place where he lay",
   "heard": 8,
   "words": 8,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Christ is risen from the dead",
   "heard": 6,
   "words": 6,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Trampling down death by death",
   "heard": 5,
   "words": 5,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The firstfruits of those who sleep",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Christ is risen, he is risen indeed",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Go quickly now and tell his friends",
   "heard": 7,
   "words": 7,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is risen from the dead",
   "heard": 6,
   "words": 6,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He goes before you into Galilee",
   "heard": 6,
   "words": 6,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
