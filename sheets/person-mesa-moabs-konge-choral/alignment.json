 "lines": [
  {
   "text": "Mesha king of Moab was a sheep breeder",
   "heard": 8,
   "words": 8,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He paid the king of Israel every year",
   "heard": 8,
   "words": 8,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A hundred thousand lambs was the tribute",
   "heard": 7,
   "words": 7,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And wool from a hundred thousand rams",
   "heard": 7,
   "words": 7,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But when Ahab died the bond was broken",
   "heard": 8,
   "words": 8,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The king of Moab rebelled against Israel",
   "heard": 7,
   "words": 7,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The sheep breeder stopped his payment",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the sheep breeder refused the heavy load",
   "heard": 8,
   "words": 8,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The tribute of lambs was no longer paid",
   "heard": 8,
   "words": 8,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The wool of the rams stayed in his fold",
   "heard": 6,
   "words": 9,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He rebelled against the king of Israel",
   "heard": 7,
   "words": 7,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the sheep breeder held his ground",
   "heard": 7,
   "words": 7,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He rebelled against the king",
   "heard": 5,
   "words": 5,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  }
 ],
