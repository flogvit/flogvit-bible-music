 "lines": [
  {
   "text": "Shepherds in the fields at night",
   "heard": 6,
   "words": 6,
   "error_s": 1.26,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Keeping watch over their flock",
   "heard": 5,
   "words": 5,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The angel of the Lord appeared",
   "heard": 6,
   "words": 6,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the glory shone around them",
   "heard": 6,
   "words": 6,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be afraid",
   "heard": 4,
   "words": 4,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I bring you good news of great joy",
   "heard": 8,
   "words": 8,
   "error_s": 1.0,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For all the people",
   "heard": 4,
   "words": 4,
   "error_s": 1.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not be afraid",
   "heard": 4,
   "words": 4,
   "error_s": 0.96,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Unto you is born this day",
   "heard": 6,
   "words": 6,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the city of David",
