 "words": 228,
 "lines": [
  {
   "text": "Ner fathered Kish, and Kish fathered Saul",
   "heard": 6,
   "words": 7,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Saul fathered Jonathan, Malchishua, Abinadab",
   "heard": 2,
   "words": 5,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The genealogy stands in the book of Chronicles",
   "heard": 8,
   "words": 8,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Listing the sons who served in the land",
   "heard": 8,
   "words": 8,
   "error_s": 1.22,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "How the mighty have fallen",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your glory lies slain on your heights",
   "heard": 7,
   "words": 7,
   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The shield of the mighty is defiled",
   "heard": 7,
   "words": 7,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No longer anointed with oil",
   "heard": 5,
   "words": 5,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Philistines closed in on the king",
   "heard": 7,
   "words": 7,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They struck down Jonathan and Abinadab",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Malchi-shua fell with his father",
   "heard": 4,
   "words": 5,
   "error_s": 0.26,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "On the slopes of Mount Gilboa",
   "heard": 6,
   "words": 6,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Many fell slain as the Israelites fled",
   "heard": 7,
   "words": 7,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Before the closing in of the enemy",
   "heard": 7,
   "words": 7,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How the mighty have fallen",
   "heard": 5,
   "words": 5,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your glory lies slain on your heights",
   "heard": 7,
   "words": 7,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The shield of the mighty is defiled",
   "heard": 7,
   "words": 7,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No longer anointed with oil",
   "heard": 5,
   "words": 5,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They cut off his head and stripped his armor",
   "heard": 9,
   "words": 9,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sent word to the temples of idols",
   "heard": 7,
   "words": 7,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They put his armor in the house of Ashtoreth",
   "heard": 9,
   "words": 9,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Fastened his body to the wall of Beth-shan",
   "heard": 7,
   "words": 8,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the people of Jabesh-gilead heard",
   "heard": 5,
   "words": 6,
   "error_s": 0.31,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "All their fighting men set out by night",
   "heard": 8,
   "words": 8,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They took the bodies down from the wall",
   "heard": 8,
   "words": 8,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Brought them to Jabesh and burned them there",
   "heard": 8,
   "words": 8,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They took the bones and buried them",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Under the tamarisk tree at Jabesh",
   "heard": 6,
   "words": 6,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "How the mighty have fallen",
   "heard": 5,
   "words": 5,
   "error_s": 0.31,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Your glory lies slain on your heights",
   "heard": 6,
