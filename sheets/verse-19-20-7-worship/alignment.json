 "offset_seconds": -4.600000000000158,
 "words_heard": 162,
 "words": 162,
 "lines": [
  {
   "text": "May He remember all your offerings",
   "heard": 6,
   "words": 6,
   "error_s": 1.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Receive your burnt offering with favor",
   "heard": 6,
   "words": 6,
   "error_s": 0.91,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give you what your heart desires",
   "heard": 6,
   "words": 6,
   "error_s": 1.15,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Bring all your plans to pass",
   "heard": 6,
   "words": 6,
   "error_s": 1.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We shout for joy at your victory",
   "heard": 7,
   "words": 7,
   "error_s": 1.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Raise our banners in the name of our God",
   "heard": 9,
   "words": 9,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The LORD fulfills every request",
   "heard": 5,
   "words": 5,
   "error_s": 1.44,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Your plans in His hands are held",
   "heard": 7,
   "words": 7,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Now I know the LORD saves his anointed",
   "heard": 8,
   "words": 8,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He answers from his holy heaven",
   "heard": 6,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With the saving power of his right hand",
   "heard": 8,
   "words": 8,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We call on the name of the LORD our God",
   "heard": 10,
   "words": 10,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Some trust in chariots and some in horses",
   "heard": 8,
   "words": 8,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But we call on the name of the LORD",
   "heard": 9,
   "words": 9,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They are brought to their knees and fall",
   "heard": 8,
   "words": 8,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But we rise up and stand firm",
   "heard": 7,
   "words": 7,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Now I know the LORD saves his anointed",
   "heard": 8,
   "words": 8,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He answers from his holy heaven",
   "heard": 6,
   "words": 6,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With the saving power of his right hand",
   "heard": 8,
   "words": 8,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We call on the name of the LORD our God",
   "heard": 10,
   "words": 10,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They fall, but we rise up",
   "heard": 6,
   "words": 6,
   "error_s": 1.16,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Standing firm in the name of the LORD",
   "heard": 8,
   "words": 8,
   "error_s": 1.43,
   "tie_split": false,
   "uncertain": true
  }
