 "words": 129,
 "lines": [
  {
   "text": "Down in the dungeon, feet in the stocks",
   "heard": 8,
   "words": 8,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Paul and Silas behind the locks",
   "heard": 6,
   "words": 6,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Around midnight they began to pray",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Singing hymns to God, and the prisoners heard them that day",
   "heard": 11,
   "words": 11,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the chains fell loose, the doors flew open",
   "heard": 9,
   "words": 9,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Every prison shook, every chain was broken",
   "heard": 7,
   "words": 7,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sing at midnight, sing in the night",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Till the morning comes with the light",
   "heard": 7,
   "words": 7,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The jailer woke and he drew his sword",
   "heard": 8,
   "words": 8,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Do not harm yourself, we are all here, said Paul",
   "heard": 10,
   "words": 10,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "What must I do to be saved, he cried",
   "heard": 9,
   "words": 9,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Believe in the Lord Jesus and you'll be saved, they replied",
   "heard": 11,
   "words": 11,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And the chains fell loose, the doors flew open",
   "heard": 9,
