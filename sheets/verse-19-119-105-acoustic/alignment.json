   "words": 6,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "LORD give me life according to your word",
   "heard": 8,
   "words": 8,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
