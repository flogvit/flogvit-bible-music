   "words": 8,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Cried out for the child when death surrounded them all",
   "heard": 10,
   "words": 10,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
