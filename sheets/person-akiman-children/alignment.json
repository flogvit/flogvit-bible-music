  },
  {
   "text": "Fear filled the hearts of Israel's band",
   "heard": 6,
   "words": 7,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The land was given, the promise kept",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
