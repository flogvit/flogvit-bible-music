   "words": 6,
   "error_s": 2.19,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "In the knowledge of him",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": true
  },
  {
