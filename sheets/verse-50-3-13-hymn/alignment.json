 "lines": [
  {
   "text": "I do not consider myself",
   "heard": 5,
   "words": 5,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To have taken hold of it yet",
   "heard": 7,
   "words": 7,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The race is not ended now",
   "heard": 6,
   "words": 6,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My feet are still on the ground",
   "heard": 7,
   "words": 7,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One thing I do with my whole heart",
   "heard": 8,
   "words": 8,
   "error_s": 0.25,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Leaving the shadows of yesterday",
   "heard": 5,
   "words": 5,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Not looking back at what I was",
   "heard": 7,
   "words": 7,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Only forward to what is true",
   "heard": 6,
   "words": 6,
   "error_s": 0.34,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Forgetting what lies behind",
   "heard": 4,
   "words": 4,
   "error_s": 0.12,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Straining toward what lies ahead",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I press on toward the goal",
   "heard": 6,
   "words": 6,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To win the prize of God's call",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Mature in my mind and soul",
   "heard": 4,
   "words": 6,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Thinking this way every day",
   "heard": 5,
   "words": 5,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If I see things differently",
   "heard": 5,
   "words": 5,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "God will make it clear to me",
   "heard": 7,
   "words": 7,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Forgetting what lies behind",
