{
 "id": "story-profetens-liknelse-om-den-fangne-orchestral",
 "song": "/Users/vhanssen/WebstormProjects/flogvit/music/YuE/outputs/catalog/story-profetens-liknelse-om-den-fangne-orchestral",
 "offset_seconds": -2.9200000000001936,
 "words_heard": 222,
 "words": 222,
 "lines": [
  {
   "text": "A prophet spoke to his companion",
   "heard": 6,
   "words": 6,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Strike me, he requested kindly",
   "heard": 5,
   "words": 5,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The man refused the voice of God",
   "heard": 7,
   "words": 7,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A lion found him and killed him",
   "heard": 7,
   "words": 7,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Another man obeyed the word",
   "heard": 5,
   "words": 5,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He struck the prophet with a wound",
   "heard": 7,
   "words": 7,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The prophet stood upon the road",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Disguised with ash upon his eyes",
   "heard": 6,
   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He waited for the king of Israel",
   "heard": 7,
   "words": 7,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To pass along the dusty way",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your servant went into the battle",
   "heard": 6,
   "words": 6,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A prisoner was brought to you",
   "heard": 6,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Guard this man, they said to you",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If he escapes, your life is paid",
   "heard": 7,
   "words": 7,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Or a talent of silver",
   "heard": 5,
   "words": 5,
   "error_s": 0.78,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "While I was busy here and there",
   "heard": 7,
   "words": 7,
   "error_s": 0.77,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The man has disappeared from sight",
   "heard": 6,
   "words": 6,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The king of Israel spoke aloud",
   "heard": 6,
   "words": 6,
   "error_s": 0.74,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "That is your sentence, he declared",
   "heard": 6,
   "words": 6,
   "error_s": 0.81,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You have pronounced it yourself now",
   "heard": 6,
   "words": 6,
   "error_s": 0.86,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The verdict rests upon your head",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The prophet pulled the bandage off",
   "heard": 6,
   "words": 6,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And Ahab saw the prophet face",
   "heard": 6,
   "words": 6,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your servant went into the battle",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A prisoner was brought to you",
   "heard": 6,
   "words": 6,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Guard this man, they said to you",
   "heard": 7,
   "words": 7,
   "error_s": 0.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If he escapes, your life is paid",
   "heard": 7,
   "words": 7,
   "error_s": 0.07,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Or a talent of silver",
   "heard": 5,
   "words": 5,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "While I was busy here and there",
   "heard": 7,
   "words": 7,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The man has disappeared from sight",
   "heard": 6,
   "words": 6,
   "error_s": 0.38,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "This is what the Lord declares",
   "heard": 6,
   "words": 6,
   "error_s": 0.92,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You set the devoted man free",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Your life shall stand for his life",
   "heard": 7,
   "words": 7,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Your people for his people",
   "heard": 5,
   "words": 5,
   "error_s": 0.7,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sullen and angry in his heart",
   "heard": 6,
   "words": 6,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The king went home to Samaria",
