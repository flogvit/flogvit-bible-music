   "words": 7,
   "error_s": 1.61,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "It is the power of God",
   "heard": 6,
   "words": 6,
   "error_s": 1.35,
   "tie_split": false,
   "uncertain": true
  },
  {
