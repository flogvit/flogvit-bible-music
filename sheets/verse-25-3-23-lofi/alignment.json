   "error_s": 0.59,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Great is your faithfulness",
   "heard": 4,
   "words": 4,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord is my portion",
