  {
   "text": "I am forgotten out of mind like the dead",
   "heard": 9,
   "words": 9,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Broken vessel cast away on the street",
   "heard": 7,
   "words": 7,
   "error_s": 0.52,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Whispering of many surrounds me in fear",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They conspire against me and plot to kill",
   "heard": 8,
   "words": 8,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But I trust in you LORD I say you are my God",
   "heard": 12,
   "words": 12,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My times are in your hand deliver me now",
   "heard": 9,
   "words": 9,
   "error_s": 0.29,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Save me from the grip of those who pursue",
