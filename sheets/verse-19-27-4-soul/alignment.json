 "words_heard": 204,
 "words": 207,
 "lines": [
  {
   "text": "The Lord is my light and my salvation",
   "heard": 8,
   "words": 8,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I have no reason to fear",
   "heard": 6,
   "words": 6,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He is the stronghold of my life",
   "heard": 7,
   "words": 7,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My heart will not be afraid",
   "heard": 6,
   "words": 6,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Evildoers close in to devour me",
   "heard": 6,
   "words": 6,
   "error_s": 0.32,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But they will stumble and fall",
   "heard": 6,
   "words": 6,
   "error_s": 0.05,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Though an army camps against me",
   "heard": 6,
   "words": 6,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "My confidence stands tall",
   "heard": 4,
   "words": 4,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One thing I ask of the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This is the only thing I seek",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To dwell in the house of the Lord",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For all the days that I have",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I want to gaze on his beauty",
   "heard": 5,
   "words": 7,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And seek him in his temple",
   "heard": 6,
   "words": 6,
   "error_s": 0.35,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In the day of trouble he keeps me",
   "heard": 8,
   "words": 8,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Safe in his shelter",
   "heard": 4,
   "words": 4,
   "error_s": 1.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "One thing I ask of the Lord",
   "heard": 7,
   "words": 7,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
