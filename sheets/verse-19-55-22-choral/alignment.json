 "words_heard": 131,
 "words": 131,
 "lines": [
  {
   "text": "He rescues me unharmed from battle",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Though many oppose my soul",
   "heard": 5,
   "words": 5,
   "error_s": 1.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "God hears and humbles the proud ones",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Who have no fear of Him",
   "heard": 6,
   "words": 6,
   "error_s": 1.17,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "My companion raised a hand",
   "heard": 5,
   "words": 5,
   "error_s": 2.07,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Against his friend's interests",
   "heard": 4,
   "words": 4,
   "error_s": 2.21,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He violated the covenant",
   "heard": 4,
   "words": 4,
   "error_s": 2.06,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And broke his sacred word",
   "heard": 5,
   "words": 5,
   "error_s": 1.69,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Cast your burden on the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 1.56,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And he will sustain you",
   "heard": 5,
   "words": 5,
   "error_s": 1.38,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He will never let the",
   "heard": 5,
   "words": 5,
   "error_s": 1.32,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Righteous be shaken",
   "heard": 3,
   "words": 3,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His speech was smoother than butter",
   "heard": 6,
   "words": 6,
   "error_s": 1.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet war lived in his heart",
   "heard": 6,
   "words": 6,
   "error_s": 1.43,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His words were softer than oil",
   "heard": 6,
   "words": 6,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yet they were drawn swords",
   "heard": 5,
   "words": 5,
   "error_s": 1.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Cast your burden on the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.79,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And he will sustain you",
   "heard": 5,
   "words": 5,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will never let the",
   "heard": 5,
   "words": 5,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Righteous be shaken",
   "heard": 3,
   "words": 3,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He will bring them down",
   "heard": 5,
   "words": 5,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To the pit of destruction",
   "heard": 5,
   "words": 5,
   "error_s": 0.64,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Men of blood and treachery",
   "heard": 5,
   "words": 5,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Will not live out half their days",
   "heard": 7,
   "words": 7,
   "error_s": 0.28,
   "tie_split": false,
   "uncertain": false
  },
