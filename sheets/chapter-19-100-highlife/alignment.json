 "lines": [
  {
   "text": "Make a joyful noise to the Lord, all the earth",
   "heard": 10,
   "words": 10,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Serve the Lord with gladness",
   "heard": 5,
   "words": 5,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Come before his presence with singing",
   "heard": 6,
   "words": 6,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Know that the Lord, he is God",
   "heard": 7,
   "words": 7,
   "error_s": 0.36,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Enter his gates with thanksgiving",
   "heard": 5,
   "words": 5,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And his courts with praise",
   "heard": 5,
   "words": 5,
   "error_s": 0.46,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give thanks to him, bless his name",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Give thanks to him, bless his name",
   "heard": 7,
   "words": 7,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "It is he who made us, and we are his",
   "heard": 10,
   "words": 10,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "We are his people, the sheep of his pasture",
   "heard": 9,
   "words": 9,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the Lord is good, his love endures forever",
   "heard": 9,
   "words": 9,
   "error_s": 0.33,
   "tie_split": false,
   "uncertain": false
  },
  {
