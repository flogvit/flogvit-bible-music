 "lines": [
  {
   "text": "I praise you Father Lord of heaven and earth",
   "heard": 9,
   "words": 9,
   "error_s": 4.51,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Because you have hidden these things from the wise",
   "heard": 9,
   "words": 9,
   "error_s": 3.58,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And learned minds who think they hold the key",
   "heard": 9,
   "words": 9,
   "error_s": 2.31,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You have revealed them to little children",
   "heard": 7,
   "words": 7,
   "error_s": 0.78,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Yes Father for this was your good pleasure",
   "heard": 8,
   "words": 8,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Hidden from the wise and learned",
   "heard": 6,
   "words": 6,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Revealed to the little ones",
   "heard": 5,
   "words": 5,
   "error_s": 0.44,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "This is your pleasure",
   "heard": 4,
   "words": 4,
   "error_s": 2.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "All things entrusted to me by my Father",
   "heard": 8,
   "words": 8,
   "error_s": 5.04,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "No one knows the Son except the Father",
   "heard": 8,
   "words": 8,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And no one knows the Father except the Son",
   "heard": 9,
   "words": 9,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And those to whom the Son chooses to reveal him",
   "heard": 9,
   "words": 10,
   "error_s": 0.63,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Yes Father for this was your good pleasure",
