   "error_s": 1.41,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Silver and gold in our care",
   "heard": 6,
   "words": 6,
   "error_s": 1.37,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For the house of the living God",
