  {
   "text": "The sun will not strike you by day",
   "heard": 8,
   "words": 8,
   "error_s": 0.87,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Nor the moon by night",
   "heard": 5,
   "words": 5,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord is your shade at your right side",
   "heard": 9,
   "words": 9,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Protecting your sight",
   "heard": 3,
   "words": 3,
   "error_s": 0.99,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The Lord will keep you from all harm",
