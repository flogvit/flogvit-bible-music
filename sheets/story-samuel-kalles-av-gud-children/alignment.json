 "lines": [
  {
   "text": "In the temple late at night",
   "heard": 6,
   "words": 6,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The lamp of God was burning bright",
   "heard": 7,
   "words": 7,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Little Samuel lay down",
   "heard": 4,
   "words": 4,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then he heard a calling sound",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Samuel, Samuel",
   "heard": 2,
   "words": 2,
   "error_s": 0.08,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He jumped up and ran to Eli",
   "heard": 7,
   "words": 7,
   "error_s": 0.54,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Here I am; you called me",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I did not call. Go back and lie down",
   "heard": 9,
   "words": 9,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Speak, LORD, for your servant is listening",
   "heard": 7,
   "words": 7,
   "error_s": 0.2,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Speak, LORD, for your servant is listening",
   "heard": 7,
   "words": 7,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Ears wide open, sitting still",
   "heard": 5,
   "words": 5,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Tell me, LORD, and I will",
   "heard": 6,
   "words": 6,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Once again the voice came near",
   "heard": 6,
   "words": 6,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Samuel, Samuel, can you hear",
   "heard": 5,
   "words": 5,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Up he got and ran once more",
   "heard": 7,
   "words": 7,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Down the hall to Eli's door",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Here I am; you called me",
