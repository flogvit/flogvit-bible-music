   "words": 6,
   "error_s": 0.6,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og lyset str\u00e5lte rundt dem",
   "heard": 5,
   "words": 5,
   "error_s": 0.37,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Sov n\u00e5, du lille, sov n\u00e5 s\u00e5 stille",
