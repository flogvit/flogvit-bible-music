 "lines": [
  {
   "text": "The Lord spoke to Moses on Mount Sinai,",
   "heard": 8,
   "words": 8,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Speak to the people of Israel's line.",
   "heard": 7,
   "words": 7,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "When you enter the land I give to you,",
   "heard": 9,
   "words": 9,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The land itself must keep the Sabbath true.",
   "heard": 8,
   "words": 8,
   "error_s": 0.84,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Six years sow the field and prune the vine,",
   "heard": 9,
   "words": 9,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Gather the produce in its season's time.",
   "heard": 7,
   "words": 7,
   "error_s": 1.04,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But in the seventh year let it rest,",
   "heard": 8,
   "words": 8,
   "error_s": 0.72,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A Sabbath of complete and holy rest.",
   "heard": 6,
   "words": 7,
   "error_s": 1.12,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "On the tenth day sound the ram's horn loud,",
   "heard": 9,
   "words": 9,
   "error_s": 0.21,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Proclaim liberty throughout the crowd.",
   "heard": 5,
   "words": 5,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Return to property and family's door,",
   "heard": 6,
   "words": 6,
   "error_s": 0.56,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The fiftieth year opens up once more.",
   "heard": 7,
   "words": 7,
   "error_s": 1.28,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "Do not take advantage of neighbor's need,",
   "heard": 7,
   "words": 7,
   "error_s": 1.59,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Fear the Lord and keep His holy creed.",
   "heard": 8,
   "words": 8,
   "error_s": 1.51,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "The land is mine and you are tenants here,",
   "heard": 9,
   "words": 9,
   "error_s": 1.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Redeem the property and draw near.",
   "heard": 6,
   "words": 6,
   "error_s": 1.01,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "If a brother sells himself to you,",
   "heard": 7,
   "words": 7,
   "error_s": 1.17,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He is not a slave to do as you.",
   "heard": 9,
   "words": 9,
   "error_s": 1.21,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Treat him as a hired worker found,",
   "heard": 7,
   "words": 7,
   "error_s": 0.95,
   "tie_split": false,
   "uncertain": false
  },
