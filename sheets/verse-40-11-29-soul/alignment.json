 "lines": [
  {
   "text": "Come to me, all you who are weary",
   "heard": 8,
   "words": 8,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "And burdened by the weight of the day",
   "heard": 8,
   "words": 8,
   "error_s": 1.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will give you a deep, sweet rest",
   "heard": 8,
   "words": 8,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the soul that is tired and heavy",
   "heard": 8,
   "words": 8,
   "error_s": 0.95,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Take my yoke upon you and learn from me",
   "heard": 9,
   "words": 9,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For I am gentle and humble in heart",
   "heard": 8,
   "words": 8,
   "error_s": 0.89,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "You will find rest for your souls",
   "heard": 7,
   "words": 7,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "In this quiet and sacred place",
   "heard": 6,
   "words": 6,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
