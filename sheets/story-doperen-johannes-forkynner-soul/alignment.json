   "words": 7,
   "error_s": 0.73,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Locusts and honey, no better rest",
   "heard": 6,
   "words": 6,
   "error_s": 0.47,
   "tie_split": false,
   "uncertain": false
