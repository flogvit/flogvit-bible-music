 "words": 101,
 "lines": [
  {
   "text": "De kom til graven tidlig morgen",
   "heard": 5,
   "words": 6,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og lette etter Herren sin",
   "heard": 5,
   "words": 5,
   "error_s": 0.06,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Da sa en engel: V\u00e6r ikke redde",
   "heard": 7,
   "words": 7,
   "error_s": 0.14,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "jeg vet hvem dere s\u00f8ker inn",
   "heard": 6,
   "words": 6,
   "error_s": 0.1,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han er ikke her, han er oppst\u00e5tt",
   "heard": 7,
   "words": 7,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "slik han har sagt, s\u00e5 er det skjedd",
   "heard": 8,
   "words": 8,
   "error_s": 0.23,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Kom og se stedet hvor han l\u00e5",
   "heard": 7,
   "words": 7,
   "error_s": 0.17,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og d\u00f8den er av livet knekt",
   "heard": 4,
   "words": 6,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "G\u00e5 n\u00e5 og si til hans disipler",
   "heard": 7,
   "words": 7,
   "error_s": 0.11,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "han er oppst\u00e5tt fra de d\u00f8de",
   "heard": 6,
   "words": 6,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han g\u00e5r i forveien til Galilea",
   "heard": 6,
   "words": 6,
   "error_s": 0.03,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "der skal dere se ham m\u00f8te",
   "heard": 6,
   "words": 6,
   "error_s": 0.39,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "S\u00e5 syng da, alle, p\u00e5skemorgen",
   "heard": 4,
   "words": 5,
   "error_s": 0.51,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "v\u00e5r Herre lever, han er her",
   "heard": 5,
   "words": 6,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Han er ikke her, han er oppst\u00e5tt",
   "heard": 7,
   "words": 7,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "og graven tom for alltid er",
   "heard": 5,
   "words": 6,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  }
 ],
