   "words": 6,
   "error_s": 0.15,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "To keep and carry out all that is due",
   "heard": 9,
   "words": 9,
   "error_s": 0.42,
   "tie_split": false,
   "uncertain": false
  },
  {
