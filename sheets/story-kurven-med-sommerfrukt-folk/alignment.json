 "lines": [
  {
   "text": "The Lord showed me a sight",
   "heard": 6,
   "words": 6,
   "error_s": 0.82,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A basket of summer fruit",
   "heard": 5,
   "words": 5,
   "error_s": 0.8,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He asked what I see, Amos",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I answered the Lord's truth",
   "heard": 5,
   "words": 5,
   "error_s": 1.09,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The end has come for Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.41,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will never pass them by",
   "heard": 6,
   "words": 6,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The time of grace is finished",
   "heard": 6,
   "words": 6,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Under the open sky",
   "heard": 4,
   "words": 4,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "On that day the palace sings",
   "heard": 6,
   "words": 6,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "But the song turns to wailing",
   "heard": 6,
   "words": 6,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The temple songs are broken",
   "heard": 5,
   "words": 5,
   "error_s": 0.98,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The joy is now failing",
   "heard": 5,
   "words": 5,
   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The end has come for Israel",
   "heard": 6,
   "words": 6,
   "error_s": 0.45,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "I will never pass them by",
   "heard": 6,
   "words": 6,
   "error_s": 0.9,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The time of grace is finished",
   "heard": 6,
   "words": 6,
   "error_s": 0.93,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Under the open sky",
   "heard": 4,
   "words": 4,
   "error_s": 0.69,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Corpses everywhere are found",
   "heard": 4,
   "words": 4,
   "error_s": 0.22,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Flung out in silence deep",
   "heard": 5,
   "words": 5,
   "error_s": 0.85,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "No one hears the lament",
   "heard": 5,
   "words": 5,
   "error_s": 0.55,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "As the secrets sleep",
   "heard": 4,
   "words": 4,
   "error_s": 1.08,
   "tie_split": false,
   "uncertain": false
  },
  {
