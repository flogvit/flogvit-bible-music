 "lines": [
  {
   "text": "Jeg var en synder langt fra Gud",
   "heard": 7,
   "words": 7,
   "error_s": 1.9,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "og visste ikke vei",
   "heard": 4,
   "words": 4,
   "error_s": 1.87,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Men s\u00e5 fikk jeg h\u00f8re ordet",
   "heard": 6,
   "words": 6,
   "error_s": 1.84,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "som er sagt til deg og meg",
   "heard": 7,
   "words": 7,
   "error_s": 1.77,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "For s\u00e5 h\u00f8yt har Gud elsket verden",
   "heard": 7,
   "words": 7,
   "error_s": 1.48,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "at han ga sin enb\u00e5rne S\u00f8nn",
   "heard": 6,
   "words": 6,
   "error_s": 1.49,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "for at hver den som tror p\u00e5 ham",
   "heard": 8,
   "words": 8,
   "error_s": 1.42,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "ikke skal g\u00e5 fortapt, men ha evig liv",
   "heard": 8,
   "words": 8,
   "error_s": 1.41,
   "tie_split": true,
   "uncertain": true
  },
  {
   "text": "N\u00e5 vil jeg synge det for alle",
   "heard": 7,
   "words": 7,
   "error_s": 1.43,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "som er trette, som er sm\u00e5",
   "heard": 6,
   "words": 6,
   "error_s": 1.24,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Det er ikke for de gode",
