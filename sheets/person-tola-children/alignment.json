 "lines": [
  {
   "text": "After Abimelech's time was done",
   "heard": 5,
   "words": 5,
   "error_s": 2.67,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Tola son of Puah rose up",
   "heard": 6,
   "words": 6,
   "error_s": 2.03,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "Son of Dodo in the sun",
   "heard": 6,
   "words": 6,
   "error_s": 2.28,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A man of Issachar he was",
   "heard": 6,
   "words": 6,
   "error_s": 2.36,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He lived in Shamir it is true",
   "heard": 7,
   "words": 7,
   "error_s": 2.25,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the hill country of Ephraim",
   "heard": 6,
   "words": 6,
   "error_s": 1.98,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He brought the peace back to the view",
   "heard": 8,
   "words": 8,
   "error_s": 1.87,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "And saved the people from their whim",
   "heard": 7,
   "words": 7,
   "error_s": 1.69,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He judged Israel for twenty-three",
   "heard": 5,
   "words": 5,
   "error_s": 0.97,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Years of quiet and stability",
   "heard": 3,
   "words": 5,
   "error_s": 0.88,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He served the land with gentle care",
   "heard": 7,
   "words": 7,
   "error_s": 1.35,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "A judge who lived without a scare",
   "heard": 7,
   "words": 7,
   "error_s": 1.46,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "His lineage from Dodo came",
   "heard": 5,
   "words": 5,
   "error_s": 1.27,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "From the tribe that knew his name",
   "heard": 7,
   "words": 7,
   "error_s": 1.29,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "He exercised his office well",
   "heard": 5,
   "words": 5,
   "error_s": 1.33,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "In the hill where the shadows fell",
   "heard": 7,
   "words": 7,
   "error_s": 0.65,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He judged Israel for twenty-three",
   "heard": 5,
   "words": 5,
   "error_s": 0.53,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "Years of quiet and stability",
   "heard": 3,
   "words": 5,
   "error_s": 0.13,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He served the land with gentle care",
   "heard": 7,
   "words": 7,
   "error_s": 0.68,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A judge who lived without a scare",
   "heard": 6,
   "words": 7,
   "error_s": 0.67,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Then he died and found his rest",
   "heard": 7,
   "words": 7,
   "error_s": 0.57,
   "tie_split": false,
   "uncertain": false
  },
