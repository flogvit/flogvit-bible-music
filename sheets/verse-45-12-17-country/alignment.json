   "error_s": 0.48,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "If he is thirsty, give him something to drink",
   "heard": 6,
   "words": 9,
   "error_s": 1.03,
   "tie_split": true,
   "uncertain": false
  },
  {
