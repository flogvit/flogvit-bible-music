   "error_s": 0.3,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The kingdom of heaven has come near",
   "heard": 7,
   "words": 7,
   "error_s": 0.76,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "A voice calling out, the world draws near",
   "heard": 8,
   "words": 8,
   "error_s": 0.62,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Prepare the way of the Lord",
   "heard": 6,
   "words": 6,
   "error_s": 0.58,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Make his paths straight for us to see",
   "heard": 8,
   "words": 8,
   "error_s": 0.66,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "The spirit and the fire are near",
   "heard": 7,
   "words": 7,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Repent now, for the day is here",
   "heard": 6,
   "words": 7,
   "error_s": 0.83,
   "tie_split": false,
   "uncertain": false
  },
  {
