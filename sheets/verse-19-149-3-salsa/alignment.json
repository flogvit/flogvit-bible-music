 "lines": [
  {
   "text": "Sing to the Lord a new song",
   "heard": 7,
   "words": 7,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "His praise in the assembly of the faithful",
   "heard": 8,
   "words": 8,
   "error_s": 0.49,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let Israel be glad in its Maker",
   "heard": 7,
   "words": 7,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let the children of Zion rejoice in their King",
   "heard": 9,
   "words": 9,
   "error_s": 0.27,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Praise his name with dancing",
   "heard": 5,
   "words": 5,
   "error_s": 0.43,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Make music with tambourine and lyre",
   "heard": 6,
   "words": 6,
   "error_s": 0.24,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "For the Lord takes pleasure in his people",
   "heard": 8,
   "words": 8,
   "error_s": 0.19,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "He crowns the humble with salvation",
   "heard": 6,
   "words": 6,
   "error_s": 0.5,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let the faithful exult in glory",
   "heard": 6,
   "words": 6,
   "error_s": 0.16,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let them sing for joy upon their beds",
   "heard": 8,
   "words": 8,
   "error_s": 0.18,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "With the high praises of God in their mouths",
   "heard": 9,
   "words": 9,
   "error_s": 0.38,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "Let them dance before the King",
   "heard": 6,
   "words": 6,
   "error_s": 0.4,
   "tie_split": false,
   "uncertain": false
