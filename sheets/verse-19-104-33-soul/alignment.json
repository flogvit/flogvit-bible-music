  {
   "text": "When you send forth your Spirit",
   "heard": 6,
   "words": 6,
   "error_s": 0.71,
   "tie_split": false,
   "uncertain": false
  },
  {
   "text": "They are created anew",
   "heard": 4,
   "words": 4,
   "error_s": 1.4,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You made it new",
   "heard": 4,
   "words": 4,
   "error_s": 2.3,
   "tie_split": false,
   "uncertain": true
  },
  {
   "text": "You renew the face of the earth",
   "heard": 7,
   "words": 7,
   "error_s": 0.28,
   "tie_split": true,
   "uncertain": false
  },
  {
   "text": "With grace that we receive",
